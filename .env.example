# Environment Variables Template for Kaptativa 2.0
# Copy this file to .env for local development

# Appwrite Cloud or Self-Hosted Configuration
PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
PUBLIC_APPWRITE_PROJECT_ID="your_project_id_here"
PUBLIC_APPWRITE_DATABASE_ID="kaptativa_db"
APPWRITE_API_KEY="your_server_api_key_here"

# OpenAI API Key for Chatbot Assistant & AI Agents
OPENAI_API_KEY="your_openai_api_key_here"

# Google Analytics 4 (opcional): con esto se activan la medición y los eventos de conversión
PUBLIC_GA4_ID=""
