---
interface Props {
  title: string;
  description?: string;
  /** Datos estructurados (JSON-LD) propios de la página: un objeto o una lista */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Página de prueba o interna: no indexar */
  noindex?: boolean;
}

const { 
  title, 
  description = "Transformamos tu negocio con tecnología que conecta, automatiza y escala.",
  schema,
  noindex = false
} = Astro.props;
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

import Chatbot from '../components/Chatbot.astro';
// Fuentes autoalojadas: solo los pesos que usa el sitio público
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/lexend/400.css';
import '@fontsource/lexend/500.css';
import '@fontsource/lexend/600.css';
import '../styles/global.css';
// Precarga de las fuentes de la primera pantalla (título y texto): evita el salto de diseño al cargar
import lexend600 from '@fontsource/lexend/files/lexend-latin-600-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kaptativa.com');
// Google Analytics 4: solo se carga si está definida PUBLIC_GA4_ID (ej. G-XXXXXXX)
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || '';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO & Optimization -->
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="kaptativa, diseño web, automatizacion de procesos, inteligencia artificial aplicada, digitalizacion de negocios, landing page, ecommerce, chatbots whatsapp">
  <meta name="author" content="kaptativa">
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"}>
  <meta name="google-site-verification" content="FDcUTvvGHpdsHNvfAK1BRzsSiaSEx27YcRAzKEQnPEM" />
  <link rel="canonical" href={canonicalURL.href}>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL.href}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://kaptativa.com/og-image.jpg">
  
  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL.href}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://kaptativa.com/og-image.jpg">
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  
  <!-- Fuentes autoalojadas (@fontsource): sin conexiones a Google Fonts -->
  <link rel="preload" href={lexend600} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
  
  <!-- JSON-LD Structured Data (Organization Schema) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "kaptativa",
    "url": "https://kaptativa.com/",
    "logo": "https://kaptativa.com/logo.svg",
    "description": "Transformamos tu negocio con tecnología que conecta, automatiza y escala.",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+54-9-380-489-0834",
      "contactType": "customer service",
      "email": "hola@kaptativa.com",
      "availableLanguage": "Spanish"
    }
  }
  </script>
  {pageSchemas.map((sch) => <script type="application/ld+json" set:html={JSON.stringify(sch)} />)}
  <script is:inline>
    const theme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', theme);
  </script>

  <style is:global>
    /* FORCED OVERRIDES FOR DESKTOP CARDS GLOBALLY */
    @media (min-width: 769px) {
      .for-card p, .rubro-card p {
        display: block !important;
        opacity: 1 !important;
        visibility: visible !important;
        max-height: none !important;
        margin-top: 15px !important;
        padding: 0 8px !important;
      }
      .card-chevron, .for-card::after, .rubro-card::after {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
      }
      .for-card .card-header-row, .rubro-card .card-header-row {
        pointer-events: none !important;
      }
    }
  </style>
  {GA4_ID && (
    <Fragment>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
      <script is:inline define:vars={{ GA4_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA4_ID);
      </script>
    </Fragment>
  )}
  <script is:inline>
    // Eventos de conversión (no hace nada si GA4 no está cargado)
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a');
      if (!a || typeof window.gtag !== 'function') return;
      var href = a.getAttribute('href') || '';
      var text = (a.textContent || '').trim();
      var params = { link_text: text.slice(0, 60), page_path: location.pathname };
      if (/solicitar demo/i.test(text)) window.gtag('event', 'solicitar_demo', params);
      if (href.indexOf('wa.me') !== -1) window.gtag('event', 'whatsapp_click', params);
      else if (href.indexOf('/contacto') === 0) window.gtag('event', 'contacto_click', params);
    });
  </script>
</head>
<body>
  <!-- Global Sticky Top Reading Progress Bar -->
  <div id="reading-progress-bar" style="position: fixed; top: 0; left: 0; height: 4px; width: 0%; background: linear-gradient(90deg, #7C5CFF 0%, #6A48F5 50%, #B7A6FF 100%); z-index: 999999; transition: width 0.08s ease-out, opacity 0.3s ease; box-shadow: 0 0 12px rgba(124, 92, 255, 0.9); pointer-events: none; opacity: 0;"></div>

  <script is:inline>
    (function() {
      function updateReadingProgress() {
        const winScroll = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
        const height = (document.documentElement.scrollHeight || document.body.scrollHeight) - window.innerHeight;
        const bar = document.getElementById('reading-progress-bar');
        if (!bar) return;
        if (height <= 0) {
          bar.style.width = '0%';
          return;
        }
        const scrolled = (winScroll / height) * 100;
        const finalWidth = Math.min(100, scrolled);
        bar.style.width = finalWidth + '%';
        bar.style.opacity = winScroll > 10 ? '1' : '0';
      }

      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      window.addEventListener('resize', updateReadingProgress, { passive: true });
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateReadingProgress);
      } else {
        updateReadingProgress();
      }
    })();
  </script>

  <div id="scroll-sentinel"></div>
  
  <slot name="header" />
  
  <slot />
  
  <slot name="footer" />

  <!-- Chatbot IA -->
  {!Astro.url.pathname.startsWith('/admin') && !Astro.url.pathname.includes('/checkout') && <Chatbot />}

  <!-- Chatbot Integration -->
  <script src="/app.js" is:inline defer></script>
</body>
</html>
