---
// Soluciones por rubro: la misma plataforma configurada para cada tipo de negocio.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroAurora from '../components/HeroAurora.astro';
import IsoK3D from '../components/IsoK3D.astro';
import CtaBeam from '../components/CtaBeam.astro';
import RubroVisual from '../components/home2/RubroVisual.astro';
import { soluciones, svg } from '../data/plataforma.js';
const WHATSAPP = 'https://wa.me/5493804890834?text=' + encodeURIComponent('¡Hola kaptativa! Quiero solicitar una demo de la plataforma para mi rubro.');
// Bento: cuatro rubros destacados (tile ancho con el gráfico animado) y cuatro compactos (ícono). El orden llena 3 filas de 4 celdas sin huecos.
const destacados = ['tiendas-online', 'mayoristas', 'inmobiliarias', 'gastronomia'];
const porSlug = (slug) => soluciones.find((x) => x.slug === slug);
const orden = ['tiendas-online', 'gimnasios-y-clubes', 'turnos-y-cursos', 'asociaciones-y-mutuales', 'servicios-profesionales', 'mayoristas', 'inmobiliarias', 'gastronomia'].map(porSlug).filter(Boolean);
const faltan = soluciones.filter((x) => !orden.includes(x));
const bento = [...orden, ...faltan];
// Abanico del hero
const heroRubros = ['tiendas-online', 'gastronomia', 'inmobiliarias'].map(porSlug).filter(Boolean);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Soluciones por rubro de kaptativa',
  itemListElement: soluciones.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: `https://kaptativa.com/soluciones/${s.slug}/` })),
};
---

<Layout title="Soluciones por rubro: sitio web, tienda y gestión para tu negocio | kaptativa" description="La misma plataforma configurada para tiendas online, mayoristas, gastronomía, gimnasios, turnos, inmobiliarias, mutuales y profesionales. Elegí tu rubro y mirá qué resuelve." schema={schema}>
  <Header slot="header" floating />

  <main>
    <section class="hero hero-section" id="soluciones-hero">
      <HeroAurora />
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="container so-hero-grid">
        <div class="hero-content reveal">
          <h1 class="hero-tagline">Una plataforma, <span class="text-gradient-crimson">configurada para tu&nbsp;rubro</span></h1>
          <p class="hero-description">La misma base tecnológica, adaptada a cómo trabaja tu negocio: sitio, tienda, gestión y asistente de IA en WhatsApp. Elegí el tuyo y mirá qué resuelve.</p>
          <div class="hero-buttons">
            <a href="#rubros" class="btn btn-primary btn-glow">Ver los rubros</a>
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Solicitar demo</a>
          </div>
        </div>

        <!-- Abanico con tres rubros: la misma plataforma mostrando datos distintos -->
        <div class="so-fan reveal reveal-delay-1" aria-hidden="true">
          {heroRubros.map((r, i) => (
            <div class={`so-card so-card-${i + 1}`}>
              <span class="so-tag"><Fragment set:html={svg(r!.icon)} />{r!.title}</span>
              <RubroVisual slug={r!.slug} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-light" id="rubros">
      <div class="container">
        <div class="section-header reveal">
          <h2>Elegí tu rubro</h2>
          <p>Ocho configuraciones listas, con los módulos y los flujos que cada negocio necesita desde el primer día.</p>
        </div>
        <div class="bg reveal">
          {bento.map((s) => destacados.includes(s.slug) ? (
            <a class="bg-tile bg-feat" href={`/soluciones/${s.slug}/`}>
              <div class="bg-stage"><RubroVisual slug={s.slug} /></div>
              <div class="bg-body">
                <span class="bg-kicker">{s.short}</span>
                <h3>{s.title}</h3>
                <p>{s.card ?? s.text}</p>
                <span class="bg-link">Ver solución para {s.cta ?? s.title.toLowerCase()} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
              </div>
            </a>
          ) : (
            <a class="bg-tile bg-mini" href={`/soluciones/${s.slug}/`}>
              <span class="bg-ic"><Fragment set:html={svg(s.icon)} /></span>
              <h3>{s.title}</h3>
              <p>{s.short}</p>
              <span class="bg-link">Ver solución para {s.cta ?? s.title.toLowerCase()} <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
            </a>
          ))}
        </div>
        <p class="sol-nota reveal">¿Tu rubro no está? La plataforma se adapta igual: <a href={WHATSAPP} target="_blank" rel="noopener noreferrer">contanos tu caso por WhatsApp</a> y te mostramos cómo quedaría.</p>
      </div>
    </section>

    <section class="section section-cta">
      <div class="container">
        <div class="cta-card-neon reveal">
          <CtaBeam />
          <div class="cta-glow-overlay"></div>
          <IsoK3D size={118} />
          <div class="cta-info-side">
            <h2>¿Te mostramos cómo funcionaría<br />en tu negocio?</h2>
            <p style="margin-bottom: 25px;">Coordinamos una demo con tu rubro ya configurado y te pasamos una propuesta a medida en 24 hs hábiles.</p>
            <div class="cta-buttons">
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow">Solicitar demo</a>
              <a href="/precios/" class="btn btn-secondary">Ver planes</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>


<style>
  /* Hero compacto con un abanico de tres rubros a la derecha (antes ocupaba toda la pantalla y la mitad quedaba vacía) */
  #soluciones-hero { min-height: 0; padding: 150px 0 80px; }
  .so-hero-grid { position: relative; z-index: 2; width: 100%; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 48px; align-items: center; }
  .so-fan { position: relative; height: 430px; text-align: left; }
  .so-card { position: absolute; width: 64%; padding: 10px; border-radius: 20px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); box-shadow: 0 26px 50px rgba(0, 0, 0, 0.5); backdrop-filter: blur(6px); transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
  .so-card :global(.rv) { height: 168px; }
  .so-tag { display: inline-flex; align-items: center; gap: 7px; margin: 2px 4px 10px; font-size: 0.82rem; font-weight: 600; color: #fff; }
  .so-tag :global(.ki) { width: 16px; height: 16px; fill: none; stroke: #A08CFF; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .so-card-1 { left: 0; top: 0; z-index: 1; transform: rotate(-4deg); }
  .so-card-2 { right: 0; top: 64px; z-index: 2; transform: rotate(3deg); }
  .so-card-3 { left: 14%; bottom: 0; z-index: 3; transform: rotate(-1deg); }
  .so-fan:hover .so-card-1 { transform: rotate(-5deg) translate(-8px, -6px); }
  .so-fan:hover .so-card-2 { transform: rotate(4deg) translate(8px, -4px); }
  .so-fan:hover .so-card-3 { transform: rotate(-1deg) translateY(6px); }
  @media (max-width: 1024px) {
    .so-hero-grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .so-fan { max-width: 560px; width: 100%; margin: 0 auto; }
  }
  @media (max-width: 600px) {
    #soluciones-hero { padding: 120px 0 48px; }
    .so-fan { height: 360px; }
    .so-card { width: 80%; padding: 8px; }
    .so-card-2 { top: 54px; }
    .so-card-3 { left: 8%; }
    .so-card :global(.rv) { height: 150px; font-size: 0.72rem; }
  }
  @media (prefers-reduced-motion: reduce) { .so-card { transition: none; } }
  /* Bento de rubros: cuatro tiles anchos con el gráfico animado y cuatro compactos con ícono; distinto de la grilla de la home */
  .bg { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(220px, auto); gap: 16px; }
  .bg-tile { position: relative; display: flex; flex-direction: column; min-width: 0; padding: 22px; border-radius: 22px; text-decoration: none; color: inherit; background: linear-gradient(180deg, #FAF8FF 0%, #FFFFFF 58%); border: 1px solid #E9E5F8; box-shadow: 0 1px 2px rgba(15, 15, 18, 0.04), 0 14px 34px -20px rgba(124, 92, 255, 0.35); transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, border-color 0.3s ease; }
  .bg-tile:hover { transform: translateY(-4px); border-color: rgba(124, 92, 255, 0.45); box-shadow: 0 2px 4px rgba(15, 15, 18, 0.04), 0 24px 48px -20px rgba(124, 92, 255, 0.45); }
  .bg-feat { grid-column: span 2; flex-direction: row; align-items: center; gap: 22px; padding: 18px 26px 18px 18px; }
  .bg-stage { flex: 0 0 46%; display: grid; place-items: center; align-self: stretch; padding: 14px 10px; border-radius: 16px; background: radial-gradient(circle at 30% 20%, rgba(124, 92, 255, 0.18), transparent 60%), linear-gradient(180deg, #F1EDFF, #F8F6FF); border: 1px solid #E9E5F8; transition: background 0.3s ease; }
  .bg-feat:hover .bg-stage { background: radial-gradient(circle at 30% 20%, rgba(124, 92, 255, 0.28), transparent 60%), linear-gradient(180deg, #EDE8FF, #F6F3FF); }
  .bg-stage > :global(.rv) { width: 100%; font-size: 0.72rem; height: auto; min-height: 150px; padding: 12px; }
  .bg-stage :global(.rv-photo) { display: none; }
  .bg-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .bg-kicker { font-size: 0.78rem; font-weight: 600; color: #5B3FE0; margin-bottom: 6px; }
  .bg-tile h3 { font-family: 'Lexend', sans-serif; font-weight: 600; color: #17161D !important; margin: 0 !important; line-height: 1.25 !important; }
  .bg-feat h3 { font-size: 1.3rem !important; }
  .bg-feat p { margin: 10px 0 0 !important; font-size: 0.92rem; line-height: 1.6; color: #4B4A57 !important; }
  .bg-ic { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: #5B3FE0; background: linear-gradient(135deg, #F3F0FF, #E6E0FF); border: 1px solid rgba(124, 92, 255, 0.28); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9); transition: background 0.25s ease, color 0.25s ease; }
  .bg-ic :global(.ki) { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .bg-mini:hover .bg-ic { background: linear-gradient(135deg, #7C5CFF, #6A48F5); color: #FFFFFF; border-color: transparent; }
  .bg-mini h3 { font-size: 1.08rem !important; margin-top: 18px !important; }
  .bg-mini p { flex: 1; margin: 6px 0 0 !important; font-size: 0.9rem; line-height: 1.5; color: #4B4A57 !important; }
  .bg-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; font-size: 0.86rem; font-weight: 600; color: #5B3FE0; }
  .bg-link svg { transition: transform 0.25s ease; }
  .bg-tile:hover .bg-link svg { transform: translateX(3px); }
  @media (max-width: 1100px) { .bg { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; } }
  @media (max-width: 640px) { .bg { grid-template-columns: 1fr; } .bg-feat { grid-column: auto; flex-direction: column; align-items: stretch; padding: 18px; } .bg-stage { flex: none; } }
  @media (prefers-reduced-motion: reduce) { .bg-tile:hover { transform: none; } }
  .sol-nota { text-align: center; margin: 32px auto 0; max-width: 60ch; color: #52525B; font-size: 0.95rem; }
  .sol-nota a { color: #5B3FE0; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .section-cta { padding: 80px 0; }
  .cta-card-neon { background: var(--card-bg); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--border-radius-lg); padding: 60px 40px; display: grid; grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 40px; align-items: center; position: relative; overflow: hidden; }
  .cta-glow-overlay { position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(124, 92, 255, 0.12) 0%, transparent 75%), radial-gradient(circle at 80% 80%, rgba(124, 92, 255, 0.08) 0%, transparent 50%); pointer-events: none; }
  .cta-info-side { position: relative; z-index: 5; max-width: 720px; }
  .cta-card-neon h2 { font-size: 2.4rem; font-family: 'Lexend', sans-serif; font-weight: 600; margin-bottom: 20px; line-height: 1.2; }
  .cta-card-neon p { font-size: 1.1rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .cta-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  @media (max-width: 768px) { .section-cta { padding: 56px 0; } .cta-card-neon { gap: 30px; padding: 40px 30px; } .cta-card-neon h2 { font-size: 1.9rem; } }
  @media (max-width: 480px) { .cta-buttons .btn { width: 100%; justify-content: center; } .cta-card-neon { padding: 32px 18px; } }
</style>
