---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Equipo from '../components/Equipo.astro';
import { svg } from '../data/plataforma.js';
---

<Layout title="Quiénes somos: el equipo detrás de Kaptativa" description="Conocé el equipo y la metodología detrás de Kaptativa. Desarrollamos soluciones tecnológicas a medida, CRM y automatizaciones con IA.">
  <Header slot="header" floating />
  
  <main>
    <!-- HERO INMERSIVO DE MARCA -->
    <section class="hero hero-section" id="nosotros-hero">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      
      <div class="container hero-container">
        <div class="hero-content reveal">
          <h1 class="hero-tagline">Somos <span class="text-gradient-crimson">kaptativa<sup>®</sup></span>.<br />Tu socio de transformación digital.</h1>
          <p class="hero-description"><span class="text-gradient-crimson" style="font-weight: 600;">kaptativa<sup>®</sup> Digital</span> es una agencia de transformación digital de La Rioja, fundada por Eliana Azcurra. Un equipo multidisciplinario que integra marketing, tecnología y datos en una sola estrategia para potenciar empresas con sistemas, no con parches.</p>
          
          <div class="hero-buttons">
            <a href="/contacto" class="btn btn-primary btn-glow">Agendá una demo</a>
            <a href="#equipo" class="btn btn-secondary">Conocer al equipo</a>
          </div>
        </div>
      </div>
    </section>

    <Equipo />


    <!-- NUESTRA HISTORIA -->


    <!-- QUÉ SOMOS Y QUÉ NO SOMOS (COMPARATIVA CON TARJETAS GLASS) -->
    <section class="section section-light" id="comparativa-identidad">
      <div class="container">
        <div class="section-header reveal text-center">
          <h2>Qué somos y qué no somos.</h2>
          <p style="max-width: 650px; margin: 0 auto; color: var(--text-secondary);">La diferencia no es de marketing, es de forma de trabajar. Acá está, sin vueltas.</p>
        </div>

        <div class="comp-flex-container reveal">
          <!-- Lo que sí somos -->
          <div class="comp-box comp-box-yes">
            <div class="comp-header">
              <h3 class="comp-title">Lo que sí somos</h3>
            </div>
            <div class="comp-items-wrap">
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
                <div class="comp-item-text">
                  <h4>Socio estratégico que se integra en tu negocio</h4>
                  <p>Trabajamos como un brazo de tu equipo, alineando los objetivos a largo plazo.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
                <div class="comp-item-text">
                  <h4>Sistemas medibles y escalables</h4>
                  <p>Construimos estructuras técnicas listas para absorber 10x más volumen sin romperse.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
                <div class="comp-item-text">
                  <h4>Transformación con transferencia</h4>
                  <p>Tu equipo aprende y adquiere la capacidad de operar las herramientas de forma autónoma.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
                <div class="comp-item-text">
                  <h4>Marketing, tecnología y datos en una sola estrategia</h4>
                  <p>Una visión 360° unificada que conecta la captación con la ejecución operativa.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Lo que no somos -->
          <div class="comp-box comp-box-no">
            <div class="comp-header">
              <h3 class="comp-title">Lo que no somos</h3>
            </div>
            <div class="comp-items-wrap">
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
                <div class="comp-item-text">
                  <h4>Proveedor que solo ejecuta tickets</h4>
                  <p>Hacer tareas a ciegas sin cuestionar si realmente le sirven al negocio.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
                <div class="comp-item-text">
                  <h4>Acciones sueltas sin medición</h4>
                  <p>Lanzar campañas o parches aislados sin métricas de rentabilidad ni retorno.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
                <div class="comp-item-text">
                  <h4>Dependencia eterna del proveedor</h4>
                  <p>Cajas negras donde necesitás pagar mensualmente para que te muevan un botón.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
                <div class="comp-item-text">
                  <h4>Una sola pata desconectada del resto</h4>
                  <p>Equipos de diseño que no entienden de ventas, o programadores que no ven marketing.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CÓMO TRABAJAMOS (CARRUSEL MARQUEE INFINITO DE EXTREMO A EXTREMO) -->
    <section class="section section-dark" id="por-que">
      <div class="container">
        <div class="section-header reveal">
          <h2>Por qué elegir Kaptativa</h2>
          <p>Seis razones concretas, no adjetivos.</p>
        </div>
        <ul class="porque-grid reveal">
          <li class="porque" style="--i:0">
            <span class="porque-icon"><Fragment set:html={svg('layers')} /></span>
            <h3>Una plataforma, no diez herramientas</h3>
            <p>Sitio, tienda, pedidos, facturación y asistente con IA en un solo panel. Sin pegar sistemas que no se hablan.</p>
          </li>
          <li class="porque" style="--i:1">
            <span class="porque-icon"><Fragment set:html={svg('shield')} /></span>
            <h3>El código es tuyo</h3>
            <p>Sin licencias por usuario ni suscripciones que te atan. Si mañana querés irte, te llevás todo.</p>
          </li>
          <li class="porque" style="--i:2">
            <span class="porque-icon"><Fragment set:html={svg('chart')} /></span>
            <h3>Resultados que se miden</h3>
            <p>Cada sitio sale con Lighthouse en verde y con los eventos de conversión conectados. Sabés qué canal trae consultas.</p>
          </li>
          <li class="porque" style="--i:3">
            <span class="porque-icon"><Fragment set:html={svg('message')} /></span>
            <h3>Hablás con quien construye</h3>
            <p>Equipo chico y directo: la persona que te responde el WhatsApp es la que diseña y programa tu sistema.</p>
          </li>
          <li class="porque" style="--i:4">
            <span class="porque-icon"><Fragment set:html={svg('clipboard')} /></span>
            <h3>Por etapas y sin letra chica</h3>
            <p>Propuesta con alcance y plazos por módulo. Arrancamos por lo que vende y sumamos la gestión después.</p>
          </li>
          <li class="porque" style="--i:5">
            <span class="porque-icon"><Fragment set:html={svg('rocket')} /></span>
            <h3>Hecho en Argentina, para vender acá</h3>
            <p>MercadoPago, ARCA, Andreani, WhatsApp y Tokko integrados de fábrica, porque así se vende en el país.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- EL EQUIPO -->

    <!-- SECCIÓN DE CONTACTO FINAL -->
    <section class="section section-dark" id="contacto-nosotros" style="padding: 100px 0;">
      <div class="container" style="text-align: center;">
        <div class="section-header reveal text-center" style="margin-bottom: 30px;">
          <h2>¿Listo para impulsar tu transformación?</h2>
          <p style="color: var(--text-secondary); max-width: 600px; margin: 10px auto 0;">Contanos tu desafío. Te responderemos en menos de 24hs hábiles.</p>
        </div>

        <div class="home-contact-buttons reveal reveal-delay-1" style="display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 25px; margin-bottom: 40px; flex-wrap: wrap;">
          <a href="/contacto" class="btn btn-primary btn-glow" style="padding: 12px 28px; font-weight: 600; border-radius: 999px;">
            <span>Agendá un diagnóstico</span>
          </a>
          <a href="https://wa.me/5493804890834" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="padding: 12px 28px; font-weight: 600; border-radius: 999px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); color: #ffffff;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            <span>WhatsApp</span>
          </a>
        </div>

        
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>


<style is:global>
  .story-card-wrapper {
    max-width: 880px;
    margin: 0 auto;
    background: rgba(27, 27, 32, 0.6);
    border: 1px solid rgba(106, 72, 245, 0.25);
    border-radius: 28px;
    padding: 50px 45px;
    backdrop-filter: blur(16px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }
  .story-body p {
    font-size: 1.08rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 22px;
  }
  .story-body p:last-child {
    margin-bottom: 0;
  }

  /* Comparison Section styling fix */
  .comp-flex-container {
    display: flex;
    gap: 30px;
    max-width: 1100px;
    margin: 45px auto 0;
  }
  .comp-box {
    flex: 1;
    background: rgba(27, 27, 32, 0.75) !important;
    border-radius: 28px !important;
    padding: 40px !important;
    backdrop-filter: blur(16px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    display: block !important;
  }
  .comp-box-yes {
    border: 1px solid rgba(124, 92, 255, 0.4) !important;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(124, 92, 255, 0.15);
  }
  .comp-box-no {
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    background: rgba(27, 27, 32, 0.45) !important;
  }
  .comp-header {
    margin-bottom: 30px;
  }
  .badge-tag-yes {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: 20px;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.4);
    margin-bottom: 12px;
  }
  .badge-tag-no {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.15);
    margin-bottom: 12px;
  }
  .comp-title {
    font-family: 'Lexend', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  .comp-items-wrap {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .comp-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .comp-icon-circle {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .icon-circle-yes {
    background: rgba(16, 185, 129, 0.18);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }
  .icon-circle-no {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .comp-item-text h4 {
    font-family: 'Lexend', sans-serif;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 4px 0;
  }
  .comp-item-text p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  /* Full Bleed Infinite Marquee Carousel Styling */
  .overflow-hidden {
    overflow: hidden;
  }
  .infinite-marquee-viewport {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
    padding: 20px 0 30px;
    mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
  }
  .infinite-marquee-track {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: marqueeSmooth 35s linear infinite;
  }
  .infinite-marquee-viewport:hover .infinite-marquee-track {
    animation-play-state: paused;
  }

  @keyframes marqueeSmooth {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .val-marquee-card {
    width: 350px;
    min-width: 350px;
    background: linear-gradient(135deg, rgba(27, 27, 32, 0.85) 0%, rgba(25, 12, 35, 0.85) 100%);
    border: 1px solid rgba(106, 72, 245, 0.25);
    border-radius: 20px;
    padding: 36px 30px;
    backdrop-filter: blur(16px);
    position: relative;
    overflow: hidden;
    transition: all 0.35s ease;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }
  .val-marquee-card:hover {
    border-color: rgba(124, 92, 255, 0.5);
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(124, 92, 255, 0.2);
  }
  .val-watermark {
    position: absolute;
    top: -15px;
    right: 15px;
    font-family: 'Lexend', sans-serif;
    font-size: 5rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.03);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    transition: color 0.35s ease;
  }
  .val-marquee-card:hover .val-watermark {
    color: rgba(124, 92, 255, 0.08);
  }
  .val-tag-pill {
    display: inline-block;
    font-family: 'Lexend', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-pink);
    background: rgba(124, 92, 255, 0.15);
    border: 1px solid rgba(124, 92, 255, 0.3);
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }
  .val-marquee-card h3 {
    font-family: 'Lexend', sans-serif;
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
  }
  .val-marquee-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .comp-flex-container {
      flex-direction: column;
    }
    .val-marquee-card {
      width: 300px;
      min-width: 300px;
      padding: 28px 22px;
    }
  }
</style>
