---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Equipo from '../components/Equipo.astro';
---

<Layout title="Quiénes Somos | Kaptativa" description="Conocé el equipo y la metodología detrás de Kaptativa. Desarrollamos soluciones tecnológicas a medida, CRM y automatizaciones con IA.">
  <Header slot="header" />
  
  <main>
    <!-- HERO INMERSIVO DE MARCA -->
    <section class="hero hero-section" id="nosotros-hero">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      
      <div class="container hero-container">
        <div class="hero-content reveal">
          <span class="badge">
            <span class="badge-dot-pulsing"></span> QUIÉNES SOMOS
          </span>
          <h1 class="hero-tagline">Somos <span class="text-gradient-crimson">kaptativa<sup>®</sup></span>.<br />Tu socio de transformación digital.</h1>
          <p class="hero-description"><span class="text-gradient-crimson" style="font-weight: 600;">kaptativa<sup>®</sup> Digital</span> es una agencia de transformación digital de La Rioja, fundada por Eliana Azcurra. Un equipo multidisciplinario que integra marketing, tecnología y datos en una sola estrategia para potenciar empresas con sistemas, no con parches.</p>
          
          <div class="hero-buttons">
            <a href="/contacto" class="btn btn-primary btn-glow">Agendá una demo</a>
            <a href="#nuestra-historia" class="btn btn-secondary">Ver el método</a>
          </div>
        </div>
      </div>
    </section>

    <!-- NUESTRA HISTORIA -->
    <section class="section section-dark" id="nuestra-historia">
      <div class="container">
        <div class="story-card-wrapper reveal">
          <div class="section-header" style="margin-bottom: 25px;">
            <span class="badge">NUESTRA HISTORIA</span>
            <h2>Kap de captación, Tativa de transformación.</h2>
          </div>
          <div class="story-body">
            <p>
              El nombre lo dice todo. <strong>Kap viene de captación y Tativa de transformación</strong>: las dos cosas que buscamos cada vez que entramos a un negocio. No nacimos para ejecutar tareas sueltas, nacimos para mover empresas hacia adelante.
            </p>
            <p>
              <span class="text-gradient-crimson" style="font-weight: 600;">kaptativa<sup>®</sup></span> empezó con una idea simple y poco común en el rubro: la mayoría de las empresas no necesita más herramientas ni más campañas, necesita orden. Necesita que alguien lea su operación como un sistema y construya las piezas que faltan para que escale sin romperse.
            </p>
            <p>
              Por eso no nos presentamos como una agencia. Una agencia te gestiona campañas; una fábrica de software te entrega un producto y desaparece. Nosotros nos integramos en tu negocio como un brazo estratégico, construimos los sistemas que necesitás y te enseñamos a operarlos. Desde La Rioja trabajamos con clientes en Argentina y en el exterior, en e-commerce, eventos, inmobiliarias, estética, salud y B2B.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- QUÉ SOMOS Y QUÉ NO SOMOS (COMPARATIVA CON TARJETAS GLASS) -->
    <section class="section" id="comparativa-identidad">
      <div class="container">
        <div class="section-header reveal text-center">
          <span class="badge badge-accent">PARA QUE QUEDE CLARO</span>
          <h2>Qué somos <span class="text-gradient-crimson">y qué no somos.</span></h2>
          <p style="max-width: 650px; margin: 0 auto; color: var(--text-secondary);">La diferencia no es de marketing, es de forma de trabajar. Acá está, sin vueltas.</p>
        </div>

        <div class="comp-flex-container reveal">
          <!-- Lo que sí somos -->
          <div class="comp-box comp-box-yes">
            <div class="comp-header">
              <span class="badge-tag-yes">kaptativa<sup>®</sup></span>
              <h3 class="comp-title">Lo que sí somos</h3>
            </div>
            <div class="comp-items-wrap">
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes">✓</div>
                <div class="comp-item-text">
                  <h4>Socio estratégico que se integra en tu negocio</h4>
                  <p>Trabajamos como un brazo de tu equipo, alineando los objetivos a largo plazo.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes">✓</div>
                <div class="comp-item-text">
                  <h4>Sistemas medibles y escalables</h4>
                  <p>Construimos estructuras técnicas listas para absorber 10x más volumen sin romperse.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes">✓</div>
                <div class="comp-item-text">
                  <h4>Transformación con transferencia</h4>
                  <p>Tu equipo aprende y adquiere la capacidad de operar las herramientas de forma autónoma.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-yes">✓</div>
                <div class="comp-item-text">
                  <h4>Marketing, tecnología y datos en una sola estrategia</h4>
                  <p>Una visión 360° unificada que conecta la captación con la ejecución operativa.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Lo que no somos -->
          <div class="comp-box comp-box-no">
            <div class="comp-header">
              <span class="badge-tag-no">Un proveedor tradicional</span>
              <h3 class="comp-title">Lo que no somos</h3>
            </div>
            <div class="comp-items-wrap">
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no">✕</div>
                <div class="comp-item-text">
                  <h4>Proveedor que solo ejecuta tickets</h4>
                  <p>Hacer tareas a ciegas sin cuestionar si realmente le sirven al negocio.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no">✕</div>
                <div class="comp-item-text">
                  <h4>Acciones sueltas sin medición</h4>
                  <p>Lanzar campañas o parches aislados sin métricas de rentabilidad ni retorno.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no">✕</div>
                <div class="comp-item-text">
                  <h4>Dependencia eterna del proveedor</h4>
                  <p>Cajas negras donde necesitás pagar mensualmente para que te muevan un botón.</p>
                </div>
              </div>
              <div class="comp-item">
                <div class="comp-icon-circle icon-circle-no">✕</div>
                <div class="comp-item-text">
                  <h4>Una sola pata desconectada del resto</h4>
                  <p>Equipos de diseño que no entienden de ventas, o programadores que no ven marketing.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CÓMO TRABAJAMOS (CARRUSEL MARQUEE INFINITO DE EXTREMO A EXTREMO) -->
    <section class="section section-dark overflow-hidden" id="valores">
      <div class="section-header reveal text-center" style="max-width: 750px; margin: 0 auto 40px auto;">
        <span class="badge">CÓMO TRABAJAMOS</span>
        <h2 style="margin-top: 12px; margin-bottom: 12px;">Siete valores que se notan <span class="text-gradient-crimson">en cada palabra.</span></h2>
        <p style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; margin: 0 auto; max-width: 620px;">No son una placa en la pared. Son la forma en que hablamos, decidimos y entregamos.</p>
      </div>

      <!-- Full Bleed 100vw Marquee Slider -->
      <div class="infinite-marquee-viewport reveal">
        <div class="infinite-marquee-track">
          <!-- SET 1 -->
          <div class="val-marquee-card">
            <div class="val-watermark">01</div>
            <span class="val-tag-pill">01 • METODOLOGÍA</span>
            <h3>Directa</h3>
            <p>Sin rodeos ni relleno. Vamos al punto y te decimos lo que importa en cada etapa.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">02</div>
            <span class="val-tag-pill">02 • METODOLOGÍA</span>
            <h3>Honesta</h3>
            <p>No inflamos expectativas. Si algo no conviene a tu negocio, te lo decimos sin vueltas.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">03</div>
            <span class="val-tag-pill">03 • METODOLOGÍA</span>
            <h3>Estratégica</h3>
            <p>Todo comunica con propósito. Cada diseño y automatización responde a metas de rentabilidad.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">04</div>
            <span class="val-tag-pill">04 • METODOLOGÍA</span>
            <h3>Cálida</h3>
            <p>Cercanos sin perder seriedad. Trabajamos mano a mano con líderes reales, no con tickets fríos.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">05</div>
            <span class="val-tag-pill">05 • METODOLOGÍA</span>
            <h3>Premium</h3>
            <p>La calidad se nota en cada detalle. Desde el copy comercial hasta la velocidad del código.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">06</div>
            <span class="val-tag-pill">06 • METODOLOGÍA</span>
            <h3>Educativa</h3>
            <p>Explicamos el porqué de cada decisión. Querés entender lo que se construye y nosotros también.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">07</div>
            <span class="val-tag-pill">07 • METODOLOGÍA</span>
            <h3>Accountable</h3>
            <p>Nos hacemos cargo de los resultados. Si nos equivocamos, lo asumimos y lo resolvemos.</p>
          </div>

          <!-- SET 2 (DUPLICADO PARA LOOP INFINITO SIN CORTES) -->
          <div class="val-marquee-card">
            <div class="val-watermark">01</div>
            <span class="val-tag-pill">01 • METODOLOGÍA</span>
            <h3>Directa</h3>
            <p>Sin rodeos ni relleno. Vamos al punto y te decimos lo que importa en cada etapa.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">02</div>
            <span class="val-tag-pill">02 • METODOLOGÍA</span>
            <h3>Honesta</h3>
            <p>No inflamos expectativas. Si algo no conviene a tu negocio, te lo decimos sin vueltas.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">03</div>
            <span class="val-tag-pill">03 • METODOLOGÍA</span>
            <h3>Estratégica</h3>
            <p>Todo comunica con propósito. Cada diseño y automatización responde a metas de rentabilidad.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">04</div>
            <span class="val-tag-pill">04 • METODOLOGÍA</span>
            <h3>Cálida</h3>
            <p>Cercanos sin perder seriedad. Trabajamos mano a mano con líderes reales, no con tickets fríos.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">05</div>
            <span class="val-tag-pill">05 • METODOLOGÍA</span>
            <h3>Premium</h3>
            <p>La calidad se nota en cada detalle. Desde el copy comercial hasta la velocidad del código.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">06</div>
            <span class="val-tag-pill">06 • METODOLOGÍA</span>
            <h3>Educativa</h3>
            <p>Explicamos el porqué de cada decisión. Querés entender lo que se construye y nosotros también.</p>
          </div>
          <div class="val-marquee-card">
            <div class="val-watermark">07</div>
            <span class="val-tag-pill">07 • METODOLOGÍA</span>
            <h3>Accountable</h3>
            <p>Nos hacemos cargo de los resultados. Si nos equivocamos, lo asumimos y lo resolvemos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- EL EQUIPO -->
    <Equipo />

    <!-- SECCIÓN DE CONTACTO FINAL -->
    <section class="section section-dark" id="contacto-nosotros" style="padding: 100px 0;">
      <div class="container" style="text-align: center;">
        <div class="section-header reveal text-center" style="margin-bottom: 30px;">
          <span class="badge badge-neon">CONECTEMOS</span>
          <h2>¿Listo para impulsar <span class="text-gradient-crimson">tu transformación?</span></h2>
          <p style="color: var(--text-secondary); max-width: 600px; margin: 10px auto 0;">Completá tus datos y contanos tu desafío. Te responderemos en menos de 24hs hábiles.</p>
        </div>

        <div class="home-contact-buttons reveal reveal-delay-1" style="display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: 25px; margin-bottom: 40px; flex-wrap: wrap;">
          <a href="/contacto" class="btn btn-primary btn-glow" style="padding: 12px 28px; font-weight: 600; border-radius: 50px;">
            <span>Agendá un diagnóstico &rarr;</span>
          </a>
          <a href="https://wa.me/5493804890834" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="padding: 12px 28px; font-weight: 600; border-radius: 50px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.15); color: #ffffff;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            <span>WhatsApp</span>
          </a>
        </div>

        <div class="contact-form-card reveal" style="background: rgba(15, 21, 36, 0.85); border: 1px solid rgba(138, 53, 229, 0.25); border-radius: 24px; padding: 40px 35px; backdrop-filter: blur(16px); box-shadow: 0 20px 50px rgba(0,0,0,0.5); max-width: 720px; margin: 0 auto; text-align: left;">
          <h3 class="form-card-title">Completá tus datos</h3>
          <p class="form-card-subtitle">Contanos tu desafío y te responderemos a la brevedad con soluciones específicas.</p>
          
          <div class="wizard-validation-error" id="form-error-banner" style="display: none; margin-bottom: 20px;"></div>

          <form id="contact-form" class="direct-contact-form" novalidate>
            <div class="form-group-row">
              <div class="form-group">
                <label for="form-name" class="form-label-uppercase">NOMBRE *</label>
                <input type="text" id="form-name" class="form-control" placeholder="Tu nombre" required>
              </div>
              <div class="form-group">
                <label for="form-email" class="form-label-uppercase">EMAIL *</label>
                <input type="email" id="form-email" class="form-control" placeholder="tu@empresa.com" required>
              </div>
            </div>
            
            <div class="form-group-row">
              <div class="form-group">
                <label for="form-whatsapp" class="form-label-uppercase">TELÉFONO / WHATSAPP *</label>
                <input type="tel" id="form-whatsapp" class="form-control" placeholder="+54 11 ..." required>
              </div>
              <div class="form-group">
                <label for="form-business" class="form-label-uppercase">EMPRESA *</label>
                <input type="text" id="form-business" class="form-control" placeholder="Nombre de tu empresa" required>
              </div>
            </div>
            
            <div class="form-group-row">
              <div class="form-group">
                <label for="form-website" class="form-label-uppercase">URL DEL SITIO (OPCIONAL)</label>
                <input type="url" id="form-website" class="form-control" placeholder="https://tusitio.com">
              </div>
              <div class="form-group">
                <label for="form-role" class="form-label-uppercase">¿QUÉ PUESTO OCUPÁS?</label>
                <select id="form-role" class="form-control form-select-custom">
                  <option value="" disabled selected>Elegí una opción</option>
                  <option value="Fundador / CEO / Socio">Fundador / CEO / Socio</option>
                  <option value="Director Comercial / Ventas">Director Comercial / Ventas</option>
                  <option value="Gerente de Marketing">Gerente de Marketing</option>
                  <option value="Operaciones / Administración">Operaciones / Administración</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="form-service-interest" class="form-label-uppercase">¿QUÉ TE INTERESA?</label>
              <select id="form-service-interest" class="form-control form-select-custom">
                <option value="" disabled selected>Elegí el servicio de tu interés</option>
                <option value="Paid Media / Publicidad Digital">Paid Media / Publicidad Digital</option>
                <option value="SEO & GEO Search">SEO & GEO Search</option>
                <option value="Social Media Manager">Social Media Manager</option>
                <option value="Web & E-commerce">Web & E-commerce</option>
                <option value="Email Marketing & CRM">Email Marketing & CRM</option>
                <option value="Software a Medida">Software a Medida</option>
                <option value="Automatización & Integraciones">Automatización & Integraciones</option>
                <option value="Agentes de Inteligencia Artificial">Agentes de Inteligencia Artificial</option>
                <option value="Consultoría Enterprise">Consultoría Enterprise</option>
              </select>
            </div>

            <div class="form-group">
              <label for="form-message" class="form-label-uppercase">¿CUÁL ES TU PRINCIPAL DESAFÍO HOY? *</label>
              <textarea id="form-message" class="form-control" rows="4" placeholder="Contanos en qué estás y qué te gustaría resolver" required></textarea>
            </div>
            
            <div class="form-group" style="margin-top: 10px; margin-bottom: 20px;">
              <label class="form-checkbox" id="label-checkbox-whatsapp">
                <input type="checkbox" id="form-send-whatsapp" checked>
                <span>Abrir chat de WhatsApp para agilizar mi consulta</span>
              </label>
            </div>
            
            <button type="submit" class="btn btn-primary submit-btn" id="btn-submit-form" style="width: 100%; justify-content: center; font-weight: 600; box-shadow: 0 0 20px var(--accent-indigo-glow);">
              <span>Enviar →</span>
            </button>
            
            <p style="text-align: center; font-size: 0.8rem; color: var(--text-muted); margin-top: 15px;">
              Te respondemos en 24hs. Tus datos se tratan según nuestra <a href="/privacidad" style="color: var(--accent-pink); text-decoration: underline;">política de privacidad</a>.
            </p>

            <div class="form-feedback" id="form-feedback-status" style="display: none; margin-top: 20px;"></div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<script>
  import { api } from '../lib/appwrite.js';

  document.addEventListener('DOMContentLoaded', () => {
    const contactForm = document.getElementById('contact-form') as HTMLFormElement;
    const errorBanner = document.getElementById('form-error-banner');
    const feedbackStatus = document.getElementById('form-feedback-status');
    const submitBtn = document.getElementById('btn-submit-form') as HTMLButtonElement;

    if (!contactForm) return;

    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (document.getElementById('form-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('form-email') as HTMLInputElement).value.trim();
      const whatsapp = (document.getElementById('form-whatsapp') as HTMLInputElement).value.trim();
      const business = (document.getElementById('form-business') as HTMLInputElement).value.trim();
      const website = (document.getElementById('form-website') as HTMLInputElement)?.value.trim() || '';
      const role = (document.getElementById('form-role') as HTMLSelectElement)?.value || 'No especificado';
      const serviceInterest = (document.getElementById('form-service-interest') as HTMLSelectElement)?.value || 'No especificado';
      const message = (document.getElementById('form-message') as HTMLTextAreaElement).value.trim();
      const sendWhatsapp = (document.getElementById('form-send-whatsapp') as HTMLInputElement)?.checked ?? true;

      if (errorBanner) errorBanner.style.display = 'none';
      if (feedbackStatus) {
        feedbackStatus.style.display = 'none';
        feedbackStatus.className = 'form-feedback';
      }

      if (!name || !email || !whatsapp || !business || !message) {
        if (errorBanner) {
          errorBanner.innerText = 'Por favor, completá todos los campos obligatorios (*).';
          errorBanner.style.display = 'block';
        }
        return;
      }

      if (feedbackStatus) {
        feedbackStatus.style.display = 'block';
        feedbackStatus.className = 'form-feedback feedback-info';
        feedbackStatus.innerText = 'Enviando tu consulta...';
      }
      if (submitBtn) submitBtn.disabled = true;

      try {
        await api.db.createLead({
          name,
          email,
          business,
          whatsapp,
          message: `Puesto: ${role}\nSitio Web: ${website}\nServicio de interés: ${serviceInterest}\n\nDesafío: ${message}`,
          status: 'nuevo',
          tags: 'Contacto Nosotros',
          score: 0,
          recommendations: `Lead generado desde la página Nosotros. Servicio: ${serviceInterest}`
        });

        if (feedbackStatus) {
          feedbackStatus.className = 'form-feedback feedback-success';
          feedbackStatus.innerText = `¡Gracias, ${name}! Tu consulta ha sido enviada con éxito.`;
        }

        if (sendWhatsapp) {
          const agencyPhone = '5493804890834';
          const text = encodeURIComponent(`¡Hola Kaptativa! Acabo de enviar una consulta desde la web.\n\n*Datos:*\n- *Nombre:* ${name}\n- *Empresa:* ${business}\n- *Email:* ${email}\n- *WhatsApp:* ${whatsapp}\n- *Puesto:* ${role}\n- *Interés:* ${serviceInterest}\n- *Desafío:* ${message}`);
          setTimeout(() => {
            window.open(`https://wa.me/${agencyPhone}?text=${text}`, '_blank');
            contactForm.reset();
            if (feedbackStatus) feedbackStatus.style.display = 'none';
          }, 1200);
        } else {
          contactForm.reset();
        }
      } catch (err: any) {
        console.error('Error enviando formulario:', err);
        if (feedbackStatus) {
          feedbackStatus.className = 'form-feedback feedback-error';
          feedbackStatus.innerText = 'Ocurrió un error al enviar el formulario. Por favor, intentá nuevamente o contactanos por WhatsApp.';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>

<style is:global>
  .story-card-wrapper {
    max-width: 880px;
    margin: 0 auto;
    background: rgba(15, 21, 36, 0.6);
    border: 1px solid rgba(138, 53, 229, 0.25);
    border-radius: 24px;
    padding: 50px 45px;
    backdrop-filter: blur(16px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }
  .story-body p {
    font-size: 1.08rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 22px;
  }
  .story-body p:last-child {
    margin-bottom: 0;
  }

  /* Comparison Section styling fix */
  .comp-flex-container {
    display: flex;
    gap: 30px;
    max-width: 1100px;
    margin: 45px auto 0;
  }
  .comp-box {
    flex: 1;
    background: rgba(15, 21, 36, 0.75) !important;
    border-radius: 24px !important;
    padding: 40px !important;
    backdrop-filter: blur(16px);
