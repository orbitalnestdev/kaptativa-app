  <script>
    import { api } from '../../lib/appwrite.js';

    document.addEventListener('DOMContentLoaded', () => {
      const emailForm = document.getElementById('email-contact-form') as HTMLFormElement;
      const feedback = document.getElementById('email-form-feedback');

      if (!emailForm) return;

      emailForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = (document.getElementById('form-nombre') as HTMLInputElement).value.trim();
        const whatsapp = (document.getElementById('form-telefono') as HTMLInputElement).value.trim();
        const business = (document.getElementById('form-empresa') as HTMLInputElement).value.trim();
        const contacts = (document.getElementById('form-contactos') as HTMLSelectElement).value;

        if (!feedback) return;

        if (!name || !whatsapp || !business || !contacts) {
          feedback.style.display = 'block';
          feedback.style.background = 'rgba(239, 68, 68, 0.1)';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.2)';
          feedback.style.color = '#ef4444';
          feedback.innerText = 'Por favor, completa todos los campos del formulario.';
          return;
        }

        feedback.style.display = 'block';
        feedback.style.background = 'rgba(6, 182, 212, 0.1)';
        feedback.style.border = '1px solid rgba(6, 182, 212, 0.2)';
        feedback.style.color = '#EA384D';
        feedback.innerText = 'Registrando solicitud...';

        try {
          await api.db.createLead({
            name,
            business,
            whatsapp,
            email: 'no-email@kaptativa.com',
            message: `Tamaño de base: ${contacts}`,
            status: 'nuevo',
            tags: 'Email Marketing',
            score: 0,
            recommendations: 'Consulta desde el formulario de Email Marketing.'
          });

          feedback.style.background = 'rgba(16, 185, 129, 0.1)';
          feedback.style.border = '1px solid rgba(16, 185, 129, 0.2)';
          feedback.style.color = '#10b981';
          feedback.innerText = '¡Registrado con éxito! Redirigiendo...';

          setTimeout(() => {
            const textMsg = `Hola! Acabo de completar el formulario para Email Marketing en la web. Mi nombre es ${name}, de la empresa/web ${business}. Nuestra base de contactos estimada es de: ${contacts}.`;
            const encodedMsg = encodeURIComponent(textMsg);
            window.open(`https://wa.me/541138830925?text=${encodedMsg}`, '_blank');
            emailForm.reset();
            feedback.style.display = 'none';
          }, 1200);

        } catch (error) {
          console.error('Error registrando lead:', error);
          feedback.style.background = 'rgba(239, 68, 68, 0.1)';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.2)';
          feedback.style.color = '#ef4444';
          feedback.innerText = 'Ocurrió un error al registrar tus datos. Por favor, intenta de nuevo o contáctanos por WhatsApp.';
        }
      });
    });
  </script>
