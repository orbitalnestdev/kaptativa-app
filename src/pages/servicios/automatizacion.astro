---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout 
  title="Automatización de Procesos & Integraciones de Sistemas | Kaptativa"
  description="Optimice las operaciones de su empresa eliminando tareas manuales repetitivas. Conectamos sus sistemas vía API (CRM, ERP, WhatsApp, Hojas de Cálculo) con flujos automatizados estables."
>
  <Header slot="header" />
  
  <main>
    <!-- HERO INMERSIVO -->
    <section class="hero hero-section" id="inicio">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      
      <div class="container hero-container">
        <div class="hero-content reveal">
          <span class="badge badge-purple">
            <span class="badge-dot-pulsing"></span> PILOTO AUTOMÁTICO
          </span>
          <h1 class="hero-tagline">Tu empresa funcionando sola, <span class="text-gradient-cyan">sin errores humanos</span></h1>
          <p class="hero-description">Dejá de hacer manual lo que la tecnología puede resolver en segundos. Conectamos tus sistemas y automatizamos las tareas repetitivas (copiar datos, mandar presupuestos, agendar reuniones) para que te enfoques en escalar tu negocio.</p>
          
          <div class="hero-buttons">
            <a href="/contacto" class="btn btn-primary btn-glow">Agendá diagnóstico gratis</a>
            <a href="https://wa.me/541138830925?text=Hola!%20Me%20gustaria%20automatizar%20los%20procesos%20de%20mi%20negocio." target="_blank" class="btn btn-secondary btn-whatsapp">
              Escribinos por WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- RESULTADOS (MÉTRICAS) -->
    <section class="section-metrics reveal">
      <div class="container">
        <div class="metrics-grid-premium">
          <div class="metric-card-glass">
            <div class="metric-value">70%</div>
            <div class="metric-label">Ahorro de tiempo administrativo</div>
          </div>
          <div class="metric-card-glass">
            <div class="metric-value">24/7</div>
            <div class="metric-label">Atención y sincronización continua</div>
          </div>
          <div class="metric-card-glass">
            <div class="metric-value">0.1%</div>
            <div class="metric-label">Margen de error en carga de datos</div>
          </div>
          <div class="metric-card-glass">
            <div class="metric-value">2 sem</div>
            <div class="metric-label">Tiempo promedio de lanzamiento</div>
          </div>
        </div>
      </div>
    </section>

    <!-- LO QUE IMPORTA (EL DOLOR VS LA SOLUCIÓN) -->
    <section class="section" id="lo-que-importa">
      <div class="container">
        <div class="section-header reveal">
          <span class="badge">POR QUÉ IMPORTA</span>
          <h2>El costo oculto de <span class="text-gradient-cyan">los procesos manuales</span></h2>
          <p>Tener a un empleado calificado copiando y pegando datos de WhatsApp a un Excel es ineficiente y costoso. Los sistemas integrados eliminan las fallas de carga de inmediato.</p>
        </div>
        
        <div class="comparison-grid">
          <!-- El problema -->
          <div class="comp-card-bad reveal">
            <div class="comp-card-header">
              <div class="comp-icon-box bad-box">✕</div>
              <h3>Caos Operativo (Tradicional)</h3>
            </div>
            <ul class="comp-list">
              <li><span>✕</span> Transcribir datos a mano entre chats de WhatsApp, Excel y CRM.</li>
              <li><span>✕</span> Demora de horas en enviar cotizaciones o confirmar cobros.</li>
              <li><span>✕</span> Leads que se pierden por olvido o falta de seguimiento rápido.</li>
              <li><span>✕</span> Imposibilidad de escalar el negocio sin contratar más personal de soporte.</li>
            </ul>
          </div>

          <!-- La solución -->
          <div class="comp-card-good reveal">
            <div class="badge-solution">Método Kaptativa</div>
            <div class="comp-card-header">
              <div class="comp-icon-box good-box">✓</div>
              <h3>Flujos Inteligentes Integrados</h3>
            </div>
            <ul class="comp-list">
              <li><span>✓</span> Conexión fluida vía API entre tus herramientas predilectas.</li>
              <li><span>✓</span> Envío automatizado de cotizaciones en PDF en menos de 2 minutos.</li>
              <li><span>✓</span> Sincronización instantánea de leads a HubSpot, Kommo o Google Sheets.</li>
              <li><span>✓</span> Escalabilidad ilimitada: procesá 10 veces más ventas con el mismo equipo.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- LO QUE INCLUYE (PILARES) -->
    <section class="section section-dark" id="lo-que-incluye">
      <div class="container">
        <div class="section-header reveal">
          <span class="badge">LO QUE INCLUYE</span>
          <h2>Sistema de automatizaciones <span class="text-gradient-cyan">y software conectado</span></h2>
          <p>Conectamos las mejores herramientas del mercado bajo un mismo flujo técnico de datos.</p>
        </div>

        <div class="pillars-grid">
          <!-- Pilar 1 -->
          <div class="glass-card-premium reveal">
            <div class="card-bg-number">01</div>
            <div class="pillar-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
            </div>
            <h3>Conexión de APIs</h3>
            <p>Conectamos tu sitio web, CRM, WhatsApp API y pasarelas de pago para que compartan datos en tiempo real y sin interrupciones.</p>
          </div>

          <!-- Pilar 2 -->
          <div class="glass-card-premium reveal">
            <div class="card-bg-number">02</div>
            <div class="pillar-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <h3>Cotizaciones al Instante</h3>
            <p>Configuramos formularios inteligentes que generan y envían presupuestos personalizados en PDF directo al mail del cliente automáticamente.</p>
          </div>

          <!-- Pilar 3 -->
          <div class="glass-card-premium reveal">
            <div class="card-bg-number">03</div>
            <div class="pillar-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <h3>Sincronización de Leads</h3>
            <p>Traspasamos de forma instantánea la información de los leads capturados en campañas a tu embudo comercial del CRM o a Google Sheets.</p>
          </div>

          <!-- Pilar 4 -->
          <div class="glass-card-premium reveal">
            <div class="card-bg-number">04</div>
            <div class="pillar-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <h3>Redundancia & Soporte</h3>
            <p>Montamos alertas en Slack/Discord para monitorear errores de integración. Si falla Make o Zapier, nuestro sistema nos avisa al instante.</p>
          </div>
        </div>
      </div>
    </section>

    
    <!-- APLICACIONES POR RUBRO / SECTOR -->
    <section class="section section-rubros" id="rubros">
      <div class="container">
        <div class="section-header reveal" style="text-align: center; margin-bottom: 50px;">
          <span class="badge">Rubros y Sectores</span>
          <h2>Soluciones adaptadas a <span class="text-gradient-cyan">tu modelo de negocio</span></h2>
          <p style="max-width: 750px; margin: 0 auto; color: var(--text-secondary);">Diseñamos y programamos según la lógica comercial de tu sector para asegurar el máximo retorno.</p>
        </div>

        <div class="rubros-grid reveal">
          <!-- Tarjeta 1 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-emerald">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            </div>
            <h3>Inmobiliarias y Corredores</h3>
            <p>Al recibir un lead de portales inmobiliarios (Zonaprop, etc.), el sistema lo guarda automáticamente en tu base de datos y lo asigna a un asesor de guardia.</p>
          </div>

          <!-- Tarjeta 2 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-purple">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
            <h3>Servicios B2B / Consultoras</h3>
            <p>Al recibir un formulario de cotización, el sistema genera de inmediato una propuesta técnica en PDF a medida y la envía por email de forma automática.</p>
          </div>

          <!-- Tarjeta 3 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-orange">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            </div>
            <h3>E-commerce / Tiendas</h3>
            <p>Sincronización automatizada de ventas web con sistemas de facturación fiscal y actualización de stock en tu ERP en tiempo real.</p>
          </div>

          <!-- Tarjeta 4 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-crimson">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <h3>Negocios Locales y Profesionales</h3>
            <p>Agenda de citas automática con recordatorios personalizados y alertas de confirmación de turnos enviados de forma autónoma por WhatsApp.</p>
          </div>

          <!-- Tarjeta 5 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-pink">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            </div>
            <h3>Salud & Clínicas Estéticas</h3>
            <p>Confirmación y cancelación de turnos automática por WhatsApp sincronizada con el software médico, reduciendo ausencias en un 30%.</p>
          </div>

          <!-- Tarjeta 6 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
            </div>
            <h3>SaaS / Startups / Tech</h3>
            <p>Flujos automatizados de onboarding por email y alertas de Slack para coordinar llamadas de soporte con usuarios que abandonan el trial.</p>
          </div>

          <!-- Tarjeta 7 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-amber">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            </div>
            <h3>Instituciones & Academias</h3>
            <p>Sistemas de recordatorio de vencimiento de cuotas mensuales y envío automático de comprobantes fiscales al registrarse el pago.</p>
          </div>

          <!-- Tarjeta 8 -->
          <div class="rubro-card">
            <div class="rubro-icon-wrapper wrapper-teal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
            </div>
            <h3>Turismo & Hotelería</h3>
            <p>Sincronización instantánea de calendarios entre múltiples plataformas (Airbnb, Booking) para evitar sobreventas de habitaciones.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PREGUNTAS Y RESPUESTAS (FAQ) -->
    <section class="section" id="preguntas">
      <div class="container">
        <div class="section-header reveal">
          <span class="badge">FAQ</span>
          <h2>Preguntas frecuentes</h2>
          <p>Respuestas claras sobre la automatización operativa de tu negocio.</p>
        </div>

        <div class="faq-accordion reveal">
          <!-- Item 1 -->
          <details class="faq-item-premium">
            <summary class="faq-trigger">
              <span>¿Necesito saber programar para mantener estas automatizaciones?</span>
              <svg class="faq-icon-arrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            
            <div class="faq-content-premium">
              <p>No, en lo absoluto. Nos encargamos de la arquitectura y la programación técnica completa. Al entregarte el sistema, te brindamos una capacitación práctica grabada para que vos o tu equipo administrativo puedan realizar ajustes de textos sencillos sin depender de nosotros.</p>
            </div>
          
          </details>

          <!-- Item 2 -->
          <details class="faq-item-premium">
            <summary class="faq-trigger">
              <span>¿Cuánto tiempo demora la integración de sistemas?</span>
              <svg class="faq-icon-arrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            
            <div class="faq-content-premium">
              <p>El plazo promedio varía entre 2 y 4 semanas según el número de plataformas a conectar y la complejidad de los flujos de validación de datos. Entregamos flujos funcionales y testeados por etapas.</p>
            </div>
          
          </details>

          <!-- Item 3 -->
          <details class="faq-item-premium">
            <summary class="faq-trigger">
              <span>¿Es seguro para los datos de mis clientes?</span>
              <svg class="faq-icon-arrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            
            <div class="faq-content-premium">
              <p>Sí, todas las integraciones se realizan bajo protocolos de encriptación seguros (HTTPS/SSL) y utilizando las credenciales oficiales de las APIs de cada software. Nunca almacenamos datos sensibles fuera de tus propios sistemas.</p>
            </div>
          
          </details>

          <!-- Item 4 -->
          <details class="faq-item-premium">
            <summary class="faq-trigger">
              <span>¿Qué herramientas previas necesito para automatizar mi negocio?</span>
              <svg class="faq-icon-arrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            
            <div class="faq-content-premium">
              <p>Requerimos que utilices al menos un canal digital inicial, como planillas de Google Sheets, un CRM o formularios web. Si no los tenés, primero desarrollamos esa base (por ejemplo, mediante un sitio web o CRM) para poder conectarla.</p>
            </div>
          
          </details>

          <!-- Item 5 -->
          <details class="faq-item-premium">
            <summary class="faq-trigger">
              <span>¿Qué sucede si un software externo cambia sus configuraciones o APIs?</span>
              <svg class="faq-icon-arrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            
            <div class="faq-content-premium">
              <p>Las plataformas estándar (Make y Zapier) absorben la mayoría de los cambios en el backend. Sin embargo, ante actualizaciones estructurales complejas de APIs de terceros, implementamos sistemas de alerta redundantes y ofrecemos soporte técnico para reajustar los módulos de inmediato y evitar interrupciones operativas.</p>
            </div>
          
          </details>
        </div>
      </div>
    </section>

    <!-- CTA DE CIERRE (CONTACTO) -->
    <section class="section section-cta">
      <div class="container">
        <div class="cta-card-neon reveal">
          <div class="cta-glow-overlay"></div>
          
          <!-- Columna Izquierda: Información -->
          <div class="cta-info-side">
            <span class="badge badge-neon-secondary">DIAGNÓSTICO SIN CARGO</span>
            <h2>¿Listo para poner a trabajar a la <span class="text-gradient-cyan">tecnología por vos?</span></h2>
            <p style="margin-bottom: 25px;">Agendá una sesión estratégica de 45 minutos para analizar tus tareas administrativas repetitivas y ver cómo automatizarlas.</p>
            
            <a href="https://wa.me/541138830925?text=Hola!%20Me%20gustaria%20automatizar%20los%20procesos%20de%20mi%20negocio." target="_blank" class="btn btn-secondary btn-whatsapp" style="display: inline-flex; align-items: center;">
              Chateá por WhatsApp
            </a>
          </div>

          <!-- Columna Derecha: Formulario de Captura -->
          <div class="cta-form-side">
            <form id="auto-contact-form" novalidate style="display: flex; flex-direction: column; gap: 15px; text-align: left; background: rgba(0,0,0,0.2); padding: 30px; border-radius: 12px; border: 1px solid var(--border-color);">
              <div id="auto-form-feedback" style="display: none; padding: 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-align: center; margin-bottom: 5px;"></div>
              
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <label for="form-nombre" style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Nombre completo</label>
                <input type="text" id="form-nombre" class="form-input" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.02) !important; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 0.9rem; outline: none; transition: border-color 0.2s;" />
              </div>
              
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <label for="form-telefono" style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">WhatsApp Comercial</label>
                <input type="tel" id="form-telefono" class="form-input" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.02) !important; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 0.9rem; outline: none; transition: border-color 0.2s;" />
              </div>

              <div style="display: flex; flex-direction: column; gap: 6px;">
                <label for="form-empresa" style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Empresa o Sitio Web</label>
                <input type="text" id="form-empresa" class="form-input" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.02) !important; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 0.9rem; outline: none; transition: border-color 0.2s;" />
              </div>

              <div style="display: flex; flex-direction: column; gap: 6px;">
                <label for="form-proceso" style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Proceso principal a automatizar</label>
                <select id="form-proceso" required style="width: 100%; padding: 10px 14px; background: #0c0d14 !important; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-primary); font-size: 0.9rem; outline: none; transition: border-color 0.2s; cursor: pointer;">
                  <option value="" disabled selected>Seleccioná tu necesidad principal</option>
                  <option value="Conectar WhatsApp con CRM">Conectar WhatsApp con CRM (HubSpot, Salesforce, etc.)</option>
                  <option value="Automatizar planillas de datos">Automatizar planillas y reportes (Google Sheets)</option>
                  <option value="Sincronizar stock/ventas">Sincronizar stock y facturación de ventas</option>
                  <option value="Otro proceso repetitivo">Otro proceso o flujo administrativo repetitivo</option>
                </select>
              </div>

              <button type="submit" class="btn btn-primary btn-glow" style="width: 100%; justify-content: center; margin-top: 10px; padding: 12px;">
                Automatizar mis procesos gratis &rarr;
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />

  <script>
    import { api } from '../../lib/appwrite.js';

    document.addEventListener('DOMContentLoaded', () => {
      const autoForm = document.getElementById('auto-contact-form') as HTMLFormElement;
      const feedback = document.getElementById('auto-form-feedback');

      if (!autoForm) return;

      autoForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = (document.getElementById('form-nombre') as HTMLInputElement).value.trim();
        const whatsapp = (document.getElementById('form-telefono') as HTMLInputElement).value.trim();
        const business = (document.getElementById('form-empresa') as HTMLInputElement).value.trim();
        const process = (document.getElementById('form-proceso') as HTMLSelectElement).value;

        if (!feedback) return;

        if (!name || !whatsapp || !business || !process) {
          feedback.style.display = 'block';
          feedback.style.background = 'rgba(239, 68, 68, 0.1)';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.2)';
          feedback.style.color = '#ef4444';
          feedback.innerText = 'Por favor, completa todos los campos del formulario.';
          return;
