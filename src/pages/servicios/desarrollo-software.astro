  <script>
    import { api } from '../../lib/appwrite.js';

    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('software-contact-form') as HTMLFormElement;
      const feedback = document.getElementById('software-form-feedback');

      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = (document.getElementById('form-nombre') as HTMLInputElement).value.trim();
        const whatsapp = (document.getElementById('form-telefono') as HTMLInputElement).value.trim();
        const softwareType = (document.getElementById('form-proyecto') as HTMLSelectElement).value;
        const budgetRange = (document.getElementById('form-presupuesto') as HTMLSelectElement).value;

        if (!feedback) return;

        if (!name || !whatsapp || !softwareType || !budgetRange) {
          feedback.style.display = 'block';
          feedback.style.background = 'rgba(239, 68, 68, 0.1)';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.2)';
          feedback.style.color = '#ef4444';
          feedback.innerText = 'Por favor, completa todos los campos del formulario.';
          return;
        }

        feedback.style.display = 'block';
        feedback.style.background = 'rgba(139, 92, 246, 0.1)';
        feedback.style.border = '1px solid rgba(139, 92, 246, 0.2)';
        feedback.style.color = '#8b5cf6';
        feedback.innerText = 'Registrando tu solicitud de cotización...';

        try {
          await api.db.createLead({
            name,
            business: 'Software a Medida',
            whatsapp,
            email: 'no-email@kaptativa.com',
            message: `Tipo de Software: ${softwareType} | Rango Presupuestario: ${budgetRange}`,
            status: 'nuevo',
            tags: 'Desarrollo de Software',
            score: 0,
            recommendations: 'Consulta desde el formulario de Desarrollo de Software.'
          });

          feedback.style.background = 'rgba(16, 185, 129, 0.1)';
          feedback.style.border = '1px solid rgba(16, 185, 129, 0.2)';
          feedback.style.color = '#10b981';
          feedback.innerText = '¡Solicitud registrada! Redirigiendo a WhatsApp...';

          setTimeout(() => {
            const textMsg = `Hola! Acabo de cotizar un Desarrollo de Software a medida en la web. Mi nombre es ${name}. Necesitamos un/a ${softwareType} con un presupuesto estimado de ${budgetRange}.`;
            const encodedMsg = encodeURIComponent(textMsg);
            window.open(`https://wa.me/5493804890834?text=${encodedMsg}`, '_blank');
            form.reset();
            feedback.style.display = 'none';
          }, 1200);

        } catch (error) {
          console.error('Error registrando lead:', error);
          feedback.style.background = 'rgba(239, 68, 68, 0.1)';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.2)';
          feedback.style.color = '#ef4444';
          feedback.innerText = 'Ocurrió un error al registrar tus datos. Por favor, intenta de nuevo o contáctanos por WhatsApp.';
        }
      });
    });
  </script>
