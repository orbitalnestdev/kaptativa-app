---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IsoK3D from '../../components/IsoK3D.astro';
import '../../styles/servicios.css';
---

<Layout title="Desarrollo de Software a Medida & Sistemas Web | Kaptativa" description="Software a medida sin licencias por usuario: plataformas web propias, portales B2B e intranets pensadas para crecer con tu empresa.">
  <Header slot="header" floating />
  
  <main class="servicio-page">
    <!-- HERO INMERSIVO -->
    <section class="hero hero-section" id="inicio">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      
      <div class="container hero-container">
        <div class="hero-content reveal">
          <h1 class="hero-tagline">Software a medida, <span class="text-gradient-cyan">sin licencias</span></h1>
          <p class="hero-description">Plataformas, portales B2B e intranets a la medida de tus procesos. Código tuyo, sin licencias por usuario.</p>
          
          <div class="hero-buttons">
            <a href="https://wa.me/5493804890834?text=Hola!%20Quiero%20cotizar%20el%20desarrollo%20de%20un%20software%20a%20medida%20para%20mi%20empresa." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow">Pedir propuesta por WhatsApp</a>
            <a href="/contacto/?servicio=Desarrollo%20de%20software" class="btn btn-secondary">Completar el formulario</a>
          </div>
        </div>
      </div>
    </section>

    <!-- RESULTADOS (MÉTRICAS) -->
    <section class="section-metrics reveal">
      <div class="container">
        <div class="metrics-grid-premium">
          <div class="metric-card-glass">
            <span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg></span>
            <div class="metric-value">Código propio</div>
            <div class="metric-label">El sistema es tuyo, sin licencias ni rehenes</div>
          </div>
          <div class="metric-card-glass">
            <span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg></span>
            <div class="metric-value">Arquitectura limpia</div>
            <div class="metric-label">Preparado para crecer sin reescribir</div>
          </div>
          <div class="metric-card-glass">
            <span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg></span>
            <div class="metric-value">Monitoreado</div>
            <div class="metric-label">Servidores con respaldo y supervisión</div>
          </div>
          <div class="metric-card-glass">
            <span class="metric-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg></span>
            <div class="metric-value">Entregas por etapas</div>
            <div class="metric-label">Ves avances funcionando cada semana</div>
          </div>
        </div>
      </div>
    </section>


    <!-- LO QUE IMPORTA (EL DOLOR VS LA SOLUCIÓN) -->
    <section class="section section-light" id="lo-que-importa">
      <div class="container">
        <div class="section-header reveal">
          <h2>El software enlatado frena tu escalabilidad</h2>
          <p>Los softwares de suscripción (SaaS) genéricos cobran licencias mensuales por cada usuario adicional. Al crecer tu empresa, tus costos se disparan por herramientas que no podés personalizar.</p>
        </div>
        
        <div class="comparison-grid">
          <!-- El problema -->
          <div class="comp-card-bad reveal">
            <div class="comp-card-header">
              <div class="comp-icon-box bad-box"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
              <h3>Software enlatado</h3>
            </div>
            <ul class="comp-list">
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></span> Cobro recurrente de licencias mensuales por usuario (gasto en dólares).</li>
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></span> Tenés que cambiar tu forma de trabajar para adaptarte al software.</li>
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></span> Integraciones rígidas y nula posibilidad de personalización extrema.</li>
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></span> Cero propiedad: si dejás de pagar, perdés tu plataforma de datos.</li>
            </ul>
          </div>

          <!-- La solución -->
          <div class="comp-card-good reveal">
            <div class="comp-card-header">
              <div class="comp-icon-box good-box"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
              <h3>Software a medida, propietario</h3>
            </div>
            <ul class="comp-list">
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Un único costo de desarrollo. Sin tarifas ocultas de licencias por usuario.</li>
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> El sistema se moldea exactamente a tus procesos operativos y comerciales.</li>
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Flexibilidad total para expandir o integrar nuevas herramientas en el futuro.</li>
              <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> Propiedad intelectual total del código fuente de tu negocio.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- LO QUE INCLUYE (PILARES) -->
    <section class="section section-dark" id="lo-que-incluye">
      <div class="container">
        <div class="section-header reveal">
          <h2>Nuestro proceso de ingeniería de software</h2>
          <p>Construimos sistemas robustos y limpios enfocados en la escalabilidad técnica.</p>
        </div>

        <div class="pillars-grid">
          <!-- Pilar 1 -->
          <div class="glass-card-premium reveal">
            <div class="pillar-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <h3>Modelado de negocio</h3>
            <p>Mapeamos los procesos internos de tu empresa y cuellos de botella de datos para que el software automatice tu trabajo.</p>
          </div>

          <!-- Pilar 2 -->
          <div class="glass-card-premium reveal" style="justify-content: space-between; display: flex; flex-direction: column;">
            <div>
              <div class="pillar-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
              </div>
              <h3>Arquitectura limpia</h3>
              <p>Escribimos código estructurado bajo estándares internacionales (Clean Architecture). Esto evita el código espagueti, reduce los costos de mantenimiento futuro y asegura que no dependas de un único programador.</p>
            </div>
            
            <!-- Clean Architecture Mockup -->
            <div class="mock-clean-arch" style="margin-top: 20px; background: rgba(15, 15, 18,0.5); border: 1px solid rgba(255,255,255,0.04); border-radius: 8px; padding: 12px; font-family: 'Inter', sans-serif; display: flex; flex-direction: column; align-items: center; gap: 8px;">
              <div style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; align-self: flex-start; border-bottom: 1px solid rgba(255,255,255,0.04); width: 100%; padding-bottom: 4px; margin-bottom: 4px;">Flujo de dependencias</div>
              <div style="width: 100%; display: flex; flex-direction: column; gap: 4px; align-items: center;">
                <div style="width: 100%; background: rgba(106, 72, 245, 0.05); border: 1px solid rgba(106, 72, 245, 0.2); padding: 4px; border-radius: 8px; text-align: center; font-size: 0.65rem; font-weight: 600; color: var(--accent-indigo);">
                  Infraestructura (Web, DB, APIs)
                </div>
                <div style="font-size: 0.55rem; color: var(--text-muted); line-height: 1;">↓ depende de</div>
                <div style="width: 85%; background: rgba(106, 72, 245, 0.05); border: 1px solid rgba(106, 72, 245, 0.2); padding: 4px; border-radius: 8px; text-align: center; font-size: 0.65rem; font-weight: 600; color: #7C5CFF;">
                  Casos de Uso (Reglas de Aplicación)
                </div>
                <div style="font-size: 0.55rem; color: var(--text-muted); line-height: 1;">↓ depende de</div>
                <div style="width: 70%; background: rgba(124, 92, 255, 0.05); border: 1px solid rgba(124, 92, 255, 0.2); padding: 4px; border-radius: 8px; text-align: center; font-size: 0.65rem; font-weight: 600; color: var(--accent-crimson);">
                  Entidades (Core Domain)
                </div>
              </div>
            </div>
          </div>

          <!-- Pilar 3 -->
          <div class="glass-card-premium reveal" style="justify-content: space-between; display: flex; flex-direction: column;">
            <div>
              <div class="pillar-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25a29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
              </div>
              <h3>Integración de APIs</h3>
              <p>Conectamos bases de datos y herramientas heredadas (CRMs, ERPs locales, sistemas contables) en un único flujo de datos.</p>
            </div>
            
            <!-- API Integration Mockup -->
            <div class="mock-api-widget" style="margin-top: 20px; background: rgba(15, 15, 18,0.5); border: 1px solid rgba(255,255,255,0.04); border-radius: 8px; padding: 12px; font-family: 'Inter', sans-serif; display: flex; flex-direction: column; gap: 6px;">
              <div style="font-size: 0.65rem; color: var(--text-muted); font-weight: 600; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 4px; margin-bottom: 4px;">Integraciones en vivo</div>
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.01); padding: 4px 6px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.03);">
                  <span style="font-size: 0.65rem; color: #ffffff; font-weight: 600;">GET /erp/stock</span>
                  <span style="font-size: 0.55rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); padding: 1px 4px; border-radius: 8px; font-weight: 600;">200 OK</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.01); padding: 4px 6px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.03);">
                  <span style="font-size: 0.65rem; color: #ffffff; font-weight: 600;">POST /crm/lead</span>
                  <span style="font-size: 0.55rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); padding: 1px 4px; border-radius: 8px; font-weight: 600;">201 Created</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.01); padding: 4px 6px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.03);">
                  <span style="font-size: 0.65rem; color: #ffffff; font-weight: 600;">PATCH /billing/invoice</span>
                  <span style="font-size: 0.55rem; background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); padding: 1px 4px; border-radius: 8px; font-weight: 600;">200 OK</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Pilar 4 -->
          <div class="glass-card-premium reveal">
            <div class="pillar-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <h3>Seguridad y nube</h3>
            <p>Desplegamos en AWS o Google Cloud implementando copias de seguridad automáticas y encriptación SSL de alta seguridad.</p>
          </div>
        </div>
      </div>
    </section>

    
    <!-- APLICACIONES POR RUBRO / SECTOR -->
    <section class="section section-rubros section-light" id="rubros">
      <div class="container">
        <div class="section-header reveal" style="text-align: center; margin-bottom: 50px;">
          <h2>Soluciones adaptadas a tu modelo de negocio</h2>
          <p style="max-width: 750px; margin: 0 auto; color: var(--text-secondary);">Diseñamos y programamos según la lógica comercial de tu sector para asegurar el máximo retorno.</p>
        </div>

        <div class="rubros-grid reveal">
          <!-- Tarjeta 1 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
                <div class="rubro-icon-wrapper wrapper-emerald">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                </div>
                <h3>Inmobiliarias y corredores</h3>
              </div>
              <svg class="card-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <p>Sistemas CRM y ERP internos personalizados donde los corredores cargan stock de propiedades, calculan comisiones y hacen seguimiento de operaciones.</p>
          </div>

          <!-- Tarjeta 2 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
                <div class="rubro-icon-wrapper wrapper-purple">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                </div>
                <h3>Servicios B2B y consultoras</h3>
              </div>
              <svg class="card-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <p>Intranets corporativas privadas para administración de proyectos complejos, carga de contratos firmados y facturación automatizada a clientes.</p>
          </div>

          <!-- Tarjeta 3 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
                <div class="rubro-icon-wrapper wrapper-orange">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                </div>
                <h3>E-commerce y tiendas</h3>
              </div>
              <svg class="card-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <p>Sistemas a medida para control de almacenes, despachos logísticos complejos y sincronización automática de stock con múltiples proveedores.</p>
          </div>

          <!-- Tarjeta 4 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
                <div class="rubro-icon-wrapper wrapper-crimson">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </div>
                <h3>Negocios locales y profesionales</h3>
              </div>
              <svg class="card-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <p>Sistemas de reservas de turnos y portales seguros para pacientes y clientes, incluyendo expedientes clínicos electrónicos encriptados y sincronización de agendas.</p>
          </div>

          <!-- Tarjeta 5 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
                <div class="rubro-icon-wrapper wrapper-pink">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                </div>
                <h3>Clínicas y centros estéticos</h3>
              </div>
              <svg class="card-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <p>Sistemas integrados de gestión médica, administración de historias clínicas y optimización de flujo de pacientes en sucursales físicas.</p>
          </div>

          <!-- Tarjeta 6 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
                <div class="rubro-icon-wrapper wrapper-blue">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                </div>
                <h3>SaaS, startups y tecnología</h3>
              </div>
              <svg class="card-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <p>Desarrollo de MVPs robustos, plataformas SaaS multi-inquilino y backend estructurado en APIs para escalar en la nube desde el primer día.</p>
          </div>

          <!-- Tarjeta 7 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
                <div class="rubro-icon-wrapper wrapper-amber">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                </div>
                <h3>Instituciones y academias</h3>
              </div>
              <svg class="card-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
            <p>Plataformas LMS y aulas virtuales personalizadas para cobro recurrente de cuotas de matrícula, control de exámenes y avance académico.</p>
          </div>

          <!-- Tarjeta 8 -->
          <div class="rubro-card">
            <div class="card-header-row">
              <div class="card-header-left">
