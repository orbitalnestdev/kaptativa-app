  <script>
    import { api } from '../../lib/appwrite.js';

    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('design-contact-form') as HTMLFormElement;
      const feedback = document.getElementById('design-form-feedback');

      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = (document.getElementById('form-nombre') as HTMLInputElement).value.trim();
        const whatsapp = (document.getElementById('form-telefono') as HTMLInputElement).value.trim();
        const siteType = (document.getElementById('form-sitio-tipo') as HTMLSelectElement).value;
        const siteStatus = (document.getElementById('form-sitio-estado') as HTMLSelectElement).value;

        if (!feedback) return;

        if (!name || !whatsapp || !siteType || !siteStatus) {
          feedback.style.display = 'block';
          feedback.style.background = 'rgba(239, 68, 68, 0.1)';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.2)';
          feedback.style.color = '#ef4444';
          feedback.innerText = 'Por favor, completa todos los campos del formulario.';
          return;
        }

        feedback.style.display = 'block';
        feedback.style.background = 'rgba(138, 53, 229, 0.1)';
        feedback.style.border = '1px solid rgba(138, 53, 229, 0.2)';
        feedback.style.color = '#d946ef';
        feedback.innerText = 'Registrando tu solicitud de cotización...';

        try {
          await api.db.createLead({
            name,
            business: 'Diseño Web Premium',
            whatsapp,
            email: 'no-email@kaptativa.com',
            message: `Tipo de Sitio: ${siteType} | Estado de su Web: ${siteStatus}`,
            status: 'nuevo',
            tags: 'Diseño Web',
            score: 0,
            recommendations: 'Consulta desde el formulario de Diseño Web.'
          });

          feedback.style.background = 'rgba(16, 185, 129, 0.1)';
          feedback.style.border = '1px solid rgba(16, 185, 129, 0.2)';
          feedback.style.color = '#10b981';
          feedback.innerText = '¡Solicitud registrada! Redirigiendo a WhatsApp...';

          setTimeout(() => {
            const textMsg = `Hola! Acabo de cotizar un Diseño Web a medida en la web. Mi nombre es ${name}. Necesitamos un/a ${siteType}. Situación actual: ${siteStatus}.`;
            const encodedMsg = encodeURIComponent(textMsg);
            window.open(`https://wa.me/5493804890834?text=${encodedMsg}`, '_blank');
            form.reset();
            feedback.style.display = 'none';
          }, 1200);

        } catch (error) {
          console.error('Error registrando lead:', error);
          feedback.style.background = 'rgba(239, 68, 68, 0.1)';
          feedback.style.border = '1px solid rgba(239, 68, 68, 0.2)';
          feedback.style.color = '#ef4444';
          feedback.innerText = 'Ocurrió un error al registrar tus datos. Por favor, intenta de nuevo o contáctanos por WhatsApp.';
        }
      });
    });
  </script>
