---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const seoTitle = "Página no encontrada | Kaptativa";
const seoDescription = "La página que estás buscando no existe. Regresa a nuestro inicio para conocer nuestras soluciones de automatización e inteligencia artificial.";
---

<Layout title={seoTitle} description={seoDescription}>
  <Header slot="header" />
  
  <main class="error-page section">
    <div class="container error-container">
      <div class="error-content">
        <div class="error-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#EA384D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
            <path d="M12 8v4"/>
            <path d="M12 16h.01"/>
          </svg>
        </div>
        <h1 class="heading-1 text-gradient">404</h1>
        <h2 class="heading-3">Parece que nos hemos desviado</h2>
        <p class="error-description">
          La página que estás buscando no existe, ha sido movida o está temporalmente fuera de servicio.
        </p>
        <div class="error-actions">
          <a href="/" class="btn btn-primary" aria-label="Volver a la página principal">
            Volver al inicio
          </a>
          <a href="/servicios/" class="btn btn-secondary" aria-label="Ver nuestros servicios">
            Ver servicios
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .error-page {
    padding-top: 140px;
    padding-bottom: 80px;
  }

  .error-container {
    text-align: center;
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }
  
  .error-badge {
    background: rgba(234, 56, 77, 0.1);
    padding: 24px;
    border-radius: 50%;
    display: inline-flex;
    box-shadow: 0 0 30px rgba(234, 56, 77, 0.2);
    margin-bottom: 24px;
  }
  
  .heading-1 {
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 1;
    margin-bottom: 16px;
  }

  .heading-3 {
    font-size: 1.8rem;
    margin-bottom: 24px;
  }

  .error-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 32px auto;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .error-actions {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .error-actions .btn-outline {
      margin-left: 0 !important;
    }
  }
</style>
