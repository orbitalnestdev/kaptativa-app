<script is:inline>
  // Script interactivo para cambiar fondo y simular en cabecera
  document.addEventListener('DOMContentLoaded', () => {
    
    // 1. Manejo del fondo global (Dark / Light) en las áreas de preview
    const bgBtns = document.querySelectorAll('[data-bg]');
    const previewAreas = document.querySelectorAll('.preview-area');
    
    bgBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        bgBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const mode = btn.getAttribute('data-bg');
        
        previewAreas.forEach(area => {
          if (mode === 'light') {
            area.classList.remove('dark-bg');
            area.classList.add('light-bg');
            area.querySelectorAll('.text-color-toggle').forEach(el => el.setAttribute('fill', '#0b0f19'));
          } else {
            area.classList.remove('light-bg');
            area.classList.add('dark-bg');
            area.querySelectorAll('.text-color-toggle').forEach(el => el.setAttribute('fill', '#FFFFFF'));
          }
        });
      });
    });

    // 2. Inyección dinámica del logo en el Header Mockup
    const logos = [];
    document.querySelectorAll('.logo-svg-render').forEach(svg => {
      logos.push(svg.cloneNode(true));
    });

    const mockupLogoTarget = document.getElementById('mockup-logo-target');
    const mockupBtns = document.querySelectorAll('[data-target]');

    // Función para renderizar el logo en el simulador
    const updateMockupLogo = (index) => {
      mockupLogoTarget.innerHTML = '';
      if (logos[index]) {
        const logoClone = logos[index].cloneNode(true);
        logoClone.querySelectorAll('.text-color-toggle').forEach(el => el.setAttribute('fill', '#FFFFFF'));
        mockupLogoTarget.appendChild(logoClone);
      }
    };

    // Inicializamos con el logo actual (índice 0)
    updateMockupLogo(0);

    mockupBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mockupBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const targetIndex = parseInt(btn.getAttribute('data-target'), 10);
        updateMockupLogo(targetIndex);
      });
    });
  });
</script>

