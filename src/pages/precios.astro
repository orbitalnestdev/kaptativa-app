---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Planes from '../components/home2/Planes.astro';
import Faq from '../components/Faq.astro';
import { svg } from '../data/plataforma.js';
import FeatureVisual from '../components/home2/FeatureVisual.astro';
import HeroAurora from '../components/HeroAurora.astro';
import IsoK3D from '../components/IsoK3D.astro';
import CtaBeam from '../components/CtaBeam.astro';
import { planes, comparativa, faqsPrecios, extras } from '../data/planes.js';
const WA_EXTRAS = 'https://wa.me/5493804890834?text=' + encodeURIComponent('¡Hola kaptativa! Quiero consultar por los extras de la plataforma.');

const WHATSAPP = 'https://wa.me/5493804890834?text=' + encodeURIComponent('¡Hola kaptativa! Quiero solicitar una demo y conocer los planes.');
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://kaptativa.com/' },
      { '@type': 'ListItem', position: 2, name: 'Planes y precios', item: 'https://kaptativa.com/precios/' },
    ] },
    { '@type': 'FAQPage', mainEntity: faqsPrecios.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
  ],
};
---

<Layout
  schema={schema}
  title="Planes y precios: sitio web, tienda y sistema | kaptativa"
  description="Tres planes sobre la misma plataforma: Presencia, E-commerce y Corporativo. Qué incluye cada uno, los add-ons por suscripción y cómo se cotiza."
>
  <Header slot="header" floating />

  <main class="precios-page">
    <section class="precios-hero">
      <HeroAurora />
      <div class="precios-glow" aria-hidden="true"></div>
      <div class="container">
        <h1>Planes y precios</h1>
        <p>Tres puntos de partida sobre la misma plataforma. Elegís el que se ajusta a tu etapa y escalás cuando lo necesites, sin rehacer nada.</p>
      </div>
    </section>

    <Planes header={false} id="planes" />

    <section class="section section-light" id="comparativa">
      <div class="container">
        <div class="section-header">
          <h2>Qué incluye cada plan</h2>
          <p>Los planes son acumulativos: cada uno suma sobre el anterior.</p>
        </div>
        <div class="cmp-wrap">
          <table class="cmp">
            <thead>
              <tr>
                <th scope="col">Incluye</th>
                {planes.map((p) => <th scope="col" class:list={{ popular: p.popular }}>{p.name}{p.popular && <small>Más elegido</small>}</th>)}
              </tr>
            </thead>
            <tbody>
              {comparativa.map((r) => (
                <tr>
                  <th scope="row">{r.item}{r.nuevo && <span class="tag-nuevo">Nuevo</span>}</th>
                  {r.planes.map((v, i) => (
                    <td class:list={{ popular: planes[i].popular }}>
                      {v === true && <span class="cmp-si"><Fragment set:html={svg('check')} /><span class="sr-only">Incluido</span></span>}
                      {v === false && <span class="cmp-no" aria-label="No incluido">–</span>}
                      {typeof v === 'string' && <span class="cmp-txt">{v}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="cmp-hint" aria-hidden="true">Deslizá para ver los tres planes <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></p>
      </div>
    </section>

    <section class="section" id="extras">
      <div class="container">
        <div class="section-header">
          <h2>Potenciá tu plataforma<br />con add-ons</h2>
          <p>Servicios por suscripción que se suman a cualquier plan: los activás cuando los necesitás y pagás según cuánto los usás.</p>
        </div>
        <div class="ex-grid" role="list">
          {extras.map((x) => (
            <article class:list={['ex-tile', { 'ex-tile--big': x.big, 'ex-tile--solid': x.solid }]} role="listitem">
              <div class="ex-head">
                <span class="ex-icon"><Fragment set:html={svg(x.icon)} /></span>
                <h3>{x.title}</h3>
                <p>{x.desc}</p>
                {x.niveles && <div class="ex-niveles">{x.niveles.map((n) => <span>{n}</span>)}</div>}
                {x.detalle && <small>{x.detalle}</small>}
              </div>
              {x.big && <FeatureVisual icon={x.icon} />}
            </article>
          ))}
        </div>
        <p class="ex-help">Se cotizan según el uso y se suman sobre el plan que tengas. <a href={WA_EXTRAS} target="_blank" rel="noopener noreferrer">Consultanos por WhatsApp</a> cuál te conviene.</p>
      </div>
    </section>

    <Faq items={faqsPrecios} title="Preguntas sobre precios" subtitle="Lo que más nos consultan antes de pedir una cotización." id="preguntas" />

    <section class="section">
      <div class="container">
        <div class="precios-cta">
          <CtaBeam />
          <IsoK3D class="precios-iso" />
          <h2>¿Te mostramos la plataforma<br />con tu rubro ya configurado?</h2>
          <p>Coordinamos una demo de 30 minutos y después te pasamos la cotización del plan que te convenga.</p>
          <div class="precios-cta-botones">
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow"><span>Solicitar demo</span></a>
            <a href="/contacto/?plan=Planes" class="btn btn-secondary"><span>Escribinos</span></a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .precios-cta :global(.precios-iso) { top: -46px; right: -22px; }
  @media (max-width: 768px) { .precios-cta :global(.precios-iso) { width: 92px; height: 92px; top: -30px; right: -6px; } }
  .precios-hero { position: relative; overflow: hidden; padding: 160px 0 40px; text-align: center; }
  .precios-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(124, 92, 255, 0.22), transparent 70%); }
  .precios-hero .container { position: relative; max-width: 760px; }
  .precios-hero h1 { font-family: 'Lexend', sans-serif; font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 600; line-height: 1.1; color: var(--text-primary); margin: 0 0 18px; }
  .precios-hero p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6; margin: 0 auto; max-width: 56ch; }

  /* Tabla comparativa */
  .cmp-wrap { overflow-x: auto; border: 1px solid var(--border-color); border-radius: 20px; background: var(--card-bg); scrollbar-color: #7C5CFF #EEEAFE; scrollbar-width: thin; }
  /* Barra de desplazamiento en violeta de marca (la global es oscura y sobre la tabla blanca se veía como una franja negra) */
  .cmp-wrap::-webkit-scrollbar { height: 8px; }
  .cmp-wrap::-webkit-scrollbar-track { background: #EEEAFE; border-radius: 999px; margin: 0 16px; }
  .cmp-wrap::-webkit-scrollbar-thumb { background: #7C5CFF; border-radius: 999px; }
  .cmp-hint { display: none; }
  .cmp { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 0.95rem; }
  .cmp th, .cmp td { padding: 14px 18px; border-bottom: 1px solid var(--border-color); text-align: center; vertical-align: middle; }
  .cmp tbody tr:last-child th, .cmp tbody tr:last-child td { border-bottom: 0; }
  .cmp thead th { font-family: 'Lexend', sans-serif; font-weight: 600; font-size: 1rem; color: var(--text-primary); padding-top: 20px; padding-bottom: 20px; }
  .cmp thead th small { display: block; margin-top: 4px; font-family: 'Inter', sans-serif; font-size: 0.7rem; font-weight: 600; color: var(--brand-primary-light); }
  .cmp th[scope='row'] { text-align: left; font-weight: 500; color: var(--text-secondary); width: 40%; }
  .cmp thead th:first-child { text-align: left; color: var(--text-muted); font-family: 'Inter', sans-serif; font-weight: 500; font-size: 0.85rem; }
  .cmp .popular { background: rgba(124, 92, 255, 0.08); }
  .tag-nuevo { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 999px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.5; vertical-align: 1px; color: #fff; background: var(--brand-fill); }
  .cmp thead th.popular { color: #fff; }
  .cmp-si { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(124, 92, 255, 0.16); color: var(--brand-primary-light); }
  .cmp-si :global(.ki) { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .cmp-no { color: var(--text-muted); font-size: 1.1rem; }
  .cmp-txt { font-weight: 600; color: var(--text-primary); font-size: 0.88rem; }

  /* CTA final */
  .precios-cta { position: relative; text-align: center; padding: 64px 32px; border-radius: var(--radius-xl); border: 1px solid transparent; background: radial-gradient(circle at 50% 0%, rgba(124, 92, 255, 0.2), transparent 70%), var(--card-bg); box-shadow: 0 30px 80px rgba(124, 92, 255, 0.12); }
  .precios-cta::before { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: linear-gradient(135deg, rgba(124, 92, 255, 0.7), rgba(124, 92, 255, 0.08) 55%, rgba(124, 92, 255, 0.5)); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  .precios-cta h2 { font-family: 'Lexend', sans-serif; font-size: clamp(1.9rem, 4vw, 2.6rem); margin: 0 0 14px; color: var(--text-primary); }
  .precios-cta p { color: var(--text-secondary); max-width: 560px; margin: 0 auto; line-height: 1.6; }
  .precios-cta-botones { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }

  @media (max-width: 768px) {
    .precios-hero { padding: 130px 0 24px; }
    .cmp th, .cmp td { padding: 12px 12px; font-size: 0.88rem; }
    /* La columna de qué incluye queda fija al deslizar, así cada fila se sigue leyendo */
    .cmp { min-width: 560px; }
    .cmp th[scope='row'], .cmp thead th:first-child { position: sticky; left: 0; z-index: 1; width: 150px; min-width: 150px; background: var(--card-bg); box-shadow: 1px 0 0 var(--border-color); }
    .cmp-hint { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 14px 0 0; font-size: 0.82rem; font-weight: 600; }
    #comparativa .cmp-hint { color: #5B3FE0 !important; }
    .precios-cta { padding: 44px 20px; }
    .precios-cta-botones .btn { width: 100%; justify-content: center; }
  }

  /* Extras: misma grilla de tiles que los módulos de la home; dos tiles dobles con mini-interfaz */
  .ex-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .ex-tile { position: relative; display: flex; flex-direction: column; gap: 18px; padding: 26px 24px 24px; border-radius: var(--radius-lg); background: var(--card-bg); border: 1px solid var(--border-color); min-height: 220px; transition: border-color var(--transition-normal); }
  .ex-tile:hover { border-color: var(--border-hover); }
  .ex-tile--big { grid-column: span 2; flex-direction: row; align-items: center; gap: 26px; }
  .ex-tile--big .ex-head { flex: 1; }
  .ex-tile--big :global(.fv) { flex: 0 0 46%; margin: 0; }
  .ex-tile--solid { background: var(--brand-fill); border-color: var(--brand-fill); }
  .ex-icon { display: inline-flex; width: 40px; height: 40px; color: var(--brand-primary); }
  .ex-icon :global(.ki) { width: 100%; height: 100%; }
  .ex-tile h3 { font-family: 'Lexend', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin: 10px 0 6px; }
  .ex-tile p { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0; }
  .ex-tile small { display: block; margin-top: 10px; font-size: 0.82rem; color: var(--text-muted); line-height: 1.5; }
  .ex-niveles { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
  .ex-niveles span { font-size: 0.74rem; font-weight: 600; padding: 4px 10px; border-radius: 999px; color: var(--brand-primary-light); background: rgba(124, 92, 255, 0.12); border: 1px solid rgba(124, 92, 255, 0.3); }
  .ex-tile--solid .ex-icon, .ex-tile--solid h3 { color: #fff; }
  .ex-tile--solid p { color: rgba(255, 255, 255, 0.94); }
  .ex-tile--solid small { color: rgba(255, 255, 255, 0.86); }
  .ex-tile--solid .ex-niveles span { color: #fff; background: rgba(14, 8, 40, 0.38); border-color: rgba(255, 255, 255, 0.28); }
  .ex-tile--solid :global(.fv) { background: rgba(14, 8, 40, 0.45); border-color: rgba(255, 255, 255, 0.14); color: rgba(255, 255, 255, 0.85); }
  .ex-help { text-align: center; margin: 36px auto 0; max-width: 60ch; color: var(--text-secondary); font-size: 0.95rem; }
  .ex-help a { color: var(--brand-primary-light); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1024px) { .ex-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 768px) { .ex-grid { grid-template-columns: 1fr; } .ex-tile--big { grid-column: auto; flex-direction: column; align-items: stretch; } .ex-tile--big :global(.fv) { flex: none; } }
  /* Tabla comparativa sobre panel claro */
  .section-light .cmp-wrap { background: #FFFFFF; border-color: #ECECEF; box-shadow: 0 12px 30px rgba(15, 15, 18, 0.06); }
  .section-light .cmp th, .section-light .cmp td { border-bottom-color: #ECECEF; }
  .section-light .cmp thead th { color: #0F0F12; }
  .section-light .cmp thead th small { color: #5B3FE0; }
  .section-light .cmp th[scope='row'] { color: #52525B; }
  .section-light .cmp thead th:first-child { color: #6E6E7A; }
  .section-light .cmp .popular { background: #F3F0FF; }
  .section-light .cmp thead th.popular { color: #0F0F12; }
  .section-light .cmp-si { background: #EDE9FF; color: #5B3FE0; }
  .section-light .cmp-no { color: #B4B4BE; }
  .section-light .cmp-txt { color: #0F0F12; }
</style>
