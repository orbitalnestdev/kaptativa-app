---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';

// SSR Authentication Guard
const sessionCookie = Astro.cookies.get('kaptativa_session');
if (!sessionCookie) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Gestión de Team | Kaptativa Admin">
  <div class="admin-wrapper" id="admin-main-view">
    
    <!-- SIDEBAR NAVIGATION -->
    <AdminSidebar activeTab="eteam" />

    <!-- MAIN CONTENT AREA -->
    <main class="admin-content-area">
      
      <!-- HEADER -->
      <header class="admin-header">
        <div>
          <h1 class="admin-page-title" style="margin: 0; font-size: 1.6rem; font-weight: 600; color: white; font-family: 'Space Grotesk', sans-serif;">Gestión de Team</h1>
          <p style="font-size: 0.825rem; color: var(--text-muted); margin-top: 4px; margin-bottom: 0;">Administra a los integrantes del equipo autorizados para emitir presupuestos, ver la agenda del equipo y consultar el pipeline CRM.</p>
        </div>
        <div>
          <button type="button" class="btn btn-primary" id="btn-open-team-modal" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600; padding: 10px 20px; border-radius: 10px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>+ Cargar Integrante</span>
          </button>
        </div>
      </header>

      <!-- METRICS GRID -->
      <section class="admin-metrics-grid" style="margin-top: 25px; margin-bottom: 30px;">
        <div class="admin-metric-card">
          <div class="metric-info">
            <span class="metric-title">Integrantes del Team</span>
            <h3 class="metric-value" id="stat-team-count">0</h3>
          </div>
          <div class="metric-icon" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
        </div>
        
        <div class="admin-metric-card">
          <div class="metric-info">
            <span class="metric-title">Consultores Activos</span>
            <h3 class="metric-value" id="stat-active-count">0</h3>
          </div>
          <div class="metric-icon" style="background: rgba(16, 185, 129, 0.1); color: #10B981; display: flex; align-items: center; justify-content: center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
        </div>
        
        <div class="admin-metric-card">
          <div class="metric-info">
            <span class="metric-title">Emisores de Presupuesto</span>
            <h3 class="metric-value" id="stat-quotes-count">0</h3>
          </div>
          <div class="metric-icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6; display: flex; align-items: center; justify-content: center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
        </div>
      </section>

      <!-- TEAM MEMBERS TABLE -->
      <section class="form-card-container" style="padding: 25px;">
        <h3 style="font-size: 1.15rem; color: #ffffff; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 10px; margin-bottom: 20px; font-family: 'Space Grotesk', sans-serif; font-weight: 600; margin-top: 0;">
          Integrantes del Team
        </h3>

        <div class="admin-table-wrapper">
          <div style="min-width: 750px;">
            <table class="admin-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
              <thead>
                <tr style="border-bottom: 1.5px solid var(--border-color); color: var(--text-muted); font-weight: 600;">
                  <th style="padding: 14px 16px;">Integrante</th>
                  <th style="padding: 14px 16px;">Contacto</th>
                  <th style="padding: 14px 16px;">Permisos Asignados</th>
                  <th style="padding: 14px 16px;">Estado</th>
                  <th style="padding: 14px 16px; text-align: right; width: 140px;">Acciones</th>
                </tr>
              </thead>
              <tbody id="team-list-body">
                <tr>
                  <td colspan="5" style="text-align: center; padding: 30px; color: var(--text-muted);">Cargando integrantes del equipo...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- MODAL: ADD / EDIT TEAM MEMBER -->
  <div class="admin-modal-backdrop" id="modal-team-member" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #0a0a10; border: 1px solid var(--border-color); border-radius: 16px; max-width: 540px; width: 100%; padding: 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.6); position: relative;">
      
      <button type="button" id="btn-close-team-modal" style="position: absolute; right: 20px; top: 20px; background: transparent; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer;">✕</button>

      <h3 id="modal-team-title" style="margin-top: 0; font-family: 'Space Grotesk', sans-serif; font-size: 1.25rem; font-weight: 600; color: white; margin-bottom: 6px;">Cargar Integrante al Team</h3>
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 22px;">Ingresa las credenciales del colaborador y habilita los permisos correspondientes.</p>

      <form id="team-member-form">
        <input type="hidden" id="tm-id" value="" />

        <div class="form-group" style="margin-bottom: 16px;">
          <label for="tm-name" class="form-label" style="display: block; font-size: 0.825rem; color: var(--text-secondary); margin-bottom: 6px; font-weight: 600;">Nombre Completo *</label>
          <input type="text" id="tm-name" class="form-control" placeholder="Ej. Eliana Azcurra" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); border-radius: 8px; color: white; font-size: 0.875rem;" />
        </div>

        <div class="form-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px;">
          <div class="form-group">
            <label for="tm-role" class="form-label" style="display: block; font-size: 0.825rem; color: var(--text-secondary); margin-bottom: 6px; font-weight: 600;">Especialidad / Rol *</label>
            <input type="text" id="tm-role" class="form-control" placeholder="Ej. Consultor Senior" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); border-radius: 8px; color: white; font-size: 0.875rem;" />
          </div>
          <div class="form-group">
            <label for="tm-phone" class="form-label" style="display: block; font-size: 0.825rem; color: var(--text-secondary); margin-bottom: 6px; font-weight: 600;">WhatsApp / Celular</label>
            <input type="text" id="tm-phone" class="form-control" placeholder="Ej. +54 9 11 1234-5678" style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); border-radius: 8px; color: white; font-size: 0.875rem;" />
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label for="tm-email" class="form-label" style="display: block; font-size: 0.825rem; color: var(--text-secondary); margin-bottom: 6px; font-weight: 600;">Email Corporativo *</label>
          <input type="email" id="tm-email" class="form-control" placeholder="ejemplo@kaptativa.com" required style="width: 100%; padding: 10px 14px; background: rgba(255,255,255,0.04); border: 1px solid var(--border-color); border-radius: 8px; color: white; font-size: 0.875rem;" />
        </div>

        <div style="margin-bottom: 22px; padding: 15px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px;">
          <label style="display: block; font-size: 0.825rem; color: white; font-weight: 600; margin-bottom: 10px;">Permisos Habilitados (Solo esto):</label>

          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.825rem; color: var(--text-secondary);">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" id="perm-presupuestos" checked style="accent-color: #EA384D; width: 16px; height: 16px;" />
              <span>Crear y emitir Presupuestos comerciales</span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" id="perm-agenda" checked style="accent-color: #EA384D; width: 16px; height: 16px;" />
              <span>Ver y gestionar la Agenda de turnos</span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
              <input type="checkbox" id="perm-pipeline" checked style="accent-color: #EA384D; width: 16px; height: 16px;" />
              <span>Ver el Pipeline CRM y tablero Kanban</span>
            </label>
          </div>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
          <button type="button" class="btn btn-secondary" id="btn-cancel-team-modal" style="padding: 10px 20px;">Cancelar</button>
          <button type="submit" class="btn btn-primary" style="padding: 10px 24px; font-weight: 600;">Guardar Integrante</button>
        </div>
      </form>

    </div>
  </div>
</AdminLayout>

<script>
  import { api } from '../../lib/appwrite.js';

  interface TeamMember {
    id: string;
    name: string;
    role: string;
    email: string;
    phone: string;
    status: 'activo' | 'inactivo';
    permPresupuestos: boolean;
    permAgenda: boolean;
    permPipeline: boolean;
    createdAt: string;
  }

  // Initial Seed Data if empty
  const SEED_TEAM: TeamMember[] = [
    {
      id: 'tm-1',
      name: 'Eliana Azcurra',
      role: 'Consultor Senior & CEO',
      email: 'contacto@kaptativa.com',
      phone: '+54 9 380 412-3456',
      status: 'activo',
      permPresupuestos: true,
      permAgenda: true,
      permPipeline: true,
      createdAt: new Date().toISOString()
    },
    {
      id: 'tm-2',
      name: 'Carlos Mendoza',
      role: 'Ejecutivo Comercial',
      email: 'cmendoza@kaptativa.com',
      phone: '+54 9 11 5432-8765',
      status: 'activo',
      permPresupuestos: true,
      permAgenda: true,
      permPipeline: true,
      createdAt: new Date().toISOString()
    }
  ];

  function getStoredTeam(): TeamMember[] {
    const raw = localStorage.getItem('mock_team');
    if (!raw) {
      localStorage.setItem('mock_team', JSON.stringify(SEED_TEAM));
      return SEED_TEAM;
    }
    try {
      return JSON.parse(raw);
    } catch (e) {
      return SEED_TEAM;
    }
  }

  function saveStoredTeam(team: TeamMember[]) {
    localStorage.setItem('mock_team', JSON.stringify(team));
  }

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('modal-team-member') as HTMLElement;
    const openBtn = document.getElementById('btn-open-team-modal') as HTMLButtonElement;
    const closeBtn = document.getElementById('btn-close-team-modal') as HTMLButtonElement;
    const cancelBtn = document.getElementById('btn-cancel-team-modal') as HTMLButtonElement;
    const form = document.getElementById('team-member-form') as HTMLFormElement;
    const tbody = document.getElementById('team-list-body') as HTMLElement;

    const tmIdInput = document.getElementById('tm-id') as HTMLInputElement;
    const tmNameInput = document.getElementById('tm-name') as HTMLInputElement;
    const tmRoleInput = document.getElementById('tm-role') as HTMLInputElement;
    const tmPhoneInput = document.getElementById('tm-phone') as HTMLInputElement;
    const tmEmailInput = document.getElementById('tm-email') as HTMLInputElement;

    const permPresupuestos = document.getElementById('perm-presupuestos') as HTMLInputElement;
    const permAgenda = document.getElementById('perm-agenda') as HTMLInputElement;
    const permPipeline = document.getElementById('perm-pipeline') as HTMLInputElement;

    function renderTeam() {
      const team = getStoredTeam();

      // Update metrics
      (document.getElementById('stat-team-count') as HTMLElement).innerText = team.length.toString();
      (document.getElementById('stat-active-count') as HTMLElement).innerText = team.filter(t => t.status === 'activo').length.toString();
      (document.getElementById('stat-quotes-count') as HTMLElement).innerText = team.filter(t => t.permPresupuestos).length.toString();

      if (team.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; padding: 40px; color: var(--text-muted);">
              Aún no has registrado colaboradores en el e-Team. Haz clic en "+ Cargar Integrante" para sumar a tu equipo.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = '';
      team.forEach(member => {
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid var(--border-color)';

        tr.innerHTML = `
          <td style="padding: 14px 16px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #EA384D, #8A35E5); color: white; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.85rem; flex-shrink: 0;">
                ${member.name.charAt(0).toUpperCase()}
              </div>
              <div>
                <span style="font-weight: 600; color: white; display: block; font-family: 'Lexend', sans-serif;">${member.name}</span>
                <span style="font-size: 0.775rem; color: var(--text-muted);">${member.role}</span>
              </div>
            </div>
          </td>
          <td style="padding: 14px 16px;">
            <div style="font-size: 0.85rem; color: #ffffff;">${member.email}</div>
            <div style="font-size: 0.775rem; color: var(--text-muted);">${member.phone || 'Sin WhatsApp'}</div>
          </td>
          <td style="padding: 14px 16px;">
            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
              ${member.permPresupuestos ? `<span style="font-size: 0.725rem; padding: 2px 8px; border-radius: 4px; background: rgba(59, 130, 246, 0.12); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3);">✓ Presupuestos</span>` : ''}
              ${member.permAgenda ? `<span style="font-size: 0.725rem; padding: 2px 8px; border-radius: 4px; background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">✓ Agenda</span>` : ''}
              ${member.permPipeline ? `<span style="font-size: 0.725rem; padding: 2px 8px; border-radius: 4px; background: rgba(139, 92, 246, 0.12); color: #a78bfa; border: 1px solid rgba(139, 92, 246, 0.3);">✓ Pipeline CRM</span>` : ''}
            </div>
          </td>
          <td style="padding: 14px 16px;">
            <span style="font-size: 0.75rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">
              ● Activo
            </span>
          </td>
          <td style="padding: 14px 16px; text-align: right; white-space: nowrap;">
            <div style="display: inline-flex; gap: 6px; justify-content: flex-end;">
              <button type="button" class="btn-edit-tm" data-id="${member.id}" style="width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: white; cursor: pointer; display: flex; align-items: center; justify-content: center;" title="Editar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button type="button" class="btn-delete-tm" data-id="${member.id}" style="width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15); color: #ef4444; cursor: pointer; display: flex; align-items: center; justify-content: center;" title="Eliminar">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          </td>
        `;

        tr.querySelector('.btn-edit-tm')?.addEventListener('click', () => {
          tmIdInput.value = member.id;
          tmNameInput.value = member.name;
          tmRoleInput.value = member.role;
          tmPhoneInput.value = member.phone;
          tmEmailInput.value = member.email;

          permPresupuestos.checked = member.permPresupuestos;
          permAgenda.checked = member.permAgenda;
          permPipeline.checked = member.permPipeline;

          (document.getElementById('modal-team-title') as HTMLElement).innerText = 'Editar Integrante del e-Team';
          modal.style.display = 'flex';
        });

        tr.querySelector('.btn-delete-tm')?.addEventListener('click', () => {
          if (confirm(`¿Deseas eliminar a ${member.name} del e-Team?`)) {
            const updated = getStoredTeam().filter(t => t.id !== member.id);
            saveStoredTeam(updated);
            if (typeof (window as any).showToast === 'function') {
              (window as any).showToast({ title: 'Integrante removido', type: 'info' });
            }
            renderTeam();
          }
        });

        tbody.appendChild(tr);
      });
    }

    // Modal controls
    openBtn?.addEventListener('click', () => {
      form.reset();
      tmIdInput.value = '';
      (document.getElementById('modal-team-title') as HTMLElement).innerText = 'Cargar Integrante al e-Team';
      modal.style.display = 'flex';
    });

    const closeModal = () => { modal.style.display = 'none'; };
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const team = getStoredTeam();
      const id = tmIdInput.value || `tm-${Date.now()}`;

      const newMember: TeamMember = {
        id,
        name: tmNameInput.value.trim(),
        role: tmRoleInput.value.trim(),
        phone: tmPhoneInput.value.trim(),
        email: tmEmailInput.value.trim(),
        status: 'activo',
        permPresupuestos: permPresupuestos.checked,
        permAgenda: permAgenda.checked,
        permPipeline: permPipeline.checked,
        createdAt: new Date().toISOString()
      };

      const existingIndex = team.findIndex(t => t.id === id);
      if (existingIndex !== -1) {
        team[existingIndex] = newMember;
      } else {
        team.push(newMember);
      }

      saveStoredTeam(team);
      closeModal();
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast({ title: 'Integrante guardado correctamente', type: 'success' });
      }
      renderTeam();
    });

    renderTeam();
  });
</script>
