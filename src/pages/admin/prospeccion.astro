    const csvFileInput = document.getElementById('csv-file-input') as HTMLInputElement;

    if (csvFileInput) {
      csvFileInput.addEventListener('change', async (e: any) => {
        const file = e.target.files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async (evt: any) => {
          const text = evt.target.result;
          try {
            const parsedLeads = parseOutscraperCSV(text);
            if (parsedLeads.length === 0) {
              alert("No se encontraron leads válidos en el CSV. Verifica el formato.");
              return;
            }

            if (confirm(`Se detectaron ${parsedLeads.length} prospectos en el archivo. ¿Deseas importarlos?`)) {
              let successCount = 0;
              // Show a temporary loading indicator
              listContainer.innerHTML = `
                <div style="text-align: center; padding: 50px; color: #8A8A9A; font-size: 0.9rem;">
                  <span class="spinner" style="display:inline-block; animation:spin 1s linear infinite; margin-right:4px;">🔄</span>
                  Importando ${parsedLeads.length} prospectos a la base de datos...
                </div>
              `;

              for (const lead of parsedLeads) {
                try {
                  const saved = await api.db.createProspect(lead);
                  rows.unshift(saved);
                  successCount++;
                } catch (err) {
                  console.error("Error al importar lead individual:", err);
                }
              }

              alert(`¡Importación completada! ${successCount} de ${parsedLeads.length} prospectos importados con éxito.`);
              calculateStats();
              render();
            }
          } catch (err) {
            console.error("Error parsing CSV:", err);
            alert("Error al procesar el archivo CSV. Asegúrate de que sea un archivo CSV válido.");
          } finally {
            csvFileInput.value = ''; // Reset file input
          }
        };
        reader.readAsText(file);
      });
    }

