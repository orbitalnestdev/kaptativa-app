            if (rowRegenBtn) {
              rowRegenBtn.disabled = true;
              rowRegenBtn.innerHTML = `<span style="display:inline-block; animation:spin 1s linear infinite; margin-right:4px;">🔄</span> Generando secuencia...`;
            }
            try {
              const controller = new AbortController();
              const timeout = setTimeout(() => controller.abort(), 30000);
              const res = await fetch('/api/generate-message', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ prospecto: r, tono: r.tono || 'informal' }),
                signal: controller.signal
              });
              clearTimeout(timeout);
              if (!res.ok) throw new Error('Server error');
              const data = await res.json();
              // Store all 3 messages
              r.mensaje = data.mensajes?.apertura || data.mensaje || '';
              r.mensaje_seguimiento = data.mensajes?.seguimiento || '';
              r.mensaje_reenganche = data.mensajes?.reenganche || '';
              r.isMockMessage = data.isMock || false;
              if (r.estado === 'nuevo') r.estado = 'mensaje_generado';
              calculateStats();
              await api.db.updateProspect(r.$id, {
                mensaje: r.mensaje,
                mensaje_seguimiento: r.mensaje_seguimiento,
                mensaje_reenganche: r.mensaje_reenganche,
                estado: r.estado,
                isMockMessage: r.isMockMessage
              });
              render();
            } catch (err: any) {
              console.error('Error al generar secuencia:', err);
              if (rowRegenBtn) rowRegenBtn.disabled = false;
            } finally {
              if (rowRegenBtn) {
                rowRegenBtn.disabled = false;
                rowRegenBtn.innerHTML = `🔄 Regenerar`;
