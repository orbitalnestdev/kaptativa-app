          <div>
            <div style="font-weight: 600; font-size: 0.9rem; letter-spacing: -0.01em; color: white;">${r.nombre}</div>
            <div style="color: #8A8A9A; font-size: 0.775rem; margin-top: 2px;">${r.ciudad}</div>
          </div>
        `;
        nameCol.addEventListener('click', async () => {
