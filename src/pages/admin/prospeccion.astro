    // ==========================================================================
    // 4. DATA LOADER & RENDERER
    // ==========================================================================
    async function loadData() {
      try {
        const res = await api.db.listProspects();
        rows = res.documents || [];
        calculateStats();
        render();
      } catch (err) {
        console.error("Error al cargar prospectos:", err);
        listContainer.innerHTML = `
          <div style="padding: 40px; text-align: center; color: #ef4444; font-size: 0.9rem;">
            Error al conectar con la base de datos de prospectos.
          </div>
        `;
      }
    }

    function calculateStats() {
      const total = rows.length;
      const sinWeb = rows.filter(r => !r.web).length;
      // Use contactado_at timestamp as source of truth (more reliable than estado field)
      const contactados = rows.filter(r => r.contactado_at || ['contactado', 'respondio', 'reunion', 'cliente'].includes(r.estado)).length;
      const activos = rows.filter(r => !['descartado', 'cliente'].includes(r.estado)).length;

      document.getElementById('stat-total')!.innerText = total.toString();
      document.getElementById('stat-sinweb')!.innerText = sinWeb.toString();
      document.getElementById('stat-contactados')!.innerText = contactados.toString();
      document.getElementById('stat-activos')!.innerText = activos.toString();
    }

    // Priority score: higher = contact first
    function getPriorityScore(r: any) {
      const rubroL = (r.rubro || 'Inmobiliaria').toLowerCase();
      let score = 0;

      // Google rating (0-50 pts): higher rating = more established business = more budget
      score += Math.round((r.rating || 0) * 10);

      // Web presence (opportunity signal)
      if (!r.web) {
        // No web = clear opportunity to sell web dev
        score += rubroL === 'e-commerce' || rubroL === 'distribuidora' ? 50 : 38;
      } else {
        // Has web = can sell automation/AI (smaller gap but real client)
        score += 12;
      }

      // Instagram = active business with social audience
      if (r.instagram) {
        score += ['estética', 'gimnasio', 'gastronomía', 'e-commerce'].includes(rubroL) ? 22 : 12;
      }

      // Penalize already contacted (lower in queue)
      if (r.contactado_at || r.estado === 'contactado') score -= 20;

      // Discard = bottom
      if (r.estado === 'descartado') score -= 200;

      return score;
    }

    function render() {
      if (!listContainer) return;

      // Filter rows
      const filtered = rows.filter(r => {
        if (statusFilter !== 'todos' && r.estado !== statusFilter) return false;
        if (rubroFilter !== 'todos' && r.rubro !== rubroFilter) return false;
        if (onlyNoWeb && r.web) return false;
        if (onlyHasWeb && !r.web) return false;
        if (searchQuery) {
          const t = ((r.nombre || "") + " " + (r.ciudad || "") + " " + (r.rubro || "") + " " + (r.telefono || "") + " " + (r.instagram || "")).toLowerCase();
          if (!t.includes(searchQuery)) return false;
        }
        return true;
      });

      // Sort by Priority Score descending
      const sorted = [...filtered].sort((a, b) => {
        return getPriorityScore(b) - getPriorityScore(a);
      });

      if (sorted.length === 0) {
        listContainer.innerHTML = `
          <div class="admin-empty-state" style="border: none; margin: 20px;">
            <div class="admin-empty-icon">🎯</div>
            <h4 class="admin-empty-title">Sin prospectos encontrados</h4>
            <p class="admin-empty-desc">No se encontraron prospectos comerciales con los filtros o la búsqueda seleccionada.</p>
          </div>
        `;
        return;
      }


      listContainer.innerHTML = '';
      sorted.forEach((r, idx) => {
        const isOpen = expandedId === r.$id;
        const est = ESTADOS[r.estado] || ESTADOS.nuevo;
        const score = getPriorityScore(r);

        // Create main row wrapper
        const rowWrapper = document.createElement('div');
        rowWrapper.setAttribute('data-id', r.$id);
