        waQuickBtn.style.color = '#7BE08A';
        waQuickBtn.title = 'Abrir WhatsApp rápido';
        waQuickBtn.innerHTML = `💬`;
        waQuickBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          abrirWhatsApp(r);
        });
        actionsCol.appendChild(waQuickBtn);

        infoRow.appendChild(actionsCol);
        rowWrapper.appendChild(infoRow);

        // Expanded message editor panel
        if (isOpen) {
          const editorPanel = document.createElement('div');
          editorPanel.style.padding = '4px 18px 20px 44px';
          editorPanel.style.background = '#1A1A24';

          // 1. Details Section (View & Edit Mode)
