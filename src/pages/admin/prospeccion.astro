    function parseOutscraperCSV(text: string) {
      const lines = text.split(/\r?\n/);
      if (lines.length < 2) return [];

      // Auto-detect delimiter (, or ;)
      const firstLine = lines[0];
      const commas = (firstLine.match(/,/g) || []).length;
      const semicolons = (firstLine.match(/;/g) || []).length;
      const delimiter = semicolons > commas ? ';' : ',';

      const headers = parseCSVLine(lines[0], delimiter);
      const indexMap: Record<string, number> = {
        nombre: -1,
        telefono: -1,
        web: -1,
        rating: -1,
        ciudad: -1,
        rubro: -1,
        instagram: -1
      };

      headers.forEach((h, idx) => {
        const cleanHeader = h.toLowerCase().trim().replace(/["']/g, '');
        if (['name', 'business name', 'nombre', 'title', 'company'].includes(cleanHeader)) {
          indexMap.nombre = idx;
        } else if (['phone', 'telefono', 'international_phone_number', 'full_phone'].includes(cleanHeader)) {
          indexMap.telefono = idx;
        } else if (['site', 'website', 'web', 'homepage'].includes(cleanHeader)) {
          indexMap.web = idx;
        } else if (['rating', 'google_rating', 'puntuacion', 'stars'].includes(cleanHeader)) {
          indexMap.rating = idx;
        } else if (['city', 'ciudad', 'locality', 'municipality'].includes(cleanHeader)) {
          indexMap.ciudad = idx;
        } else if (['category', 'categories', 'subtypes', 'rubro', 'type', 'industry'].includes(cleanHeader)) {
          indexMap.rubro = idx;
        } else if (['instagram', 'ig', 'social_instagram', 'instagram_profile'].includes(cleanHeader)) {
          indexMap.instagram = idx;
        }
      });

      if (indexMap.nombre === -1) indexMap.nombre = 0;
      if (indexMap.telefono === -1) {
        headers.forEach((h, idx) => {
          if (h.toLowerCase().includes('phone') || h.toLowerCase().includes('tel')) {
            indexMap.telefono = idx;
          }
        });
      }

      const results: any[] = [];

      for (let i = 1; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) continue;

        const row = parseCSVLine(line, delimiter);
        if (row.length < headers.length) continue;

        const nombre = getCSVValue(row, indexMap.nombre);
        if (!nombre) continue;

        let telefono = getCSVValue(row, indexMap.telefono) || '';
        telefono = telefono.trim();

        let rubroRaw = getCSVValue(row, indexMap.rubro) || 'Inmobiliaria';
        let rubro = 'Inmobiliaria';
        const rubroLower = rubroRaw.toLowerCase();
        
        if (rubroLower.includes('gym') || rubroLower.includes('gimnasio') || rubroLower.includes('fitness') || rubroLower.includes('crossfit')) {
          rubro = 'Gimnasio';
        } else if (rubroLower.includes('contab') || rubroLower.includes('accountant') || rubroLower.includes('auditor') || rubroLower.includes('estudio')) {
          rubro = 'Estudio Contable';
        } else if (rubroLower.includes('e-commerce') || rubroLower.includes('shop') || rubroLower.includes('tienda') || rubroLower.includes('boutique') || rubroLower.includes('regalos')) {
          rubro = 'E-commerce';
        } else if (rubroLower.includes('clinic') || rubroLower.includes('medic') || rubroLower.includes('doctor') || rubroLower.includes('consultorio') || rubroLower.includes('salud')) {
          rubro = 'Centro Médico';
        } else if (rubroLower.includes('restaur') || rubroLower.includes('food') || rubroLower.includes('gastronom') || rubroLower.includes('burger') || rubroLower.includes('pizza') || rubroLower.includes('cafe')) {
          rubro = 'Gastronomía';
        } else if (rubroLower.includes('distribuid') || rubroLower.includes('wholesal') || rubroLower.includes('mayorist')) {
          rubro = 'Distribuidora';
        } else if (rubroLower.includes('estet') || rubroLower.includes('beauty') || rubroLower.includes('spa') || rubroLower.includes('peluquer') || rubroLower.includes('barber')) {
          rubro = 'Estética';
        }

        const rawRating = getCSVValue(row, indexMap.rating);
        const rating = parseFloat(rawRating) || 4.2;

        let instagram = getCSVValue(row, indexMap.instagram) || null;
        if (instagram) {
          instagram = instagram.trim().replace(/\/$/, "");
          if (instagram.includes('instagram.com/')) {
            const parts = instagram.split('instagram.com/');
            instagram = parts[parts.length - 1].split('?')[0];
          }
          instagram = instagram.replace(/^@/, "");
        }

        let web = getCSVValue(row, indexMap.web) || null;
        if (web) {
          web = web.trim().replace(/^(https?:\/\/)?(www\.)?/, "");
        }

        const ciudad = getCSVValue(row, indexMap.ciudad) || 'Rosario';

        results.push({
          nombre,
          ciudad,
          telefono,
          instagram,
          web,
          rating,
          rubro,
          fuente: 'outscraper_csv',
          estado: 'nuevo',
          contactado_at: null,
          mensaje: ''
        });
      }

      return results;
    }

    function getCSVValue(row: string[], index: number) {
      if (index === -1 || index >= row.length) return '';
      return row[index].replace(/^["']|["']$/g, '').trim();
    }

    function parseCSVLine(line: string, delimiter: string = ',') {
      const result: string[] = [];
      let current = '';
      let inQuotes = false;
      
      for (let i = 0; i < line.length; i++) {
        const char = line[i];
        if (char === '"') {
          inQuotes = !inQuotes;
        } else if (char === delimiter && !inQuotes) {
          result.push(current);
          current = '';
        } else {
          current += char;
        }
      }
      result.push(current);
      return result;
    }

    // ==========================================================================
    // 6. ADD PROSPECT MODAL HANDLERS
    // ==========================================================================
    if (addProspectBtn && addProspectModal) {
      addProspectBtn.addEventListener('click', () => {
        addProspectModal.style.display = 'flex';
        setTimeout(() => addProspectModal.classList.add('active'), 10);
      });
    }

    function closeAddModal() {
      if (addProspectModal) {
        addProspectModal.classList.remove('active');
        setTimeout(() => {
          addProspectModal.style.display = 'none';
        }, 250);
      }
      if (addProspectForm) {
        addProspectForm.reset();
      }
    }

    if (closeProspectModalBtn) closeProspectModalBtn.addEventListener('click', closeAddModal);
    if (cancelProspectBtn) cancelProspectBtn.addEventListener('click', closeAddModal);
    if (addProspectModal) {
      addProspectModal.addEventListener('click', (e) => {
        if (e.target === addProspectModal) closeAddModal();
      });
    }

    if (addProspectForm) {
      addProspectForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = addProspectForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `⌛ Procesando...`;

        const newProspect = {
          nombre: (document.getElementById('form-name') as HTMLInputElement).value.trim(),
          rubro: (document.getElementById('form-rubro') as HTMLSelectElement).value,
          ciudad: (document.getElementById('form-ciudad') as HTMLInputElement).value.trim(),
          telefono: (document.getElementById('form-telefono') as HTMLInputElement).value.trim(),
          rating: parseFloat((document.getElementById('form-rating') as HTMLInputElement).value) || 4.0,
          instagram: (document.getElementById('form-instagram') as HTMLInputElement).value.trim() || null,
          web: (document.getElementById('form-web') as HTMLInputElement).value.trim() || null,
          fuente: 'manual',
          estado: 'nuevo',
          contactado_at: null,
          mensaje: ''
        };

        // Call Claude server-side endpoint to generate message
        let initialMsg = '';
        try {
          const res = await fetch('/api/generate-message', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prospecto: newProspect, tono: 'informal' })
          });
          if (res.ok) {
            const data = await res.json();
            initialMsg = data.mensaje;
            newProspect.isMockMessage = data.isMock || false;
          }
        } catch (err) {
          console.error("Error al generar mensaje inicial:", err);
        }

        if (!initialMsg) {
          initialMsg = `¡Hola! Soy Diego de Kaptativa. Estuve viendo lo de ${newProspect.nombre} en ${newProspect.ciudad} y me pareció muy interesante. ¿Te va charlar unos minutos?`;
        }

        newProspect.mensaje = initialMsg;
        newProspect.estado = 'mensaje_generado';

        try {
          const saved = await api.db.createProspect(newProspect);
          rows.unshift(saved);
          calculateStats();
          closeAddModal();
          render();
        } catch (err) {
          console.error("Error al guardar prospecto:", err);
          alert("Error al guardar el prospecto en la base de datos.");
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      });
    }

    // ==========================================================================
    // 7. MANAGE RUBROS HANDLERS & INITIALIZATION
    // ==========================================================================
    function renderRubrosList() {
      if (!rubrosListContainer) return;
      rubrosListContainer.innerHTML = '';
      
      RUBROS.forEach(r => {
        const item = document.createElement('div');
        item.style.cssText = 'display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #0B0B11; border: 1px solid rgba(255,255,255,0.05); border-radius: 8px; margin-bottom: 6px;';
        item.innerHTML = `
          <div style="display: flex; gap: 8px; align-items: center; font-size: 0.9rem;">
            <span style="font-size: 1.1rem;">${r.emoji}</span>
            <span style="color: white; font-weight: 500;">${r.name}</span>
          </div>
          <button type="button" class="btn-delete-rubro" style="background: transparent; border: none; color: #FF8C7A; cursor: pointer; font-size: 0.9rem; padding: 4px;" title="Eliminar rubro">🗑️</button>
        `;
        
        item.querySelector('.btn-delete-rubro')!.addEventListener('click', (e) => {
          e.stopPropagation();
          if (confirm(`¿Estás seguro de que deseas eliminar el rubro "${r.name}"? Los prospectos existentes seguirán cargados pero no podrás seleccionarlo en nuevos registros.`)) {
            RUBROS = RUBROS.filter(item => item.name !== r.name);
            localStorage.setItem('mock_rubros', JSON.stringify(RUBROS));
            loadRubros();
            populateRubroSelects();
            renderRubrosList();
            render();
          }
        });
        
        rubrosListContainer.appendChild(item);
      });
    }

    if (manageRubrosBtn && manageRubrosModal) {
      manageRubrosBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        renderRubrosList();
        manageRubrosModal.style.display = 'flex';
        setTimeout(() => manageRubrosModal.classList.add('active'), 10);
      });
    }

    function closeRubrosModal() {
      if (manageRubrosModal) {
        manageRubrosModal.classList.remove('active');
        setTimeout(() => {
          manageRubrosModal.style.display = 'none';
        }, 250);
      }
    }

    if (closeRubrosModalBtn) closeRubrosModalBtn.addEventListener('click', closeRubrosModal);
    if (manageRubrosModal) {
      manageRubrosModal.addEventListener('click', (e) => {
        if (e.target === manageRubrosModal) closeRubrosModal();
      });
    }

    if (addRubroForm) {
      addRubroForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const emojiInput = document.getElementById('new-rubro-emoji') as HTMLInputElement;
        const nameInput = document.getElementById('new-rubro-name') as HTMLInputElement;
        
        const emoji = emojiInput.value.trim();
        const name = nameInput.value.trim();
        
        if (!emoji || !name) return;
        
        if (RUBROS.some(r => r.name.toLowerCase() === name.toLowerCase())) {
          alert("Este rubro ya existe.");
          return;
        }
        
        RUBROS.push({ name, emoji });
        localStorage.setItem('mock_rubros', JSON.stringify(RUBROS));
        
        emojiInput.value = '';
        nameInput.value = '';
        
        loadRubros();
        populateRubroSelects();
        renderRubrosList();
        render();
      });
    }

    // Populate rubros selects on init
    populateRubroSelects();

    // Run Load
    await loadData();
  });
</script>
