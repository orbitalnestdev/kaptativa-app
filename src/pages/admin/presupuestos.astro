---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';

// SSR Authentication Guard
const sessionCookie = Astro.cookies.get('kaptativa_session');
if (!sessionCookie) {
  return Astro.redirect('/admin/login');
}
---

<AdminLayout title="Generador de Presupuestos | Kaptativa">
  <div class="admin-wrapper" id="admin-main-view">
    
    <!-- SIDEBAR NAVIGATION -->
    <AdminSidebar activeTab="presupuestos" />

    <!-- MAIN CONTENT AREA -->
    <main class="admin-content-area">
      <!-- HEADER -->
      <header class="admin-header">
        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 15px;">
          <div>
            <h1 class="admin-page-title" style="margin: 0; font-size: 1.6rem; font-weight: 600; color: white; font-family: 'Space Grotesk', sans-serif;">Presupuestos y Finanzas</h1>
          </div>
          <button class="btn btn-primary" id="btn-new-budget" style="padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 0.9rem; display: flex; gap: 8px; align-items: center; cursor: pointer;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Nuevo Presupuesto
          </button>
        </div>
      </header>

      <!-- MODAL BACKDROP CONTAINER -->
      <div id="budget-modal" class="admin-modal-backdrop">
        <div class="admin-modal admin-modal-lg" style="position: relative; padding: 35px;">
          <!-- Close button -->
          <button type="button" id="btn-close-modal" class="admin-modal-close">✕</button>
          
          <h2 id="modal-budget-title" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; color: white; margin-bottom: 20px; font-weight: 600;">Crear Presupuesto Comercial</h2>
          
          <!-- CREATE VIEW SECTION -->
          <section id="budget-create-section">

        <!-- AI BUDGET GENERATOR PANEL -->
        <div id="ai-budget-panel" style="background: linear-gradient(135deg, rgba(183,166,255,0.06), rgba(6,182,212,0.04)); border: 1px solid rgba(183,166,255,0.2); border-radius: 12px; padding: 20px; margin-bottom: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <div>
              <div style="font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: #B7A6FF; font-weight: 600; font-family: 'Space Grotesk', sans-serif; margin-bottom: 3px;">Generación Inteligente</div>
              <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 600; color: white; margin: 0;">Describí el proyecto y la IA arma el presupuesto</h3>
            </div>
            <button type="button" id="btn-toggle-ai-panel" style="background: transparent; border: none; color: #5A5A68; cursor: pointer; font-size: 0.75rem; white-space: nowrap;">Ocultar ▲</button>
          </div>
          <div id="ai-panel-body">
            <textarea id="ai-project-description" rows="3" placeholder="Ej: Sitio web para restaurante con carta digital, sistema de reservas online y bot de WhatsApp para tomar pedidos. Cliente en Córdoba." style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 12px; color: #ECECF2; font-size: 0.875rem; line-height: 1.5; resize: vertical; font-family: 'Inter', sans-serif; box-sizing: border-box;"></textarea>
            <div style="display: flex; gap: 10px; margin-top: 10px; align-items: center; flex-wrap: wrap;">
              <button type="button" id="btn-ai-generate-budget" style="background: linear-gradient(135deg, #B7A6FF, #EA384D); border: none; color: #0B0B11; padding: 10px 22px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; cursor: pointer; font-family: 'Space Grotesk', sans-serif; transition: opacity 0.2s;">
                Generar presupuesto
              </button>
              <span id="ai-budget-status" style="font-size: 0.78rem; color: #5A5A68;"></span>
            </div>
            <div id="ai-budget-result" style="display: none; margin-top: 14px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 14px;">
              <div id="ai-result-explanation" style="font-size: 0.8rem; color: #B7A6FF; margin-bottom: 10px;"></div>
              <div id="ai-result-summary" style="font-size: 0.82rem; color: #ECECF2; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;"></div>
              <button type="button" id="btn-ai-apply" style="background: rgba(183,166,255,0.15); border: 1px solid rgba(183,166,255,0.3); color: #B7A6FF; padding: 8px 18px; border-radius: 6px; font-weight: 600; font-size: 0.8rem; cursor: pointer; font-family: 'Space Grotesk', sans-serif;">
                Aplicar al formulario
              </button>
            </div>
          </div>
        </div>

        <form id="budget-generator-form">
          <!-- CONTENT GRID -->
          <div class="budget-panel-grid">

            <!-- LEFT: FORM AND ITEMS -->
            <div class="form-card-container" style="flex: 1.3; display: flex; flex-direction: column; gap: 20px;">

              <!-- Wizard Steps Tabs -->
              <div class="budget-modal-tabs">
                <button type="button" class="budget-modal-tab-link active" data-budget-step="step-client-service">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle; margin-right: 4px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> 1. Cliente & Servicio
                </button>
                <button type="button" class="budget-modal-tab-link" data-budget-step="step-modules-custom">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle; margin-right: 4px;"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg> 2. Módulos & Adicionales
                </button>
                <button type="button" class="budget-modal-tab-link" data-budget-step="step-terms-notes">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle; margin-right: 4px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg> 3. Alcance & Notas
                </button>
              </div>

              <!-- STEP 1: CLIENT & SERVICE -->
              <div class="budget-step-content active" id="step-client-service" style="display: flex; flex-direction: column; gap: 20px;">
                <!-- 1. Datos del Cliente -->
                <h3 class="section-title-custom" style="margin-top: 0;">1. Datos del Cliente</h3>
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="client-name" class="form-label">Nombre del Cliente / Representante *</label>
                    <input type="text" id="client-name" class="form-control" placeholder="Ej. Carlos Valenzuela" required>
                  </div>
                  <div class="form-group">
                    <label for="client-business" class="form-label">Empresa / Negocio *</label>
                    <input type="text" id="client-business" class="form-control" placeholder="Ej. Sabor & Fuego" required>
                  </div>
                </div>
                
                <div class="form-grid-2" style="margin-top: 10px;">
                  <div class="form-group">
                    <label for="client-whatsapp" class="form-label">WhatsApp (con código de país)</label>
                    <input type="text" id="client-whatsapp" class="form-control" placeholder="Ej. 5491133334444">
                  </div>
                  <div class="form-group">
                    <label for="client-email" class="form-label">Correo Electrónico *</label>
                    <input type="email" id="client-email" class="form-control" placeholder="Ej. carlos@saboryfuego.com" required>
                  </div>
                </div>

                <!-- 2. Service Templates Grid -->
                <h3 class="section-title-custom" style="margin-top: 20px;">2. Plantilla de Servicio</h3>
                <p style="font-size: 0.775rem; color: var(--text-muted); margin-bottom: 5px; margin-top: -8px;">Selecciona el servicio principal. Los precios base se cargan desde la configuración general.</p>
                <div class="service-templates-grid" id="service-templates-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px;">
                  <div style="grid-column: 1 / -1; text-align: center; padding: 20px; color: var(--text-muted);">Cargando plantillas de servicio...</div>
                </div>

                <!-- 3. Features -->
                <div class="form-group" style="margin-top: 10px;">
                  <label for="quote-features" class="form-label">Características Incluidas (Editable)</label>
                  <textarea id="quote-features" class="form-control" style="min-height: 100px; font-family: inherit; font-size: 0.85rem;" placeholder="Lista de características del servicio seleccionado..."></textarea>
                  <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 5px; margin-bottom: 0;">* Separa cada característica con un salto de línea (Enter). Se imprimirán como viñetas en el PDF.</p>
                </div>
                
                <div style="display: flex; justify-content: flex-end; margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 15px;">
                  <button type="button" class="btn btn-primary btn-next-step" data-next-step="step-modules-custom" style="padding: 10px 22px;">Siguiente Paso ➔</button>
                </div>
              </div>

              <!-- STEP 2: MODULES & CUSTOM CONCEPTS -->
              <div class="budget-step-content" id="step-modules-custom" style="display: none; flex-direction: column; gap: 20px;">
                <!-- 4. Modular Blocks -->
                <h3 class="section-title-custom" style="margin-top: 0;">3. Módulos Adicionales (Opcionales)</h3>
                <p style="font-size: 0.775rem; color: var(--text-muted); margin-bottom: 5px; margin-top: -8px;">Selecciona funcionalidades adicionales para agregar al alcance del proyecto.</p>
                <div class="modular-blocks-grid" id="modular-blocks-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
                  <div style="grid-column: 1 / -1; text-align: center; padding: 20px; color: var(--text-muted);">Cargando módulos adicionales...</div>
                </div>

                <!-- 5. Manual Custom Items -->
                <h3 class="section-title-custom" style="margin-top: 20px;">4. Conceptos Personalizados</h3>
                <p style="font-size: 0.775rem; color: var(--text-muted); margin-bottom: 5px; margin-top: -8px;">Añade conceptos manuales con facturación fija o por hora (se calculan automáticamente).</p>
                <div class="table-scroll-wrapper" style="margin-bottom: 10px;">
                  <table class="budget-items-table">
                    <thead>
                       <tr>
                         <th>Descripción del Concepto Personalizado</th>
                         <th style="width: 130px;">Tipo de Cobro</th>
                         <th style="width: 170px;">Costo / Horas</th>
                         <th style="width: 40px;"></th>
                       </tr>
                    </thead>
                    <tbody id="custom-items-body">
                      <!-- Dinamic custom items rows -->
                    </tbody>
                  </table>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" id="btn-add-custom-concept" style="border-style: dashed; justify-content: center; width: 100%; border-color: rgba(255,255,255,0.15);">
                  ➕ Añadir Concepto Personalizado
                </button>
                
                <div style="display: flex; justify-content: space-between; margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 15px;">
                  <button type="button" class="btn btn-secondary btn-prev-step" data-prev-step="step-client-service" style="padding: 10px 22px;">⬅ Atrás</button>
                  <button type="button" class="btn btn-primary btn-next-step" data-next-step="step-terms-notes" style="padding: 10px 22px;">Siguiente Paso ➔</button>
                </div>
              </div>

              <!-- STEP 3: CONDITIONS & NOTES -->
              <div class="budget-step-content" id="step-terms-notes" style="display: none; flex-direction: column; gap: 20px;">
                <!-- 6. Validity & Notes -->
                <h3 class="section-title-custom" style="margin-top: 0;">5. Alcance & Condiciones</h3>
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="quote-validity" class="form-label">Validez de Propuesta (días)</label>
                    <input type="number" id="quote-validity" class="form-control" placeholder="15" value="15" required>
                  </div>
                  <div class="form-group">
                    <label class="form-label" style="opacity: 0.5;">Información</label>
                    <div style="font-size: 0.775rem; color: var(--text-muted); line-height: 1.4; padding: 10px; background: rgba(255,255,255,0.01); border-radius: 6px; border: 1px solid var(--border-color);">
                      El presupuesto incluirá firmas del prestador y términos según la configuración comercial.
                    </div>
                  </div>
                </div>

                <div class="form-group" style="margin-top: 10px;">
                  <label for="quote-notes" class="form-label">Notas o Observaciones Técnicas (Opcional)</label>
                  <textarea id="quote-notes" class="form-control" style="min-height: 80px;" placeholder="Ej. El abono incluye backups diarios automáticos y soporte prioritario 24/7..."></textarea>
                </div>

                <!-- ACTION BUTTONS -->
                <div style="margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 20px; display: flex; gap: 15px;">
                  <button type="submit" class="btn btn-primary" style="padding: 12px 28px; display: flex; gap: 10px; align-items: center; justify-content: center; flex: 1;">
                    📄 Guardar y Generar PDF
                  </button>
                  <button type="button" class="btn btn-secondary" id="btn-clear-budget" style="border-color: #ef4444; color: #ef4444; background: rgba(239, 68, 68, 0.05); padding: 12px 20px;">
                    Vaciar Formulario
                  </button>
                </div>
                <div id="pdf-feedback" class="login-feedback" style="margin-top: 15px;"></div>
                
                <div style="display: flex; justify-content: flex-start; margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 15px;">
                  <button type="button" class="btn btn-secondary btn-prev-step" data-prev-step="step-modules-custom" style="padding: 10px 22px;">⬅ Atrás</button>
                </div>
              </div>
            </div>

            <!-- RIGHT: FINANCIAL SIDEBAR & LIVE PREVIEW -->
            <div class="sidebar-card-container" style="flex: 1; min-width: 320px; display: flex; flex-direction: column; gap: 25px;">
              
              <!-- FINANCIAL ADJUSTMENTS -->
              <div class="form-card-container" style="padding: 20px;">
                <h3 class="section-title-custom" style="margin-top: 0; font-size: 1rem; margin-bottom: 15px;">Ajustes Financieros</h3>
                
                <!-- Moneda y Tipo de Cambio -->
                <div class="form-grid-2" style="margin-bottom: 15px;">
                  <div class="form-group">
                    <label for="quote-currency" class="form-label">Moneda</label>
                    <select id="quote-currency" class="form-control" style="padding: 8px 12px; font-size: 0.85rem;">
                      <option value="USD">USD ($)</option>
                      <option value="ARS">ARS ($)</option>
                    </select>
                  </div>
                  <div class="form-group" id="exchange-rate-group" style="display: none;">
                    <label for="quote-exchange-rate" class="form-label">Tipo Cambio (ARS)</label>
                    <input type="number" id="quote-exchange-rate" class="form-control" placeholder="1000" value="1000" style="padding: 8px 12px; font-size: 0.85rem;">
                  </div>
                </div>

                <!-- Facilidades ARS -->
                <div id="ars-facilities-group" style="display: none; background: rgba(6, 182, 212, 0.03); border: 1.5px solid rgba(6, 182, 212, 0.1); border-radius: 6px; padding: 12px; margin-bottom: 15px;">
                  <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                    <input type="checkbox" id="chk-installment" style="cursor: pointer; width: 15px; height: 15px;" checked>
                    <label for="chk-installment" style="font-size: 0.775rem; color: var(--text-primary); cursor: pointer;">3 Cuotas sin Interés (MP)</label>
                  </div>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <input type="checkbox" id="chk-transfer-discount" style="cursor: pointer; width: 15px; height: 15px;" checked>
                    <label for="chk-transfer-discount" style="font-size: 0.775rem; color: var(--text-primary); cursor: pointer;">15% Desc. Transferencia</label>
                  </div>
                </div>

                <!-- Urgencia Slider -->
                <div class="form-group" style="margin-bottom: 15px;">
                  <label for="quote-urgency" class="form-label">Urgencia / Prioridad: <span id="urgency-percentage-val" style="color: var(--accent-indigo); font-weight: 600;">+0%</span></label>
                  <input type="range" id="quote-urgency" min="0" max="50" step="5" value="0" style="width: 100%; accent-color: var(--accent-indigo); cursor: pointer;">
                  <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-muted); margin-top: 2px;">
                    <span>Normal (Estándar)</span>
                    <span>Urgente (+50%)</span>
                  </div>
                </div>

                <!-- Descuento y SLA -->
                <div class="form-grid-2">
                  <div class="form-group">
                    <label for="quote-discount-usd" class="form-label">Descuento (USD)</label>
                    <input type="number" id="quote-discount-usd" class="form-control" placeholder="0" value="0" style="padding: 8px 12px; font-size: 0.85rem;">
                  </div>
                  <div class="form-group">
                    <label for="quote-maintenance-usd" class="form-label">Mantenimiento SLA (USD/Mes)</label>
                    <input type="number" id="quote-maintenance-usd" class="form-control" placeholder="0" value="0" style="padding: 8px 12px; font-size: 0.85rem;">
                  </div>
                </div>
              </div>

              <!-- SMART UPSELL (IA) -->
              <div class="form-card-container upsell-suggestion-card" id="upsell-card" style="padding: 20px; border: 1.5px dashed var(--accent-indigo); background: rgba(124, 58, 237, 0.03); display: none; border-radius: 8px;">
                <div style="display: flex; gap: 10px; align-items: flex-start;">
                  <div style="font-size: 1.3rem;">💡</div>
                  <div>
                    <h4 style="margin: 0 0 5px 0; font-size: 0.825rem; font-weight: 600; color: white; text-transform: uppercase; letter-spacing: 0.5px;">Sugerencia IA</h4>
                    <p id="upsell-text" style="margin: 0; font-size: 0.775rem; color: var(--text-secondary); line-height: 1.4;"></p>
                  </div>
                </div>
              </div>

              <!-- AGENCY PERFORMANCE METRICS -->
              <div class="form-card-container" style="padding: 20px; background: linear-gradient(135deg, rgba(15,23,42,0.6) 0%, rgba(30,41,59,0.6) 100%);">
                <h3 class="section-title-custom" style="margin-top: 0; font-size: 1rem; margin-bottom: 15px;">Métricas de Rentabilidad</h3>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 8px;">
                    <span style="font-size: 0.8rem; color: var(--text-muted);">Horas de Desarrollo Est.</span>
                    <span id="metric-dev-hours" style="font-size: 0.85rem; font-weight: 600; color: white;">0 hs</span>
                  </div>
                  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.03); padding-bottom: 8px;">
                    <span style="font-size: 0.8rem; color: var(--text-muted);">Valor Contrato (12 meses LTV)</span>
                    <span id="metric-ltv" style="font-size: 0.85rem; font-weight: 600; color: var(--accent-crimson);">US$ 0</span>
                  </div>
                  <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 4px;">
                    <span style="font-size: 0.8rem; color: var(--text-muted);">Margen de Ganancia Neto Est.</span>
                    <span id="metric-profit" style="font-size: 0.85rem; font-weight: 600; color: #10B981;">US$ 0</span>
                  </div>
                  <!-- Margin Progress bar -->
                  <div style="height: 6px; width: 100%; background: rgba(255,255,255,0.05); border-radius: 3px; overflow: hidden; margin-top: -4px;">
                    <div id="metric-profit-progress" style="height: 100%; width: 0%; background: linear-gradient(90deg, #10B981, #059669); border-radius: 3px; transition: width 0.3s ease;"></div>
                  </div>
                </div>
              </div>

              <!-- LIVE PREVIEW BOX -->
              <div class="form-card-container" style="padding: 20px; display: flex; flex-direction: column;">
                <h3 class="section-title-custom" style="margin-top: 0; font-size: 1rem; margin-bottom: 15px;">Vista Previa en Vivo</h3>
                <div class="live-preview-box" style="padding: 20px; min-height: auto; background-color: #0b0f19; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 6px;">
                  <div class="preview-brand-header" style="margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); display: flex; justify-content: space-between; align-items: center;">
                    <span class="preview-logo-text" style="font-weight: 600; font-size: 1rem; background: linear-gradient(135deg, #ffffff, #EA384D); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">KAPTATIVA</span>
                    <span class="preview-quote-title" style="font-size: 0.7rem; color: var(--accent-indigo); font-weight: 600; text-transform: uppercase;">Propuesta</span>
                  </div>
                  <div class="preview-client-block" style="padding: 10px; margin-bottom: 12px; font-size: 0.75rem; background-color: rgba(255, 255, 255, 0.01); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 4px;">
                    <p style="margin: 0 0 4px 0; color: var(--text-secondary);"><strong>Cliente:</strong> <span id="prev-client">Negocio Cliente</span></p>
                    <p style="margin: 0; color: var(--text-secondary);"><strong>Contacto:</strong> <span id="prev-contact">Contacto Representante</span></p>
                  </div>
                  <div class="preview-items-list" id="preview-items-container" style="gap: 5px; margin-bottom: 12px; display: flex; flex-direction: column;">
                    <!-- Dynamically populated preview rows -->
                  </div>
                  <div class="preview-totals-block" style="padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.06);">
                    <div class="totals-row" style="font-size: 0.75rem; margin-bottom: 4px; display: flex; justify-content: space-between; color: var(--text-secondary);">
                      <span>Subtotal Setup:</span>
                      <span id="prev-subtotal">$0.00</span>
                    </div>
                    <div class="totals-row" id="prev-urgency-row" style="display: none; color: var(--accent-indigo); font-size: 0.75rem; margin-bottom: 4px; justify-content: space-between;">
                      <span>Prioridad (<span id="prev-urgency-pct">0</span>%):</span>
                      <span id="prev-urgency-val">+$0.00</span>
                    </div>
                    <div class="totals-row" id="prev-discount-row" style="display: none; color: #ef4444; font-size: 0.75rem; margin-bottom: 4px; justify-content: space-between;">
                      <span>Descuento:</span>
                      <span id="prev-discount-val">-$0.00</span>
                    </div>
