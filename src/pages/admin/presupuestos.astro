    // ==========================================================================
    // 10.1 WIZARD STEP SWITCHER (BUDGET MODAL)
    // ==========================================================================
    const stepLinks = document.querySelectorAll('.budget-modal-tab-link');
    const stepContents = document.querySelectorAll('.budget-step-content');
    
    function showStep(stepId: string) {
      stepLinks.forEach(link => {
        if (link.getAttribute('data-budget-step') === stepId) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
      
      stepContents.forEach(content => {
        if (content.id === stepId) {
          content.classList.add('active');
        } else {
          content.classList.remove('active');
        }
      });
    }

    stepLinks.forEach(link => {
      link.addEventListener('click', () => {
        const stepId = link.getAttribute('data-budget-step');
        if (stepId) showStep(stepId);
      });
    });

    // Next / Prev step buttons inside wizard
    document.querySelectorAll('.btn-next-step').forEach(btn => {
      btn.addEventListener('click', () => {
        const currentStep = btn.closest('.budget-step-content');
        if (currentStep) {
          const requiredFields = currentStep.querySelectorAll('[required]') as NodeListOf<HTMLInputElement | HTMLSelectElement>;
          let allValid = true;
          requiredFields.forEach(field => {
            if (!field.value.trim() || (field.type === 'email' && !field.value.includes('@'))) {
              field.reportValidity();
              allValid = false;
            }
          });
          if (!allValid) return;
        }

        const nextStepId = btn.getAttribute('data-next-step');
        if (nextStepId) showStep(nextStepId);
      });
    });

    document.querySelectorAll('.btn-prev-step').forEach(btn => {
      btn.addEventListener('click', () => {
