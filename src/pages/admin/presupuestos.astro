  /* Chrome/Safari/Firefox scrollbars & inputs */
  input[type=number]::-webkit-inner-spin-button, 
  input[type=number]::-webkit-outer-spin-button { 
    -webkit-appearance: none; 
    margin: 0; 
  }
  input[type=number] {
    -moz-appearance: textfield;
  }

  /* Toast Notification Container */
  .toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 9999;
    pointer-events: none;
  }

  /* Toast Notification */
  .toast-notification {
    background: rgba(18, 18, 24, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    padding: 14px 20px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-family: 'Lexend', sans-serif;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 280px;
    max-width: 400px;
    pointer-events: auto;
    animation: toast-fade-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .toast-notification.success {
    border-left: 4px solid var(--accent-crimson);
  }

  .toast-notification.error {
    border-left: 4px solid #ef4444;
  }

  .toast-notification.info {
    border-left: 4px solid var(--accent-indigo);
  }

  .toast-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .toast-content {
    flex-grow: 1;
    line-height: 1.4;
  }

  .toast-close {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .toast-close:hover {
    color: var(--text-primary);
  }

  @keyframes toast-fade-in {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  import { api } from '../../lib/appwrite.js';

  document.addEventListener('DOMContentLoaded', async () => {
    
    // ==========================================================================
    // 2. LOAD AGENCY SETTINGS & BASE COST PRESETS
    // ==========================================================================
    let costWeb = 600;
    let costAuto = 500;
    let costIa = 800;
    let costSistema = 1500;
    let agencyPhone = '+54 9 11 1234-5678';
    let agencyEmail = 'contacto@kaptativa.com';

    let defaultDollarRate = 1000;
    function loadSettings() {
      const saved = localStorage.getItem('crm_settings');
      if (saved) {
        const settings = JSON.parse(saved);
        costWeb = parseInt(settings.cost_web) || 600;
        costAuto = parseInt(settings.cost_auto) || 500;
        costIa = parseInt(settings.cost_ia) || 800;
        costSistema = parseInt(settings.cost_sistema) || 1500;
        agencyEmail = settings.support_email || 'contacto@kaptativa.com';
        defaultDollarRate = parseFloat(settings.dollar_rate) || 1000;
        
        const rawPhone = settings.whatsapp_phone || '5491112345678';
        agencyPhone = `+${rawPhone.slice(0, 2)} ${rawPhone.slice(2, 3)} ${rawPhone.slice(3, 5)} ${rawPhone.slice(5, 9)}-${rawPhone.slice(9)}`;
      }
      
      const exInput = document.getElementById('quote-exchange-rate') as HTMLInputElement;
      if (exInput) {
        exInput.value = defaultDollarRate.toString();
      }
      
      // Update template labels in UI
      if (Array.isArray(availableTemplates)) {
        availableTemplates.forEach(t => {
          if (t.$id === 'web') t.basePrice = costWeb;
          else if (t.$id === 'auto') t.basePrice = costAuto;
          else if (t.$id === 'ia') t.basePrice = costIa;
          else if (t.$id === 'sistema') t.basePrice = costSistema;
          
          const lbl = document.getElementById(`price-lbl-${t.$id}`);
          if (lbl) lbl.innerText = `Desde $${t.basePrice} USD`;
        });
      }

      // Update PDF details
      const emailEl = document.getElementById('pdf-agency-email');
      const phoneEl = document.getElementById('pdf-agency-phone');
      if (emailEl) emailEl.innerText = agencyEmail;
      if (phoneEl) phoneEl.innerText = agencyPhone;
    }

    // ==========================================================================
    // 3. BUILDER VARIABLES & DOM ELEMENTS
    // ==========================================================================
    const clientNameInput = document.getElementById('client-name') as HTMLInputElement;
    const clientBusinessInput = document.getElementById('client-business') as HTMLInputElement;
    const clientEmailInput = document.getElementById('client-email') as HTMLInputElement;
    const clientWhatsappInput = document.getElementById('client-whatsapp') as HTMLInputElement;
    const quoteValidityInput = document.getElementById('quote-validity') as HTMLInputElement;
    const quoteNotesInput = document.getElementById('quote-notes') as HTMLTextAreaElement;
    const quoteFeaturesInput = document.getElementById('quote-features') as HTMLTextAreaElement;

    // Sidebar inputs
    const currencySelect = document.getElementById('quote-currency') as HTMLSelectElement;
    const exchangeRateGroup = document.getElementById('exchange-rate-group') as HTMLElement;
    const exchangeRateInput = document.getElementById('quote-exchange-rate') as HTMLInputElement;
    const arsFacilitiesGroup = document.getElementById('ars-facilities-group') as HTMLElement;
    const chkInstallment = document.getElementById('chk-installment') as HTMLInputElement;
    const chkTransferDiscount = document.getElementById('chk-transfer-discount') as HTMLInputElement;
    const urgencySlider = document.getElementById('quote-urgency') as HTMLInputElement;
    const urgencyLabel = document.getElementById('urgency-percentage-val') as HTMLElement;
    const discountInput = document.getElementById('quote-discount-usd') as HTMLInputElement;
    const maintenanceInput = document.getElementById('quote-maintenance-usd') as HTMLInputElement;

    // Suggestion and metrics
    const upsellCard = document.getElementById('upsell-card') as HTMLElement;
    const upsellText = document.getElementById('upsell-text') as HTMLElement;
    const metricDevHours = document.getElementById('metric-dev-hours') as HTMLElement;
    const metricLtv = document.getElementById('metric-ltv') as HTMLElement;
    const metricProfit = document.getElementById('metric-profit') as HTMLElement;
    const metricProfitProgress = document.getElementById('metric-profit-progress') as HTMLElement;

    // Builder state
    let selectedTemplate = ''; // 'web' | 'auto' | 'ia' | 'sistema'
    let templateBasePrice = 0;
    let customItemsList: Array<{ id: string; label: string; billingType: 'flat' | 'hourly'; price: number; hours: number; hourlyRate: number }> = [];

    // Helper to format values dynamically based on selected currency
    function formatVal(value: number, isArs: boolean, rate: number) {
      const converted = isArs ? value * rate : value;
      if (isArs) {
        return `$ ${Math.round(converted).toLocaleString('es-AR')}`;
      }
      return `US$ ${Math.round(converted).toLocaleString('en-US')}`;
    }

    // Dynamic templates and blocks lists
    let availableTemplates: any[] = [];
    let availableBlocks: any[] = [];

    const fallbackTemplates = [
      {
        $id: 'web',
        label: 'Diseño Web',
        basePrice: costWeb,
        icon: '🌐',
        features: [
          'Diseño responsivo y adaptado a móviles',
          'Optimización SEO básica on-page',
          'Integración de formularios de contacto',
          'Certificado SSL bonificado de seguridad'
        ],
        desc: 'Sitio web corporativo o Landing Page profesional'
      },
      {
        $id: 'auto',
        label: 'Automatización',
        basePrice: costAuto,
        icon: '⚡',
        features: [
          'Mapeo conceptual de procesos inicial',
          'Integración modular en Make o n8n',
          'Sincronización con bases de datos Cloud',
          'Notificaciones autónomas en WhatsApp/Slack'
        ],
        desc: 'Automatización de procesos repetitivos y sincronizaciones'
      },
      {
        $id: 'ia',
        label: 'Agente IA',
        basePrice: costIa,
        icon: '🤖',
        features: [
          'Entrenamiento con base de conocimientos de negocio',
          'Conectores de WhatsApp y Webchat integrados',
          'Procesamiento de Lenguaje Natural avanzado',
          'Derivación a agentes humanos inteligente'
        ],
        desc: 'Agentes y chatbots inteligentes entrenados a medida'
      },
      {
        $id: 'sistema',
        label: 'Sistema Completo',
        basePrice: costSistema,
        icon: '🛡️',
        features: [
          'Diseño de interfaz a medida (Figma & UX)',
          'Backend robusto con bases de datos estructuradas',
          'Dashboard interno de métricas en tiempo real',
          'Seguridad y encriptado de nivel empresarial'
        ],
        desc: 'Aplicaciones a medida y plataformas web complejas'
      }
    ];

    const fallbackBlocks = [
      { $id: 'block-uiux', label: 'Diseño UI/UX a Medida', price: 200, category: 'Diseño' },
      { $id: 'block-api', label: 'Integración de API Externa', price: 300, category: 'Desarrollo' },
      { $id: 'block-admin', label: 'Panel de Administración', price: 400, category: 'Backoffice' },
      { $id: 'block-lang', label: 'Soporte Multi-idioma', price: 150, category: 'Desarrollo' },
      { $id: 'block-speed', label: 'WPO (Optimización SEO/Speed)', price: 150, category: 'Optimización' },
      { $id: 'block-db', label: 'Base de Datos Cloud', price: 250, category: 'Infraestructura' },
      { $id: 'block-crm', label: 'Integración CRM', price: 300, category: 'Automatización' },
      { $id: 'block-vps', label: 'Servidor VPS Dedicado', price: 350, category: 'Infraestructura' }
    ];

    async function loadTemplatesAndBlocks() {
      const templatesContainer = document.getElementById('service-templates-container');
      const blocksContainer = document.getElementById('modular-blocks-container');

      try {
        const templatesRes = await api.db.listServiceTemplates();
        availableTemplates = templatesRes.documents || [];
      } catch (err) {
        console.error('Error fetching templates:', err);
      }

      if (availableTemplates.length === 0) {
        availableTemplates = JSON.parse(JSON.stringify(fallbackTemplates));
      }

      try {
        const blocksRes = await api.db.listModularBlocks();
        availableBlocks = blocksRes.documents || [];
      } catch (err) {
        console.error('Error fetching blocks:', err);
      }

      if (availableBlocks.length === 0) {
        availableBlocks = JSON.parse(JSON.stringify(fallbackBlocks));
      }

      // Apply settings overrides if any
      availableTemplates.forEach(t => {
        if (t.$id === 'web') t.basePrice = costWeb;
        else if (t.$id === 'auto') t.basePrice = costAuto;
        else if (t.$id === 'ia') t.basePrice = costIa;
        else if (t.$id === 'sistema') t.basePrice = costSistema;
      });

      // Render templates
      if (templatesContainer) {
        templatesContainer.innerHTML = '';
        availableTemplates.forEach(template => {
          const card = document.createElement('div');
          card.className = 'service-template-card';
          card.setAttribute('data-template', template.$id);
          card.style.cssText = 'cursor: pointer; padding: 20px; border-radius: 8px; border: 1.5px solid var(--border-color); background: rgba(255,255,255,0.01); text-align: center; transition: all 0.3s ease;';
          card.innerHTML = `
            <div style="font-size: 2rem; margin-bottom: 8px;">${template.icon || '🌐'}</div>
            <div style="font-weight: 600; color: white;">${template.label}</div>
            <div class="template-price-label" id="price-lbl-${template.$id}" style="font-size: 0.8rem; color: var(--text-muted); margin-top: 5px;">Desde $${template.basePrice} USD</div>
          `;
          
          card.addEventListener('click', () => {
            document.querySelectorAll('.service-template-card').forEach(c => c.classList.remove('active-template-card'));
            
            if (selectedTemplate === template.$id) {
              // Deselect
              selectedTemplate = '';
              templateBasePrice = 0;
              quoteFeaturesInput.value = '';
            } else {
              // Select
              selectedTemplate = template.$id;
              card.classList.add('active-template-card');
              templateBasePrice = template.basePrice;
              
              const features = Array.isArray(template.features) 
                ? template.features 
                : (template.features || '').split('\n').filter((f: string) => f.trim() !== '');
              quoteFeaturesInput.value = features.join('\n');
            }
            updateCalculations();
          });

          templatesContainer.appendChild(card);
        });
      }

      // Render blocks
      if (blocksContainer) {
        blocksContainer.innerHTML = '';
        availableBlocks.forEach(block => {
          const card = document.createElement('div');
          card.className = 'modular-block-card';
          card.setAttribute('data-block-id', block.$id);
          card.style.cssText = 'cursor: pointer; padding: 15px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(255,255,255,0.01); display: flex; align-items: center; gap: 12px; transition: all 0.2s;';
          
          const inputId = `chk-${block.$id}`;
          card.innerHTML = `
            <input type="checkbox" id="${inputId}" class="block-checkbox" style="cursor: pointer; width: 16px; height: 16px;" value="${block.price}">
            <div style="flex-grow: 1;">
              <div style="font-size: 0.85rem; font-weight: 600; color: white;">${block.label}</div>
              <div style="font-size: 0.725rem; color: var(--text-muted);">${block.desc || block.category || 'Módulo Adicional'}</div>
            </div>
            <div style="font-weight: 600; color: var(--accent-crimson); font-size: 0.85rem;">+$${block.price}</div>
          `;

          const chk = card.querySelector('.block-checkbox') as HTMLInputElement;
          card.addEventListener('click', (e) => {
            if (e.target !== chk) {
              chk.checked = !chk.checked;
            }
            if (chk.checked) {
              card.classList.add('active-block-card');
            } else {
              card.classList.remove('active-block-card');
            }
            updateCalculations();
          });

          blocksContainer.appendChild(card);
        });
      }

      updateCalculations();
    }

    // ==========================================================================
    // 6. CUSTOM MANUAL ITEMS CONTROLLER
    // ==========================================================================
    const customItemsBody = document.getElementById('custom-items-body') as HTMLElement;
    const addCustomBtn = document.getElementById('btn-add-custom-concept') as HTMLButtonElement;

    function uniqueId() {
      return 'manual-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
    }

    function addCustomItem(label = '', billingType: 'flat' | 'hourly' = 'flat', price = 0, hours = 0, hourlyRate = 25) {
      const id = uniqueId();
      customItemsList.push({ id, label, billingType, price, hours, hourlyRate });
      renderCustomItems();
      updateCalculations();
    }

    function removeCustomItem(id: string) {
      customItemsList = customItemsList.filter(item => item.id !== id);
      renderCustomItems();
      updateCalculations();
    }

    function updateCustomItemField(id: string, field: string, value: any) {
      const idx = customItemsList.findIndex(item => item.id === id);
      if (idx !== -1) {
        if (field === 'label') customItemsList[idx].label = value;
        if (field === 'billingType') {
          customItemsList[idx].billingType = value;
          // reset prices
          customItemsList[idx].price = 0;
          customItemsList[idx].hours = 0;
        }
        if (field === 'price') customItemsList[idx].price = parseFloat(value) || 0;
        if (field === 'hours') {
          customItemsList[idx].hours = parseFloat(value) || 0;
          customItemsList[idx].price = customItemsList[idx].hours * customItemsList[idx].hourlyRate;
        }
        if (field === 'hourlyRate') {
          customItemsList[idx].hourlyRate = parseFloat(value) || 0;
          customItemsList[idx].price = customItemsList[idx].hours * customItemsList[idx].hourlyRate;
        }
        
        // update price calculation in UI row if hourly
        if (customItemsList[idx].billingType === 'hourly') {
          const totalSpan = document.getElementById(`lbl-total-${id}`);
          if (totalSpan) {
            totalSpan.innerText = `= $${customItemsList[idx].price.toFixed(2)}`;
          }
        }
        updateCalculations();
      }
    }

    function renderCustomItems() {
      if (!customItemsBody) return;
      customItemsBody.innerHTML = '';

      if (customItemsList.length === 0) {
        customItemsBody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: var(--text-muted); padding: 20px;">No hay conceptos manuales agregados.</td></tr>`;
        return;
      }

      customItemsList.forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <input type="text" class="table-input custom-label-field" value="${item.label}" placeholder="Descripción del servicio..." data-id="${item.id}">
          </td>
          <td>
            <select class="table-input custom-billing-field" data-id="${item.id}" style="padding: 6px 8px;">
              <option value="flat" ${item.billingType === 'flat' ? 'selected' : ''}>Fijo</option>
              <option value="hourly" ${item.billingType === 'hourly' ? 'selected' : ''}>Por Hora</option>
            </select>
          </td>
          <td>
            ${item.billingType === 'flat' ? `
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-muted);">$</span>
                <input type="number" class="table-input custom-price-field" value="${item.price || ''}" placeholder="Precio USD" data-id="${item.id}">
              </div>
            ` : `
              <div style="display: flex; align-items: center; gap: 8px;">
                <input type="number" class="table-input custom-hours-field" value="${item.hours || ''}" placeholder="Hs" data-id="${item.id}" style="width: 60px; text-align: center;">
                <span style="font-size: 0.775rem; color: var(--text-muted);">hs x $</span>
                <input type="number" class="table-input custom-rate-field" value="${item.hourlyRate || ''}" placeholder="$/h" data-id="${item.id}" style="width: 60px; text-align: center;">
                <span id="lbl-total-${item.id}" style="font-size: 0.8rem; font-weight: 600; color: var(--accent-crimson); margin-left: auto;">= $${item.price.toFixed(2)}</span>
              </div>
            `}
          </td>
          <td style="text-align: center;">
            <button type="button" class="btn-delete-row" data-id="${item.id}" style="background: none; border: none; color: #ef4444; font-size: 1.1rem; cursor: pointer;">✕</button>
          </td>
        `;

        // Listeners
        tr.querySelector('.custom-label-field')?.addEventListener('input', (e) => {
          updateCustomItemField(item.id, 'label', (e.target as HTMLInputElement).value);
        });
        tr.querySelector('.custom-billing-field')?.addEventListener('change', (e) => {
          updateCustomItemField(item.id, 'billingType', (e.target as HTMLSelectElement).value);
          renderCustomItems();
        });
        tr.querySelector('.custom-price-field')?.addEventListener('input', (e) => {
          updateCustomItemField(item.id, 'price', (e.target as HTMLInputElement).value);
        });
        tr.querySelector('.custom-hours-field')?.addEventListener('input', (e) => {
          updateCustomItemField(item.id, 'hours', (e.target as HTMLInputElement).value);
        });
        tr.querySelector('.custom-rate-field')?.addEventListener('input', (e) => {
          updateCustomItemField(item.id, 'hourlyRate', (e.target as HTMLInputElement).value);
        });
        tr.querySelector('.btn-delete-row')?.addEventListener('click', () => {
          removeCustomItem(item.id);
        });

        customItemsBody.appendChild(tr);
      });
    }

    addCustomBtn.addEventListener('click', () => {
      addCustomItem('', 'flat', 0, 0, 25);
    });

    // ==========================================================================
    // 7. SIDEBAR EVENT LISTENERS
    // ==========================================================================
    currencySelect.addEventListener('change', () => {
      const val = currencySelect.value;
      if (val === 'ARS') {
        exchangeRateGroup.style.display = 'block';
        arsFacilitiesGroup.style.display = 'block';
      } else {
        exchangeRateGroup.style.display = 'none';
        arsFacilitiesGroup.style.display = 'none';
      }
      updateCalculations();
    });

    exchangeRateInput.addEventListener('input', updateCalculations);
    chkInstallment.addEventListener('change', updateCalculations);
    chkTransferDiscount.addEventListener('change', updateCalculations);

    urgencySlider.addEventListener('input', () => {
      const uVal = parseInt(urgencySlider.value) || 0;
      urgencyLabel.innerText = `+${uVal}%`;
      updateCalculations();
    });

    discountInput.addEventListener('input', updateCalculations);
    maintenanceInput.addEventListener('input', updateCalculations);

    // ==========================================================================
    // 8. LIVE CALCULATIONS & AI UPSELL LOGIC
    // ==========================================================================
    function updateCalculations() {
      // 1. Calculate Blocks setup price
      let blocksPrice = 0;
      const checkedBlockIds: string[] = [];
      document.querySelectorAll('.block-checkbox').forEach(chkBox => {
        const chk = chkBox as HTMLInputElement;
        if (chk.checked) {
          blocksPrice += parseFloat(chk.value) || 0;
          const card = chk.closest('.modular-block-card');
          if (card) {
            checkedBlockIds.push(card.getAttribute('data-block-id') || '');
          }
        }
      });

      // 2. Calculate Manual setup price
      let customPrice = 0;
      customItemsList.forEach(item => {
        customPrice += item.price;
      });

      // 3. Subtotal Setup (in USD)
      const subtotalSetup = templateBasePrice + blocksPrice + customPrice;

      // 4. Urgency
      const urgencyPct = parseInt(urgencySlider.value) || 0;
      const urgencyVal = subtotalSetup * (urgencyPct / 100);

      // 5. Discount
      const discount = parseFloat(discountInput.value) || 0;

      // 6. Total Setup (in USD)
      const totalSetup = Math.max(0, subtotalSetup + urgencyVal - discount);

      // 7. Abono SLA
      const maintenance = parseFloat(maintenanceInput.value) || 0;

      // 8. LTV 12m
      const ltv12m = totalSetup + (maintenance * 12);

      // 9. Metrics
      const estHours = Math.ceil(totalSetup / 40);
      const netProfit = (totalSetup * 0.70) + (maintenance * 12 * 0.90);
      const profitMarginPct = ltv12m > 0 ? (netProfit / ltv12m) * 100 : 0;

      // 10. Multi-currency values
      const isArs = currencySelect.value === 'ARS';
      const rate = parseFloat(exchangeRateInput.value) || 1000;

      // Render calculations on Live Preview Box
      (document.getElementById('prev-subtotal') as HTMLElement).innerText = formatVal(subtotalSetup, isArs, rate);
      
      const prevUrgencyRow = document.getElementById('prev-urgency-row') as HTMLElement;
      const prevUrgencyPct = document.getElementById('prev-urgency-pct') as HTMLElement;
      const prevUrgencyVal = document.getElementById('prev-urgency-val') as HTMLElement;
      if (urgencyPct > 0) {
        if (prevUrgencyPct) prevUrgencyPct.innerText = urgencyPct.toString();
        if (prevUrgencyVal) prevUrgencyVal.innerText = `+${formatVal(urgencyVal, isArs, rate)}`;
        if (prevUrgencyRow) prevUrgencyRow.style.display = 'flex';
      } else {
        if (prevUrgencyRow) prevUrgencyRow.style.display = 'none';
      }

      const prevDiscountRow = document.getElementById('prev-discount-row') as HTMLElement;
      const prevDiscountVal = document.getElementById('prev-discount-val') as HTMLElement;
      if (discount > 0) {
        if (prevDiscountVal) prevDiscountVal.innerText = `-${formatVal(discount, isArs, rate)}`;
        if (prevDiscountRow) prevDiscountRow.style.display = 'flex';
      } else {
        if (prevDiscountRow) prevDiscountRow.style.display = 'none';
      }

      (document.getElementById('prev-total') as HTMLElement).innerText = formatVal(totalSetup, isArs, rate);

      const prevRecurringRow = document.getElementById('prev-recurring-row') as HTMLElement;
      const prevRecurringVal = document.getElementById('prev-recurring-val') as HTMLElement;
      if (maintenance > 0) {
        if (prevRecurringVal) prevRecurringVal.innerText = `${formatVal(maintenance, isArs, rate)}/mes`;
        if (prevRecurringRow) prevRecurringRow.style.display = 'flex';
      } else {
        if (prevRecurringRow) prevRecurringRow.style.display = 'none';
      }

      // Render Metrics
      if (metricDevHours) metricDevHours.innerText = `${estHours} hs`;
      if (metricLtv) metricLtv.innerText = formatVal(ltv12m, isArs, rate);
      if (metricProfit) metricProfit.innerText = formatVal(netProfit, isArs, rate);
      if (metricProfitProgress) {
        metricProfitProgress.style.width = `${Math.min(100, Math.round(profitMarginPct))}%`;
      }

      // Populate Live Preview list of items
      const prevItemsContainer = document.getElementById('preview-items-container');
      if (prevItemsContainer) {
        prevItemsContainer.innerHTML = '';
        
        let hasItems = false;
        
        if (selectedTemplate) {
          const card = document.createElement('div');
          card.className = 'preview-item-row';
          const templateObj = availableTemplates.find(t => t.$id === selectedTemplate);
          const labelText = templateObj ? templateObj.label : 'Servicio';
          card.innerHTML = `
            <span>Base: ${labelText} <span class="qty-label">(x1)</span></span>
            <span>${formatVal(templateBasePrice, isArs, rate)}</span>
          `;
          prevItemsContainer.appendChild(card);
          hasItems = true;
        }

        document.querySelectorAll('.block-checkbox').forEach(chkBox => {
          const chk = chkBox as HTMLInputElement;
          if (chk.checked) {
            const cardElement = chk.closest('.modular-block-card');
            const blockId = cardElement?.getAttribute('data-block-id');
            const blockObj = availableBlocks.find(b => b.$id === blockId);
            const label = blockObj ? blockObj.label : 'Módulo';
            const val = parseFloat(chk.value) || 0;
            
            const card = document.createElement('div');
            card.className = 'preview-item-row';
            card.innerHTML = `
              <span>${label} <span class="qty-label">(x1)</span></span>
              <span>${formatVal(val, isArs, rate)}</span>
            `;
            prevItemsContainer.appendChild(card);
            hasItems = true;
          }
        });

        customItemsList.forEach(item => {
          const card = document.createElement('div');
          card.className = 'preview-item-row';
          const hoursLabel = item.billingType === 'hourly' ? ` (${item.hours} hs)` : '';
          card.innerHTML = `
            <span>${item.label || 'Concepto manual'}${hoursLabel} <span class="qty-label">(x1)</span></span>
            <span>${formatVal(item.price, isArs, rate)}</span>
          `;
          prevItemsContainer.appendChild(card);
          hasItems = true;
        });

        if (!hasItems) {
          prevItemsContainer.innerHTML = `<span style="font-size: 0.8rem; color: var(--text-muted); text-align: center; margin: 15px 0;">Formulario vacío</span>`;
        }
      }

      // AI Cross-Selling Upsell Engine
      const suggestion = getUpsellSuggestion(selectedTemplate, checkedBlockIds, urgencyPct);
      if (suggestion) {
        if (upsellText) upsellText.innerText = suggestion;
        if (upsellCard) upsellCard.style.display = 'block';
      } else {
        if (upsellCard) upsellCard.style.display = 'none';
      }
    }

    function getUpsellSuggestion(template: string, checkedBlockIds: string[], urgency: number) {
      const hasBlock = (id: string) => checkedBlockIds.includes(id);

      if (template === 'web' && !hasBlock('block-api') && !hasBlock('crm')) {
        return '💡 Tip: Sugiere Automatización o Integración CRM para capturar y procesar leads de forma autónoma en el sistema.';
      }
      if (template === 'web' && !hasBlock('block-speed')) {
        return '💡 Tip: Sugiere Optimización WPO / SEO Técnico para acelerar la carga en móviles e incrementar las visitas.';
      }
      if ((template === 'ia' || template === 'sistema') && !hasBlock('block-db') && !hasBlock('block-crm')) {
        return '💡 Tip: Sugiere una Base de Datos Cloud Dedicada para estructurar las interacciones de tu Agente IA.';
      }
      if (urgency > 20 && !hasBlock('block-vps')) {
        return '💡 Tip: Sugiere Servidor VPS Dedicado Linux para soportar cargas críticas de urgencia sin caídas.';
      }
      return '';
    }

    // Bind inputs to Live client previews
    clientNameInput.addEventListener('input', updateClientPreview);
    clientBusinessInput.addEventListener('input', updateClientPreview);

    function updateClientPreview() {
      const cBusiness = document.getElementById('prev-client');
      const cContact = document.getElementById('prev-contact');
      if (cBusiness) cBusiness.innerText = clientBusinessInput.value.trim() || 'Negocio Cliente';
      if (cContact) cContact.innerText = clientNameInput.value.trim() || 'Contacto Representante';
