            let serviceType = 'Servicios Digitales';
            let meta: any = null;
            if (budget.metadata) {
              try {
                meta = JSON.parse(budget.metadata);
              } catch (err) {}
            }
            if (!meta) {
              const metaSeparator = (budget.notes || '').indexOf('\n\n---METADATA---\n');
              if (metaSeparator !== -1) {
                try {
                  meta = JSON.parse(budget.notes.substring(metaSeparator + 16));
                } catch (e) {}
              }
            }
            if (meta && meta.serviceType) {
              serviceType = meta.serviceType === 'web' ? 'Diseño Web' :
                            meta.serviceType === 'auto' ? 'Automatización' :
                            meta.serviceType === 'ia' ? 'Agente IA' : 'Sistema Completo';
            }

            const text = `Hola ${budget.client_name || ''}! Te comparto el presupuesto online para el proyecto de ${serviceType}: ${link}`;
            const phone = budget.client_whatsapp ? budget.client_whatsapp.replace(/[^0-9]/g, '') : '';
            const url = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
            window.open(url, '_blank');
          });

          // Edit budget
          tr.querySelector('.btn-edit-budget')?.addEventListener('click', () => {
            loadBudgetIntoForm(budget);
          });

          // PDF download
          tr.querySelector('.btn-pdf-budget')?.addEventListener('click', () => {
            generateBudgetPDF(budget);
          });

          // Delete budget
          tr.querySelector('.btn-delete-budget')?.addEventListener('click', async () => {
            if (confirm(`¿Deseas eliminar el presupuesto ${budget.quote_number || ''}?`)) {
              try {
                await api.db.deleteBudget(budget.$id);
                showToast('Presupuesto eliminado correctamente.', 'success');
                loadBudgetsHistory();
              } catch (err: any) {
                showToast("Error al eliminar: " + err.message, 'error');
              }
            }
          });

          historyBody.appendChild(tr);
        });

      } catch (err: any) {
        console.error("Error loading budgets list:", err);
        historyBody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 30px; color: #ef4444;">Error al cargar el historial: ${err.message}</td></tr>`;
      }
    }

    function loadBudgetIntoForm(budget: any) {
      currentEditBudgetId = budget.$id;
      
      // Clear previous builder states
      selectedTemplate = '';
      templateBasePrice = 0;
      document.querySelectorAll('.service-template-card').forEach(c => c.classList.remove('active-template-card'));
      quoteFeaturesInput.value = '';

      // Uncheck blocks
      document.querySelectorAll('.block-checkbox').forEach(chkBox => {
        const chk = chkBox as HTMLInputElement;
        chk.checked = false;
        chk.closest('.modular-block-card')?.classList.remove('active-block-card');
      });

      // Default values
      currencySelect.value = 'USD';
      exchangeRateGroup.style.display = 'none';
      arsFacilitiesGroup.style.display = 'none';
      chkInstallment.checked = true;
      chkTransferDiscount.checked = true;
      urgencySlider.value = '0';
      urgencyLabel.innerText = '+0%';
      discountInput.value = '0';
      maintenanceInput.value = '0';

      // Parse metadata block
      let userNotes = budget.notes || '';
      let meta: any = null;

      if (budget.metadata) {
        try {
          meta = JSON.parse(budget.metadata);
        } catch (err) {
          console.error("Failed to parse dedicated metadata attribute", err);
        }
      }

      if (!meta) {
        const separatorIdx = userNotes.indexOf('\n\n---METADATA---\n');
        if (separatorIdx !== -1) {
          try {
            const metaString = userNotes.substring(separatorIdx + 16);
            userNotes = userNotes.substring(0, separatorIdx);
            meta = JSON.parse(metaString);
          } catch (err) {
            console.error("Failed to parse metadata block in notes", err);
          }
        }
      }

      if (meta) {
        try {
          // Restore selected template
          if (meta.serviceType) {
            selectedTemplate = meta.serviceType;
            const activeCard = document.querySelector(`.service-template-card[data-template="${meta.serviceType}"]`);
            if (activeCard) {
              activeCard.classList.add('active-template-card');
            }
            templateBasePrice = meta.basePrice || 0;
          }

          // Restore features
          if (meta.features) {
            quoteFeaturesInput.value = Array.isArray(meta.features) ? meta.features.join('\n') : meta.features;
          }

          // Restore blocks checks
          if (meta.blocks && Array.isArray(meta.blocks)) {
            meta.blocks.forEach((blockId: string) => {
              const chk = document.querySelector(`.modular-block-card[data-block-id="${blockId}"] .block-checkbox`) as HTMLInputElement;
              if (chk) {
                chk.checked = true;
                chk.closest('.modular-block-card')?.classList.add('active-block-card');
              }
            });
          }

          // Restore custom items
          if (meta.customItems) {
            customItemsList = meta.customItems;
          }

          // Restore settings
          if (meta.currency) {
            currencySelect.value = meta.currency;
            if (meta.currency === 'ARS') {
              exchangeRateGroup.style.display = 'block';
              arsFacilitiesGroup.style.display = 'block';
            }
          }
          if (meta.exchangeRate) exchangeRateInput.value = meta.exchangeRate.toString();
          if (meta.enableInstallments !== undefined) chkInstallment.checked = meta.enableInstallments;
          if (meta.enableTransferDiscount !== undefined) chkTransferDiscount.checked = meta.enableTransferDiscount;
          if (meta.urgency !== undefined) {
            urgencySlider.value = meta.urgency.toString();
            urgencyLabel.innerText = `+${meta.urgency}%`;
          }
          if (meta.discount !== undefined) discountInput.value = meta.discount.toString();
          if (meta.maintenance !== undefined) maintenanceInput.value = meta.maintenance.toString();

        } catch (err) {
          console.error("Failed to restore form values from parsed metadata", err);
          try {
            customItemsList = JSON.parse(budget.items || '[]');
          } catch (e) {
            customItemsList = [];
          }
        }
      } else {
        // legacy budget format
        try {
          const itemsRaw = JSON.parse(budget.items || '[]');
          customItemsList = itemsRaw.map((itm: any) => ({
            id: uniqueId(),
            label: itm.name || 'Servicio',
            billingType: 'flat',
            price: itm.price || 0,
            hours: 0,
            hourlyRate: 25
          }));
        } catch (e) {
          customItemsList = [];
        }
      }

      // Populate basic client fields
      if (clientNameInput) clientNameInput.value = budget.client_name || '';
      if (clientBusinessInput) clientBusinessInput.value = budget.client_business || '';
      if (clientEmailInput) clientEmailInput.value = budget.client_email || '';
      if (clientWhatsappInput) clientWhatsappInput.value = budget.client_whatsapp || '';
      if (quoteValidityInput) quoteValidityInput.value = budget.validity_days || 15;
      if (quoteNotesInput) quoteNotesInput.value = userNotes;

      renderCustomItems();
      updateClientPreview();
      updateCalculations();

      // Open the budget modal in edit mode
      openModal(true);
    }

    // ==========================================================================
    // 11. PDF LAYOUT DYNAMIC COMPILER & DOWNLOADER
    // ==========================================================================
    function generateBudgetPDF(budget: any) {
      // 1. Check for metadata block
      let userNotes = budget.notes || '';
      let meta: any = {
        currency: 'USD',
        exchangeRate: 1000,
        enableInstallments: true,
        enableTransferDiscount: true,
        urgency: 0,
        maintenance: 0,
        discount: 0,
        basePrice: budget.subtotal,
        serviceType: 'Propuesta',
        features: []
      };

      let sepIdx = -1;
      if (budget.metadata) {
        try {
          meta = JSON.parse(budget.metadata);
        } catch (err) {}
      } else {
        sepIdx = userNotes.indexOf('\n\n---METADATA---\n');
        if (sepIdx !== -1) {
          try {
            meta = JSON.parse(userNotes.substring(sepIdx + 16));
            userNotes = userNotes.substring(0, sepIdx);
          } catch (err) {}
        } else {
          // legacy map
          meta.features = [];
        }
      }

      const isArs = meta.currency === 'ARS';
      const rate = parseFloat(meta.exchangeRate) || 1000;

      // Populate basic fields
      (document.getElementById('pdf-client-business') as HTMLElement).innerText = budget.client_business || '';
      (document.getElementById('pdf-client-name') as HTMLElement).innerText = budget.client_name || '';
      (document.getElementById('pdf-client-email') as HTMLElement).innerText = budget.client_email || '';
      (document.getElementById('pdf-quote-validity-val') as HTMLElement).innerText = budget.validity_days || 15;
      
      const budgetDate = new Date(budget.created_at || budget.$createdAt);
      (document.getElementById('pdf-quote-date') as HTMLElement).innerText = budgetDate.toLocaleDateString('es-AR');
      (document.getElementById('pdf-quote-number') as HTMLElement).innerText = budget.quote_number || 'KP-0000';

      const pdfNoteItem = document.getElementById('pdf-custom-note-item') as HTMLElement;
      if (userNotes.trim()) {
        (document.getElementById('pdf-custom-note-text') as HTMLElement).innerText = userNotes.trim();
        pdfNoteItem.style.display = 'block';
      } else {
        pdfNoteItem.style.display = 'none';
      }

      // Populate PDF Items list (converting if ARS)
      const pdfTableBody = document.getElementById('pdf-items-body') as HTMLElement;
      if (pdfTableBody) {
        pdfTableBody.innerHTML = '';
        
        let items: any[] = [];
        try {
          items = JSON.parse(budget.items || '[]');
        } catch (e) {}

        // If metadata exists, let's render more detail
        const hasStructuredMeta = !!(budget.metadata) || (sepIdx !== -1 && meta.serviceType !== 'Propuesta');
        if (hasStructuredMeta) {
          // Render base template row with features
          if (meta.basePrice > 0) {
            const tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid #e2e8f0';
            
            let featuresHtml = '';
            if (Array.isArray(meta.features) && meta.features.length > 0 && meta.features.some((f: string) => f.trim() !== '')) {
              featuresHtml = `
                <div style="margin-top: 8px; background: #f8fafc; border: 1px solid #cbd5e1; padding: 10px; border-radius: 4px; border-left: 2px solid #d12237;">
                  <div style="font-size: 0.7rem; font-weight: 600; color: #64748b; text-transform: uppercase; margin-bottom: 5px;">Incluye:</div>
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px 15px;">
                    ${meta.features.map((f: string) => f.trim() ? `<div style="font-size: 0.75rem; color: #334155;"><span style="color: #c026d3; margin-right: 4px;">•</span> ${f.trim()}</div>` : '').join('')}
                  </div>
                </div>
              `;
            }

            const templateObj = availableTemplates.find(t => t.$id === meta.serviceType);
            const baseLabel = templateObj ? templateObj.label : meta.serviceType;

            tr.innerHTML = `
              <td style="padding: 12px 15px; color: #0f172a; font-weight: 500; text-align: left;">
                <div style="font-weight: 600;">Base del Proyecto: ${baseLabel}</div>
                ${featuresHtml}
              </td>
              <td style="padding: 12px 15px; text-align: right; color: #334155; vertical-align: top;">${formatVal(meta.basePrice, isArs, rate)}</td>
              <td style="padding: 12px 15px; text-align: center; color: #334155; vertical-align: top;">1</td>
              <td style="padding: 12px 15px; text-align: right; color: #0f172a; font-weight: 600; vertical-align: top;">${formatVal(meta.basePrice, isArs, rate)}</td>
            `;
            pdfTableBody.appendChild(tr);
          }

          // Render blocks
          if (meta.blocks && Array.isArray(meta.blocks)) {
            meta.blocks.forEach((blockId: string) => {
              const blk = availableBlocks.find(b => b.$id === blockId);
              if (blk) {
                const tr = document.createElement('tr');
                tr.style.borderBottom = '1px solid #e2e8f0';
                tr.innerHTML = `
                  <td style="padding: 12px 15px; color: #0f172a; font-weight: 500;">Módulo Adicional: ${blk.label}</td>
                  <td style="padding: 12px 15px; text-align: right; color: #334155;">${formatVal(blk.price, isArs, rate)}</td>
                  <td style="padding: 12px 15px; text-align: center; color: #334155;">1</td>
                  <td style="padding: 12px 15px; text-align: right; color: #0f172a; font-weight: 600;">${formatVal(blk.price, isArs, rate)}</td>
                `;
                pdfTableBody.appendChild(tr);
              }
            });
          }

          // Render custom items
          if (meta.customItems && Array.isArray(meta.customItems)) {
            meta.customItems.forEach((itm: any) => {
              const tr = document.createElement('tr');
              tr.style.borderBottom = '1px solid #e2e8f0';
              const subLabel = itm.billingType === 'hourly' ? `<div style="font-size: 0.725rem; color: #64748b; margin-top: 2px;">(${itm.hours} hs x ${formatVal(itm.hourlyRate, isArs, rate)}/h)</div>` : '';
              tr.innerHTML = `
                <td style="padding: 12px 15px; color: #0f172a; font-weight: 500;">
                  <div>${itm.label || 'Concepto manual'}</div>
                  ${subLabel}
                </td>
                <td style="padding: 12px 15px; text-align: right; color: #334155;">${formatVal(itm.billingType === 'hourly' ? itm.hourlyRate * itm.hours : itm.price, isArs, rate)}</td>
                <td style="padding: 12px 15px; text-align: center; color: #334155;">1</td>
                <td style="padding: 12px 15px; text-align: right; color: #0f172a; font-weight: 600;">${formatVal(itm.billingType === 'hourly' ? itm.hourlyRate * itm.hours : itm.price, isArs, rate)}</td>
              `;
              pdfTableBody.appendChild(tr);
            });
          }

        } else {
          // Render legacy items list
          items.forEach(item => {
            const tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid #e2e8f0';
            tr.innerHTML = `
              <td style="padding: 12px 15px; color: #0f172a; font-weight: 500;">${item.name || 'Servicio Técnico'}</td>
              <td style="padding: 12px 15px; text-align: right; color: #334155;">${formatVal(item.price, isArs, rate)}</td>
              <td style="padding: 12px 15px; text-align: center; color: #334155;">${item.qty}</td>
              <td style="padding: 12px 15px; text-align: right; color: #0f172a; font-weight: 600;">${formatVal(item.price * item.qty, isArs, rate)}</td>
            `;
            pdfTableBody.appendChild(tr);
          });
        }
      }

      // Calculations setup totals (converting if ARS)
      const subtotalSetup = budget.subtotal;
      const urgencyPct = meta.urgency || 0;
      const urgencyAmount = subtotalSetup * (urgencyPct / 100);
      const discount = meta.discount || budget.discount_val || 0;
      const totalSetup = Math.max(0, subtotalSetup + urgencyAmount - discount);
      const maintenance = meta.maintenance || 0;
      const estHours = Math.ceil(totalSetup / 40);

      // Populate PDF Setup Column
      (document.getElementById('pdf-subtotal') as HTMLElement).innerText = formatVal(subtotalSetup, isArs, rate);
      
      const pdfUrgencyRow = document.getElementById('pdf-urgency-row') as HTMLElement;
      const pdfUrgencyPct = document.getElementById('pdf-urgency-pct') as HTMLElement;
      const pdfUrgencyVal = document.getElementById('pdf-urgency-val') as HTMLElement;
      if (urgencyPct > 0) {
        if (pdfUrgencyPct) pdfUrgencyPct.innerText = urgencyPct.toString();
        if (pdfUrgencyVal) pdfUrgencyVal.innerText = `+${formatVal(urgencyAmount, isArs, rate)}`;
        if (pdfUrgencyRow) pdfUrgencyRow.style.display = 'flex';
      } else {
        if (pdfUrgencyRow) pdfUrgencyRow.style.display = 'none';
      }

      const pdfDiscountRow = document.getElementById('pdf-discount-row') as HTMLElement;
      const pdfDiscountVal = document.getElementById('pdf-discount-val') as HTMLElement;
      if (discount > 0) {
        if (pdfDiscountVal) pdfDiscountVal.innerText = `-${formatVal(discount, isArs, rate)}`;
        if (pdfDiscountRow) pdfDiscountRow.style.display = 'flex';
      } else {
        if (pdfDiscountRow) pdfDiscountRow.style.display = 'none';
      }

      (document.getElementById('pdf-total') as HTMLElement).innerText = formatVal(totalSetup, isArs, rate);

      // Recurring SLA columns
      const pdfRecurringCard = document.getElementById('pdf-recurring-card') as HTMLElement;
      const pdfRecurringTotal = document.getElementById('pdf-recurring-total') as HTMLElement;
      if (maintenance > 0) {
        if (pdfRecurringTotal) pdfRecurringTotal.innerText = `${formatVal(maintenance, isArs, rate)}/mes`;
        if (pdfRecurringCard) pdfRecurringCard.style.display = 'flex';
      } else {
        if (pdfRecurringCard) pdfRecurringCard.style.display = 'none';
      }

      // Exchange rate note
      const pdfExchangeNote = document.getElementById('pdf-exchange-rate-note') as HTMLElement;
      const pdfExchangeVal = document.getElementById('pdf-exchange-rate-val') as HTMLElement;
      if (isArs) {
        if (pdfExchangeVal) pdfExchangeVal.innerText = rate.toLocaleString('es-AR');
        if (pdfExchangeNote) pdfExchangeNote.style.display = 'block';
      } else {
        if (pdfExchangeNote) pdfExchangeNote.style.display = 'none';
      }

      // Terms & Conditions checkboxes
      const termInstallments = document.getElementById('pdf-term-installment') as HTMLElement;
      const termTransfer = document.getElementById('pdf-term-transfer') as HTMLElement;
      const termDeliveryDays = document.getElementById('pdf-term-delivery-days') as HTMLElement;

      if (meta.enableInstallments !== false) {
        if (termInstallments) termInstallments.style.display = 'list-item';
      } else {
        if (termInstallments) termInstallments.style.display = 'none';
      }

      if (meta.enableTransferDiscount !== false) {
        if (termTransfer) termTransfer.style.display = 'list-item';
      } else {
        if (termTransfer) termTransfer.style.display = 'none';
      }

      // Set delivery times based on hours
      if (termDeliveryDays) {
        const minDays = Math.max(5, Math.ceil(estHours / 5));
        const maxDays = Math.max(10, Math.ceil(estHours / 3));
        termDeliveryDays.innerText = `${minDays} - ${maxDays}`;
      }

      // Render A4 printable element via html2pdf CDN
      const printableElement = document.getElementById('printable-invoice') as HTMLElement;
      if (!printableElement) return;

      // Ensure html2pdf is loaded
      if (typeof (window as any).html2pdf === 'undefined') {
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
        document.head.appendChild(s);
      }

      const origStyle = printableElement.getAttribute('style') || '';
      printableElement.style.display = 'block';
      printableElement.style.position = 'fixed';
      printableElement.style.left = '0';
      printableElement.style.top = '0';
      printableElement.style.zIndex = '999999';
      printableElement.style.opacity = '1';
      printableElement.style.visibility = 'visible';
      printableElement.style.background = '#ffffff';
      printableElement.style.color = '#0f172a';

      const opt = {
        margin:       [0.3, 0.3, 0.3, 0.3],
        filename:     `Presupuesto_Kaptativa_${(budget.client_business || 'Cliente').replace(/[^a-zA-Z0-9]/g, '_')}.pdf`,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
      };

      try {
        if (typeof (window as any).html2pdf !== 'undefined') {
          (window as any).html2pdf().set(opt).from(printableElement).save().finally(() => {
            printableElement.setAttribute('style', origStyle);
          });
        } else {
          window.print();
          printableElement.setAttribute('style', origStyle);
        }
      } catch (e) {
        console.error('[PDF] Generation error:', e);
        printableElement.setAttribute('style', origStyle);
      }
    }

    // ==========================================================================
    // 12. CRM REDIRECT HANDLER
    // ==========================================================================
    const urlParams = new URLSearchParams(window.location.search);
    const leadId = urlParams.get('leadId');
    const leadMode = urlParams.get('mode') || 'lead';

    if (leadId) {
      try {
        let clientData: any = null;
        if (leadMode === 'lead') {
          const res = await api.db.listLeads();
          clientData = (res.documents || []).find((l: any) => l.$id === leadId);
        } else {
          const res = await api.db.listProjects();
          clientData = (res.documents || []).find((p: any) => p.$id === leadId);
        }

        if (clientData) {
          if (clientNameInput) clientNameInput.value = clientData.name || '';
          if (clientBusinessInput) clientBusinessInput.value = clientData.business || '';
          if (clientEmailInput) clientEmailInput.value = clientData.email || '';
          if (clientWhatsappInput) clientWhatsappInput.value = clientData.whatsapp || '';
          
          if (clientData.recommendations && quoteNotesInput) {
            quoteNotesInput.value = `Propuesta basada en el diagnóstico: ${clientData.recommendations}`;
          }
          
          // Clear query params from url
          window.history.replaceState({}, document.title, window.location.pathname);
          
          updateClientPreview();
          updateCalculations();
        }
      } catch (err) {
        console.error("Failed to prefill CRM parameters:", err);
      }
    }

    // ==========================================================================
    // 13. BUDGET FORM SUBMIT (SAVE & DOWNLOAD)
    // ==========================================================================
    const budgetForm = document.getElementById('budget-generator-form') as HTMLFormElement;
    const pdfFeedback = document.getElementById('pdf-feedback') as HTMLElement;

    if (budgetForm) {
      budgetForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (!selectedTemplate && customItemsList.length === 0) {
          showFeedback('Por favor, selecciona una plantilla de servicio o añade conceptos personalizados.', 'error');
          return;
        }

        const clientName = clientNameInput.value.trim();
        const clientBusiness = clientBusinessInput.value.trim();
        const clientEmail = clientEmailInput.value.trim();
        const clientWhatsapp = clientWhatsappInput.value.trim();
        const validityDays = quoteValidityInput.value.trim() || '15';
        const userNotes = quoteNotesInput.value.trim();

        // 1. Calculations setup totals (in USD)
        let blocksPrice = 0;
        const checkedBlockIds: string[] = [];
        document.querySelectorAll('.block-checkbox').forEach(chkBox => {
          const chk = chkBox as HTMLInputElement;
          if (chk.checked) {
            blocksPrice += parseFloat(chk.value) || 0;
            const card = chk.closest('.modular-block-card');
            if (card) {
              checkedBlockIds.push(card.getAttribute('data-block-id') || '');
            }
          }
        });

        let customPrice = 0;
        customItemsList.forEach(item => {
          customPrice += item.price;
        });

        const subtotalSetup = templateBasePrice + blocksPrice + customPrice;
        const urgencyPct = parseInt(urgencySlider.value) || 0;
        const urgencyVal = subtotalSetup * (urgencyPct / 100);
        const discount = parseFloat(discountInput.value) || 0;
        const totalSetup = Math.max(0, subtotalSetup + urgencyVal - discount);
        const maintenance = parseFloat(maintenanceInput.value) || 0;

        // 2. Resolve items into standard array for db compatibility
        const resolvedItems: Array<{ name: string; price: number; qty: number }> = [];
        if (selectedTemplate) {
          const templateObj = availableTemplates.find(t => t.$id === selectedTemplate);
          const labelText = templateObj ? templateObj.label : 'Servicio';
          resolvedItems.push({ name: `Base del Proyecto: ${labelText}`, price: templateBasePrice, qty: 1 });
        }

        checkedBlockIds.forEach(blockId => {
          const blk = availableBlocks.find(b => b.$id === blockId);
          const label = blk ? `Módulo: ${blk.label}` : 'Módulo Adicional';
          const cardEl = document.querySelector(`.modular-block-card[data-block-id="${blockId}"] .block-checkbox`) as HTMLInputElement;
          const price = cardEl ? parseFloat(cardEl.value) || 0 : 0;
          resolvedItems.push({ name: label, price, qty: 1 });
        });
        customItemsList.forEach(item => {
          const hoursLabel = item.billingType === 'hourly' ? ` (${item.hours} hs x $${item.hourlyRate}/h)` : '';
          resolvedItems.push({
            name: `${item.label || 'Concepto manual'}${hoursLabel}`,
            price: item.price,
            qty: 1
          });
        });

        // 3. Serialized Configuration Metadata for notes empaquetado
        const metadata = {
          serviceType: selectedTemplate,
          basePrice: templateBasePrice,
          features: quoteFeaturesInput.value.split('\n'),
          blocks: checkedBlockIds,
          customItems: customItemsList,
          currency: currencySelect.value,
          exchangeRate: parseFloat(exchangeRateInput.value) || 1000,
          enableInstallments: chkInstallment.checked,
          enableTransferDiscount: chkTransferDiscount.checked,
          urgency: urgencyPct,
          maintenance: maintenance,
          discount: discount
        };

        // 4. Budget Quote Code Number
        const today = new Date();
        const quoteNum = `KP-${today.getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;

        let finalQuoteNumber = quoteNum;
        if (currentEditBudgetId) {
          const editedBudget = allBudgets.find(b => b.$id === currentEditBudgetId);
          if (editedBudget) finalQuoteNumber = editedBudget.quote_number || quoteNum;
        }

        // 5. Package Payload
        const budgetPayload: any = {
          quote_number: finalQuoteNumber,
          client_name: clientName,
          client_business: clientBusiness,
          client_email: clientEmail,
          client_whatsapp: clientWhatsapp,
          items: JSON.stringify(resolvedItems),
          subtotal: subtotalSetup,
          discount_pct: subtotalSetup > 0 ? Math.round((discount / subtotalSetup) * 100) : 0,
          discount_val: discount,
          total: totalSetup,
          validity_days: parseInt(validityDays) || 15,
          notes: userNotes,
          metadata: JSON.stringify(metadata),
          // Preserve existing status on edit; default 'enviado' on new
          status: currentEditBudgetId
            ? (allBudgets.find((b: any) => b.$id === currentEditBudgetId)?.status || 'enviado')
            : 'enviado'
        };

        // 6. DB Sync
        const editingId = currentEditBudgetId;
        try {
          let savedBudgetObj;
          if (editingId) {
            savedBudgetObj = await api.db.updateBudget(editingId, budgetPayload);
            showFeedback('Presupuesto actualizado correctamente.', 'success');
          } else {
            savedBudgetObj = await api.db.createBudget(budgetPayload);
            showFeedback('Presupuesto guardado en base de datos.', 'success');
          }
          
          // Download PDF directly
          showFeedback('Exportando propuesta comercial en formato PDF...', 'success');
          generateBudgetPDF(savedBudgetObj || budgetPayload);

          // Reset edit mode and clear form on new budgets
          currentEditBudgetId = '';
          closeModal();
          await loadBudgetsHistory();
          setTimeout(() => {
            if (!editingId) {
              clearBtn.click();
            }
          }, 500);

        } catch (err: any) {
          console.error("Failed to save budget:", err);
          showFeedback('Error al guardar el presupuesto: ' + err.message, 'error');
        }
      });
    }

    function showFeedback(msg: string, type: 'success' | 'error') {
      if (!pdfFeedback) return;
      pdfFeedback.innerText = msg;
      pdfFeedback.className = `login-feedback ${type}`;
      pdfFeedback.style.display = 'block';
      setTimeout(() => {
        pdfFeedback.style.display = 'none';
      }, 5000);
      showToast(msg, type);
    }

    function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `toast-notification ${type}`;

      let icon = '⚡';
      if (type === 'success') icon = '✅';
      else if (type === 'error') icon = '❌';
      else if (type === 'info') icon = 'ℹ️';

      toast.innerHTML = `
        <span class="toast-icon">${icon}</span>
        <span class="toast-content">${message}</span>
        <button class="toast-close" type="button">&times;</button>
      `;

      const closeBtn = toast.querySelector('.toast-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-20px)';
          setTimeout(() => toast.remove(), 300);
        });
      }

      setTimeout(() => {
        if (toast.parentNode) {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-20px)';
          setTimeout(() => {
            if (toast.parentNode) toast.remove();
          }, 300);
        }
      }, 5000);

      container.appendChild(toast);
    }

    // Load settings first to populate cost variables, then load templates/blocks, and reload settings to bind dynamically generated UI elements

    // Load settings first to populate cost variables, then load templates/blocks, and reload settings to bind dynamically generated UI elements
    loadSettings();
    await loadTemplatesAndBlocks();
    loadSettings();

    // Run Initial table renders
    renderCustomItems();
    updateClientPreview();
    updateCalculations();
    await loadBudgetsHistory();

    // ==========================================================================
    // 15. AI BUDGET GENERATION PANEL
    // ==========================================================================
    let aiBudgetResult: any = null;

    const aiToggleBtn = document.getElementById('btn-toggle-ai-panel') as HTMLButtonElement;
    const aiPanelBody = document.getElementById('ai-panel-body') as HTMLElement;
    aiToggleBtn?.addEventListener('click', () => {
      const hidden = aiPanelBody.style.display === 'none';
      aiPanelBody.style.display = hidden ? 'block' : 'none';
      aiToggleBtn.textContent = hidden ? 'Ocultar ▲' : 'Mostrar ▼';
    });

    const btnAiGenerate = document.getElementById('btn-ai-generate-budget') as HTMLButtonElement;
    const aiStatus = document.getElementById('ai-budget-status') as HTMLElement;
    const aiResultDiv = document.getElementById('ai-budget-result') as HTMLElement;
    const aiExplanation = document.getElementById('ai-result-explanation') as HTMLElement;
    const aiSummary = document.getElementById('ai-result-summary') as HTMLElement;
    const btnAiApply = document.getElementById('btn-ai-apply') as HTMLButtonElement;
    const aiDescription = document.getElementById('ai-project-description') as HTMLTextAreaElement;

    btnAiGenerate?.addEventListener('click', async () => {
      const desc = aiDescription?.value.trim();
      if (!desc) { aiStatus.textContent = 'Escribí una descripción primero.'; return; }

      btnAiGenerate.disabled = true;
      btnAiGenerate.textContent = '⏳ Analizando...';
      aiStatus.textContent = '';
      aiResultDiv.style.display = 'none';

      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 30000);
        const res = await fetch('/api/generate-budget', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ description: desc }),
          signal: controller.signal
        });
        clearTimeout(timeout);

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Error desconocido' }));
          throw new Error(err.error || `HTTP ${res.status}`);
        }

        aiBudgetResult = await res.json();

        // Show result summary
        aiExplanation.textContent = `💡 ${aiBudgetResult.explanation}`;
        aiSummary.innerHTML = [
          `<span style="background:rgba(183,166,255,0.12);border:1px solid rgba(183,166,255,0.2);padding:4px 10px;border-radius:6px;font-size:0.75rem;">📦 ${aiBudgetResult.templateLabel} — $${aiBudgetResult.basePrice} USD</span>`,
          ...aiBudgetResult.blockLabels.map((b: any) =>
            `<span style="background:rgba(6,182,212,0.1);border:1px solid rgba(6,182,212,0.2);padding:4px 10px;border-radius:6px;font-size:0.75rem;">+ ${b.label} — $${b.price}</span>`
          ),
          `<span style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);padding:4px 10px;border-radius:6px;font-size:0.75rem;font-weight: 600;">Total estimado: $${aiBudgetResult.suggestedTotal} USD</span>`
        ].join('');
        aiResultDiv.style.display = 'block';
        aiStatus.textContent = '';

      } catch (err: any) {
        const msg = err.name === 'AbortError' ? 'Tiempo de espera agotado.' : err.message;
        aiStatus.textContent = `⚠️ ${msg}`;
      } finally {
        btnAiGenerate.disabled = false;
        btnAiGenerate.textContent = '✨ Generar presupuesto';
      }
    });

    btnAiApply?.addEventListener('click', () => {
      if (!aiBudgetResult) return;

      // 1. Select the template card (attribute is data-template, not data-template-id)
      document.querySelectorAll('.service-template-card').forEach((card: any) => {
        const cardId = card.getAttribute('data-template');
        if (cardId === aiBudgetResult.template) {
          card.click(); // triggers existing selection logic
        }
      });

      // 2. Check/uncheck blocks — data-block-id is on the .modular-block-card div, not the checkbox
      document.querySelectorAll('.modular-block-card').forEach((blockCard: any) => {
        const blockId = blockCard.getAttribute('data-block-id');
        const chk = blockCard.querySelector('.block-checkbox') as HTMLInputElement;
        if (!chk || !blockId) return;
        const shouldCheck = aiBudgetResult.blocks.includes(blockId);
        if (chk.checked !== shouldCheck) blockCard.click();
      });

      // 3. Set features textarea
      const featuresInput = document.getElementById('quote-features') as HTMLTextAreaElement;
      if (featuresInput && aiBudgetResult.features.length > 0) {
        featuresInput.value = aiBudgetResult.features.join('\n');
        featuresInput.dispatchEvent(new Event('input'));
      }

      // 4. Set maintenance
      const maintenanceInput = document.getElementById('quote-maintenance-usd') as HTMLInputElement;
      if (maintenanceInput && aiBudgetResult.maintenance > 0) {
        maintenanceInput.value = String(aiBudgetResult.maintenance);
        maintenanceInput.dispatchEvent(new Event('input'));
      }

      // 5. Set notes
      const notesInput = document.getElementById('quote-notes') as HTMLTextAreaElement;
      if (notesInput && aiBudgetResult.notes) {
        notesInput.value = aiBudgetResult.notes;
      }

      updateCalculations();
      showToast('✅ Presupuesto cargado por la IA. Revisá y ajustá los datos del cliente.', 'success');

      // Scroll to form
      document.getElementById('budget-generator-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

