---
return Astro.redirect('/admin');
---

<AdminLayout title="Gestión de Proyectos & Casos de Éxito | Kaptativa Admin">
  <div class="admin-wrapper" id="admin-main-view">
    
    <!-- SIDEBAR NAVIGATION -->
    <AdminSidebar activeTab="proyectos" />

    <!-- MAIN CONTENT AREA -->
    <main class="admin-content-area">
      <!-- HEADER -->
      <header class="admin-header">
        <div>
          <h1 class="admin-page-title" style="margin: 0; font-size: 1.6rem; font-weight: 600; color: white; font-family: 'Space Grotesk', sans-serif;">
            Gestión de Proyectos & Casos de Éxito
          </h1>
          <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: var(--text-secondary);">
            Administrá el catálogo de desarrollos, automatizaciones y plataformas públicas (Estructura ElyFullStack)
          </p>
        </div>
        <button class="btn btn-primary btn-sm" id="btn-new-project" style="align-self: center; display: flex; align-items: center; gap: 6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Nuevo Proyecto
        </button>
      </header>

      <!-- METRICS ROW -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px;">
        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 16px; border-radius: 12px;">
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Total Proyectos</span>
          <div id="stat-total" style="font-size: 1.6rem; font-weight: 600; color: white; margin-top: 4px;">0</div>
        </div>
        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 16px; border-radius: 12px;">
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Publicados</span>
          <div id="stat-published" style="font-size: 1.6rem; font-weight: 600; color: #10b981; margin-top: 4px;">0</div>
        </div>
        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 16px; border-radius: 12px;">
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Destacados ⭐</span>
          <div id="stat-featured" style="font-size: 1.6rem; font-weight: 600; color: #f59e0b; margin-top: 4px;">0</div>
        </div>
        <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); padding: 16px; border-radius: 12px;">
          <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Borradores</span>
          <div id="stat-drafts" style="font-size: 1.6rem; font-weight: 600; color: #94a3b8; margin-top: 4px;">0</div>
        </div>
      </div>

      <!-- FILTER & SEARCH BAR -->
      <div style="display: flex; gap: 15px; margin-bottom: 20px; flex-wrap: wrap; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.02); padding: 12px 16px; border-radius: 10px; border: 1px solid var(--border-color);">
        <div style="display: flex; gap: 12px; flex-wrap: wrap; flex: 1;">
          <input type="text" id="project-search" class="form-control" placeholder="Buscar por título, cliente, tecnología..." style="max-width: 320px; height: 38px; font-size: 0.85rem;">
          <select id="filter-category" class="form-control" style="max-width: 180px; height: 38px; font-size: 0.85rem; background: var(--bg-primary);">
            <option value="all">Todas las Categorías</option>
            <option value="web">Web & SEO</option>
            <option value="auto">Automatizaciones</option>
            <option value="ia">Agentes IA</option>
            <option value="opt">Sistemas Custom</option>
          </select>
          <select id="filter-status" class="form-control" style="max-width: 160px; height: 38px; font-size: 0.85rem; background: var(--bg-primary);">
            <option value="all">Todos los Estados</option>
            <option value="published">Publicados</option>
            <option value="draft">Borradores</option>
          </select>
        </div>
      </div>

      <!-- PROJECTS TABLE -->
      <section class="blog-list-container">
        <div class="admin-table-wrapper">
          <div style="min-width: 750px;">
            <table class="admin-table" id="projects-table">
              <thead>
                <tr>
                  <th style="width: 70px;">Orden</th>
                  <th>Proyecto</th>
                  <th>Categoría</th>
                  <th style="text-align: center;">Destacado</th>
                  <th>Estado</th>
                  <th style="text-align: right;">Acciones</th>
                </tr>
              </thead>
              <tbody id="projects-table-body">
                <tr>
                  <td colspan="6" style="text-align: center; padding: 30px; color: var(--text-muted);">
                    Cargando proyectos...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- PROJECT MODAL FORM (2 COLUMNS ELYFULLSTACK ARCHITECTURE) -->
      <div id="project-modal" class="admin-modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
        <div class="admin-modal" style="width: 100%; max-width: 950px; max-height: 92vh; overflow-y: auto; background: #0f172a; border: 1px solid rgba(255,255,255,0.12); border-radius: 16px; padding: 28px; color: white;">
          
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 14px;">
            <div>
              <h2 id="modal-project-title" style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 1.3rem; font-weight: 600;">Crear Nuevo Proyecto</h2>
              <span style="font-size: 0.75rem; color: #38bdf8;">Configuración técnica, galería de imágenes y optimización SEO (Formato ElyFullStack)</span>
            </div>
            <button type="button" id="btn-close-project-modal" style="background: transparent; border: none; color: #94a3b8; font-size: 1.4rem; cursor: pointer;">✕</button>
          </div>

          <form id="project-form">
            <input type="hidden" id="proj-id">

            <div style="display: grid; grid-template-columns: 1fr 300px; gap: 20px;">
              
              <!-- LEFT MAIN COLUMN -->
              <div style="display: flex; flex-direction: column; gap: 14px;">
                
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
                  <div>
                    <label class="form-label">Título del Proyecto *</label>
                    <input type="text" id="proj-title" class="form-control" placeholder="Ej. Plataforma Corporativa B2B de Servicios" required>
                  </div>
                  <div>
                    <label class="form-label">Subtítulo / Badge</label>
                    <input type="text" id="proj-subtitle" class="form-control" placeholder="Ej. Web & SEO · Entregado 2026">
                  </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                  <div>
                    <label class="form-label">Categoría Principal *</label>
                    <select id="proj-category" class="form-control" style="background: var(--bg-primary);">
                      <option value="web">Web & SEO</option>
                      <option value="auto">Automatizaciones</option>
                      <option value="ia">Agentes IA</option>
                      <option value="opt">Sistemas Custom</option>
                    </select>
                  </div>
                  <div>
                    <label class="form-label">Tipo Específico / Tag</label>
                    <input type="text" id="proj-tipo" class="form-control" placeholder="Ej. Landing Page + CRM Integrado">
                  </div>
                </div>

                <div>
                  <label class="form-label">Descripción Breve (Aparece en tarjetas públicas)</label>
                  <textarea id="proj-desc-short" rows="2" class="form-control" style="resize: none;" placeholder="Breve resumen del proyecto..."></textarea>
                </div>

                <div>
                  <label class="form-label">Memoria Descriptiva Completa (HTML o Texto)</label>
                  <textarea id="proj-desc-full" rows="6" class="form-control" style="font-family: monospace; font-size: 0.82rem;" placeholder="<h2>Detalle del Caso</h2><p>Explicación del problema, solución técnica y resultados...</p>"></textarea>
                </div>

                <!-- FICHA TÉCNICA ELYFULLSTACK -->
                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); padding: 14px; border-radius: 10px;">
                  <div style="font-size: 0.85rem; font-weight: 600; color: #f8fafc; margin-bottom: 10px;">📋 Ficha Técnica del Proyecto</div>
                  
                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <div>
                      <label class="form-label">Cliente / Empresa</label>
                      <input type="text" id="proj-client" class="form-control" placeholder="Ej. Estudio Contable & Co.">
                    </div>
                    <div>
                      <label class="form-label">Plazo de Desarrollo / Fecha</label>
                      <input type="text" id="proj-date" class="form-control" placeholder="Ej. 3 Semanas (Enero 2026)">
                    </div>
                  </div>

                  <div style="margin-top: 10px;">
                    <label class="form-label">Tecnologías & Stack Utilizado</label>
                    <input type="text" id="proj-tech" class="form-control" placeholder="Astro.js, TailwindCSS, Appwrite, OpenAI API, WhatsApp Webhook">
                  </div>

                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
                    <div>
                      <label class="form-label">Servicios Realizados</label>
                      <input type="text" id="proj-services" class="form-control" placeholder="Diseño UX/UI, Backend, SEO Local">
                    </div>
                    <div>
                      <label class="form-label">Resultado / KPI Destacado</label>
                      <input type="text" id="proj-results" class="form-control" placeholder="+40% consultas calificadas">
                    </div>
                  </div>

                  <div style="margin-top: 10px;">
                    <label class="form-label">Enlace Externo (Demostración Live / Sitio Web)</label>
                    <input type="url" id="proj-link" class="form-control" placeholder="https://ejemplo.com">
                  </div>
                </div>

                <!-- SEO BOX -->
                <div style="background: rgba(56,189,248,0.05); border: 1px solid rgba(56,189,248,0.2); padding: 14px; border-radius: 10px;">
                  <div style="font-size: 0.85rem; font-weight: 600; color: #38bdf8; margin-bottom: 10px;">🔍 Optimización SEO en Google</div>
                  
                  <div style="margin-bottom: 10px;">
                    <label class="form-label">Título SEO (Meta Title)</label>
                    <input type="text" id="proj-seo-title" class="form-control" placeholder="Plataforma B2B | Casos de Éxito Kaptativa">
                  </div>
                  <div>
                    <label class="form-label">Descripción SEO (Meta Description)</label>
                    <textarea id="proj-seo-desc" rows="2" class="form-control" style="resize: none;" placeholder="Descripción corta para buscadores..."></textarea>
                  </div>

                  <!-- Google Snippet Live Preview -->
                  <div style="margin-top: 12px;">
                    <label style="font-size: 0.7rem; color: #64748b; text-transform: uppercase;">Preview Google Snippet</label>
                    <div style="background: white; color: #1a0dab; padding: 10px 14px; border-radius: 6px; font-family: arial, sans-serif; margin-top: 4px;">
                      <div style="font-size: 0.72rem; color: #4d5156;">https://kaptativa.com › proyectos › <span id="snippet-slug">slug-del-proyecto</span></div>
                      <div style="font-size: 0.95rem; color: #1a0dab; font-weight: 500; text-decoration: underline;" id="snippet-title">Título del Proyecto</div>
                      <div style="font-size: 0.78rem; color: #4d5156;" id="snippet-desc">Descripción que aparecerá en los resultados de Google...</div>
                    </div>
                  </div>
                </div>

              </div>

              <!-- RIGHT SIDEBAR COLUMN -->
              <div style="display: flex; flex-direction: column; gap: 14px; background: rgba(255,255,255,0.02); padding: 14px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.06); height: fit-content;">
                <div style="font-size: 0.85rem; font-weight: 600; color: white; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 6px;">
                  Ajustes de Publicación
                </div>

                <div>
                  <label class="form-label">Estado de Publicación</label>
                  <select id="proj-status" class="form-control" style="background: var(--bg-primary);">
                    <option value="published">🟢 Publicado</option>
                    <option value="draft">📝 Borrador</option>
                  </select>
                </div>

                <div>
                  <label class="form-label">Orden de Aparición (#)</label>
                  <input type="number" id="proj-order" min="1" value="1" class="form-control">
                </div>

                <div>
                  <label style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: white; cursor: pointer;">
                    <input type="checkbox" id="proj-featured">
                    ⭐ Marcar como Destacado
                  </label>
                </div>

                <div>
                  <label class="form-label">URL / Slug</label>
                  <input type="text" id="proj-slug" class="form-control" placeholder="plataforma-b2b">
                </div>

                <div>
                  <label class="form-label">Imagen Principal (URL / Mockup)</label>
                  <input type="text" id="proj-image" class="form-control" placeholder="https://images.unsplash.com/...">
                  <div style="margin-top: 8px; border-radius: 8px; overflow: hidden; height: 110px; background: #070a12; border: 1px solid rgba(255,255,255,0.08);">
                    <img id="proj-image-preview" src="" alt="Preview" style="width: 100%; height: 100%; object-fit: cover; display: none;" loading="lazy" decoding="async">
                    <div id="proj-image-empty" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.75rem;">Sin Imagen</div>
                  </div>
                </div>

                <div>
                  <label class="form-label">Galería (URLs separadas por comas)</label>
                  <textarea id="proj-gallery" rows="3" class="form-control" style="resize: vertical;" placeholder="https://..., https://..."></textarea>
                </div>

                <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 8px;">
                  <button type="submit" class="btn btn-primary" style="width: 100%;">
                    ✨ Guardar Proyecto
                  </button>
                  <button type="button" id="btn-cancel-project" class="btn btn-secondary" style="width: 100%;">
                    Cancelar
                  </button>
                </div>
              </div>

            </div>

          </form>

        </div>
      </div>

    </main>
  </div>
</AdminLayout>

<script>
  import { casesData } from '../../data/content.js';

  // Seed Data Initializer
  const INITIAL_KAPTATIVA_PROJECTS = casesData.map((c, i) => ({
    id: `proj-${i + 1}`,
    titulo: c.title,
    subtitle: `${c.tag} · Entregado`,
    category: c.category,
    tipo: c.tag,
    descripcionBreve: c.solution,
    descripcionCompleta: `<h2>Ficha Técnica del Caso</h2><p><strong>Problema inicial:</strong> ${c.problem}</p><p><strong>Solución implementada:</strong> ${c.solution}</p><p><strong>Resultado obtenido:</strong> ${c.result}</p>`,
    image: c.image.startsWith('http') ? c.image : `https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=600&q=80`,
    gallery: [c.image],
    cliente: c.title.split(' ')[0] + ' Corp',
    fecha: c.details?.[0]?.value || '3 Semanas',
    tech: 'Astro.js, TailwindCSS, TypeScript, Appwrite',
    servicios: c.tag,
    resultados: c.result,
    link: 'https://kaptativa.com',
    order: i + 1,
    destacado: true,
    status: 'published',
    slug: c.title.toLowerCase().replace(/[^\w\s-]/g, '').replace(/[\s_-]+/g, '-'),
    seoTitulo: `${c.title} | Casos de Éxito Kaptativa`,
    seoDescripcion: c.solution
  }));

  function getProjects() {
    try {
      const stored = localStorage.getItem('kaptativa_projects');
      if (stored) return JSON.parse(stored);
    } catch(e) {}
    localStorage.setItem('kaptativa_projects', JSON.stringify(INITIAL_KAPTATIVA_PROJECTS));
    return INITIAL_KAPTATIVA_PROJECTS;
  }

  function saveProjects(projects: any[]) {
    localStorage.setItem('kaptativa_projects', JSON.stringify(projects));
  }

  document.addEventListener('DOMContentLoaded', () => {
    let projectsList = getProjects();

    const tableBody = document.getElementById('projects-table-body');
    const modal = document.getElementById('project-modal');
    const form = document.getElementById('project-form') as HTMLFormElement;
    
    const btnNew = document.getElementById('btn-new-project');
    const btnClose = document.getElementById('btn-close-project-modal');
    const btnCancel = document.getElementById('btn-cancel-project');
    
    const searchInput = document.getElementById('project-search') as HTMLInputElement;
    const filterCat = document.getElementById('filter-category') as HTMLSelectElement;
    const filterSt = document.getElementById('filter-status') as HTMLSelectElement;

    // Form inputs
    const inputId = document.getElementById('proj-id') as HTMLInputElement;
    const inputTitle = document.getElementById('proj-title') as HTMLInputElement;
    const inputSubtitle = document.getElementById('proj-subtitle') as HTMLInputElement;
    const inputCategory = document.getElementById('proj-category') as HTMLSelectElement;
    const inputTipo = document.getElementById('proj-tipo') as HTMLInputElement;
    const inputDescShort = document.getElementById('proj-desc-short') as HTMLTextAreaElement;
    const inputDescFull = document.getElementById('proj-desc-full') as HTMLTextAreaElement;
    const inputClient = document.getElementById('proj-client') as HTMLInputElement;
    const inputDate = document.getElementById('proj-date') as HTMLInputElement;
    const inputTech = document.getElementById('proj-tech') as HTMLInputElement;
    const inputServices = document.getElementById('proj-services') as HTMLInputElement;
    const inputResults = document.getElementById('proj-results') as HTMLInputElement;
    const inputLink = document.getElementById('proj-link') as HTMLInputElement;
    const inputSeoTitle = document.getElementById('proj-seo-title') as HTMLInputElement;
    const inputSeoDesc = document.getElementById('proj-seo-desc') as HTMLTextAreaElement;
    const inputStatus = document.getElementById('proj-status') as HTMLSelectElement;
    const inputOrder = document.getElementById('proj-order') as HTMLInputElement;
    const inputFeatured = document.getElementById('proj-featured') as HTMLInputElement;
    const inputSlug = document.getElementById('proj-slug') as HTMLInputElement;
    const inputImage = document.getElementById('proj-image') as HTMLInputElement;
    const inputGallery = document.getElementById('proj-gallery') as HTMLTextAreaElement;

    const imgPreview = document.getElementById('proj-image-preview') as HTMLImageElement;
    const imgEmpty = document.getElementById('proj-image-empty');

    const snippetSlug = document.getElementById('snippet-slug');
    const snippetTitle = document.getElementById('snippet-title');
    const snippetDesc = document.getElementById('snippet-desc');

    function updateStats() {
      const totalEl = document.getElementById('stat-total');
      const pubEl = document.getElementById('stat-published');
      const featEl = document.getElementById('stat-featured');
      const draftEl = document.getElementById('stat-drafts');

      if (totalEl) totalEl.innerText = projectsList.length.toString();
      if (pubEl) pubEl.innerText = projectsList.filter((p: any) => p.status === 'published').length.toString();
      if (featEl) featEl.innerText = projectsList.filter((p: any) => p.destacado).length.toString();
      if (draftEl) draftEl.innerText = projectsList.filter((p: any) => p.status === 'draft').length.toString();
    }

    function renderTable() {
      updateStats();

      const query = searchInput?.value.toLowerCase().trim() || '';
      const catVal = filterCat?.value || 'all';
      const stVal = filterSt?.value || 'all';

      const filtered = projectsList.filter((p: any) => {
        if (catVal !== 'all' && p.category !== catVal) return false;
        if (stVal !== 'all' && p.status !== stVal) return false;
        if (!query) return true;
        return (
          p.titulo?.toLowerCase().includes(query) ||
          p.cliente?.toLowerCase().includes(query) ||
          p.tech?.toLowerCase().includes(query) ||
          p.slug?.toLowerCase().includes(query)
        );
      }).sort((a: any, b: any) => (a.order || 0) - (b.order || 0));

      if (!tableBody) return;

      if (filtered.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">
              🔍 No se encontraron proyectos con los filtros seleccionados.
            </td>
          </tr>
        `;
        return;
      }

      tableBody.innerHTML = filtered.map((proj: any, idx: number) => {
        const isPub = proj.status === 'published';
        const img = proj.image || 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=120&q=80';

        return `
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 4px;">
                <strong style="color: #38bdf8;">#${proj.order || idx + 1}</strong>
                <div style="display: flex; flex-direction: column; gap: 2px;">
                  <button data-reorder="${proj.id}" data-dir="up" style="background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 0.6rem; padding: 0;">▲</button>
                  <button data-reorder="${proj.id}" data-dir="down" style="background: none; border: none; color: #94a3b8; cursor: pointer; font-size: 0.6rem; padding: 0;">▼</button>
                </div>
              </div>
            </td>
            <td>
              <div style="display: flex; align-items: center; gap: 12px;">
                <img src="${img}" alt="${proj.titulo}" style="width: 44px; height: 44px; border-radius: 6px; object-fit: cover; background: #000;" / loading="lazy" decoding="async">
                <div>
                  <strong style="color: white; font-size: 0.9rem; display: block;">${proj.titulo}</strong>
                  <span style="font-size: 0.72rem; color: #38bdf8;">/proyectos/${proj.slug}</span>
                </div>
              </div>
            </td>
            <td>
              <span class="badge" style="text-transform: uppercase; font-size: 0.7rem;">${proj.category}</span>
            </td>
            <td style="text-align: center;">
              <button data-toggle-featured="${proj.id}" style="background: ${proj.destacado ? 'rgba(245,158,11,0.2)' : 'rgba(255,255,255,0.05)'}; color: ${proj.destacado ? '#f59e0b' : '#64748b'}; border: none; padding: 3px 8px; border-radius: 4px; font-weight: 600; cursor: pointer; font-size: 0.75rem;">
                ${proj.destacado ? '⭐ Sí' : '☆ No'}
              </button>
            </td>
            <td>
              <span class="admin-badge ${isPub ? 'admin-badge-emerald' : 'admin-badge-amber'}">
                ${isPub ? '🟢 Publicado' : '📝 Borrador'}
              </span>
            </td>
            <td style="text-align: right;">
              <div style="display: flex; gap: 6px; justify-content: flex-end;">
                <button data-edit="${proj.id}" title="Editar" class="btn btn-secondary btn-sm" style="padding: 4px 8px; font-size: 0.75rem;">✏️</button>
                <button data-duplicate="${proj.id}" title="Duplicar" class="btn btn-secondary btn-sm" style="padding: 4px 8px; font-size: 0.75rem; color: #38bdf8;">📋</button>
                <button data-delete="${proj.id}" title="Eliminar" class="btn btn-secondary btn-sm" style="padding: 4px 8px; font-size: 0.75rem; color: #ef4444;">🗑️</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Modal Handlers
    function openModal(project: any = null) {
      if (modal) modal.style.display = 'flex';
      
      if (project) {
        (document.getElementById('modal-project-title') as HTMLElement).innerText = '✏️ Editar Proyecto';
        inputId.value = project.id;
        inputTitle.value = project.titulo || '';
        inputSubtitle.value = project.subtitle || '';
        inputCategory.value = project.category || 'web';
        inputTipo.value = project.tipo || '';
        inputDescShort.value = project.descripcionBreve || '';
        inputDescFull.value = project.descripcionCompleta || '';
        inputClient.value = project.cliente || '';
        inputDate.value = project.fecha || '';
        inputTech.value = project.tech || '';
        inputServices.value = project.servicios || '';
        inputResults.value = project.resultados || '';
        inputLink.value = project.link || '';
        inputSeoTitle.value = project.seoTitulo || '';
        inputSeoDesc.value = project.seoDescripcion || '';
        inputStatus.value = project.status || 'published';
        inputOrder.value = (project.order || 1).toString();
        inputFeatured.checked = !!project.destacado;
        inputSlug.value = project.slug || '';
        inputImage.value = project.image || '';
        inputGallery.value = Array.isArray(project.gallery) ? project.gallery.join(', ') : (project.gallery || '');
      } else {
        (document.getElementById('modal-project-title') as HTMLElement).innerText = '➕ Crear Nuevo Proyecto';
        form.reset();
        inputId.value = '';
        inputOrder.value = (projectsList.length + 1).toString();
        inputFeatured.checked = true;
        inputCategory.value = 'web';
        inputStatus.value = 'published';
      }

      updateLivePreview();
    }

    function closeModal() {
      if (modal) modal.style.display = 'none';
    }

    function updateLivePreview() {
      if (snippetSlug) snippetSlug.innerText = inputSlug.value || 'slug-del-proyecto';
      if (snippetTitle) snippetTitle.innerText = inputSeoTitle.value || inputTitle.value || 'Título del Proyecto';
      if (snippetDesc) snippetDesc.innerText = inputSeoDesc.value || inputDescShort.value || 'Descripción en Google...';

      if (inputImage.value) {
        if (imgPreview) {
          imgPreview.src = inputImage.value;
          imgPreview.style.display = 'block';
        }
        if (imgEmpty) imgEmpty.style.display = 'none';
      } else {
        if (imgPreview) imgPreview.style.display = 'none';
        if (imgEmpty) imgEmpty.style.display = 'flex';
      }
    }

    // Auto slug on title change
    inputTitle?.addEventListener('input', () => {
      if (!inputId.value) {
        const autoSlug = inputTitle.value.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/[\s_-]+/g, '-');
        inputSlug.value = autoSlug;
        inputSeoTitle.value = inputTitle.value ? `${inputTitle.value} | Casos de Éxito Kaptativa` : '';
      }
      updateLivePreview();
    });

    [inputSlug, inputSeoTitle, inputSeoDesc, inputDescShort, inputImage].forEach(el => {
      el?.addEventListener('input', updateLivePreview);
    });

    btnNew?.addEventListener('click', () => openModal(null));
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    searchInput?.addEventListener('input', renderTable);
    filterCat?.addEventListener('change', renderTable);
    filterSt?.addEventListener('change', renderTable);

    // Delegate Table Actions
    tableBody?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest('button');
      if (!btn) return;

      const editId = btn.getAttribute('data-edit');
      const dupId = btn.getAttribute('data-duplicate');
      const delId = btn.getAttribute('data-delete');
      const toggleId = btn.getAttribute('data-toggle-featured');
      const reorderId = btn.getAttribute('data-reorder');
      const reorderDir = btn.getAttribute('data-dir');

      if (editId) {
        const proj = projectsList.find((p: any) => p.id === editId);
        if (proj) openModal(proj);
      }

      if (dupId) {
        const proj = projectsList.find((p: any) => p.id === dupId);
        if (proj) {
          const copy = {
            ...proj,
            id: `proj-${Date.now()}`,
            titulo: `${proj.titulo} (Copia)`,
            slug: `${proj.slug}-copia`,
            status: 'draft',
            order: projectsList.length + 1
          };
          projectsList.push(copy);
          saveProjects(projectsList);
          renderTable();
        }
      }

      if (delId) {
        if (confirm('¿Estás seguro de eliminar este proyecto del catálogo?')) {
          projectsList = projectsList.filter((p: any) => p.id !== delId);
          saveProjects(projectsList);
          renderTable();
        }
      }

      if (toggleId) {
        projectsList = projectsList.map((p: any) => p.id === toggleId ? { ...p, destacado: !p.destacado } : p);
        saveProjects(projectsList);
        renderTable();
      }

      if (reorderId) {
        const idx = projectsList.findIndex((p: any) => p.id === reorderId);
        if (idx !== -1) {
          if (reorderDir === 'up' && idx > 0) {
            const temp = projectsList[idx].order;
            projectsList[idx].order = projectsList[idx - 1].order;
            projectsList[idx - 1].order = temp;
          } else if (reorderDir === 'down' && idx < projectsList.length - 1) {
            const temp = projectsList[idx].order;
            projectsList[idx].order = projectsList[idx + 1].order;
            projectsList[idx + 1].order = temp;
          }
          saveProjects(projectsList);
          renderTable();
        }
      }
    });

    // Form Submit
    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const galleryArray = inputGallery.value
        ? inputGallery.value.split(',').map(s => s.trim()).filter(Boolean)
        : [inputImage.value];

      const projData = {
        id: inputId.value || `proj-${Date.now()}`,
        titulo: inputTitle.value,
        subtitle: inputSubtitle.value,
        category: inputCategory.value,
        tipo: inputTipo.value,
        descripcionBreve: inputDescShort.value,
        descripcionCompleta: inputDescFull.value,
        cliente: inputClient.value,
        fecha: inputDate.value,
        tech: inputTech.value,
        servicios: inputServices.value,
        resultados: inputResults.value,
        link: inputLink.value,
        seoTitulo: inputSeoTitle.value || `${inputTitle.value} | Casos de Éxito Kaptativa`,
        seoDescripcion: inputSeoDesc.value || inputDescShort.value,
        status: inputStatus.value,
        order: parseInt(inputOrder.value) || 1,
        destacado: inputFeatured.checked,
        slug: inputSlug.value || inputTitle.value.toLowerCase().replace(/\s+/g, '-'),
        image: inputImage.value || 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=600&q=80',
        gallery: galleryArray
      };

      const existsIdx = projectsList.findIndex((p: any) => p.id === projData.id);
      if (existsIdx !== -1) {
        projectsList[existsIdx] = projData;
      } else {
        projectsList.push(projData);
      }

      saveProjects(projectsList);
      renderTable();
      closeModal();
    });

    // Initial render
    renderTable();
  });
</script>
