  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
}
.inmo-toggle-label {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text-secondary);
  transition: color 0.3s ease;
  user-select: none;
}
.inmo-toggle-label.active {
  color: var(--text-primary);
  font-weight: 600;
}
.inmo-switch {
  position: relative;
  display: inline-block;
  width: 48px;
  height: 26px;
}
.inmo-switch input {
  opacity: 0;
  width: 0;
  height: 0;
}
.inmo-slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(255, 255, 255, 0.1);
  transition: .3s;
  border-radius: 34px;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
[data-theme="light"] .inmo-slider {
  background-color: rgba(0, 0, 0, 0.08);
  border-color: rgba(0, 0, 0, 0.05);
}
.inmo-slider:before {
  position: absolute;
  content: "";
  height: 18px;
  width: 18px;
  left: 3px;
  bottom: 3px;
  background-color: #d4ff00;
  transition: .3s;
  border-radius: 50%;
  box-shadow: 0 0 10px rgba(212, 255, 0, 0.5);
}
[data-theme="light"] .inmo-slider:before {
  background-color: var(--accent-indigo);
  box-shadow: 0 0 10px rgba(124, 58, 237, 0.3);
}
input:checked + .inmo-slider {
  background-color: rgba(212, 255, 0, 0.05);
}
[data-theme="light"] input:checked + .inmo-slider {
  background-color: rgba(124, 58, 237, 0.05);
}
input:checked + .inmo-slider:before {
  transform: translateX(22px);
}

