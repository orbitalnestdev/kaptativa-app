  }
  70% {
    transform: scale(1.2);
    opacity: 0.4;
    box-shadow: 0 0 0 8px rgba(234, 56, 77, 0);
  }
  100% {
    transform: scale(0.8);
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(234, 56, 77, 0);
  }
}
