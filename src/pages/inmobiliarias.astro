<!-- ==========================================================================
     SCRIPTS CLIENT-SIDE (VANILLA JAVASCRIPT EXTREMAMENTE OPTIMIZADO)
     COLOCADOS AL ROOT LEVEL DE ASTRO PARA EVITAR ERRORES DE COMPILACIÓN Y SCOPING
     ========================================================================== -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    /* ==========================================================
       1. PERSONALIZACIÓN DINÁMICA POR PARÁMETROS URL (UTM)
       ========================================================== */
    const urlParams = new URLSearchParams(window.location.search);
    const cityParam = urlParams.get('city');
    
    if (cityParam) {
      const headline = document.getElementById('dynamic-headline');
      if (headline) {
        const formattedCity = cityParam
          .replace(/([A-Z])/g, ' $1')
          .trim();
        const capitalizedCity = formattedCity.charAt(0).toUpperCase() + formattedCity.slice(1);
        headline.innerHTML = `Vender propiedades en <span class="text-outline">${capitalizedCity}</span> sin Web es un caos administrativo.`;
      }
    }

    /* ==========================================================
       2. ACORDEÓN DE PREGUNTAS FRECUENTES (FAQ)
       ========================================================== */
    const faqItems = document.querySelectorAll('.inmo-faq-item');
    faqItems.forEach(item => {
      const questionBtn = item.querySelector('.inmo-faq-question');
      const answer = item.querySelector('.inmo-faq-answer');
      
      if (questionBtn) {
        questionBtn.addEventListener('click', () => {
          const isOpen = item.classList.contains('open');
          
          faqItems.forEach(otherItem => {
            otherItem.classList.remove('open');
            const otherAnswer = otherItem.querySelector('.inmo-faq-answer');
            if (otherAnswer) otherAnswer.style.maxHeight = null;
          });
          
          if (!isOpen) {
            item.classList.add('open');
            if (answer) answer.style.maxHeight = answer.scrollHeight + "px";
          }
        });
      }
    });

    /* ==========================================================
       3. CALCULADORA DINÁMICA DE PRECIOS Y CROSS-SELLING
       ========================================================== */
    const pricingSwitch = document.getElementById('pricing-method-switch');
    
    const priceDisplay = document.getElementById('pricing-amount');
    const installmentsBadge = document.getElementById('pricing-installments-badge');
    const pricingCtaBtn = document.getElementById('pricing-cta-btn');
    
    const labelCuotas = document.getElementById('toggle-label-cuotas');
    const labelTransferencia = document.getElementById('toggle-label-transferencia');
    
    const CONTACT_WHATSAPP_NUMBER = "5493804890834";
    
    function updatePricing() {
      const isTransfer = pricingSwitch ? pricingSwitch.checked : false;
      
      let basePrice = 360000;
      let displayPriceText = "";
      let installmentsText = "";
      let ctaLink = "";
      
      if (isTransfer) {
        // Transferencia: 10% OFF
        const discountPrice = basePrice * 0.9;
        displayPriceText = `ARS ${discountPrice.toLocaleString('es-AR')}`;
        installmentsText = `⚡ Ahorrás ARS 36.000 pagando por transferencia`;
        if (labelCuotas) labelCuotas.classList.remove('active');
        if (labelTransferencia) labelTransferencia.classList.add('active');
        
        ctaLink = `/checkout?method=transfer`;
      } else {
        // Cuotas: Precio de lista normal
        displayPriceText = `ARS ${basePrice.toLocaleString('es-AR')}`;
        installmentsText = `3 cuotas sin interés de ARS ${(basePrice / 3).toLocaleString('es-AR')}`;
        if (labelCuotas) labelCuotas.classList.add('active');
        if (labelTransferencia) labelTransferencia.classList.remove('active');
        ctaLink = `/checkout?method=mp`;
      }
      
      if (priceDisplay) priceDisplay.textContent = displayPriceText;
      if (installmentsBadge) {
        if (isTransfer) {
          installmentsBadge.innerHTML = installmentsText;
          installmentsBadge.style.background = 'rgba(16, 185, 129, 0.08)';
          installmentsBadge.style.borderColor = 'rgba(16, 185, 129, 0.2)';
          installmentsBadge.style.color = '#10B981';
        } else {
          installmentsBadge.innerHTML = installmentsText;
          installmentsBadge.style.background = 'rgba(138, 53, 229, 0.08)';
          installmentsBadge.style.borderColor = 'rgba(138, 53, 229, 0.25)';
          installmentsBadge.style.color = '#ffffff';
        }
      }
      if (pricingCtaBtn) pricingCtaBtn.setAttribute('href', ctaLink);
    }
    
    if (pricingSwitch) pricingSwitch.addEventListener('change', updatePricing);

    /* ==========================================================
       4. CRONÓMETRO DE URGENCIA (COUNTDOWN TIMER TO MIDNIGHT)
       ========================================================== */
    const timerElement = document.getElementById('countdown-timer-top');
    
    function updateTimer() {
      const now = new Date();
      const midnight = new Date();
      midnight.setHours(23, 59, 59, 999); // Establecer al final de la jornada de hoy
      
      const diff = midnight - now;
      
      if (diff <= 0) {
        if (timerElement) timerElement.textContent = "00:00:00";
        return;
      }
      
      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);
      
      const formattedTime = [
        hours.toString().padStart(2, '0'),
        minutes.toString().padStart(2, '0'),
        seconds.toString().padStart(2, '0')
      ].join(':');
      
      if (timerElement) timerElement.textContent = formattedTime;
    }
    
    updateTimer();
    setInterval(updateTimer, 1000);

  });
</script>

