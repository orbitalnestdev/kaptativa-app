---
import Layout from '../layouts/Layout.astro';

// Configuración de Enlaces y Contactos (CRO / Campaña)
const MERCADO_PAGO_PLAN_BASE = import.meta.env.MERCADO_PAGO_PLAN_BASE || "https://link.mercadopago.com.ar/tu-link-de-pago-web";
const MERCADO_PAGO_PLAN_IA = import.meta.env.MERCADO_PAGO_PLAN_IA || "https://link.mercadopago.com.ar/tu-link-de-suscripcion-ia";
const CONTACT_WHATSAPP_NUMBER = import.meta.env.CONTACT_WHATSAPP_NUMBER || "5493804890834";

// Generar enlaces dinámicos de WhatsApp
const waContactUrl = `https://wa.me/${CONTACT_WHATSAPP_NUMBER}?text=Hola,%20vi%20la%20Landing%20Inmobiliaria%20y%20quiero%20hacerles%20una%20consulta`;
const waDemoUrl = `https://wa.me/${CONTACT_WHATSAPP_NUMBER}?text=Hola,%20vi%20la%20Landing%20Inmobiliaria%20y%20quiero%20una%20demo%20de%20mi%20marca`;
---

<Layout title="Inmo-Scale 360° | Software de Gestión y Catálogos Web Inmobiliarios" description="La plataforma digital inmobiliaria completa llave en mano. Tu panel de control administrativo, tu sitio web público ultra-rápido, tu CRM integrado y tu Agente IA de WhatsApp que atiende y agenda consultas 24/7.">
  
  <!-- JSON-LD Structured Data: SoftwareApplication & RealEstateAgent Service -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Inmo-Scale 360°",
    "operatingSystem": "All",
    "applicationCategory": "BusinessApplication",
    "browserRequirements": "Requires HTML5/JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "360000.00",
      "priceCurrency": "ARS"
    },
    "description": "Infraestructura digital exclusiva para inmobiliarias: Portal de propiedades premium autogestionable, CRM operativo integrado con embudo Kanban y módulo opcional de Agente IA en WhatsApp que atiende y califica consultas 24/7.",
    "softwareHelp": {
      "@type": "CreativeWork",
      "name": "Kaptativa Soporte Técnico y Setup Llave en Mano"
    }
  }
  </script>

  <!-- ==========================================================================
       HEADER DE CAMPAÑA PREMIUM (CERO FUGAS DE CONVERSIÓN)
       ========================================================================== -->
  <div slot="header">
    <!-- Barra de Anuncios / Urgencia Superior (CRO Toolbar) -->
    <div class="inmo-top-announcement-bar" id="top-urgency-bar">
      <div class="container inmo-top-bar-container">
        <div class="inmo-top-bar-content">
          <span class="pulse-dot"></span>
          <span class="scarcity-text">Solo 3 cupos disponibles</span>
          <span class="scarcity-divider">|</span>
          <span class="scarcity-timer"><span class="hide-mobile">La oferta termina en: </span><strong id="countdown-timer-top">00:00:00</strong></span>
        </div>
      </div>
    </div>

    <header class="header inmo-campaign-header" id="header">
      <div class="container inmo-header-container">
        <a href="/" class="logo" id="logo-brand" aria-label="Volver al inicio de Kaptativa">
          <svg class="header-logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="150" height="34" style="display: block;">
            <defs>
              <linearGradient id="logo-gradient-inmo" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#EA384D" />
                <stop offset="100%" stop-color="#8A35E5" />
              </linearGradient>
            </defs>
            <g>
              <path d="M 6 13 L 6 47" stroke="url(#logo-gradient-inmo)" stroke-width="6.5" stroke-linecap="round" fill="none" />
              <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-gradient-inmo)" stroke-width="6.5" stroke-linecap="round" fill="none" />
              <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-gradient-inmo)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </g>
            <text x="44" y="39" font-family="'Lexend', 'Inter', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">
              kaptativa<tspan fill="#EA384D">.</tspan>
            </text>
          </svg>
        </a>
        
        <nav class="nav inmo-nav" id="main-navigation">
          <a href="#solucion" class="nav-link">Cómo Funciona</a>
          <a href="/inmo-demo" target="_blank" rel="noopener noreferrer" class="nav-link">Demo</a>
          <a href="#planes" class="nav-link">Precio</a>
          <a href="#faq" class="nav-link">FAQ</a>
        </nav>
        
        <div class="header-actions">
          <!-- Selector de Tema -->
          <button class="theme-toggle-btn" id="theme-toggle" aria-label="Cambiar tema de color">
            <svg class="moon-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
            </svg>
            <svg class="sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
            </svg>
          </button>
          
          <a href="#planes" class="btn btn-primary btn-sm">Quiero este sistema</a>
          
          <button class="mobile-toggle" id="mobile-menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
  </div>

  <main class="inmo-main-content">
    <!-- ==========================================================================
         HERO SECTION: LA PROMESA COMERCIAL
         ========================================================================== -->
    <section class="inmo-hero" id="inicio">
      <div class="inmo-hero-glow"></div>
      <div class="container">
        <div class="inmo-hero-wrapper">
          <div class="inmo-hero-info reveal">
            <span class="badge inmo-badge-gray">SISTEMA INMOBILIARIO WEB + CRM</span>
            <h1 class="inmo-hero-title" id="dynamic-headline">
              Tu portal inmobiliario y CRM, integrados en un solo sistema
            </h1>
            <p class="inmo-hero-desc">
              Publicá propiedades, centralizá consultas y organizá el seguimiento comercial desde una plataforma diseñada para tu inmobiliaria.
            </p>
            <div class="inmo-hero-ctas">
              <a href="/inmo-demo" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg inmo-btn-pulse">Ver demostración</a>
              <a href="#planes" class="btn btn-secondary btn-lg">Quiero este sistema</a>
            </div>

            <div class="inmo-hero-social-proof">
              <div class="inmo-avatar-stack">
                <img loading="lazy" decoding="async" class="inmo-proof-avatar-badge" src="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=250&q=80" alt="Inmobiliaria Registrada 1" width="40" height="40" style="object-fit: cover; border: 2px solid rgba(255, 255, 255, 0.2); box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                <img loading="lazy" decoding="async" class="inmo-proof-avatar-badge" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=250&q=80" alt="Inmobiliaria Registrada 2" width="40" height="40" style="object-fit: cover; border: 2px solid rgba(255, 255, 255, 0.2); box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                <img loading="lazy" decoding="async" class="inmo-proof-avatar-badge" src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?auto=format&fit=crop&w=250&q=80" alt="Inmobiliaria Registrada 3" width="40" height="40" style="object-fit: cover; border: 2px solid rgba(255, 255, 255, 0.2); box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                <img loading="lazy" decoding="async" class="inmo-proof-avatar-badge" src="/broker_4.jpg" alt="Inmobiliaria Registrada 4" width="40" height="40" style="object-fit: cover; border: 2px solid rgba(255, 255, 255, 0.2); box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
              </div>
              <div class="inmo-proof-text">
                <strong>Más de 30 inmobiliarias</strong> ya gestionan su operación con nuestra tecnología
              </div>
            </div>
            
            <div class="inmo-hero-trust-bar">
              <span class="inmo-trust-badge-mini" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-pink);"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                Pago Único
              </span>
              <span class="inmo-trust-badge-mini" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-pink);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Garantía de 30 Días
              </span>
              <span class="inmo-trust-badge-mini" style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-pink);"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                Web + Sistema CRM
              </span>
            </div>
          </div>
          
          <div class="inmo-hero-visual reveal">
            <div class="inmo-layered-mockup">
              
              <!-- 1. BASE LAYER: PUBLIC PROPERTY PORTAL WEB MOCKUP -->
              <div class="inmo-browser-mockup inmo-glass-panel">
                <div class="inmo-browser-header">
                  <div class="inmo-browser-dots">
                    <span class="dot red"></span>
                    <span class="dot yellow"></span>
                    <span class="dot green"></span>
                  </div>
                  <div class="inmo-browser-address">tuinmobiliaria.com/propiedades/palermo-modern</div>
                </div>
                
                <div class="inmo-browser-body">
                  <!-- Real Estate Listing Header -->
                  <div class="inmo-listing-nav">
                    <span class="inmo-listing-logo">Premium Inmuebles</span>
                    <div class="inmo-listing-menu">
                      <span>Comprar</span>
                      <span>Alquilar</span>
                      <span>Tasar</span>
                    </div>
                  </div>
                  
                  <!-- Real Estate Property Info & Visual -->
                  <div class="inmo-listing-hero">
                    <div class="inmo-listing-img-placeholder" style="position: relative; overflow: hidden; height: 185px; border-radius: 12px;">
                      <img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1000&q=80" alt="Departamento Moderno en Palermo" style="width: 100%; height: 100%; object-fit: cover;" />
                      <div class="inmo-listing-tag" style="position: absolute; top: 12px; left: 12px; z-index: 2;">VENTA EXCLUSIVA</div>
                    </div>
                    
                    <div class="inmo-listing-details">
                      <span class="inmo-listing-price">USD 245.000</span>
                      <h4 class="inmo-listing-title">Departamento moderno en Palermo</h4>
                      <p class="inmo-listing-meta">3 ambientes · 85 m² · Cochera</p>
                      
                      <!-- Search simulator inside the page -->
                      <div class="inmo-listing-search-bar">
                        <span>🔍 Palermo, 3 ambientes…</span>
                        <span class="search-btn">Buscar</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- 2. FOREGROUND LAYER 1: WHATSAPP IA AGENT LIVE CHAT (FLOATING OVERLAY) -->
              <div class="inmo-phone-chat-overlay inmo-glass-panel">
                <div class="inmo-chat-header">
                  <div class="inmo-chat-user">
                    <div class="inmo-chat-avatar">IA</div>
                    <div>
                      <div class="inmo-chat-name">Sofía IA — Asesora inmobiliaria</div>
                      <div class="inmo-chat-subtitle">Atención inmediata 🟢</div>
                    </div>
                  </div>
                </div>
                <div class="inmo-chat-messages">
                  <div class="inmo-msg incoming">¿Qué expensas tiene?</div>
                  <div class="inmo-msg outgoing">Son $45.000. ¿Querés coordinar una visita?</div>
                  <div class="inmo-msg incoming">Sí, el martes por la tarde.</div>
                  <div class="inmo-msg outgoing">¡Listo! Agendé tu visita para el martes a las 16:30. 📅</div>
                </div>
              </div>
              
              <!-- 3. FOREGROUND LAYER 2: CRM CONSOLE CARD (FLOATING OVERLAY) -->
              <div class="inmo-crm-card-overlay inmo-glass-panel">
                <div class="inmo-crm-header">
                  <span class="crm-indicator">● CRM COMERCIAL</span>
                  <span class="crm-title">Visita agendada</span>
                </div>
                <div class="inmo-crm-lead-info">
                  <div class="lead-avatar">PG</div>
                  <div>
                    <div class="lead-name">Pedro Gómez</div>
                    <div class="lead-detail">Palermo · Martes 16:30</div>
                  </div>
                </div>
                <span class="lead-badge-status">Contacto calificado por IA</span>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    </section>



    <!-- ==========================================================================
         SECCIÓN DOLORES CRÍTICOS: IDENTIFICACIÓN DEL DOLOR INMOBILIARIO
         ========================================================================== -->
    <section class="section inmo-dolores-section" id="dolores">
      <div class="container">
        <div class="section-header reveal">
          <span class="badge inmo-badge-gray">FUGAS OPERATIVAS</span>
          <h2>Lo que pierde tu inmobiliaria cuando depende solo de <span class="text-outline-purple">Instagram y WhatsApp</span></h2>
          <p>Instagram y WhatsApp ayudan a generar consultas, pero no alcanzan para organizar propiedades, realizar seguimientos y escalar la operación comercial.</p>
        </div>
        
        <div class="inmo-dolores-grid reveal">
          <!-- Tarjeta 1: Propiedades difíciles de encontrar -->
          <div class="inmo-pain-card inmo-glass-panel">
            <div class="inmo-pain-icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3>Propiedades difíciles de encontrar</h3>
            <p>Las publicaciones desaparecen rápidamente del feed. Sin un catálogo organizado, los interesados no pueden buscar fácilmente por zona, precio, ambientes o tipo de propiedad.</p>
          </div>
          
          <!-- Tarjeta 2: Consultas que se enfrían -->
          <div class="inmo-pain-card inmo-glass-panel">
            <div class="inmo-pain-icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3>Consultas que se enfrían</h3>
            <p>Las demoras reducen las posibilidades de concretar una visita. Las consultas que llegan fuera de horario pueden perderse antes de que un asesor pueda responderlas.</p>
          </div>
          
          <!-- Tarjeta 3: Horas perdidas enviando información -->
          <div class="inmo-pain-card inmo-glass-panel">
            <div class="inmo-pain-icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <h3>Horas perdidas enviando información</h3>
            <p>Buscar fotografías, preparar fichas y enviar archivos manualmente consume tiempo que tu equipo podría dedicar a captar propiedades, realizar visitas y cerrar operaciones.</p>
          </div>
          
          <!-- Tarjeta 4: Menor confianza para captar exclusivas -->
          <div class="inmo-pain-card inmo-glass-panel">
            <div class="inmo-pain-icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
            </div>
            <h3>Menor confianza para captar exclusivas</h3>
            <p>Los propietarios buscan una inmobiliaria que proyecte profesionalismo y confianza. Una web propia, moderna y bien posicionada fortalece tu marca y mejora la captación de propiedades exclusivas.</p>
          </div>
        </div>
      </div>
    </section>



    <!-- ==========================================================================
         EL SERVICIO: DESGLOSE DEL SOFTWARE QUE ENTREGAMOS (INMO-SCALE 360)
         ========================================================================== -->
    <section class="section inmo-service-details-section" id="solucion">
      <div class="container">
        <div class="section-header reveal">
          <span class="badge inmo-badge-gray">EL SISTEMA INTEGRAL</span>
          <h2>Tu ecosistema inmobiliario, <span class="text-outline">conectado en una sola plataforma</span></h2>
          <p>Integramos la web, el CRM, las consultas, la agenda y las automatizaciones para que puedas publicar propiedades, administrar oportunidades y acompañar a cada cliente desde un único sistema.</p>
        </div>
        
        <div class="inmo-specs-grid reveal">
          
          <!-- Tarjeta 1: Portal Inmobiliario -->
          <div class="inmo-spec-card inmo-glass-panel">
            <div class="inmo-card-watermark-bg">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3zm0 2.84L18 11v7h-2v-6H8v6H6v-7l6-5.16z"/></svg>
            </div>
            <div class="inmo-spec-icon-wrapper inmo-crimson-icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            </div>
            <div class="inmo-spec-text">
              <h3>1. Portal inmobiliario de alto rendimiento</h3>
              <p>Una web profesional, rápida y adaptada a la identidad de tu inmobiliaria, diseñada para mostrar propiedades y generar consultas con una arquitectura optimizada para alta velocidad.</p>
              <ul class="inmo-spec-features-list">
                <li><span>✓</span> <span>Diseño personalizado con marca propia</span></li>
                <li><span>✓</span> <span>Catálogo autogestionable de propiedades</span></li>
                <li><span>✓</span> <span>Buscador por operación, zona, precio, ambientes y tipología</span></li>
                <li><span>✓</span> <span>Fichas con fotos, mapas y tours 360°</span></li>
                <li><span>✓</span> <span>Formularios de consulta y solicitud de tasaciones</span></li>
                <li><span>✓</span> <span>Contacto directo por WhatsApp</span></li>
                <li><span>✓</span> <span>Diseño responsive para celular, tablet y computadora</span></li>
                <li><span>✓</span> <span>Optimización SEO local y estructura orientada a conversión</span></li>
                <li><span>✓</span> <span>Dominio propio, certificado SSL y protección de datos</span></li>
              </ul>
            </div>
          </div>

          <!-- Tarjeta 2: Panel de control e integraciones -->
          <div class="inmo-spec-card inmo-glass-panel">
            <div class="inmo-card-watermark-bg">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 2H9c-1.1 0-2 .9-2 2v4H5c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM5 20V10h2v10H5zm6 0V4h8v16h-8zm2-14h2v2h-2V6zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2zm4-8h2v2h-2V6zm0 4h2v2h-2v-2zm0 4h2v2h-2v-2z"/></svg>
            </div>
            <div class="inmo-spec-icon-wrapper inmo-indigo-icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"></path></svg>
            </div>
            <div class="inmo-spec-text">
              <h3>2. Panel de control e integraciones</h3>
              <p>Centralizá la información de tu negocio y mantené actualizado el catálogo mediante integraciones con plataformas externas.</p>
              <ul class="inmo-spec-features-list">
                <li><span>✓</span> <span>Panel centralizado de administración</span></li>
                <li><span>✓</span> <span>Estadísticas de visitas, consultas y favoritos</span></li>
                <li><span>✓</span> <span>Identificación del origen de cada oportunidad</span></li>
                <li><span>✓</span> <span>Integración con Tokko Broker y otras plataformas</span></li>
                <li><span>✓</span> <span>Importación y actualización automática de propiedades</span></li>
                <li><span>✓</span> <span>Sincronización con bases de datos externas mediante API</span></li>
                <li><span>✓</span> <span>Control del estado de las integraciones</span></li>
                <li><span>✓</span> <span>Reportes comerciales y de rendimiento</span></li>
              </ul>
              <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 12px; font-style: italic; line-height: 1.3;">
                Las integraciones dependen de la disponibilidad y los permisos de la API de cada plataforma.
              </p>
            </div>
          </div>

