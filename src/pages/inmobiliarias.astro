.inmo-browser-mockup {
    width: 100%;
    background: rgba(15, 23, 42, 0.45) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    border-radius: 14px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3) !important;
    overflow: hidden;
    font-family: 'Lexend', sans-serif;
  }
.inmo-browser-header {
    background: rgba(10, 10, 12, 0.5);
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
.inmo-browser-dots {
    display: flex;
    gap: 6px;
  }
.inmo-browser-dots .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
.inmo-browser-dots .dot.red { background: #ff5f56; }
.inmo-browser-dots .dot.yellow { background: #ffbd2e; }
.inmo-browser-dots .dot.green { background: #27c93f; }
.inmo-browser-address {
    font-size: 0.65rem;
    color: #475569;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 3px 12px;
    border-radius: 6px;
    flex-grow: 1;
    text-align: center;
    font-family: monospace;
  }

.inmo-browser-body {
    padding: 16px;
  }
.inmo-listing-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding-bottom: 8px;
    margin-bottom: 12px;
  }
.inmo-listing-logo {
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
  }
.inmo-listing-menu {
    display: flex;
    gap: 10px;
    font-size: 0.65rem;
    color: #64748b;
  }

.inmo-listing-hero {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
.inmo-listing-img-placeholder {
    width: 100%;
    height: 140px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(139, 92, 246, 0.1) 100%);
    border-radius: 8px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
.inmo-listing-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #d4ff00;
    color: #000;
    font-size: 0.55rem;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
  }
/* Drawing a simple geometric house vector */
.inmo-house-vector {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 60px;
  }
.inmo-house-vector .house-roof {
    width: 0;
    height: 0;
    border-left: 30px solid transparent;
    border-right: 30px solid transparent;
    border-bottom: 20px solid rgba(16, 185, 129, 0.8);
  }
.inmo-house-vector .house-wall {
    width: 50px;
    height: 30px;
    background: rgba(139, 92, 246, 0.6);
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding: 0 8px;
  }
.inmo-house-vector .house-window {
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.7);
    border-radius: 2px;
  }

.inmo-listing-details {
    text-align: left;
  }
.inmo-listing-price {
    font-size: 1.25rem;
    font-weight: 600;
    color: #d4ff00;
  }
.inmo-listing-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    margin: 4px 0;
  }
.inmo-listing-meta {
    font-size: 0.7rem;
    color: #64748b;
    margin-bottom: 12px;
  }
.inmo-listing-search-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.7rem;
    color: #475569;
  }
.inmo-listing-search-bar .search-btn {
    background: var(--accent-indigo);
    color: #fff;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 0.6rem;
    font-weight: 600;
  }

/* Floating overlay: WhatsApp IA Agent */
.inmo-phone-chat-overlay {
    position: absolute;
    bottom: 20px;
    right: -25px;
    width: 250px;
    border-radius: 12px;
    padding: 10px;
    background: rgba(10, 10, 12, 0.85) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 15px 30px rgba(0,0,0,0.4) !important;
    font-family: 'Lexend', sans-serif;
    z-index: 10;
    animation: floatEffect 6s ease-in-out infinite;
  }
.inmo-phone-chat-overlay .inmo-chat-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 6px;
    margin-bottom: 8px;
  }
.inmo-phone-chat-overlay .inmo-chat-user {
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
.inmo-phone-chat-overlay .inmo-chat-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #EA384D;
    color: #000;
    font-size: 0.65rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
.inmo-phone-chat-overlay .inmo-chat-name {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
  }
.inmo-phone-chat-overlay .inmo-chat-subtitle {
    font-size: 0.55rem;
    color: #10b981;
  }
.inmo-phone-chat-overlay .inmo-chat-messages {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
.inmo-phone-chat-overlay .inmo-msg {
    max-width: 85%;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 0.65rem;
    line-height: 1.3;
  }
.inmo-phone-chat-overlay .inmo-msg.incoming {
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    align-self: flex-start;
    border-bottom-left-radius: 1px;
  }
.inmo-phone-chat-overlay .inmo-msg.outgoing {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(139, 92, 246, 0.2) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
    align-self: flex-end;
    border-bottom-right-radius: 1px;
  }

/* Floating overlay: CRM card */
.inmo-crm-card-overlay {
    position: absolute;
    top: 20px;
    left: -25px;
    width: 210px;
    padding: 10px;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 15px 30px rgba(0,0,0,0.4) !important;
    font-family: 'Lexend', sans-serif;
    z-index: 10;
    animation: floatEffect 6s ease-in-out infinite 3s;
  }
.inmo-crm-card-overlay .inmo-crm-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 6px;
    margin-bottom: 8px;
    font-size: 0.55rem;
  }
.inmo-crm-card-overlay .crm-indicator {
    color: #a78bfa;
    font-weight: 600;
  }
.inmo-crm-card-overlay .crm-title {
    color: #64748b;
  }
.inmo-crm-card-overlay .inmo-crm-lead-info {
    display: flex;
    align-items: center;
    gap: 8px;
    text-align: left;
  }
.inmo-crm-card-overlay .lead-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.2);
    color: #a78bfa;
    font-size: 0.65rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(139, 92, 246, 0.3);
  }
.inmo-crm-card-overlay .lead-name {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
  }
.inmo-crm-card-overlay .lead-detail {
    font-size: 0.55rem;
    color: #64748b;
  }
.inmo-crm-card-overlay .lead-badge-status {
    display: inline-block;
    font-size: 0.55rem;
    font-weight: 600;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    margin-top: 8px;
    text-align: center;
    width: fit-content;
  }

/* Animations */
@keyframes floatEffect {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-8px); }
}

/* Light Theme Overrides for Layered Mockup */
[data-theme="light"] .inmo-browser-mockup {
    background: rgba(255, 255, 255, 0.75) !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08) !important;
  }
[data-theme="light"] .inmo-browser-header {
    background: rgba(0, 0, 0, 0.03);
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }
[data-theme="light"] .inmo-browser-address {
    color: #64748b;
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.04);
  }
[data-theme="light"] .inmo-listing-logo {
    color: #0f172a;
  }
[data-theme="light"] .inmo-listing-title {
    color: #0f172a;
  }
[data-theme="light"] .inmo-listing-search-bar {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.04);
    color: #64748b;
  }
[data-theme="light"] .inmo-phone-chat-overlay {
    background: rgba(255, 255, 255, 0.95) !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
  }
[data-theme="light"] .inmo-phone-chat-overlay .inmo-chat-header {
    border-bottom-color: rgba(0, 0, 0, 0.06);
  }
[data-theme="light"] .inmo-phone-chat-overlay .inmo-chat-name {
    color: #0f172a;
  }
[data-theme="light"] .inmo-phone-chat-overlay .inmo-msg.incoming {
    background: rgba(0, 0, 0, 0.04);
    color: #334155;
  }
[data-theme="light"] .inmo-phone-chat-overlay .inmo-msg.outgoing {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(16, 185, 129, 0.08) 100%);
    border-color: rgba(124, 58, 237, 0.1);
    color: #0f172a;
  }
[data-theme="light"] .inmo-crm-card-overlay {
    background: rgba(255, 255, 255, 0.95) !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
  }
[data-theme="light"] .inmo-crm-card-overlay .inmo-crm-header {
    border-bottom-color: rgba(0, 0, 0, 0.06);
  }
[data-theme="light"] .inmo-crm-card-overlay .lead-name {
    color: #0f172a;
  }
[data-theme="light"] .inmo-crm-card-overlay .lead-avatar {
    background: rgba(124, 58, 237, 0.08);
    border-color: rgba(124, 58, 237, 0.15);
  }
/* Badges */
.badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin-bottom: 15px;
    border: 1px solid rgba(255,255,255,0.08);
  }
.inmo-badge {
    background: rgba(124, 58, 237, 0.1);
    color: var(--accent-indigo);
    border-color: rgba(124, 58, 237, 0.2);
  }
.inmo-badge-green {
    background: rgba(16, 185, 129, 0.1);
    color: #10B981;
    border-color: rgba(16, 185, 129, 0.2);
  }
.inmo-badge-indigo {
    background: rgba(124, 58, 237, 0.1);
    color: var(--accent-indigo);
    border-color: rgba(124, 58, 237, 0.2);
  }
.inmo-badge-gray {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    border-color: rgba(255, 255, 255, 0.1);
  }
[data-theme="light"] .inmo-badge-gray {
    background: rgba(0, 0, 0, 0.04);
    color: #64748b;
    border-color: rgba(0, 0, 0, 0.08);
  }
/* Secciones Estándar */
.section {
    padding: 100px 0;
    position: relative;
  }
.text-outline-purple {
    background-image: var(--gradient-text-crimson);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: var(--accent-crimson);
    -webkit-text-stroke: 0px;
    font-weight: 600;
  }
.section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px;
  }
.section-header h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-family: 'Lexend', sans-serif;
    font-weight: 600;
    margin-bottom: 15px;
    color: var(--text-primary);
  }
.section-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }
/* Glass Panels */
.inmo-glass-panel {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    backdrop-filter: blur(14px);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 10px 30px rgba(0,0,0,0.25);
  }
/* Dolores Section Cards */
.inmo-dolores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
.inmo-pain-card {
    padding: 40px 30px;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
.inmo-pain-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-indigo);
    box-shadow: 0 10px 30px var(--accent-indigo-glow);
  }
.inmo-pain-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
.inmo-pain-card:nth-child(1) .inmo-pain-icon {
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.15);
    box-shadow: 0 4px 15px rgba(239, 68, 68, 0.05);
  }
.inmo-pain-card:nth-child(2) .inmo-pain-icon {
    background: rgba(167, 139, 250, 0.08);
    color: #a78bfa;
    border: 1px solid rgba(167, 139, 250, 0.15);
    box-shadow: 0 4px 15px rgba(167, 139, 250, 0.05);
  }
.inmo-pain-card:nth-child(3) .inmo-pain-icon {
    background: rgba(245, 158, 11, 0.08);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.15);
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.05);
  }
.inmo-pain-card:nth-child(4) .inmo-pain-icon {
    background: rgba(16, 185, 129, 0.08);
    color: #EA384D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.05);
  }
/* Light theme overrides for pain card icons */
[data-theme="light"] .inmo-pain-card:nth-child(1) .inmo-pain-icon { background: rgba(239, 68, 68, 0.04); }
[data-theme="light"] .inmo-pain-card:nth-child(2) .inmo-pain-icon { background: rgba(167, 139, 250, 0.04); }
[data-theme="light"] .inmo-pain-card:nth-child(3) .inmo-pain-icon { background: rgba(245, 158, 11, 0.04); }
[data-theme="light"] .inmo-pain-card:nth-child(4) .inmo-pain-icon { background: rgba(16, 185, 129, 0.04); }
.inmo-pain-card h3 {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text-primary);
    font-family: 'Lexend', sans-serif;
  }
.inmo-pain-card p {
    font-size: 1.0rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }
/* Service Package: Specs List Grid */
.inmo-specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }
.inmo-specs-grid .span-2 {
    grid-column: span 2;
  }
.inmo-spec-card {
    display: flex;
    gap: 25px;
    padding: 35px;
    align-items: flex-start;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
    position: relative;
    overflow: hidden;
  }
.inmo-card-watermark-bg {
    position: absolute;
    right: -25px;
    bottom: -25px;
    width: 170px;
    height: 170px;
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
    transition: opacity 0.35s ease, transform 0.35s ease, color 0.35s ease;
    color: var(--text-primary);
  }
.inmo-spec-card:hover .inmo-card-watermark-bg {
    opacity: 0.14;
    transform: scale(1.1) rotate(-4deg);
    color: #EA384D;
  }
.inmo-spec-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-hover);
  }
.inmo-spec-icon-wrapper {
    background: rgba(124, 58, 237, 0.1);
    color: var(--accent-indigo);
    padding: 16px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 15px rgba(124,58,237,0.1);
  }
.inmo-spec-icon-wrapper.inmo-crimson-icon {
    background: rgba(234, 56, 77, 0.1);
    color: #EA384D;
    box-shadow: 0 4px 15px rgba(234, 56, 77, 0.1);
  }
.inmo-spec-icon-wrapper.inmo-indigo-icon {
    background: rgba(124, 58, 237, 0.1);
    color: var(--accent-indigo);
    box-shadow: 0 4px 15px rgba(124,58,237,0.1);
  }
.inmo-spec-icon-wrapper.inmo-orange-icon {
    background: rgba(249, 115, 22, 0.1);
    color: #F97316;
    box-shadow: 0 4px 15px rgba(249,115,22,0.1);
  }
.inmo-spec-icon-wrapper.inmo-green-icon {
    background: rgba(16, 185, 129, 0.1);
    color: #10B981;
    box-shadow: 0 4px 15px rgba(16,185,129,0.1);
  }
.inmo-spec-text h3 {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text-primary);
  }
.inmo-spec-text p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 18px;
  }
.inmo-spec-features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
.inmo-spec-features-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.9rem;
    line-height: 1.4;
  }
.inmo-spec-features-list li span:first-child {
    color: var(--accent-crimson);
    font-weight: 600;
    flex-shrink: 0;
  }
.inmo-spec-features-list li span:last-child {
    color: var(--text-secondary);
  }
/* Hero Mockup Overlay Responsive Styles */
@media (max-width: 768px) {
  .inmo-layered-mockup {
    max-width: 320px !important;
    padding: 20px 0 !important;
  }
  .inmo-phone-chat-overlay {
    width: 200px !important;
    right: -10px !important;
    bottom: 10px !important;
  }
  .inmo-crm-card-overlay {
    width: 170px !important;
    left: -10px !important;
    top: 10px !important;
  }
}


/* Featured Plan Static Border Glow */
.featured-plan.neon-style {
  position: relative;
  border: 1px solid rgba(138, 53, 229, 0.35) !important;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(138, 53, 229, 0.12) !important;
  background: radial-gradient(circle at top right, rgba(138, 53, 229, 0.08) 0%, rgba(15, 21, 36, 0.85) 60%) !important;
  border-radius: 24px;
}
.featured-plan.neon-style::before,
.featured-plan.neon-style::after {
  display: none !important;
  content: none !important;
  animation: none !important;
}
.featured-plan.neon-style > * {
  position: relative;
  z-index: 1;
}

/* Light theme overrides for Neon */
[data-theme="light"] .featured-plan.neon-style::after {
  background: rgba(255, 255, 255, 0.95);
}

/* Pricing Section Styling */
.inmo-pricing-section {
    position: relative;
    padding: 100px 0;
  }
.inmo-pricing-container {
    max-width: 540px;
    margin: 40px auto 0;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
.inmo-pricing-features-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 25px 0 0 0;
  }
.inmo-pricing-features-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--text-secondary);
  }
.inmo-pricing-features-list li .feature-check {
    color: #10B981;
    font-weight: 600;
    flex-shrink: 0;
  }

.inmo-pricing-card-upgrade {
    width: 100%;
    padding: 35px 30px;
    border-radius: var(--border-radius-md);
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 15px;
    text-align: left;
    transition: border-color var(--transition-normal), box-shadow var(--transition-normal);
  }
.inmo-pricing-card-upgrade:hover {
