---
import DemoSistema from '../components/DemoSistema.jsx';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kaptativa CRM | Demostración del Sistema</title>
  <meta name="description" content="Explora el panel administrativo autogestionable en tiempo real. Gestioná propiedades, controlá contratos de alquiler, redactá artículos SEO y configurá tu bot de WhatsApp.">
  <link rel="icon" type="image/svg+xml" href="/logo.svg">
  
  <!-- CDN Preconnects & DNS Prefetch -->
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
  <link rel="dns-prefetch" href="https://images.unsplash.com">
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lexend:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script is:inline>
    // Force light theme for this demo system
    document.documentElement.setAttribute('data-theme', 'light');
  </script>

  <style is:global>
    * {
      font-family: 'Lexend', sans-serif !important;
    }
  </style>
</head>
<body style="background: #f8fafc; margin: 0; padding: 0; height: 100vh; width: 100vw; overflow: hidden; font-family: 'Lexend', sans-serif;">
  
  <!-- Light CRM Dashboard full screen -->
  <DemoSistema client:only="react" />

</body>
</html>

