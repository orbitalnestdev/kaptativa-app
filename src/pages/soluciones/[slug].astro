---
// Página de solución por rubro. Sigue el patrón de /servicios/* (hero, indicadores, comparación,
// pilares, FAQ y cierre) y suma lo de la referencia: módulos y otras soluciones.
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { svg, soluciones, modulos } from '../../data/plataforma.js';
import SolucionMockup from '../../components/home2/SolucionMockup.astro';
import FeatureVisual from '../../components/home2/FeatureVisual.astro';

export function getStaticPaths() {
  return soluciones.map((sol) => ({ params: { slug: sol.slug }, props: { sol } }));
}

const { sol } = Astro.props;
const [titleStart, titleEnd = ''] = sol.headline.split(sol.accent);
const mods = sol.modulos.map((k) => modulos.find((m) => m.key === k)).filter(Boolean);
const otras = soluciones.filter((s) => s.slug !== sol.slug);
const pageUrl = `https://kaptativa.com/soluciones/${sol.slug}/`;
const solSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: sol.headline,
    serviceType: `Sitio web y sistema de gestión para ${sol.title.toLowerCase()}`,
    description: sol.text,
    url: pageUrl,
    provider: { '@type': 'Organization', name: 'Kaptativa', url: 'https://kaptativa.com/' },
    areaServed: { '@type': 'Country', name: 'Argentina' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: sol.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://kaptativa.com/' },
      { '@type': 'ListItem', position: 2, name: 'Soluciones', item: 'https://kaptativa.com/#rubros' },
      { '@type': 'ListItem', position: 3, name: sol.title, item: pageUrl },
    ],
  },
];
const WHATSAPP = 'https://wa.me/5493804890834?text=' + encodeURIComponent(`¡Hola Kaptativa! Quiero solicitar una demo de la solución para ${sol.title.toLowerCase()}.`);
const CONTACTO = `/contacto/?demo=${encodeURIComponent(sol.title)}`;
// Ícono de cada contador según lo que dice (misma idea que en servicios)
const iconoMetrica = (m) => {
  const t = `${m.v} ${m.l}`.toLowerCase();
  const reglas = [['24/7', 'bell'], ['qr', 'qr'], ['whatsapp', 'message'], ['consulta', 'message'], ['turno', 'calendar'], ['agenda', 'calendar'], ['reserva', 'calendar'], ['cuota', 'card'], ['cobro', 'card'], ['seña', 'card'], ['pago', 'card'], ['factur', 'receipt'], ['stock', 'box'], ['depósito', 'box'], ['pedido', 'cart'], ['propiedad', 'building'], ['socio', 'users'], ['asociado', 'users'], ['cliente', 'users'], ['panel', 'monitor'], ['sitio', 'monitor'], ['web', 'monitor'], ['planilla', 'file'], ['carta', 'utensils'], ['mesa', 'utensils'], ['beneficio', 'tag'], ['%', 'chart']];
  for (const [k, ic] of reglas) if (t.includes(k)) return ic;
  return 'check';
};
---

<Layout title={`${sol.headline} | Kaptativa`} description={sol.text} schema={solSchema}>
  <Header slot="header" floating />

  <main>
    <!-- HERO -->
    <section class:list={['hero', 'hero-section', { 'con-foto': sol.foto }]} id="inicio">
      {sol.foto && <img class="sol-hero-foto" src={sol.foto} alt="" aria-hidden="true" width="1600" height="900" fetchpriority="low" decoding="async" />}
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="container sol-hero-grid">
        <div class="hero-content reveal">
          <h1 class="hero-tagline">{titleStart}<span class="text-gradient-cyan">{sol.accent}</span>{titleEnd}</h1>
          <p class="hero-description">{sol.text}</p>
          <div class="hero-buttons">
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow">Solicitar demo</a>
            <a href="/precios/" class="btn btn-secondary">Ver planes</a>
          </div>
          {sol.demo && <a href={sol.demo} class="sol-hero-demo">Ver una demo en vivo de esta solución</a>}
        </div>
        <div class="sol-hero-visual reveal">
          <SolucionMockup tipo={sol.mockup} />
        </div>
      </div>
    </section>

    <!-- INDICADORES -->
    <section class="section-metrics reveal">
      <div class="container">
        <div class="metrics-grid-premium">
          {sol.metrics.map((m) => (
            <div class="metric-card-glass">
              <span class="metric-icon" aria-hidden="true"><Fragment set:html={svg(iconoMetrica(m))} /></span>
              <div class:list={['metric-value', { long: m.v.length > 6 }]}>{m.v}</div>
              <div class="metric-label">{m.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- POR QUÉ IMPORTA: HOY VS CON KAPTATIVA -->
    <section class="section" id="por-que">
      <div class="container">
        <div class="section-header reveal">
          <h2>Lo que hoy te frena,<br />resuelto en un sistema</h2>
          <p>La misma plataforma, configurada para cómo trabaja tu negocio.</p>
        </div>
        <div class="comparison-grid">
          <div class="comp-card-bad reveal">
            <div class="comp-card-header">
              <div class="comp-icon-box bad-box"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
              <h3>Hoy, sin sistema</h3>
            </div>
            <ul class="comp-list">
              {sol.pains.map((p) => <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></span> {p}</li>)}
            </ul>
          </div>
          <div class="comp-card-good reveal">
            <div class="comp-card-header">
              <div class="comp-icon-box good-box"><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
              <h3>Con la plataforma</h3>
            </div>
            <ul class="comp-list">
              {sol.gains.map((g) => <li><span><svg class="glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span> {g}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- LO QUE INCLUYE -->
    <section class="section section-dark" id="lo-que-incluye">
      <div class="container">
        <div class="section-header reveal">
          <h2>Así lo resolvemos</h2>
          <p>Funciones pensadas para la operación real de tu rubro, listas desde el primer día.</p>
        </div>
        <div class="pillars-grid">
          {sol.features.map((f, i) => (
            <div class="glass-card-premium reveal">
              <span class="pillar-bg-icon" aria-hidden="true"><Fragment set:html={svg(f.icon)} /></span>
              <div class="pillar-text">
                <span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <span class="pillar-line"></span>
                <p>{f.text}</p>
              </div>
              <FeatureVisual icon={f.icon} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MÓDULOS -->
    <section class="section" id="modulos">
      <div class="container">
        <div class="section-header reveal">
          <h2>Módulos que usa esta solución</h2>
          <p>Arrancás con lo esencial y activás más módulos a medida que el negocio crece, sin migrar nada.</p>
        </div>
        <div class="sol-mods">
          {mods.map((m) => (
            <div class="sol-mod reveal">
              <span class="pillar-icon"><Fragment set:html={svg(m.icon)} /></span>
              <span>{m.title}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-light" id="preguntas">
      <div class="container">
        <div class="section-header reveal">
          <h2>Preguntas frecuentes</h2>
          <p>Lo que más nos consultan antes de implementar la solución.</p>
        </div>
        <div class="faq-accordion reveal">
          {sol.faqs.map((f) => (
            <details class="faq-item-premium">
              <summary class="faq-trigger">
                <span>{f.q}</span>
                <svg class="faq-icon-arrow" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg>
              </summary>
              <div class="faq-content-premium"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CIERRE CON FORMULARIO -->
    <section class="section section-cta" id="cotizar">
      <div class="container">
        <div class="cta-card-neon reveal">
          <div class="cta-glow-overlay"></div>
          <div class="cta-info-side">
            <h2>¿Te mostramos cómo funcionaría<br />en tu negocio?</h2>
            <p style="margin-bottom: 25px;">Coordinamos una demo con tu rubro ya configurado, con ejemplos que te resulten familiares, y te pasamos un presupuesto a medida.</p>
            <div class="cta-buttons">
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow">Solicitar demo</a>
              <a href="/precios/" class="btn btn-secondary">Ver planes</a>
            </div>
          </div>
        </div>

        <div class="sol-otras reveal">
          <h3>Otras soluciones</h3>
          <div class="sol-otras-list">
            {otras.map((o) => <a href={`/soluciones/${o.slug}/`}><Fragment set:html={svg(o.icon)} />{o.title}</a>)}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>


<style>
  /* ---- Base del patrón de servicios (mismos valores que /servicios/*) ---- */
  .hero-section { position: relative; overflow: hidden; padding-top: 160px; padding-bottom: 110px; }
  .sol-hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .hero-content { position: relative; z-index: 10; text-align: left; }
  .sol-hero-visual { position: relative; z-index: 10; }
  .badge-neon { background: rgba(124, 92, 255, 0.05); color: var(--accent-pink); border: 1px solid rgba(124, 92, 255, 0.2); padding: 8px 16px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; }
  .badge-dot-pulsing { width: 6px; height: 6px; background: var(--accent-pink); border-radius: 50%; box-shadow: 0 0 8px rgba(124, 92, 255, 0.4); animation: pulseGlow 1.5s infinite; }
  @keyframes pulseGlow { 0% { transform: scale(0.9); opacity: 0.6; } 50% { transform: scale(1.2); opacity: 1; } 100% { transform: scale(0.9); opacity: 0.6; } }
  .hero-tagline { font-size: clamp(2.6rem, 4.6vw, 3.6rem); line-height: 1.05; font-weight: 600; margin-bottom: 24px; letter-spacing: -0.02em; }
  .hero-description { font-size: 1.15rem; color: var(--text-secondary); margin: 0 0 36px; max-width: 560px; line-height: 1.6; }
  /* Foto de ambiente: textura en escala de grises, velo violeta, enmascarada para no tocar el panel */
  .sol-hero-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: 0; pointer-events: none; filter: grayscale(1) brightness(1.35) contrast(1.15); opacity: 0.32; -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 42%, transparent 70%), linear-gradient(180deg, #000 60%, transparent 100%); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, #000 0%, #000 42%, transparent 70%), linear-gradient(180deg, #000 60%, transparent 100%); mask-composite: intersect; }
  .hero-section.con-foto::after { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(135deg, rgba(124, 92, 255, 0.28), transparent 55%); mix-blend-mode: screen; opacity: 0.6; }
  .hero-section.con-foto .hero-glow-1, .hero-section.con-foto .hero-glow-2 { z-index: 1; }
  @media (max-width: 992px) { .sol-hero-foto { -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent 88%); mask-image: linear-gradient(180deg, #000 35%, transparent 88%); opacity: 0.26; } }
  @media (prefers-reduced-motion: no-preference) { .sol-hero-foto { animation: sol-foto-in 1.6s ease both; } @keyframes sol-foto-in { from { opacity: 0; transform: scale(1.04); } } }
  .hero-buttons { display: flex; gap: 16px; flex-wrap: wrap; }
  .sol-hero-demo { display: inline-block; margin-top: 16px; font-size: 0.9rem; color: var(--text-secondary); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: transparent; transition: color var(--transition-fast), text-decoration-color var(--transition-fast); }
  .sol-hero-demo:hover { color: var(--brand-primary-light); text-decoration-color: currentColor; }
  .btn-whatsapp { background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.2); color: #10b981; display: inline-flex; align-items: center; transition: all 0.3s ease; }
  .btn-whatsapp:hover { background: #10b981; border-color: #10b981; color: #fff; box-shadow: 0 0 15px rgba(16, 185, 129, 0.2); transform: translateY(-2px); }
  .btn-glow:hover { box-shadow: 0 10px 25px rgba(124, 92, 255, 0.35); }
  .hero-glow-1, .hero-glow-2 { position: absolute; width: 600px; height: 600px; border-radius: 50%; filter: blur(140px); opacity: 0.15; pointer-events: none; z-index: 0; }
  .hero-glow-1 { top: -250px; left: 15%; background: radial-gradient(circle, var(--accent-pink) 0%, transparent 70%); }
  .hero-glow-2 { top: -150px; right: 15%; background: radial-gradient(circle, var(--accent-pink) 0%, transparent 70%); }

  .section-metrics { margin-top: -30px; margin-bottom: 60px; position: relative; z-index: 10; }
  .metrics-grid-premium { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .metric-card-glass { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: var(--border-radius-md); padding: 30px 20px; text-align: center; backdrop-filter: blur(10px); transition: all 0.3s ease; }
  .metric-card-glass:hover { border-color: rgba(124, 92, 255, 0.2); transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3); }
  .metric-value { font-size: 2.6rem; font-weight: 600; background: linear-gradient(135deg, #fff 0%, #8E8E99 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; font-family: 'Lexend', sans-serif; margin-bottom: 8px; line-height: 1.1; }
  .metric-value.long { font-size: 1.75rem; padding: 6px 0; }
  .metric-label { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.4; }

  .comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 40px; }
  .comp-card-bad { background: rgba(239, 68, 68, 0.01); border: 1px solid rgba(239, 68, 68, 0.12); border-radius: var(--border-radius-md); padding: 40px; transition: all 0.3s ease; }
  .comp-card-bad:hover { background: rgba(239, 68, 68, 0.02); }
  .comp-card-header { display: flex; align-items: center; margin-bottom: 24px; gap: 16px; }
  .comp-icon-box { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 1.1rem; }
  .bad-box { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
  .comp-card-bad h3 { font-size: 1.4rem; color: var(--accent-crimson); font-family: 'Lexend', sans-serif; font-weight: 600; }
  .comp-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .comp-card-bad .comp-list li { font-size: 1rem; color: var(--text-muted); line-height: 1.6; display: flex; align-items: flex-start; }
  .comp-card-bad .comp-list li span { color: #ef4444; margin-right: 12px; font-weight: 600; }
  .comp-card-good { background: var(--card-bg); border: 1px solid rgba(124, 92, 255, 0.25); border-radius: var(--border-radius-md); padding: 40px; position: relative; box-shadow: 0 10px 30px rgba(124, 92, 255, 0.05); transition: all 0.3s ease; }
  .comp-card-good:hover { border-color: var(--accent-pink); box-shadow: 0 15px 35px rgba(124, 92, 255, 0.1); }
  .good-box { background: rgba(124, 92, 255, 0.1); color: var(--accent-pink); }
  .comp-card-good h3 { font-size: 1.4rem; color: var(--text-primary); font-family: 'Lexend', sans-serif; font-weight: 600; }
  .comp-card-good .comp-list li { font-size: 1rem; color: var(--text-primary); line-height: 1.6; display: flex; align-items: flex-start; }
  .comp-card-good .comp-list li span { color: var(--accent-pink); margin-right: 12px; font-weight: 600; }
  .badge-solution { position: absolute; top: -15px; right: 30px; background: var(--gradient-primary); color: #fff; padding: 6px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; box-shadow: 0 4px 15px rgba(124, 92, 255, 0.4); }

  /* Grilla pareja 2x2: las cuatro funciones del mismo tamaño, con su mini interfaz debajo */
  .pillars-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 40px; }
  .glass-card-premium { gap: 22px; }
  .pillar-text { position: relative; z-index: 1; padding-right: 70px; }
  .glass-card-premium > :global(.fv) { position: relative; z-index: 1; }
  /* Ícono grande de fondo, tenue y cortado por el borde (como la referencia) */
  .pillar-bg-icon { position: absolute; top: -26px; right: -26px; width: 150px; height: 150px; color: var(--accent-pink); opacity: 0.08; pointer-events: none; transition: opacity 0.5s ease, transform 0.5s ease; }
  .pillar-bg-icon :global(.ki) { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .glass-card-premium:hover .pillar-bg-icon { opacity: 0.16; transform: scale(1.1) rotate(-4deg); }
  .pillar-num { display: inline-block; font-family: 'Lexend', sans-serif; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.1em; color: var(--accent-pink); margin-bottom: 10px; }
  .pillar-line { display: block; width: 40px; height: 4px; border-radius: 8px; margin: -2px 0 14px; background: var(--gradient-primary); transition: width 0.3s ease; }
  .glass-card-premium:hover .pillar-line { width: 64px; }
  .glass-card-premium { background: linear-gradient(160deg, rgba(124, 92, 255, 0.06), transparent 45%), var(--card-bg); border: 1px solid var(--border-color); border-radius: var(--border-radius-md); padding: 32px 28px; position: relative; overflow: hidden; backdrop-filter: blur(12px); transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1); display: flex; flex-direction: column; }
  .glass-card-premium::before { content: ''; position: absolute; top: 0; left: 0; width: 3px; height: 0; background: var(--gradient-primary); transition: height 0.4s ease; }
  .glass-card-premium:hover::before { height: 100%; }
  .glass-card-premium:hover { border-color: rgba(124, 92, 255, 0.25); box-shadow: 0 15px 30px rgba(124, 92, 255, 0.1); }
  .pillar-icon { width: 46px; height: 46px; flex-shrink: 0; border-radius: 12px; background: rgba(124, 92, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); display: flex; align-items: center; justify-content: center; color: var(--accent-pink); margin-bottom: 24px; transition: all 0.3s ease; }
  .pillar-icon :global(.ki) { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .glass-card-premium:hover .pillar-icon { background: rgba(124, 92, 255, 0.18); box-shadow: 0 0 15px rgba(124, 92, 255, 0.3); transform: scale(1.05); }
  .glass-card-premium h3 { font-size: 1.25rem; font-family: 'Lexend', sans-serif; color: var(--text-primary); margin-bottom: 12px; font-weight: 600; }
  .glass-card-premium p { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }

  .faq-accordion { max-width: 850px; margin: 40px auto 0; display: flex; flex-direction: column; gap: 16px; }
  .faq-item-premium { border-radius: 12px; border: 1px solid var(--border-color); background: var(--card-bg); overflow: hidden; transition: all 0.3s ease; }
  .faq-item-premium[open] { border-color: rgba(124, 92, 255, 0.2); box-shadow: 0 0 15px rgba(124, 92, 255, 0.05); }
  .faq-trigger { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 25px; font-family: 'Lexend', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text-primary); cursor: pointer; user-select: none; list-style: none; transition: color 0.2s ease; outline: none; }
  .faq-trigger::-webkit-details-marker { display: none; }
  .faq-trigger:hover, .faq-trigger:focus-visible { color: var(--accent-pink); }
  .faq-icon-arrow { flex-shrink: 0; transition: transform 0.3s ease; color: var(--text-muted); }
  .faq-item-premium[open] .faq-icon-arrow { transform: rotate(180deg); color: var(--accent-pink); }
  .faq-content-premium { padding: 0 25px; }
  .faq-item-premium[open] .faq-content-premium { animation: slideDown 0.3s ease-out; }
  .faq-content-premium p { padding-bottom: 20px; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0; }
  @keyframes slideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

  .section-cta { padding: 80px 0; }
  .cta-card-neon { background: var(--card-bg); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--border-radius-lg); padding: 60px 40px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; position: relative; overflow: hidden; }
  .cta-glow-overlay { position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(124, 92, 255, 0.12) 0%, transparent 75%), radial-gradient(circle at 80% 80%, rgba(124, 92, 255, 0.08) 0%, transparent 50%); pointer-events: none; }
  .cta-info-side { position: relative; z-index: 5; text-align: left; }
