---
// Home: enfocada en desarrollo web (sitio + tienda + gestión).
// Estructura inspirada en referencias del rubro, con identidad y textos propios de kaptativa.
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import ControlShowcase from '../components/home2/ControlShowcase.astro';
import RubrosGrid from '../components/home2/RubrosGrid.astro';
import HeroAurora from '../components/HeroAurora.astro';
import IsoK3D from '../components/IsoK3D.astro';
import CtaBeam from '../components/CtaBeam.astro';
import FeatureVisual from '../components/home2/FeatureVisual.astro';
import Planes from '../components/home2/Planes.astro';
import TrabajosCinta from '../components/home2/TrabajosCinta.astro';
import HeroStage from '../components/home2/HeroStage.astro';
import { svg, soluciones, modulos } from '../data/plataforma.js';
import { readFileSync } from 'node:fs';

const WHATSAPP = 'https://wa.me/5493804890834?text=' + encodeURIComponent('¡Hola kaptativa! Quiero solicitar una demo de la plataforma web.');

const rubros = soluciones;

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'kaptativa',
    url: 'https://kaptativa.com/',
    logo: 'https://kaptativa.com/logo.svg',
    image: 'https://kaptativa.com/og-image.jpg',
    description: 'Sitios web, tiendas online y sistemas de gestión autoadministrables, con integraciones y asistentes de IA.',
    email: 'hola@kaptativa.com',
    telephone: '+54-9-380-489-0834',
    address: { '@type': 'PostalAddress', addressLocality: 'La Rioja', addressCountry: 'AR' },
    areaServed: { '@type': 'Country', name: 'Argentina' },
    sameAs: ['https://instagram.com/kaptativa', 'https://linkedin.com/company/kaptativa'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Soluciones por rubro',
      itemListElement: soluciones.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.headline, url: `https://kaptativa.com/soluciones/${s.slug}/` },
      })),
    },
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'kaptativa', url: 'https://kaptativa.com/', inLanguage: 'es-AR' },
];

// Rubros que rotan en el título del hero, en el orden del menú Soluciones
// Mismo orden que las tarjetas de rubros (tiendas, mayoristas, gastronomía, gimnasios, turnos, inmobiliarias, mutuales, profesionales)
const heroRubros = ['tu tienda online.', 'tu distribuidora.', 'tu restaurante.', 'tu gimnasio.', 'tu consultorio.', 'tu inmobiliaria.', 'tu mutual.', 'tu estudio.'];



// Integraciones en dos filas (pagos/logística y herramientas/IA).
// `logo` = logotipo completo (va solo). `icon` = símbolo de la marca (va con el nombre al lado).
// Sin archivo: logotipo tipográfico (`w` = peso, `t` = tratamiento).
// Fuentes: Simple Icons 16.32.0 (CC0), Wikimedia Commons (dominio público) y los sitios oficiales de cada marca
// (WooCommerce, Perfit, Zonaprop, Argenprop). Archivos en /public/integraciones.
// Ancho de cada logotipo (alto 36px) según su viewBox, para que el navegador reserve el espacio
const logoWidth = (file, size = 36, known) => {
  if (known) return Math.round((size * known[0]) / known[1]);
  const vb = readFileSync(`public/integraciones/${file}.svg`, 'utf8').match(/viewBox="([^"]+)"/);
  const [, , w, h] = vb ? vb[1].trim().split(/[\s,]+/).map(Number) : [0, 0, 1, 1];
  return Math.round((size * w) / h);
};

const integracionesFilas = [
  // Ventas, pagos, logística y facturación
  [
    { name: 'Mercado Pago', icon: 'mercadopago' }, { name: 'Mercado Libre', logo: 'mercadolibre', h: 46 }, { name: 'WooCommerce', logo: 'woocommerce', h: 26 },
    { name: 'MODO', logo: 'modo', ext: 'png', size: [524, 120], h: 30 }, { name: 'PayPal', icon: 'paypal' }, { name: 'Mobbex', logo: 'mobbex', ext: 'png', size: [360, 64], h: 28 },
    { name: 'Go Cuotas', logo: 'gocuotas', h: 40 }, { name: 'Payway', w: 700 }, { name: 'Ualá', logo: 'uala' }, { name: 'Correo Argentino', logo: 'correoargentino', h: 42 },
    { name: 'Andreani', logo: 'andreani', ext: 'png', size: [525, 120], h: 30 }, { name: 'OCA', logo: 'oca', h: 26 }, { name: 'ARCA', w: 800, t: 'upper' },
  ],
  // Comunicación, marketing, herramientas, portales inmobiliarios e IA
  [
    { name: 'WhatsApp', icon: 'whatsapp' }, { name: 'Instagram', icon: 'instagram' }, { name: 'Meta', icon: 'meta' }, { name: 'Google Ads', icon: 'googleads' },
    { name: 'Google Analytics', icon: 'googleanalytics' }, { name: 'Google Maps', icon: 'googlemaps' }, { name: 'Google Sheets', icon: 'googlesheets' },
    { name: 'Google Calendar', icon: 'googlecalendar' }, { name: 'Perfit', logo: 'perfit', h: 32 }, { name: 'n8n', icon: 'n8n' }, { name: 'Tokko Broker', w: 700 },
    { name: 'Zonaprop', logo: 'zonaprop', h: 30 }, { name: 'Argenprop', logo: 'argenprop', h: 29 }, { name: 'OpenAI', icon: 'openai' }, { name: 'Claude', icon: 'claude' },
    { name: 'Gemini', icon: 'googlegemini' },
  ],
];

const pasos = [
  { icon: 'monitor', tag: '30 minutos', title: 'Demo y diagnóstico', text: 'Una videollamada de 30 minutos: vemos cómo trabajás hoy y te mostramos la plataforma con casos de tu rubro.' },
  { icon: 'file', tag: '24 hs hábiles', title: 'Propuesta a medida', text: 'Qué módulos activar, en qué orden y cuánto cuesta. Sin letra chica.' },
  { icon: 'rocket', tag: 'Por etapas', title: 'Implementación y acompañamiento', text: 'Arrancamos por lo que vende y sumamos la gestión por etapas. Capacitamos a tu equipo y seguimos del otro lado del WhatsApp.' },
];
const heroIntegraciones = [
  { name: 'Mercado Pago', icon: 'mercadopago' }, { name: 'WhatsApp', icon: 'whatsapp' }, { name: 'Mercado Libre', logo: 'mercadolibre' },
  { name: 'Google Analytics', icon: 'googleanalytics' }, { name: 'Meta', icon: 'meta' }, { name: 'OpenAI', icon: 'openai' },
];


---

<Layout
  schema={homeSchema}
  title="kaptativa | Sitios web, tiendas online y sistemas de gestión"
  description="Tu sitio web, tu tienda online y la gestión de tu negocio en una sola plataforma autoadministrable. Diseño, desarrollo e integraciones a medida."
>
  <Header slot="header" floating />

  <main class="home2">
    <!-- ================= HERO ================= -->
    <section class="h2-hero">
      <HeroAurora />
      <div class="h2-hero-glow" aria-hidden="true"></div>
      <div class="container h2-hero-grid">
        <div class="h2-hero-copy reveal">
          <h1>
            Sitio web y sistema de&nbsp;gestión<br class="br-desk" /> para{" "}
            <span class="h2-rotator" data-rotator data-words={JSON.stringify(heroRubros.slice(1))}>
              <span class="text-gradient-crimson on">{heroRubros[0]}</span>
            </span>
          </h1>
          <p>Diseñamos y desarrollamos una plataforma modular que une sitio web, tienda online, pedidos, facturación y un asistente con IA. Activás solo lo que tu negocio necesita y lo administrás vos.</p>
          <div class="h2-ctas">
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow"><span>Solicitar demo</span></a>
            <a href="#rubros" class="btn btn-secondary"><span>Soluciones por rubro</span></a>
          </div>
        </div>

        <!-- Escena del producto: panel, tienda en el celular y asistente de IA en WhatsApp; cambia con el rubro del título -->
        <div class="h2-stage reveal reveal-delay-1" data-tilt>
          <HeroStage rubros={heroRubros} />
        </div>
        <div class="h2-trust reveal reveal-delay-2">
          <span>Se integra con</span>
          <ul aria-label="Integraciones">
            {heroIntegraciones.map((m, i) => (
              <li style={`--i:${i}`}>
                {m.logo
                  ? <img class="wide" src={`/integraciones/${m.logo}.svg`} alt={m.name} width={logoWidth(m.logo, 22)} height="22" decoding="async" />
                  : <><img src={`/integraciones/${m.icon}.svg`} alt="" width="20" height="20" decoding="async" /><span>{m.name}</span></>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ================= RUBROS ================= -->
    <section class="section section-light" id="rubros">
      <div class="container">
        <div class="section-header reveal">
          <h2>Una plataforma,<br />configurada para tu rubro</h2>
          <p>La misma base tecnológica, adaptada a cómo trabaja tu negocio. Elegí el tuyo y mirá qué resuelve.</p>
        </div>
        <RubrosGrid />
      </div>
    </section>

    <!-- ================= CONTROL TOTAL ================= -->
    <ControlShowcase />

    <!-- ================= TRABAJOS: cinta curva; la grilla completa está en /proyectos/ ================= -->
    <TrabajosCinta />

    <!-- ================= MÓDULOS ================= -->
    <section class="section" id="modulos">
      <div class="container">
        <div class="section-header reveal">
          <h2>Activá solo lo que<br />tu negocio necesita</h2>
          <p>Herramientas que trabajan juntas. Empezás con tu web y sumás módulos a medida que crecés.</p>
        </div>
        <div class="h2-bento" role="list">
          {modulos.map((m) => {
            const big = ['sitio', 'tienda', 'turnos', 'ia'].includes(m.key);
            const solid = ['sitio', 'ia'].includes(m.key);
            return (
              <article class:list={['h2-tile', { 'h2-tile--big': big, 'h2-tile--solid': solid }]} role="listitem">
                <div class="h2-tile-head">
                  <span class="h2-icon"><Fragment set:html={svg(m.icon)} /></span>
                  <h3>{m.title}</h3>
                  <p>{m.text}</p>
                </div>
                {big && <FeatureVisual icon={m.icon} />}
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ================= INTEGRACIONES ================= -->
    <section class="section h2-integra h2-light section-light">
      <div class="container">
        <div class="section-header reveal">
          <h2>Soluciones integradas</h2>
          <p>Plataformas de pagos, logística, marketing, comunicación e inteligencia artificial con las que podemos integrar tu sistema.</p>
        </div>
      </div>

      <div class="h2-marquees reveal" aria-label="Plataformas con las que nos integramos">
        {integracionesFilas.map((fila, f) => (
          <div class="h2-marquee">
            <div class:list={['h2-marquee-track', { reverse: f === 1 }]}>
              {[0, 1].map((copia) => (
                <ul class="h2-marquee-group" aria-hidden={copia === 1 ? 'true' : undefined}>
                  {fila.map((m) => (
                    m.logo
                      ? <li class="h2-brand"><img class="h2-brand-logo" src={`/integraciones/${m.logo}.${m.ext ?? 'svg'}`} alt={m.name} width={logoWidth(m.logo, m.h ?? 36, m.size)} height={m.h ?? 36} style={m.h ? `--lh:${m.h - 2}px` : undefined} decoding="async" /></li>
                      : m.icon
                        ? <li class="h2-brand"><img class="h2-brand-icon" src={`/integraciones/${m.icon}.svg`} alt="" width="30" height="30" decoding="async" /><span>{m.name}</span></li>
                        : <li class={`h2-brand h2-wordmark ${m.t ?? ''}`} style={`font-weight:${m.w}`}>{m.name}</li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="container">
        <div class="h2-integra-banner reveal">
          <span class="h2-icon"><Fragment set:html={svg('layers')} /></span>
          <div class="h2-integra-banner-text">
            <h3>Integraciones a medida para tu negocio</h3>
            <p>¿Usás otra herramienta? Conectamos tu sistema con el software que ya tenés vía API.</p>
          </div>
          <a href="/contacto" class="btn btn-primary"><span>Consultar ahora</span></a>
        </div>
      </div>
    </section>

    <!-- ================= CÓMO TRABAJAMOS ================= -->
    <section class="section" id="proceso">
      <div class="container">
        <div class="section-header reveal">
          <h2>De la demo a tu negocio<br />funcionando</h2>
          <p>Un proceso corto y por etapas: primero lo que vende, después lo que ordena.</p>
        </div>
        <ol class="h2-steps">
          {pasos.map((paso, i) => (
            <li class="h2-step" style={`--i:${i}`}>
              <div class="h2-step-top">
                <span class="h2-step-ic"><Fragment set:html={svg(paso.icon)} /></span>
                <span class="h2-step-tag">{paso.tag}</span>
                <span class="h2-step-num">0{i + 1}</span>
              </div>
              <h3>{paso.title}</h3>
              <p>{paso.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ================= PLANES ================= -->
    <Planes light />


    <!-- ================= CTA FINAL ================= -->
    <section class="section">
      <div class="container">
        <div class="h2-cta reveal">
          <CtaBeam />
          <IsoK3D class="h2-cta-iso" />
          <h2>¿Hablamos de tu proyecto?</h2>
          <p>Contanos qué necesita tu negocio y te mostramos la plataforma funcionando en una demo, sin compromiso.</p>
          <div class="h2-ctas" style="justify-content:center;">
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow"><span>Solicitar demo</span></a>
            <a href="/contacto/" class="btn btn-secondary"><span>Escribinos</span></a>
          </div>
        </div>
      </div>
    </section>

    <Faq />
  </main>

  <Footer slot="footer" />
</Layout>

<script>
  // Título del hero: en el HTML el h1 lleva un solo rubro (SEO); los demás se agregan acá y rotan junto con la escena
  // (quieto si el usuario prefiere menos movimiento)
  document.querySelectorAll<HTMLElement>('[data-rotator]').forEach((rot) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      const extra: string[] = JSON.parse(rot.dataset.words || '[]');
      // Se clona el primero para heredar el atributo de alcance de Astro (si no, no los alcanza el CSS y se ven todos a la vez)
      const first = rot.firstElementChild as HTMLElement;
      extra.forEach((w) => { const el = first.cloneNode(false) as HTMLElement; el.classList.remove('on', 'out'); el.setAttribute('aria-hidden', 'true'); el.textContent = w; rot.appendChild(el); });
    } catch { return; }
    const words = [...rot.children] as HTMLElement[];
    if (words.length < 2) return;
    let i = 0;
    // La escena del hero avisa qué rubro muestra; así el título y la escena cambian juntos
    document.addEventListener('hero:rubro', (ev) => {
      const n = (ev as CustomEvent<number>).detail % words.length;
      if (n === i) return;
      const prev = words[i];
      i = n;
      prev.classList.remove('on');
      prev.classList.add('out');
      words[i].classList.remove('out');
      words[i].classList.add('on');
      setTimeout(() => prev.classList.remove('out'), 500);
    });
  });

</script>

<style>
  /* La home es siempre oscura: fijamos la paleta oscura aunque el sitio quede en tema claro */
  .home2 {
    --bg-primary: #0F0F12;
    --bg-secondary: #151519;
    --bg-tertiary: #1B1B20;
    --text-primary: #ffffff;
    --text-secondary: #B4B4BE;
    --text-muted: #8E8E99;
    --accent-indigo: #7C5CFF;
    --accent-indigo-glow: rgba(124, 92, 255, 0.15);
    --gradient-primary: var(--brand-gradient);
    --border-color: rgba(255, 255, 255, 0.06);
    --border-hover: rgba(124, 92, 255, 0.25);
    --card-bg: rgba(27, 27, 32, 0.6);
    --glass-bg: rgba(15, 15, 18, 0.85);
    --shadow-glow: 0 0 25px rgba(124, 92, 255, 0.2);
  }

  .home2 :global(.ki) { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

  .h2-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 26px;
    transition: opacity var(--transition-slow), border-color var(--transition-normal), transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  .h2-card:hover { border-color: var(--border-hover); }
  .h2-card h3 { font-family: 'Lexend', sans-serif; font-size: 1.12rem; font-weight: 600; color: var(--text-primary); margin: 0; }
  .h2-card p { color: var(--text-secondary); font-size: 0.93rem; line-height: 1.6; margin: 10px 0 0; }

  .h2-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 12px;
    color: var(--accent-indigo);
    background: var(--accent-indigo-glow);
    border: 1px solid var(--border-hover);
  }

  /* Sin animación de entrada por sección: el único movimiento de la página es el hero y el recorrido "Control total" */
  .home2 .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  .h2-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
  .h2-title { font-family: 'Lexend', sans-serif; font-size: clamp(2rem, 4vw, 2.7rem); line-height: 1.15; margin: 16px 0 12px; color: var(--text-primary); }
  .h2-lead { color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; }

  /* ---------- HERO ---------- */
  .h2-hero { position: relative; padding: 150px 0 90px; overflow: hidden; }
  /* Entrada orquestada: título, texto, botones e integraciones suben escalonados una sola vez */
  .h2-hero-copy > * { opacity: 0; }
  .h2-hero-copy.active > * { animation: h2-rise 0.75s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .h2-hero-copy.active > :nth-child(1) { animation-delay: 0.05s; }
  .h2-hero-copy.active > :nth-child(2) { animation-delay: 0.22s; }
  .h2-hero-copy.active > :nth-child(3) { animation-delay: 0.38s; }
  .h2-hero-copy.active > :nth-child(4) { animation-delay: 0.54s; }
  @keyframes h2-rise { from { opacity: 0; transform: translateY(22px); filter: blur(6px); } to { opacity: 1; transform: none; filter: blur(0); } }
  @media (prefers-reduced-motion: reduce) { .h2-hero-copy > * { opacity: 1; animation: none !important; } }
  .h2-hero-glow {
    position: absolute; inset: 0; pointer-events: none;
    /* Elipses con tamaño explícito: se desvanecen antes de tocar los bordes de la caja */
    background: radial-gradient(ellipse 65% 45% at 25% 18%, rgba(124, 92, 255, 0.18), transparent 70%),
                radial-gradient(ellipse 50% 40% at 85% 22%, rgba(91, 63, 224, 0.16), transparent 70%);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .h2-hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; grid-template-areas: 'copy stage' 'trust stage'; column-gap: 48px; align-items: center; }
  .h2-hero-copy { grid-area: copy; align-self: end; }
  .h2-stage { grid-area: stage; }
  .h2-trust { grid-area: trust; align-self: start; }
  .h2-hero h1 { font-family: 'Lexend', sans-serif; font-size: clamp(2.3rem, 5vw, 3.6rem); line-height: 1.08; letter-spacing: -0.02em; margin: 18px 0 20px; color: var(--text-primary); }
  .h2-rotator { display: inline-grid; vertical-align: bottom; }
  .h2-rotator > span { grid-area: 1 / 1; white-space: nowrap; opacity: 0; transform: translateY(0.45em); transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
  .h2-rotator > span.on { opacity: 1; transform: none; }
  .h2-rotator > span.out { opacity: 0; transform: translateY(-0.45em); }
  @media (max-width: 768px) { .br-desk { display: none; } .h2-hero h1 .h2-rotator { display: grid; } }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .h2-hero-copy > p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.65; max-width: 560px; }


  /* ---------- RUBROS: el ícono grande de fondo es la identidad de cada tarjeta ---------- */

  /* ---------- MÓDULOS: catálogo en grilla de celdas (distinto de las tarjetas de rubros) ---------- */
  /* Módulos: grilla bento, dos tiles en violeta sólido como foco */
  .h2-bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .h2-tile { position: relative; display: flex; flex-direction: column; gap: 18px; padding: 26px 24px 24px; border-radius: var(--radius-lg); background: var(--card-bg); border: 1px solid var(--border-color); min-height: 210px; }
  .h2-tile--big { grid-column: span 2; }
  .h2-tile--big .h2-tile-head { max-width: 36ch; }
  .h2-tile--solid { background: var(--brand-fill); border-color: var(--brand-fill); }
  .h2-tile .h2-icon { width: 40px; height: 40px; border: 0; background: transparent; color: var(--brand-primary); padding: 0; justify-content: flex-start; }
  .h2-tile h3 { font-family: 'Lexend', sans-serif; font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin: 10px 0 6px; }
  .h2-tile p { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin: 0; }
  .h2-tile--solid .h2-icon, .h2-tile--solid h3 { color: #fff; }
  .h2-tile--solid p { color: rgba(255, 255, 255, 0.93); }
  .h2-tile :global(.fv) { margin-top: auto; }
  .h2-tile--solid :global(.fv) { background: rgba(14, 8, 40, 0.45); border-color: rgba(255, 255, 255, 0.14); color: rgba(255, 255, 255, 0.85); }
  /* Tablet: dos columnas (los destacados ocupan el ancho); celular: una columna. Antes quedaban 4 columnas y la grilla se salía de la pantalla */
  @media (max-width: 992px) { .h2-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .h2-bento { grid-template-columns: minmax(0, 1fr); gap: 12px; } .h2-tile--big { grid-column: auto; } .h2-tile { min-height: 0; padding: 22px 20px 20px; } }
  /* Cómo trabajamos: tres pasos unidos por una línea */
  /* Proceso: tres tarjetas unidas por flechas (antes una línea que seguía de largo después del último paso) */
  .h2-steps { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; counter-reset: paso; }
