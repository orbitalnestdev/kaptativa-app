---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Servicios from '../components/Servicios.astro';
---

<Layout title="Servicios | Kaptativa" description="Catálogo completo de servicios de tecnología: desarrollo web, CRM, automatización de procesos, agentes de IA y posicionamiento SEO & GEO.">
  <Header slot="header" />
  
  <main>
    <!-- HERO INMERSIVO -->
    <section class="hero hero-section" id="inicio">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      
      <div class="container hero-container">
        <div class="hero-content reveal">
          <span class="badge badge-neon">
            <span class="badge-dot-pulsing"></span> EL MÉTODO KAPTATIVA
          </span>
          <h1 class="hero-tagline">Cómo potenciamos tu <span class="text-gradient-crimson">crecimiento</span></h1>
          <p class="hero-description">No creemos en parches aislados que complican tu operación. Diseñamos e implementamos sistemas integrados que eliminan tareas manuales repetitivas, profesionalizan tu marca y multiplican tus ventas de forma sincronizada.</p>
          
          <div class="hero-buttons">
            <a href="/contacto/" class="btn btn-primary btn-glow">Agendá un diagnóstico</a>
            <a href="#metodologia" class="btn btn-secondary">Ver el método</a>
          </div>
        </div>
      </div>
    </section>

    <Servicios isPage={true} />

    <!-- METODOLOGÍA -->
    <section class="section" id="metodologia">
      <div class="container">
        <div class="section-header reveal" style="text-align: center; margin-bottom: 50px;">
          <span class="badge badge-accent">LA INTEGRACIÓN</span>
          <h2>Cómo encajan los servicios en tu negocio</h2>
          <p style="max-width: 750px; margin: 0 auto; color: var(--text-secondary);">Cada solución modular de Kaptativa se conecta de forma natural para formar un sistema de crecimiento automatizado.</p>
        </div>

        <div class="metodologia-flow reveal">
          <div class="flow-step">
            <h4>1. Atracción y Captación</h4>
            <p>Posicionamos tu marca con SEO/GEO y anuncios en Paid Media, canalizando la atención calificada.</p>
          </div>
          <div class="flow-step-arrow">&rarr;</div>
          <div class="flow-step">
            <h4>2. Conversión Web</h4>
            <p>Recibimos al usuario en tu sitio corporativo o e-commerce premium diseñado para acelerar la decisión.</p>
          </div>
          <div class="flow-step-arrow">&rarr;</div>
          <div class="flow-step">
            <h4>3. Operación y Soporte</h4>
            <p>Los agentes de IA y las automatizaciones procesan los datos, agendan y administran sin intervención humana.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA DE CIERRE (CONTACTO) -->
    <section class="section section-cta">
      <div class="container">
        <div class="cta-card-neon reveal">
          <div class="cta-glow-overlay"></div>
          <div class="cta-content-wrapper">
            <span class="badge badge-neon-secondary">DIAGNÓSTICO DIGITAL</span>
            <h2>¿Listo para digitalizar la <span class="text-gradient-cyan">operación de tu negocio?</span></h2>
            <p>Agendá un diagnóstico inicial de 45 minutos sin costo para analizar los procesos de tu empresa y armar una propuesta a medida.</p>
            
            <div class="cta-buttons">
              <a href="/contacto/" class="btn btn-primary btn-glow">Agendá un diagnóstico</a>
              <a href="https://wa.me/5493804890834?text=Hola!%20Me%20interesa%20agendar%20un%20diagnostico%20de%20madurez%20digital%20con%20Kaptativa." target="_blank" class="btn btn-secondary btn-whatsapp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                Escribinos por WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<!-- ESTILOS LOCALES PREMIUM ENCAPSULADOS -->
<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    padding-top: 180px;
    padding-bottom: 100px;
  }
  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-content {
    max-width: 850px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }
  .badge-neon {
    background: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--badge-border);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .badge-dot-pulsing {
    width: 6px;
    height: 6px;
    background: var(--badge-dot);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--badge-border);
    animation: pulseGlow 1.5s infinite;
  }
  @keyframes pulseGlow {
    0% { transform: scale(0.9); opacity: 0.6; }
    50% { transform: scale(1.2); opacity: 1; box-shadow: 0 0 12px var(--badge-border); }
    100% { transform: scale(0.9); opacity: 0.6; }
  }
  .hero-tagline {
    font-size: 4.2rem;
    line-height: 1.05;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }
  .hero-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-whatsapp {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: #10b981;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
  }
  .btn-whatsapp:hover {
    background: rgba(16, 185, 129, 0.15);
    border-color: #10b981;
    color: #ffffff;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
    transform: translateY(-2px);
  }
  .btn-glow:hover {
    box-shadow: 0 10px 25px rgba(6, 182, 212, 0.35);
  }

  /* Glows y Grid */
  .hero-glow-1, .hero-glow-2 {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.15;
    pointer-events: none;
    z-index: 0;
  }
  .hero-glow-1 {
    top: -250px;
    left: 15%;
    background: radial-gradient(circle, var(--accent-indigo) 0%, transparent 70%);
  }
  .hero-glow-2 {
    top: -150px;
    right: 15%;
    background: radial-gradient(circle, var(--accent-crimson) 0%, transparent 70%);
  }

  /* Listado de Servicios Hub */
  .services-list-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 30px;
    margin-top: 20px;
  }
  .service-list-group-header {
    grid-column: 1 / -1;
    border-left: 4px solid var(--accent-indigo);
    padding-left: 20px;
    margin-top: 35px;
    margin-bottom: 10px;
    text-align: left;
  }
  .service-list-group-header h3 {
    font-family: 'Lexend', sans-serif;
    font-size: 1.6rem !important;
    font-weight: 600 !important;
    color: var(--text-primary) !important;
    margin: 0 0 6px 0 !important;
    letter-spacing: -0.01em;
  }
  .service-list-group-header p {
    color: var(--text-secondary) !important;
    font-size: 1rem !important;
    margin: 0 !important;
    line-height: 1.4;
  }
  .service-hub-card {
    background: rgba(15, 21, 36, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--border-radius-lg);
    padding: 35px 35px;
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
    width: 100%;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }
  .service-hub-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.03), transparent 60%);
    pointer-events: none;
  }
  .service-hub-card:hover {
    border-color: rgba(6, 182, 212, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(6, 182, 212, 0.1), 0 0 20px rgba(6, 182, 212, 0.05);
  }
  .service-hub-header {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    position: relative;
    z-index: 2;
  }
  .service-hub-num {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-muted);
    opacity: 0.3;
    flex-shrink: 0;
  }
  .service-hub-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }
  .icon-orange { background: var(--accent-orange-glow); color: var(--accent-orange); }
  .icon-emerald { background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); }
  .icon-blue { background: rgba(37, 99, 235, 0.15); color: #2563EB; }
  .icon-cyan { background: var(--accent-crimson-glow); color: var(--accent-crimson); }
  .icon-pink { background: var(--accent-pink-glow); color: var(--accent-pink); }
  .icon-purple { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; }
  .icon-indigo { background: var(--accent-indigo-glow); color: var(--accent-indigo); }
  .icon-cyan-glow { background: var(--accent-crimson-glow); color: var(--accent-crimson); }
  .icon-violet { background: var(--accent-violet-glow); color: var(--accent-violet); }

  .service-hub-card h3 {
    font-size: 1.4rem;
    color: #ffffff;
    font-family: 'Lexend', sans-serif;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }
  .service-hub-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 100%;
  }
  .service-hub-card .btn {
    align-self: flex-start;
    margin-top: 4px;
  }

  /* Metodología Flow */
  .metodologia-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 40px;
  }
  .flow-step {
    background: rgba(10, 10, 16, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 35px;
    flex: 1;
    text-align: center;
  }
  .flow-step h4 {
    font-family: 'Lexend', sans-serif;
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 12px;
    font-weight: 600;
  }
  .flow-step p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .flow-step-arrow {
    font-size: 2rem;
    color: var(--text-muted);
    font-weight: 300;
  }

  /* CTA de Cierre */
  .section-cta {
    padding: 80px 0;
  }
  .cta-card-neon {
    background: rgba(15, 21, 36, 0.45);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--border-radius-lg);
    padding: 60px 40px;
    position: relative;
    overflow: hidden;
  }
  .cta-glow-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(138, 53, 229, 0.12) 0%, transparent 75%),
                radial-gradient(circle at 80% 80%, rgba(234, 56, 77, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  .cta-content-wrapper {
    position: relative;
    z-index: 5;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }
  .badge-neon-secondary {
    background: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--badge-border);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 20px;
  }
  .cta-card-neon h2 {
    font-size: 2.5rem;
    font-family: 'Lexend', sans-serif;
    font-weight: 600;
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .cta-card-neon p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 30px;
  }
  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .cta-card-neon {
      padding: 40px 30px;
    }
    .hero-tagline {
      font-size: 3rem;
    }
    .service-hub-card {
      padding: 24px 20px;
      gap: 14px;
    }
    .service-hub-header {
      gap: 12px;
    }
    .service-hub-card h3 {
      font-size: 1.2rem;
      line-height: 1.3;
      word-break: break-word;
    }
    .service-hub-desc {
      font-size: 0.93rem;
      line-height: 1.5;
    }
    .service-hub-card .btn {
      align-self: stretch;
      width: 100%;
      text-align: center;
      justify-content: center;
      box-sizing: border-box;
      padding: 12px 16px;
      margin-top: 6px;
    }
    .metodologia-flow {
      flex-direction: column;
      gap: 20px;
    }
    .flow-step-arrow {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 768px) {
    .metodologia-flow {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 15px;
      padding: 10px 20px 25px 20px;
      margin-left: -20px;
      margin-right: -20px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    
    .metodologia-flow::-webkit-scrollbar {
      display: none;
    }
    
    .flow-step {
      flex: 0 0 80%;
      scroll-snap-align: center;
      margin-bottom: 0;
      height: auto;
    }
    
    .flow-step-arrow {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .hero-section {
      padding-top: 140px;
      padding-bottom: 80px;
    }
    .hero-tagline {
      font-size: 2.2rem;
    }
    .hero-description {
      font-size: 1.1rem;
    }
    .cta-card-neon {
      padding: 40px 20px;
    }
    .cta-card-neon h2 {
      font-size: 1.8rem;
    }
  }
</style>

