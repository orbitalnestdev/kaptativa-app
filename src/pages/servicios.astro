---
// Servicios adicionales: se contratan aparte o se suman a la plataforma o a la web que el cliente ya tiene.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroAurora from '../components/HeroAurora.astro';
import IsoK3D from '../components/IsoK3D.astro';
import CtaBeam from '../components/CtaBeam.astro';
import { svg } from '../data/plataforma.js';
const WHATSAPP = 'https://wa.me/5493804890834?text=' + encodeURIComponent('¡Hola kaptativa! Quiero pedir una propuesta de servicios para mi negocio.');
const servicios = [
  { slug: 'publicidad-digital', icon: 'megaphone', title: 'Publicidad digital', text: 'Campañas en Meta y Google medidas por resultados: más consultas y ventas, no solo clics.' },
  { slug: 'seo-geo', icon: 'search', title: 'SEO y GEO', text: 'Que te encuentren en Google y en las respuestas de la IA cuando buscan lo que vendés.' },
  { slug: 'social-media', icon: 'users', title: 'Social media', text: 'Contenido y calendario para tus redes, con una línea clara y constante.' },
  { slug: 'diseno-web', icon: 'monitor', title: 'Diseño web y e-commerce', text: 'Sitios y tiendas enfocados en conversión, rápidos y fáciles de administrar.' },
  { slug: 'email-marketing', icon: 'message', title: 'Email marketing', text: 'Campañas y automatizaciones de correo integradas con Perfit y tu base de clientes.' },
  { slug: 'agentes-ia', icon: 'bot', title: 'Agentes de IA', text: 'Un asistente que atiende, califica y agenda 24/7 en WhatsApp y en tu web.' },
  { slug: 'automatizacion', icon: 'layers', title: 'Automatización e integraciones', text: 'Conectamos tus herramientas y eliminamos el trabajo repetitivo entre sistemas.' },
  { slug: 'desarrollo-software', icon: 'grid', title: 'Desarrollo de software', text: 'Sistemas a medida para procesos propios: paneles, APIs e integraciones.' },
];
const etapas = [
  { n: '01', title: 'Que te encuentren', text: 'Llevar tu negocio a quien ya está buscando lo que vendés.', slugs: ['seo-geo', 'publicidad-digital', 'social-media'] },
  { n: '02', title: 'Que te elijan', text: 'Un sitio o una tienda claros y rápidos, y correos que acompañan la decisión.', slugs: ['diseno-web', 'email-marketing'] },
  { n: '03', title: 'Operación automática', text: 'Atención, procesos y sistemas que trabajan solos.', slugs: ['agentes-ia', 'automatizacion', 'desarrollo-software'] },
];
const etapaDe = (slug) => etapas.find((e) => e.slugs.includes(slug));
// Lo que gana el negocio en cada etapa (embudo del hero)
const resultadoEtapa = ['Más visitas y consultas', 'Más ventas y clientes que vuelven', 'Menos trabajo manual'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de kaptativa',
  itemListElement: servicios.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: `https://kaptativa.com/servicios/${s.slug}/` })),
};
---

<Layout title="Servicios de marketing, IA y desarrollo para tu negocio | kaptativa" description="Publicidad digital, SEO y GEO, social media, email marketing, agentes de IA, automatización, diseño web y desarrollo de software. Se contratan aparte o se suman a tu plataforma." schema={schema}>
  <Header slot="header" floating />

  <main>
    <section class="hero hero-section" id="inicio">
      <HeroAurora />
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="container sv-hero-grid">
        <div class="hero-content reveal">
          <h1 class="hero-tagline">Servicios adicionales para&nbsp;<span class="text-gradient-crimson">hacer crecer tu negocio</span></h1>
          <p class="hero-description">Se contratan aparte o se suman a tu plataforma o a la web que ya tenés: marketing, publicidad, contenido, automatización y desarrollo a medida.</p>
          <div class="hero-buttons">
            <a href="#servicios" class="btn btn-primary btn-glow">Ver los servicios</a>
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Pedir propuesta por WhatsApp</a>
          </div>
        </div>

        <!-- Embudo: las tres etapas que empujan los servicios, con los íconos de cada uno -->
        <ol class="sv-funnel reveal reveal-delay-1" aria-hidden="true">
          {etapas.map((e, i) => (
            <li class={`sv-step sv-step-${i + 1}`}>
              <span class="sv-n">{e.n}</span>
              <span class="sv-txt"><strong>{e.title}</strong><small>{resultadoEtapa[i]}</small></span>
              <span class="sv-ics">{e.slugs.map((sl) => <i title={servicios.find((x) => x.slug === sl)?.title}><Fragment set:html={svg(servicios.find((x) => x.slug === sl)?.icon ?? 'grid')} /></i>)}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section-light" id="servicios">
      <div class="container">
        <div class="section-header reveal">
          <h2>Qué podemos sumar</h2>
          <p>Ocho servicios que trabajan solos o combinados, sobre tu plataforma o sobre la web que ya tenés. La etiqueta dice qué etapa empuja cada uno.</p>
        </div>
        <div class="sg">
          {servicios.map((s, i) => {
            const e = etapaDe(s.slug);
            return (
              <a class="sg-card reveal" href={`/servicios/${s.slug}/`} style={`--i:${i}`}>
                <span class="sg-ic"><Fragment set:html={svg(s.icon)} /></span>
                <span class="sg-body">
                  {e && <span class="sg-tag"><b>{e.n}</b>{e.title}</span>}
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </span>
                <span class="sg-go" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section section-cta">
      <div class="container">
        <div class="cta-card-neon reveal">
          <CtaBeam />
          <div class="cta-glow-overlay"></div>
          <IsoK3D size={118} />
          <div class="cta-info-side">
            <h2>¿Qué servicio le falta a tu negocio?</h2>
            <p style="margin-bottom: 25px;">Contanos qué querés lograr y te proponemos por dónde empezar, con una propuesta en 24 hs hábiles.</p>
            <div class="cta-buttons">
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow">Pedir propuesta por WhatsApp</a>
              <a href="/contacto/?servicio=Servicios" class="btn btn-secondary">Completar el formulario</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  /* Hero compacto con el embudo de etapas a la derecha (antes ocupaba toda la pantalla y la mitad quedaba vacía) */
  #inicio.hero { min-height: 0; padding: 150px 0 80px; }
  .sv-hero-grid { position: relative; z-index: 2; width: 100%; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px; align-items: center; }
  /* El degradado en línea (no inline-block) para que "para" quede pegado a "hacer" y no sola en un renglón */
  .sv-hero-grid .hero-tagline .text-gradient-crimson { display: inline !important; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .sv-funnel { text-align: left; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .sv-step { position: relative; display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 18px; color: #fff; border: 1px solid rgba(124, 92, 255, 0.35); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35); }
  .sv-step-1 { width: 100%; background: linear-gradient(135deg, rgba(124, 92, 255, 0.22), rgba(21, 21, 25, 0.92)); }
  .sv-step-2 { width: 88%; background: linear-gradient(135deg, rgba(124, 92, 255, 0.38), rgba(21, 21, 25, 0.92)); }
  .sv-step-3 { width: 76%; background: linear-gradient(135deg, #7C5CFF, #4B2FD0); border-color: transparent; box-shadow: 0 18px 40px rgba(91, 63, 224, 0.4); }
  .sv-step:not(:last-child)::after { content: ''; position: absolute; left: 50%; bottom: -11px; width: 10px; height: 10px; margin-left: -5px; border-right: 2px solid rgba(160, 140, 255, 0.7); border-bottom: 2px solid rgba(160, 140, 255, 0.7); transform: rotate(45deg); }
  .sv-n { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; font-family: 'Lexend', sans-serif; font-size: 0.85rem; font-weight: 600; color: #fff; background: rgba(255, 255, 255, 0.12); }
  .sv-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .sv-txt strong { font-family: 'Lexend', sans-serif; font-size: 1rem; font-weight: 600; }
  .sv-txt small { font-size: 0.8rem; color: rgba(255, 255, 255, 0.75); }
  .sv-ics { flex: none; display: flex; gap: 6px; }
  .sv-ics i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.12); }
  .sv-ics :global(.ki) { width: 16px; height: 16px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (prefers-reduced-motion: no-preference) {
    .sv-funnel.active .sv-step { animation: sv-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .sv-funnel.active .sv-step-2 { animation-delay: 0.12s; }
    .sv-funnel.active .sv-step-3 { animation-delay: 0.24s; }
    @keyframes sv-in { from { opacity: 0; transform: translateY(10px); } }
  }
  @media (max-width: 1024px) {
    .sv-hero-grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .sv-funnel { max-width: 520px; width: 100%; margin: 0 auto; }
  }
  @media (max-width: 600px) {
    #inicio.hero { padding: 120px 0 48px; }
    .sv-step { padding: 12px 12px; gap: 10px; }
    .sv-step-2 { width: 94%; }
    .sv-step-3 { width: 88%; }
    .sv-txt strong { font-size: 0.9rem; }
    .sv-txt small { font-size: 0.74rem; }
    .sv-ics i { width: 26px; height: 26px; }
    .sv-ics :global(.ki) { width: 14px; height: 14px; }
  }
  /* Grilla de servicios: tarjetas horizontales en dos columnas (ícono, etiqueta de etapa, título, texto y flecha) */
  .sg { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .sg-card { position: relative; display: grid; grid-template-columns: 52px minmax(0, 1fr) 40px; gap: 18px; align-items: start; min-width: 0; padding: 24px 22px 24px 24px; border-radius: 20px; text-decoration: none; color: inherit; background: linear-gradient(180deg, #FAF8FF 0%, #FFFFFF 58%); border: 1px solid #E9E5F8; box-shadow: 0 1px 2px rgba(15, 15, 18, 0.04), 0 14px 34px -20px rgba(124, 92, 255, 0.35); overflow: hidden; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease, border-color 0.3s ease; }
  .sg-card::before { content: ''; position: absolute; left: 0; top: 18px; bottom: 18px; width: 3px; border-radius: 3px; background: linear-gradient(180deg, #7C5CFF, #C9BDFF); opacity: 0; transform: scaleY(0.6); transition: opacity 0.3s ease, transform 0.3s ease; }
  .sg-card:hover { transform: translateY(-3px); border-color: rgba(124, 92, 255, 0.45); box-shadow: 0 2px 4px rgba(15, 15, 18, 0.04), 0 24px 48px -20px rgba(124, 92, 255, 0.45); }
  .sg-card:hover::before { opacity: 1; transform: none; }
  .sg-ic { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; color: #5B3FE0; background: linear-gradient(135deg, #F3F0FF, #E6E0FF); border: 1px solid rgba(124, 92, 255, 0.28); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 6px 14px -8px rgba(124, 92, 255, 0.5); transition: background 0.25s ease, color 0.25s ease; }
  .sg-ic :global(.ki) { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sg-card:hover .sg-ic { background: linear-gradient(135deg, #7C5CFF, #6A48F5); color: #FFFFFF; border-color: transparent; }
  .sg-body { display: flex; flex-direction: column; min-width: 0; }
  .sg-tag { display: inline-flex; align-items: center; gap: 7px; align-self: flex-start; font-size: 0.74rem; font-weight: 600; color: #5B3FE0; background: #F3F0FF; border: 1px solid rgba(124, 92, 255, 0.22); border-radius: 999px; padding: 3px 10px 3px 4px; margin-bottom: 10px; }
  .sg-tag b { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; font-family: 'Lexend', sans-serif; font-size: 0.68rem; color: #FFFFFF; background: #7C5CFF; }
  .sg-card h3 { font-family: 'Lexend', sans-serif; font-size: 1.15rem !important; font-weight: 600; line-height: 1.3 !important; color: #17161D !important; margin: 0 !important; }
  .sg-card p { margin: 8px 0 0 !important; font-size: 0.93rem; line-height: 1.6; color: #4B4A57 !important; }
  .sg-go { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; color: #5B3FE0; border: 1px solid #E9E5F8; background: #FFFFFF; transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease; }
  .sg-card:hover .sg-go { background: #7C5CFF; color: #FFFFFF; border-color: transparent; transform: translateX(2px); }
  @media (max-width: 760px) { .sg { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .sg-card { grid-template-columns: 46px minmax(0, 1fr); padding: 20px 18px; gap: 14px; } .sg-go { display: none; } .sg-ic { width: 46px; height: 46px; } }
  @media (prefers-reduced-motion: reduce) { .sg-card:hover { transform: none; } }

  /* Cierre */
  .section-cta { padding: 80px 0; }
  .cta-card-neon { background: var(--card-bg); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--border-radius-lg); padding: 60px 40px; display: grid; grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 40px; align-items: center; position: relative; overflow: hidden; }
  .cta-glow-overlay { position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(124, 92, 255, 0.12) 0%, transparent 75%), radial-gradient(circle at 80% 80%, rgba(124, 92, 255, 0.08) 0%, transparent 50%); pointer-events: none; }
  .cta-info-side { position: relative; z-index: 5; max-width: 720px; }
  .cta-card-neon h2 { font-size: 2.4rem; font-family: 'Lexend', sans-serif; font-weight: 600; margin-bottom: 20px; line-height: 1.2; }
  .cta-card-neon p { font-size: 1.1rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .cta-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 768px) { .section-cta { padding: 56px 0; } .cta-card-neon { gap: 30px; padding: 40px 30px; } .cta-card-neon h2 { font-size: 1.9rem; } }
  @media (max-width: 520px) { .cta-buttons .btn { width: 100%; justify-content: center; } .cta-card-neon { padding: 32px 18px; } }
</style>
