---
// Servicios adicionales: se contratan aparte o se suman a la plataforma o a la web que el cliente ya tiene.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroAurora from '../components/HeroAurora.astro';
import IsoK3D from '../components/IsoK3D.astro';
import CtaBeam from '../components/CtaBeam.astro';
import { svg } from '../data/plataforma.js';
const WHATSAPP = 'https://wa.me/5493804890834?text=' + encodeURIComponent('¡Hola Kaptativa! Quiero pedir una propuesta de servicios para mi negocio.');
const servicios = [
  { slug: 'publicidad-digital', icon: 'megaphone', title: 'Publicidad digital', text: 'Campañas en Meta y Google medidas por resultados: más consultas y ventas, no solo clics.' },
  { slug: 'seo-geo', icon: 'search', title: 'SEO y GEO', text: 'Que te encuentren en Google y en las respuestas de la IA cuando buscan lo que vendés.' },
  { slug: 'social-media', icon: 'users', title: 'Social media', text: 'Contenido y calendario para tus redes, con una línea clara y constante.' },
  { slug: 'email-marketing', icon: 'message', title: 'Email marketing', text: 'Campañas y automatizaciones de correo integradas con Perfit y tu base de clientes.' },
  { slug: 'agentes-ia', icon: 'bot', title: 'Agentes de IA', text: 'Un asistente que atiende, califica y agenda 24/7 en WhatsApp y en tu web.' },
  { slug: 'automatizacion', icon: 'layers', title: 'Automatización e integraciones', text: 'Conectamos tus herramientas y eliminamos el trabajo repetitivo entre sistemas.' },
  { slug: 'diseno-web', icon: 'monitor', title: 'Diseño web y e-commerce', text: 'Sitios y tiendas enfocados en conversión, rápidos y fáciles de administrar.' },
  { slug: 'desarrollo-software', icon: 'grid', title: 'Desarrollo de software', text: 'Sistemas a medida para procesos propios: paneles, APIs e integraciones.' },
];
const etapas = [
  { n: '01', title: 'Que te encuentren', text: 'Llevar tu negocio a quien ya está buscando lo que vendés.', slugs: ['seo-geo', 'publicidad-digital', 'social-media'] },
  { n: '02', title: 'Que te elijan', text: 'Un sitio o una tienda claros y rápidos, y correos que acompañan la decisión.', slugs: ['diseno-web', 'email-marketing'] },
  { n: '03', title: 'Que la operación no dependa de nadie', text: 'Atención, procesos y sistemas que trabajan solos.', slugs: ['agentes-ia', 'automatizacion', 'desarrollo-software'] },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de Kaptativa',
  itemListElement: servicios.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: `https://kaptativa.com/servicios/${s.slug}/` })),
};
---

<Layout title="Servicios de marketing, IA y desarrollo para tu negocio | Kaptativa" description="Publicidad digital, SEO y GEO, social media, email marketing, agentes de IA, automatización, diseño web y desarrollo de software. Se contratan aparte o se suman a tu plataforma." schema={schema}>
  <Header slot="header" floating />

  <main>
    <section class="hero hero-section" id="inicio">
      <HeroAurora />
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="container hero-container">
        <div class="hero-content reveal">
          <h1 class="hero-tagline">Servicios adicionales para <span class="text-gradient-crimson">hacer crecer tu negocio</span></h1>
          <p class="hero-description">Se contratan aparte o se suman a tu plataforma o a la web que ya tenés: marketing, publicidad, contenido, automatización y desarrollo a medida.</p>
          <div class="hero-buttons">
            <a href="#servicios" class="btn btn-primary btn-glow">Ver los servicios</a>
            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Pedir propuesta por WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-light" id="servicios">
      <div class="container">
        <div class="section-header reveal">
          <h2>Qué podemos sumar</h2>
          <p>Ocho servicios ordenados por la etapa que empujan. Trabajan solos o combinados, sobre tu plataforma o sobre la web que ya tenés.</p>
        </div>
        <div class="sv-map">
          {etapas.map((e) => (
            <div class="sv-stage reveal">
              <div class="sv-stage-head">
                <span class="sv-stage-n">{e.n}</span>
                <h3>{e.title}</h3>
                <p>{e.text}</p>
              </div>
              <div class="sv-stage-items">
                {e.slugs.map((slug) => servicios.find((x) => x.slug === slug)).map((s) => (
                  <a class="sv-item" href={`/servicios/${s.slug}/`}>
                    <span class="sv-icon"><Fragment set:html={svg(s.icon)} /></span>
                    <span class="sv-item-txt"><strong>{s.title}</strong><span>{s.text}</span></span>
                    <span class="sv-item-go">Ver servicio <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-cta">
      <div class="container">
        <div class="cta-card-neon reveal">
          <CtaBeam />
          <div class="cta-glow-overlay"></div>
          <IsoK3D size={118} />
          <div class="cta-info-side">
            <h2>¿Qué servicio le falta a tu negocio?</h2>
            <p style="margin-bottom: 25px;">Contanos qué querés lograr y te proponemos por dónde empezar, con una propuesta en 24 hs hábiles.</p>
            <div class="cta-buttons">
              <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-glow">Pedir propuesta por WhatsApp</a>
              <a href="/contacto/?servicio=Servicios" class="btn btn-secondary">Completar el formulario</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  /* Mapa por etapas: cada etapa es una fila con su cabecera y sus servicios en lista, separados por filetes */
  .sv-map { display: grid; gap: 16px; }
  .sv-stage { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 26px; padding: 26px 28px; border-radius: 22px; background: linear-gradient(180deg, #FAF8FF 0%, #FFFFFF 58%); border: 1px solid #E9E5F8; box-shadow: 0 1px 2px rgba(15, 15, 18, 0.04), 0 14px 34px -20px rgba(124, 92, 255, 0.3); }
  .sv-stage-n { display: block; font-family: 'Lexend', sans-serif; font-size: 2rem; font-weight: 600; line-height: 1; color: #7C5CFF; letter-spacing: -0.02em; }
  .sv-stage-head h3 { font-family: 'Lexend', sans-serif; font-size: 1.3rem !important; line-height: 1.25 !important; color: #17161D !important; margin: 12px 0 8px !important; }
  .sv-stage-head p { margin: 0 !important; font-size: 0.92rem; line-height: 1.55; color: #4B4A57 !important; }
  .sv-stage-items { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .sv-item { display: flex; flex-direction: column; gap: 12px; min-width: 0; padding: 6px 20px 6px 22px; border-left: 1px solid #ECE9F6; text-decoration: none; color: inherit; border-radius: 0; transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  .sv-item:first-child { border-left: 0; padding-left: 0; }
  .sv-item:hover { transform: translateY(-3px); }
  .sv-icon { width: 42px; height: 42px; border-radius: 11px; display: grid; place-items: center; color: #5B3FE0; background: linear-gradient(135deg, #F3F0FF, #E6E0FF); border: 1px solid rgba(124, 92, 255, 0.28); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9); transition: background 0.25s ease, color 0.25s ease; }
  .sv-icon :global(.ki) { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sv-item:hover .sv-icon { background: linear-gradient(135deg, #7C5CFF, #6A48F5); color: #FFFFFF; border-color: transparent; }
  .sv-item-txt { display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .sv-item-txt strong { font-family: 'Lexend', sans-serif; font-size: 1rem; font-weight: 600; color: #17161D; line-height: 1.3; }
  .sv-item-txt span { font-size: 0.88rem; line-height: 1.55; color: #4B4A57; }
  .sv-item-go { display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; font-weight: 600; color: #5B3FE0; }
  .sv-item-go svg { transition: transform 0.25s ease; }
  .sv-item:hover .sv-item-go svg { transform: translateX(3px); }
  @media (max-width: 960px) {
    .sv-stage { grid-template-columns: 1fr; gap: 18px; padding: 22px; }
    .sv-stage-items { grid-template-columns: 1fr; }
    .sv-item { border-left: 0; padding: 16px 0 0; border-top: 1px solid #ECE9F6; }
    .sv-item:first-child { border-top: 0; padding-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .sv-item:hover { transform: none; } }

  /* Cierre */
  .section-cta { padding: 80px 0; }
  .cta-card-neon { background: var(--card-bg); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--border-radius-lg); padding: 60px 40px; display: grid; grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 40px; align-items: center; position: relative; overflow: hidden; }
  .cta-glow-overlay { position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(124, 92, 255, 0.12) 0%, transparent 75%), radial-gradient(circle at 80% 80%, rgba(124, 92, 255, 0.08) 0%, transparent 50%); pointer-events: none; }
  .cta-info-side { position: relative; z-index: 5; max-width: 720px; }
  .cta-card-neon h2 { font-size: 2.4rem; font-family: 'Lexend', sans-serif; font-weight: 600; margin-bottom: 20px; line-height: 1.2; }
  .cta-card-neon p { font-size: 1.1rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .cta-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 768px) { .section-cta { padding: 56px 0; } .cta-card-neon { gap: 30px; padding: 40px 30px; } .cta-card-neon h2 { font-size: 1.9rem; } }
  @media (max-width: 520px) { .cta-buttons .btn { width: 100%; justify-content: center; } .cta-card-neon { padding: 32px 18px; } }
</style>
