---
// Página de prueba (noindex, fuera del sitemap): tres alternativas de diseño para la sección Trabajos,
// con las capturas reales. Se elige una y se pasa a Trabajos.astro; después esta página se borra.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { trabajos } from '../data/trabajos.js';
const host = (u) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const link = { target: '_blank', rel: 'noopener noreferrer nofollow', referrerpolicy: 'no-referrer' };
---

<Layout title="Trabajos: opciones de diseño (prueba)" description="Página interna de prueba." noindex>
  <Header slot="header" floating />
  <main class="home2">

    <!-- ===== OPCIÓN A: Vitrina (navegador grande + lista de proyectos, rota sola) ===== -->
    <section class="section" id="opcion-a">
      <div class="container">
        <p class="op-tag">Opción A · Vitrina</p>
        <div class="section-header">
          <h2>Sitios que ya están<br />funcionando</h2>
          <p>Elegí uno y miralo como lo ve un cliente. Capturas reales, sin maquetas.</p>
        </div>
        <div class="vt">
          <ol class="vt-tabs" aria-label="Proyectos">
            {trabajos.map((t, i) => (
              <li><button type="button" class:list={['vt-tab', { on: i === 0 }]} data-host={host(t.url)} data-url={t.url} data-resultado={t.resultado} aria-pressed={i === 0 ? 'true' : 'false'}><b>{t.nombre}</b><span>{t.rubro}</span></button></li>
            ))}
          </ol>
          <div class="vt-stage">
            <div class="vt-browser">
              <div class="vt-bar"><i></i><i></i><i></i><span class="vt-url">{host(trabajos[0].url)}</span></div>
              <div class="vt-body">
                {trabajos.map((t, i) => <img class:list={['vt-shot', { on: i === 0 }]} src={t.imagen} alt={`Sitio de ${t.nombre}`} width="1200" height="750" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />)}
              </div>
            </div>
            <div class="vt-caption"><p>{trabajos[0].resultado}</p><a href={trabajos[0].url} {...link}>Visitar el sitio</a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== OPCIÓN B: Mosaico (una grande + cuatro chicas, nombre sobre la foto) ===== -->
    <section class="section section-light" id="opcion-b">
      <div class="container">
        <p class="op-tag">Opción B · Mosaico</p>
        <div class="section-header">
          <h2>Sitios que ya están<br />funcionando</h2>
          <p>Capturas reales de lo entregado. Entrá y recorrelos.</p>
        </div>
        <div class="mz">
          {trabajos.map((t, i) => (
            <a class:list={['mz-item', { big: i === 0 }]} href={t.url} {...link}>
              <img src={t.imagen} alt={`Sitio de ${t.nombre}`} width="1200" height="750" loading="lazy" decoding="async" />
              <span class="mz-cap"><b>{t.nombre}</b><span>{t.rubro}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== OPCIÓN C: Editorial (filas alternadas, captura en navegador + texto) ===== -->
    <section class="section" id="opcion-c">
      <div class="container">
        <p class="op-tag">Opción C · Editorial</p>
        <div class="section-header">
          <h2>Sitios que ya están<br />funcionando</h2>
          <p>Cada proyecto con su captura y qué resuelve.</p>
        </div>
        <div class="ed">
          {trabajos.map((t) => (
            <article class="ed-row">
              <a class="ed-shot" href={t.url} {...link}>
                <span class="ed-bar"><i></i><i></i><i></i><span>{host(t.url)}</span></span>
                <img src={t.imagen} alt={`Sitio de ${t.nombre}`} width="1200" height="750" loading="lazy" decoding="async" />
              </a>
              <div class="ed-copy">
                <span class="ed-rubro">{t.rubro}</span>
                <h3>{t.nombre}</h3>
                <p>{t.resultado}</p>
                <a href={t.url} {...link}>Visitar el sitio</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer slot="footer" />
</Layout>

<script>
  // Opción A: cambia el proyecto al hacer clic y rota solo cada 6 s hasta que el usuario interactúa
  const vt = document.querySelector('.vt');
  if (vt) {
    const tabs = [...vt.querySelectorAll<HTMLButtonElement>('.vt-tab')];
    const shots = [...vt.querySelectorAll<HTMLImageElement>('.vt-shot')];
    const url = vt.querySelector('.vt-url') as HTMLElement;
    const cap = vt.querySelector('.vt-caption p') as HTMLElement;
    const link = vt.querySelector('.vt-caption a') as HTMLAnchorElement;
    const show = (i: number) => {
      tabs.forEach((t, j) => { t.classList.toggle('on', j === i); t.setAttribute('aria-pressed', j === i ? 'true' : 'false'); });
      shots.forEach((s, j) => s.classList.toggle('on', j === i));
      url.textContent = tabs[i].dataset.host || '';
      cap.textContent = tabs[i].dataset.resultado || '';
      link.href = tabs[i].dataset.url || '#';
    };
    let i = 0;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = reduce ? 0 : window.setInterval(() => { if (document.hidden) return; i = (i + 1) % tabs.length; show(i); }, 6000);
    const stop = () => { if (timer) { clearInterval(timer); timer = 0; } };
    tabs.forEach((t, j) => t.addEventListener('click', () => { stop(); i = j; show(i); }));
    vt.addEventListener('pointerenter', stop);
  }
</script>

<style>
  .op-tag { display: inline-block; margin: 0 0 18px; padding: 6px 12px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; color: #fff; background: var(--brand-fill); }

  /* ---------- A: Vitrina ---------- */
  .vt { display: grid; grid-template-columns: 0.85fr 1.45fr; gap: 40px; align-items: center; margin-top: 44px; }
  .vt-tabs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .vt-tab { width: 100%; text-align: left; display: flex; flex-direction: column; gap: 3px; padding: 14px 16px 14px 20px; border-radius: 14px; border: 1px solid transparent; background: transparent; color: var(--text-secondary); cursor: pointer; position: relative; font: inherit; transition: background var(--transition-fast), border-color var(--transition-fast); }
  .vt-tab b { font-family: 'Lexend', sans-serif; font-weight: 600; color: var(--text-primary); font-size: 1rem; }
  .vt-tab span { font-size: 0.82rem; color: var(--text-muted); }
  .vt-tab:hover { background: rgba(255, 255, 255, 0.03); }
  .vt-tab.on { background: var(--card-bg); border-color: var(--border-hover); }
  .vt-tab.on::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; border-radius: 3px; background: var(--brand-primary); box-shadow: 0 0 12px rgba(124, 92, 255, 0.6); }
  .vt-browser { border-radius: 16px; overflow: hidden; border: 1px solid var(--border-hover); background: #0F0F12; box-shadow: 0 30px 80px rgba(124, 92, 255, 0.16), 0 24px 60px rgba(0, 0, 0, 0.5); }
  .vt-bar { display: flex; align-items: center; gap: 7px; padding: 10px 14px; background: #1B1B20; border-bottom: 1px solid var(--border-color); }
  .vt-bar i { width: 10px; height: 10px; border-radius: 50%; background: #2A2A31; }
  .vt-url { margin-left: 10px; flex: 1; font-size: 0.78rem; color: var(--n-300); background: #0F0F12; border-radius: 8px; padding: 5px 12px; }
  .vt-body { position: relative; aspect-ratio: 16 / 10; background: #fff; }
  .vt-shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: 0; transition: opacity 0.5s ease; }
  .vt-shot.on { opacity: 1; }
  .vt-caption { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 16px; color: var(--text-secondary); font-size: 0.92rem; line-height: 1.55; }
  .vt-caption p { margin: 0; }
  .vt-caption a { white-space: nowrap; color: var(--brand-primary-light); font-weight: 600; text-decoration: none; }
  .vt-caption a:hover { text-decoration: underline; }
  @media (max-width: 992px) {
    .vt { grid-template-columns: 1fr; gap: 20px; }
    .vt-tabs { flex-direction: row; overflow-x: auto; padding-bottom: 6px; }
    .vt-tab { flex: none; padding: 10px 14px 10px 16px; }
    .vt-tab.on::before { top: 10px; bottom: 10px; }
    .vt-caption { flex-direction: column; align-items: flex-start; }
  }

  /* ---------- B: Mosaico ---------- */
  .mz { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 205px; gap: 14px; margin-top: 44px; }
  .mz-item { position: relative; overflow: hidden; border-radius: 16px; background: #fff; border: 1px solid rgba(124, 92, 255, 0.25); box-shadow: 0 18px 40px rgba(124, 92, 255, 0.1); text-decoration: none; display: block; }
  .mz-item.big { grid-column: span 2; grid-row: span 2; }
  .mz-item img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform 0.6s ease; }
  .mz-item:hover img { transform: scale(1.03); }
  .mz-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 44px 16px 14px; background: linear-gradient(180deg, transparent, rgba(15, 15, 18, 0.88)); color: #fff; display: flex; flex-direction: column; gap: 2px; }
  .mz-cap b { font-family: 'Lexend', sans-serif; font-weight: 600; font-size: 1rem; }
  .mz-item.big .mz-cap b { font-size: 1.25rem; }
  .mz-cap span { font-size: 0.8rem; opacity: 0.82; }
  @media (max-width: 992px) { .mz { grid-template-columns: 1fr 1fr; } .mz-item.big { grid-column: span 2; grid-row: span 1; } }
  @media (max-width: 640px) { .mz { grid-template-columns: 1fr; grid-auto-rows: 190px; } .mz-item.big { grid-column: auto; } }

  /* ---------- C: Editorial ---------- */
  .ed { display: flex; flex-direction: column; gap: 18px; margin-top: 44px; }
  .ed-row { display: grid; grid-template-columns: 1.25fr 1fr; gap: 32px; align-items: center; padding: 18px; border-radius: 18px; border: 1px solid var(--border-color); background: var(--card-bg); }
  .ed-row:nth-child(even) { grid-template-columns: 1fr 1.25fr; }
  .ed-row:nth-child(even) .ed-shot { order: 2; }
  .ed-shot { display: block; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-hover); background: #0F0F12; }
  .ed-bar { display: flex; align-items: center; gap: 6px; padding: 8px 12px; background: #1B1B20; border-bottom: 1px solid var(--border-color); font-size: 0.72rem; color: var(--n-300); }
  .ed-bar i { width: 8px; height: 8px; border-radius: 50%; background: #2A2A31; }
  .ed-bar > span { margin-left: 8px; }
  .ed-shot img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .ed-copy { padding: 8px 12px; }
  .ed-rubro { font-size: 0.82rem; color: var(--brand-primary-light); font-weight: 600; }
  .ed-copy h3 { font-family: 'Lexend', sans-serif; font-size: 1.4rem; font-weight: 600; color: var(--text-primary); margin: 8px 0 10px; }
  .ed-copy p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin: 0 0 14px; }
  .ed-copy a { color: var(--brand-primary-light); font-weight: 600; text-decoration: none; }
  .ed-copy a:hover { text-decoration: underline; }
  @media (max-width: 992px) { .ed-row, .ed-row:nth-child(even) { grid-template-columns: 1fr; } .ed-row:nth-child(even) .ed-shot { order: 0; } }
</style>
