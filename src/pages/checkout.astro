---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Checkout Seguro | Kaptativa" description="Completá tu compra del Plan Inmobiliario + CRM de forma rápida y segura.">

  <main class="checkout-main">
    <!-- MINI HEADER DE CHECKOUT SEGURO -->
    <header class="checkout-mini-header" style="max-width: 1100px; margin: 0 auto 20px auto; padding: 10px 0; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.06); padding-left: 20px; padding-right: 20px; position: relative; z-index: 10;">
      <a href="/" style="display: flex; align-items: center; text-decoration: none;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="130" height="32" style="display: block;">
          <defs>
            <linearGradient id="logo-grad-chk" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#EA384D" />
              <stop offset="100%" stop-color="#8A35E5" />
            </linearGradient>
          </defs>
          <g>
            <path d="M 6 13 L 6 47" stroke="url(#logo-grad-chk)" stroke-width="6.5" stroke-linecap="round" fill="none" />
            <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-grad-chk)" stroke-width="6.5" stroke-linecap="round" fill="none" />
            <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-grad-chk)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </g>
          <text x="44" y="39" font-family="'Lexend', 'Inter', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">
            kaptativa<tspan fill="#EA384D">.</tspan>
          </text>
        </svg>
      </a>
      <div style="display: flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2); padding: 8px 16px; border-radius: 99px; font-size: 0.775rem; color: #10B981; font-weight: 600; font-family: 'Lexend', sans-serif;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px; display: inline-block; vertical-align: middle;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Checkout seguro
      </div>
    </header>

    <div class="checkout-glow-1"></div>
    <div class="checkout-glow-2"></div>
    <div class="container">
      <div class="checkout-grid">
        <!-- FORM COLUMN -->
        <div class="checkout-form-card">
          <h1 class="checkout-title">Completá tu pedido</h1>
          <p class="checkout-subtitle">Ingresá los datos de facturación para tu sitio web y acceso al CRM.</p>

          <div class="error-banner" id="form-error-banner" style="display: none;"></div>

          <form id="checkout-form" novalidate>
            <div class="form-group">
              <input type="hidden" id="checkout-id" value="inmobiliaria">
            </div>

            <div class="form-section-title">1. Tu Correo Electrónico</div>
            <div class="form-group" style="margin-bottom: 25px;">
              <label for="checkout-email" class="form-label">Email de contacto *</label>
              <input type="email" id="checkout-email" class="form-control" placeholder="Ej. contacto@tuinmobiliaria.com" style="padding: 15px; font-size: 1rem; width: 100%;" required>
              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 6px;">
                Usaremos este correo para enviarte las credenciales de acceso y el estado de tu pedido.
              </div>
            </div>


            <div class="form-section-title" style="margin-top: 30px;">2. Método de Pago</div>
            <div class="payment-methods-grid">
              <label class="payment-option active" id="option-mp">
                <input type="radio" name="payment-method" value="mp" checked style="display: none;">
                <div class="payment-option-header">
                  <span class="radio-circle"></span>
                  <strong>Mercado Pago</strong>
                </div>
                <p>3 Cuotas sin interés con tarjetas bancarias o saldo de cuenta.</p>
                <div class="payment-badges">
                  <span class="pm-badge">Tarjetas</span>
                  <span class="pm-badge">3 Cuotas</span>
                </div>
              </label>

              <label class="payment-option" id="option-transfer">
                <input type="radio" name="payment-method" value="transfer" style="display: none;">
                <div class="payment-option-header">
                  <span class="radio-circle"></span>
                  <strong>Transferencia Bancaria</strong>
                </div>
                <p>Aboná mediante transferencia directa y obtené un 10% de descuento adicional.</p>
                <div class="payment-badges">
                  <span class="pm-badge discount">-10% OFF</span>
                </div>
              </label>
            </div>

            <button type="submit" class="btn btn-primary checkout-submit-btn" id="btn-submit-checkout">
              <span>Pagar ARS $360.000 (Pago Único)</span>
              <div class="spinner" id="checkout-spinner" style="display: none;"></div>
            </button>

            <!-- BANNER DE GARANTÍA / PAGO ÚNICO -->
            <div id="checkout-guarantee-box" style="margin-top: 20px; background: rgba(255, 255, 255, 0.02); border: 1.5px solid rgba(255, 255, 255, 0.05); border-radius: 12px; padding: 18px 24px; display: flex; align-items: flex-start; gap: 14px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-indigo); flex-shrink: 0; margin-top: 2px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 11 2 2 4-4"/></svg>
              <div>
                <h4 style="margin: 0 0 4px 0; color: white; font-size: 0.85rem; font-weight: 600; font-family: 'Lexend', sans-serif;">Inversión de Pago Único</h4>
                <p style="margin: 0; color: var(--text-secondary); font-size: 0.775rem; line-height: 1.45;">Adquirís el sitio web y el CRM para siempre. Sin cargos recurrentes, suscripciones ocultas ni cuotas mensuales obligatorias.</p>
              </div>
            </div>
          </form>
        </div>

        <!-- SUMMARY COLUMN -->
        <div class="checkout-summary-card">
          <h3>Resumen del Pedido</h3>
          
          <div class="summary-plan-details">
            <div class="plan-icon" style="color: var(--accent-indigo);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="plan-info">
              <h4>Web Inmobiliaria + CRM</h4>
              <p>Desarrollo con Pago Único</p>
            </div>
          </div>

          <div class="summary-features-list">
            <div class="feature-item">
              <span class="check">✓</span>
              <span>Sitio web profesional autogestionable</span>
            </div>
            <div class="feature-item">
              <span class="check">✓</span>
              <span>Buscador y catálogo de propiedades avanzado</span>
            </div>
            <div class="feature-item">
              <span class="check">✓</span>
              <span>CRM inmobiliario integrado con tablero Kanban</span>
            </div>
            <div class="feature-item">
              <span class="check">✓</span>
              <span>Hosting, seguridad y dominio .com.ar por 12 meses</span>
            </div>
            <div class="feature-item">
              <span class="check">✓</span>
              <span>Soporte técnico y mantenimiento del servidor bonificado</span>
            </div>
          </div>

          <div class="pricing-summary-box">
            <div class="pricing-row">
              <span>Precio Original:</span>
              <span style="text-decoration: line-through; opacity: 0.5;">ARS $780.000</span>
            </div>
            <div class="pricing-row highlight">
              <span>Precio Base:</span>
              <span>ARS $360.000</span>
            </div>
            <div class="pricing-row" id="row-discount" style="display: none; color: #10b981; font-weight: 600;">
              <span>Descuento (10% Transferencia):</span>
              <span>- ARS $36.000</span>
            </div>
            <div class="divider"></div>
            <div class="pricing-row total">
              <span>Total a Pagar:</span>
              <span id="lbl-total-price">ARS $360.000</span>
            </div>
            <div class="pricing-installments" id="lbl-installments-text">
              o 3 cuotas sin interés de <strong>ARS $120.000</strong>
            </div>
          </div>

          <div style="margin-top: 20px; font-size: 0.75rem; color: var(--text-muted); text-align: center; display: flex; align-items: center; justify-content: center; gap: 6px;">
            <span>🛡️</span> Conexión Cifrada SSL | Compra 100% Protegida
          </div>
        </div>
      </div>

      <!-- SECCIÓN PREGUNTAS FRECUENTES (Q&A) -->
      <div class="checkout-faq-section" style="margin-top: 60px; border-top: 1px solid var(--border-color); padding-top: 50px; max-width: 860px; margin-left: auto; margin-right: auto;">
        <div style="text-align: center; margin-bottom: 35px;">
          <span class="badge inmo-badge-gray" style="margin-bottom: 12px; display: inline-block;">FAQ</span>
          <h2 style="font-family: 'Lexend', sans-serif; font-size: 1.8rem; font-weight: 600; color: var(--text-primary);">Preguntas Frecuentes</h2>
          <p style="font-size: 0.95rem; color: var(--text-secondary); margin-top: 6px;">Resolvemos tus dudas antes de finalizar tu contratación.</p>
        </div>
        
        <div class="inmo-faq-accordion-wrapper" style="display: flex; flex-direction: column; gap: 14px;">
          
          <details class="inmo-faq-item inmo-glass-panel" style="background: rgba(15, 21, 36, 0.7); border: 1px solid var(--border-color); border-radius: 16px; backdrop-filter: blur(12px); overflow: hidden; transition: all 0.3s ease;">
            <summary style="list-style: none; outline: none; padding: 20px 24px; font-family: 'Lexend', sans-serif; font-weight: 600; font-size: 1rem; color: var(--text-primary); display: flex; justify-content: space-between; align-items: center; cursor: pointer; text-align: left;">
              <span>¿Qué sucede inmediatamente después de mi pago?</span>
              <span class="inmo-faq-arrow" style="font-size: 1.2rem; color: var(--accent-pink); font-weight: 400; transition: transform 0.3s;">+</span>
            </summary>
            <div style="padding: 0 24px 20px 24px; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; border-top: 1px solid rgba(255, 255, 255, 0.05); margin-top: 4px; padding-top: 14px; text-align: left;">
              Recibirás un correo electrónico de confirmación automático. Nuestro equipo técnico se contactará en menos de 2 horas hábiles para coordinar el registro de tu dominio `.com.ar`, configuración de colores/marca y puesta en marcha del CRM.
            </div>
          </details>

          <details class="inmo-faq-item inmo-glass-panel" style="background: rgba(15, 21, 36, 0.7); border: 1px solid var(--border-color); border-radius: 16px; backdrop-filter: blur(12px); overflow: hidden; transition: all 0.3s ease;">
            <summary style="list-style: none; outline: none; padding: 20px 24px; font-family: 'Lexend', sans-serif; font-weight: 600; font-size: 1rem; color: var(--text-primary); display: flex; justify-content: space-between; align-items: center; cursor: pointer; text-align: left;">
              <span>¿Cómo funciona el pago en 3 cuotas sin interés?</span>
              <span class="inmo-faq-arrow" style="font-size: 1.2rem; color: var(--accent-pink); font-weight: 400; transition: transform 0.3s;">+</span>
            </summary>
            <div style="padding: 0 24px 20px 24px; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; border-top: 1px solid rgba(255, 255, 255, 0.05); margin-top: 4px; padding-top: 14px; text-align: left;">
              Al seleccionar Mercado Pago, el sistema te redirigirá a su plataforma oficial. Si posees tarjetas de crédito emitidas por bancos físicos, verás la opción de abonar en 3 cuotas sin interés de ARS $120.000 de forma directa.
            </div>
          </details>

          <details class="inmo-faq-item inmo-glass-panel" style="background: rgba(15, 21, 36, 0.7); border: 1px solid var(--border-color); border-radius: 16px; backdrop-filter: blur(12px); overflow: hidden; transition: all 0.3s ease;">
            <summary style="list-style: none; outline: none; padding: 20px 24px; font-family: 'Lexend', sans-serif; font-weight: 600; font-size: 1rem; color: var(--text-primary); display: flex; justify-content: space-between; align-items: center; cursor: pointer; text-align: left;">
              <span>¿Hay algún costo oculto o mantenimiento mensual obligatorio?</span>
              <span class="inmo-faq-arrow" style="font-size: 1.2rem; color: var(--accent-pink); font-weight: 400; transition: transform 0.3s;">+</span>
            </summary>
            <div style="padding: 0 24px 20px 24px; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; border-top: 1px solid rgba(255, 255, 255, 0.05); margin-top: 4px; padding-top: 14px; text-align: left;">
              No. El sitio web y el CRM se adquieren con un pago único. El primer año de hosting, certificado SSL de seguridad y soporte técnico están incluidos.
            </div>
          </details>

          <details class="inmo-faq-item inmo-glass-panel" style="background: rgba(15, 21, 36, 0.7); border: 1px solid var(--border-color); border-radius: 16px; backdrop-filter: blur(12px); overflow: hidden; transition: all 0.3s ease;">
            <summary style="list-style: none; outline: none; padding: 20px 24px; font-family: 'Lexend', sans-serif; font-weight: 600; font-size: 1rem; color: var(--text-primary); display: flex; justify-content: space-between; align-items: center; cursor: pointer; text-align: left;">
              <span>¿Cómo reclamo el 10% de descuento por transferencia?</span>
              <span class="inmo-faq-arrow" style="font-size: 1.2rem; color: var(--accent-pink); font-weight: 400; transition: transform 0.3s;">+</span>
            </summary>
            <div style="padding: 0 24px 20px 24px; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; border-top: 1px solid rgba(255, 255, 255, 0.05); margin-top: 4px; padding-top: 14px; text-align: left;">
              Seleccioná "Transferencia Bancaria" en el checkout. La web registrará tu pedido con el monto final de ARS $324.000 y te mostrará los datos de nuestra cuenta bancaria. Luego, hacés clic en "Enviar comprobante por WhatsApp" para finalizar.
            </div>
          </details>

        </div>
      </div>
    </div>

    <!-- BANK TRANSFER MODAL -->
    <div class="modal-overlay" id="transfer-modal" style="display: none;">
      <div class="modal-content">
        <div class="modal-header">
          <h3 style="display: flex; align-items: center; gap: 8px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: #10B981; display: inline-block; vertical-align: middle;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            ¡Tu pedido ha sido registrado!
          </h3>
        </div>
        <p style="margin-bottom: 20px; color: var(--text-secondary); font-size: 0.9rem;">
          Para completar la contratación de tu **Plan Inmobiliario**, realizá la transferencia por el total con descuento y envíanos el comprobante.
        </p>

        <div class="bank-details-box">
          <div class="bank-row">
            <span>Banco:</span>
            <strong id="modal-bank-name">-</strong>
          </div>
          <div class="bank-row">
            <span>Titular:</span>
            <strong id="modal-bank-titular">-</strong>
          </div>
          <div class="bank-row">
            <span>Alias:</span>
            <strong id="modal-bank-alias">-</strong>
          </div>
          <div class="bank-row">
            <span>CBU:</span>
            <strong id="modal-bank-cbu">-</strong>
          </div>
          <div class="bank-row total-pay">
            <span>Monto con Descuento:</span>
            <strong style="color: #10b981;">ARS $324.000</strong>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 25px;">
          <a id="btn-modal-whatsapp" href="#" target="_blank" class="btn btn-primary" style="background: linear-gradient(90deg, #10B981, #059669); border: none; justify-content: center; color: white; font-weight: 600; text-decoration: none;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px; display: inline-block; vertical-align: middle;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg> Enviar Comprobante por WhatsApp
          </a>
          <button id="btn-modal-close" class="btn btn-secondary" style="justify-content: center;">
            Cerrar e ir al Inicio
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .checkout-main {
    min-height: 90vh;
    padding-top: 15px;
    padding-bottom: 80px;
    position: relative;
    overflow: hidden;
    background-color: var(--bg-primary);
  }
  .faq-card {
    transition: background 0.3s, border-color 0.3s;
  }
  .faq-card summary {
    list-style: none;
  }
  .faq-card summary::-webkit-details-marker {
    display: none;
  }
  .faq-card[open] {
    background: rgba(255, 255, 255, 0.03) !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
  }
  .faq-card[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .checkout-glow-1 {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 70, 239, 0.08) 0%, transparent 70%);
    top: -100px;
    left: -100px;
    z-index: 0;
    pointer-events: none;
  }
  .checkout-glow-2 {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.06) 0%, transparent 70%);
    bottom: 50px;
    right: -100px;
    z-index: 0;
    pointer-events: none;
  }
  .checkout-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 30px;
    position: relative;
    z-index: 1;
    margin-top: 20px;
  }
  @media (max-width: 992px) {
    .checkout-grid {
      grid-template-columns: 1fr;
    }
  }
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
    display: inline-block;
  }
  .back-link:hover {
    color: var(--accent-indigo);
  }
  .checkout-form-card {
    background: rgba(15, 15, 25, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 35px;
    backdrop-filter: blur(10px);
  }
  .checkout-title {
    font-family: 'Lexend', sans-serif;
    font-size: 2rem;
    font-weight: 600;
    color: white;
    margin: 0 0 6px 0;
    letter-spacing: -0.02em;
  }
  .checkout-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0 0 30px 0;
    line-height: 1.5;
  }
  .form-section-title {
    font-family: 'Lexend', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: white;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding-bottom: 8px;
  }
  .form-group-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  @media (max-width: 576px) {
    .form-group-row {
      grid-template-columns: 1fr;
      gap: 15px;
      margin-bottom: 15px;
    }
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #8A8A9A;
  }
  .form-control {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 12px 16px;
    color: white;
    font-size: 0.9rem;
    outline: none;
    transition: all 0.2s;
  }
  .form-control:focus {
    border-color: var(--accent-indigo);
    box-shadow: 0 0 10px rgba(217, 70, 239, 0.15);
  }
  .payment-methods-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 30px;
  }
  @media (max-width: 576px) {
    .payment-methods-grid {
      grid-template-columns: 1fr;
    }
  }
  .payment-option {
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255,255,255,0.01);
    border-radius: 12px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .payment-option:hover {
    border-color: rgba(217, 70, 239, 0.3);
    background: rgba(217, 70, 239, 0.02);
  }
  .payment-option.active {
    border-color: var(--accent-indigo);
    background: rgba(217, 70, 239, 0.04);
  }
  .payment-option-header {
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
  }
  .radio-circle {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.3);
    display: inline-block;
    position: relative;
  }
  .payment-option.active .radio-circle {
    border-color: var(--accent-indigo);
  }
  .payment-option.active .radio-circle::after {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent-indigo);
    border-radius: 50%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .payment-option p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }
  .payment-badges {
    display: flex;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
  }
  .pm-badge {
    font-size: 0.65rem;
    font-weight: 600;
    padding: 2px 6px;
    background: rgba(255,255,255,0.06);
    color: var(--text-secondary);
    border-radius: 4px;
    text-transform: uppercase;
  }
  .pm-badge.discount {
    background: rgba(16, 185, 129, 0.15);
