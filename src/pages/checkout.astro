    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 10px;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* MODAL */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
  }
  .modal-content {
    background: #0f0f1b;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 30px;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    position: relative;
  }
  .modal-header h3 {
    font-family: 'Lexend', sans-serif;
    color: white;
    font-size: 1.35rem;
    margin: 0 0 12px 0;
  }
  .bank-details-box {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 20px;
  }
  .bank-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    margin-bottom: 8px;
    color: var(--text-secondary);
  }
  .bank-row strong {
    color: white;
    word-break: break-all;
  }
  .bank-row.total-pay {
    margin-top: 15px;
    border-top: 1px dashed rgba(255,255,255,0.08);
    padding-top: 12px;
    font-size: 1rem;
    font-weight: 600;
    color: white;
  }
</style>

<script>
  import { api } from '../lib/appwrite.js';

  document.addEventListener('DOMContentLoaded', () => {
    const checkoutForm = document.getElementById('checkout-form') as HTMLFormElement;
    const btnSubmit = document.getElementById('btn-submit-checkout') as HTMLButtonElement;
    const spinner = document.getElementById('checkout-spinner');
    const errorBanner = document.getElementById('form-error-banner');

    const optionMp = document.getElementById('option-mp')!;
    const optionTransfer = document.getElementById('option-transfer')!;
    const radioMp = optionMp.querySelector('input[type="radio"]') as HTMLInputElement;
    const radioTransfer = optionTransfer.querySelector('input[type="radio"]') as HTMLInputElement;

    const rowDiscount = document.getElementById('row-discount')!;
    const lblTotalPrice = document.getElementById('lbl-total-price')!;
    const lblInstallmentsText = document.getElementById('lbl-installments-text')!;

    const transferModal = document.getElementById('transfer-modal')!;
    const btnCloseModal = document.getElementById('btn-modal-close')!;
    const btnModalWhatsapp = document.getElementById('btn-modal-whatsapp') as HTMLAnchorElement;

    // Load dynamic bank configurations
    const crmSettings = JSON.parse(localStorage.getItem('crm_settings') || '{}');
    const bankName = crmSettings.bank_name || 'Banco Galicia';
    const bankTitular = crmSettings.bank_titular || 'Kaptativa Digital';
    const bankAlias = crmSettings.bank_alias || 'kaptativa.dev';
    const bankCbu = crmSettings.bank_cbu || '0070123456789012345678';

    // Populate modal bank details
    document.getElementById('modal-bank-name')!.innerText = bankName;
    document.getElementById('modal-bank-titular')!.innerText = bankTitular;
    document.getElementById('modal-bank-alias')!.innerText = bankAlias;
    document.getElementById('modal-bank-cbu')!.innerText = bankCbu;

    let selectedPayment = 'mp'; // 'mp' | 'transfer'

    // Toggle Payment Methods handler
    optionMp.addEventListener('click', () => {
      selectedPayment = 'mp';
      optionMp.classList.add('active');
      optionTransfer.classList.remove('active');
      radioMp.checked = true;

      // Update summary pricing
      rowDiscount.style.display = 'none';
      lblTotalPrice.innerText = 'ARS $360.000';
      lblInstallmentsText.style.display = 'block';
      
      btnSubmit.querySelector('span')!.innerText = 'Pagar ARS $360.000 (Pago Único)';
    });

    optionTransfer.addEventListener('click', () => {
      selectedPayment = 'transfer';
      optionTransfer.classList.add('active');
      optionMp.classList.remove('active');
      radioTransfer.checked = true;

      // Update summary pricing
      rowDiscount.style.display = 'flex';
      lblTotalPrice.innerText = 'ARS $324.000';
      lblInstallmentsText.style.display = 'none';

      btnSubmit.querySelector('span')!.innerText = 'Pagar ARS $324.000 (Pago Único)';
    });

    // Check url param method on load
    const urlParams = new URLSearchParams(window.location.search);
    const methodParam = urlParams.get('method');
    if (methodParam === 'transfer') {
      optionTransfer.click();
    } else {
      optionMp.click();
    }

    // Form Submission
    if (checkoutForm) {
      checkoutForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const email = (document.getElementById('checkout-email') as HTMLInputElement).value.trim();

        // Validate
        if (errorBanner) errorBanner.style.display = 'none';

        if (!email) {
          showError('Por favor, ingresa tu correo electrónico.');
          return;
        }

        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(email)) {
          showError('Por favor, ingresa un correo electrónico válido.');
          return;
        }

        // Start spinner
        btnSubmit.disabled = true;
        if (spinner) spinner.style.display = 'block';

        // Infer parameters to fulfill database schemas
        const name = email.split('@')[0] || 'Cliente Web';
        const business = 'Inmobiliaria a Confirmar';
        const whatsapp = '-';

        const rawAmount = selectedPayment === 'mp' ? 360000 : 324000;
        const usdPrice = selectedPayment === 'mp' ? 360 : 324;
        const discountPct = selectedPayment === 'mp' ? 0 : 10;
        const discountVal = selectedPayment === 'mp' ? 0 : 36;

        try {
          // 1. Create CRM Lead log
          const lead = await api.db.createLead({
            name,
            business,
            whatsapp,
            email,
            message: `Checkout de Plan Inmobiliario iniciado. Método de pago: ${selectedPayment === 'mp' ? 'Mercado Pago' : 'Transferencia (10% OFF)'}.`,
            status: 'nuevo',
            tags: `Checkout Inmobiliarias, ${selectedPayment === 'mp' ? 'Mercado Pago' : 'Transferencia'}`,
            score: 95,
            recommendations: 'Plan Inmobiliario ($360.000) seleccionado en checkout.'
          });

          // 2. Create Budget/Quote invoice log
          const budget = await api.db.createBudget({
            quote_number: `KP-INMO-${Date.now().toString().slice(-4)}`,
            client_name: name,
            client_business: business,
            client_email: email,
            client_whatsapp: whatsapp,
            items: JSON.stringify([{ name: 'Web Inmobiliaria + CRM Integrado (Pago Único)', price: 360, qty: 1 }]),
            subtotal: 360,
            discount_pct: discountPct,
            discount_val: discountVal,
            total: usdPrice,
            validity_days: 7,
            notes: `Plan Inmobiliario contratado desde la web. Método de pago: ${selectedPayment === 'mp' ? 'Mercado Pago' : 'Transferencia Bancaria'}.`,
            metadata: JSON.stringify({ serviceType: 'inmobiliaria', currency: 'ARS', exchangeRate: 1000, basePrice: 360, features: [] }),
            status: 'enviado'
          });

          if (selectedPayment === 'mp') {
            // 3. MERCADO PAGO GATEWAY PROCESS
            const mpRes = await fetch('/api/create-mp-preference', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                quoteId: budget.$id,
                client: business,
                email: email,
                title: 'Web Inmobiliaria + CRM (Pago Único) - Kaptativa',
                amount: rawAmount,
                currency: 'ARS'
              })
            });

            if (!mpRes.ok) {
              const errData = await mpRes.json().catch(() => ({}));
              throw new Error(errData.error || `Mercado Pago err ${mpRes.status}`);
            }

            const mpData = await mpRes.json();
            if (mpData.init_point) {
              window.location.href = mpData.init_point;
            } else {
              throw new Error('No se recibió la URL de redirección de Mercado Pago.');
            }

          } else {
            // 4. BANK TRANSFER PROCESS: Show confirmation modal
            if (spinner) spinner.style.display = 'none';
            btnSubmit.disabled = false;

            // Generate WhatsApp Link
            const textMsg = `¡Hola Kaptativa! Acabo de confirmar la compra del Plan Inmobiliario por transferencia bancaria (Monto: ARS $324.000). Mi correo es ${email}. En breve les envío el comprobante de transferencia.`;
            btnModalWhatsapp.href = `https://wa.me/541138830925?text=${encodeURIComponent(textMsg)}`;
            
            // Show modal
            transferModal.style.display = 'flex';
          }

        } catch (err: any) {
          console.error(err);
          showError(`Ocurrió un error al procesar tu solicitud: ${err.message || 'Inténtalo de nuevo.'}`);
          btnSubmit.disabled = false;
          if (spinner) spinner.style.display = 'none';
        }
      });
    }

    function showError(msg: string) {
      if (errorBanner) {
        errorBanner.innerText = msg;
        errorBanner.style.display = 'block';
        errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    // Modal Close
    if (btnCloseModal) {
      btnCloseModal.addEventListener('click', () => {
        transferModal.style.display = 'none';
        window.location.href = '/';
      });
    }
  });
</script>
