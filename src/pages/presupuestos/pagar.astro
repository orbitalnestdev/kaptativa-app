---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pasarela de Pagos Segura | Kaptativa" description="Plataforma de cobros y facturación online para tu propuesta técnica.">

  <main class="quote-payment-main" style="padding-top: 40px; padding-bottom: 80px; min-height: 90vh; position: relative;">
    
    <div class="container" style="max-width: 1050px; margin: 0 auto;">
      <!-- SECURE CHECKOUT HEADER -->
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 15px 0; margin-bottom: 40px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); flex-wrap: wrap; gap: 15px;">
        <a href="/" style="display: flex; align-items: center; text-decoration: none;">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="160" height="34" aria-label="Kaptativa Logo">
            <defs>
              <linearGradient id="logo-gradient-checkout" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#EA384D" />
                <stop offset="100%" stop-color="#8A35E5" />
              </linearGradient>
            </defs>
            <g>
              <path d="M 6 13 L 6 47" stroke="url(#logo-gradient-checkout)" stroke-width="6.5" stroke-linecap="round" fill="none" />
              <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-gradient-checkout)" stroke-width="6.5" stroke-linecap="round" fill="none" />
              <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-gradient-checkout)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </g>
            <text x="44" y="39" font-family="'Lexend', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">
              kaptativa<tspan fill="#EA384D">.</tspan>
            </text>
          </svg>
        </a>
        <div style="display: flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.2); padding: 8px 16px; border-radius: 99px; font-size: 0.8rem; color: #10B981; font-weight: 600; font-family: 'Lexend', sans-serif;">
          <span style="font-size: 0.95rem; line-height: 1;">🔒</span> Conexión Cifrada SSL 256-bit
        </div>
      </div>
    </div>

    <!-- LOADING STATUS -->
    <div class="container" id="payment-loading-status">
      <div style="text-align: center; padding: 100px 0;">
        <div class="spinner" style="margin: 0 auto 20px auto;"></div>
        <p style="color: var(--text-secondary); font-size: 1.1rem;">Iniciando pasarela segura...</p>
      </div>
    </div>

    <!-- ERROR STATUS -->
    <div class="container" id="payment-error-status" style="display: none;">
      <div style="text-align: center; padding: 100px 0; max-width: 600px; margin: 0 auto;">
        <span style="font-size: 4rem; display: block; margin-bottom: 20px;">⚠️</span>
        <h2 style="font-family: 'Lexend', sans-serif; font-size: 2rem; color: white;">Error al iniciar el pago</h2>
        <p style="color: var(--text-secondary); margin: 15px auto 30px auto; line-height: 1.6;">
          Tuvimos un inconveniente al procesar el pago. No te preocupes: podés escribirle de inmediato a tu asesor comercial asignado o contactarnos por WhatsApp para resolverlo juntos.
        </p>
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
          <a href="https://wa.me/541138830925?text=Hola,%20tuve%20un%20error%20en%20la%20pasarela%20de%20pagos%20de%20Kaptativa." target="_blank" class="btn btn-secondary btn-whatsapp" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: rgba(16, 185, 129, 0.08); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); font-weight: 600; text-decoration: none; border-radius: 8px; font-size: 0.95rem; transition: all 0.2s;">
            Soporte por WhatsApp 💬
          </a>
          <a href="/" class="btn btn-primary" style="padding: 12px 24px;">Volver al Inicio</a>
        </div>
      </div>
    </div>

    <!-- MAIN VIEW CONTAINER -->
    <div class="container" id="payment-main-view" style="display: none; max-width: 1050px; margin: 0 auto;">
      
      <!-- TOP NAVIGATION BAR -->
      <div style="margin-bottom: 30px;">
        <a id="lnk-back-to-quote" href="#" style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; color: var(--text-secondary); text-decoration: none; font-weight: 500; transition: color 0.2s;">
          <span style="font-size: 1.1rem;">←</span> Volver a la propuesta
        </a>
      </div>

      <!-- SUCCESS / STATUS NOTIFICATION -->
      <div id="payment-status-card" style="display: none; background: rgba(16, 185, 129, 0.1); border: 1.5px solid #10b981; border-radius: 12px; padding: 22px; margin-bottom: 30px; box-shadow: 0 10px 20px rgba(16, 185, 129, 0.05);">
        <div style="display: flex; gap: 15px; align-items: flex-start;">
          <span style="font-size: 1.5rem; line-height: 1;">✅</span>
          <div>
            <h3 style="margin: 0 0 5px 0; font-family: 'Lexend', sans-serif; font-size: 1.15rem; font-weight: 600; color: white;">¡Pago acreditado con éxito!</h3>
            <p style="margin: 0; color: var(--text-secondary); font-size: 0.85rem; line-height: 1.5;">
              Hemos recibido la confirmación electrónica de Mercado Pago. El desarrollo técnico de tu proyecto se agendará de inmediato. Tu consultor se pondrá en contacto para coordinar la primera sesión técnica.
            </p>
          </div>
        </div>
      </div>

      <div class="grid-2-custom" style="display: grid; grid-template-columns: 1.1fr 1.3fr; gap: 40px; align-items: start;">
        
        <!-- LEFT COLUMN: QUOTE DETAILED SUMMARY (GLASS PANEL) -->
        <div style="background: var(--card-bg); border: 1px solid var(--border-color); padding: 35px; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); color: var(--text-primary); backdrop-filter: blur(12px);">
          <span class="badge" style="margin-bottom: 12px; background: linear-gradient(90deg, #D946EF, #EA384D); color: white; padding: 4px 12px; border-radius: 99px; font-size: 0.725rem; font-weight: 600; display: inline-block; text-transform: uppercase; letter-spacing: 0.5px;">Resumen Comercial</span>
          <h2 id="lbl-service-title" style="font-family: 'Lexend', sans-serif; font-size: 1.7rem; color: #ffffff; margin-top: 10px; margin-bottom: 25px; font-weight: 600;">Servicios Digitales</h2>
          
          <div style="display: flex; flex-direction: column; gap: 16px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); padding: 20px; border-radius: 10px; margin-bottom: 25px;">
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; align-items: center;">
              <span style="color: var(--text-secondary);">Código de Propuesta:</span>
              <span id="lbl-quote-ref" style="font-weight: 600; color: #ffffff;">KP-0000</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; align-items: center;">
              <span style="color: var(--text-secondary);">Razón Social:</span>
              <span id="lbl-client-business" style="font-weight: 600; color: #ffffff;">Cliente</span>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; align-items: center;">
              <span style="color: var(--text-secondary);">Representante:</span>
              <span id="lbl-client-name" style="font-weight: 500; color: #ffffff;">Contacto</span>
            </div>
          </div>

          <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 20px;">
            <div style="font-size: 0.725rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 15px;">Conceptos Cotizados</div>
            <div id="payment-items-container" style="display: flex; flex-direction: column; gap: 12px;">
              <!-- Dynamic item rows -->
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: CHOOSE OPTIONS AND PAY (GLASS PANEL) -->
        <div style="display: flex; flex-direction: column; gap: 30px;">
          
          <!-- 1. CHOOSE PAYMENT RATIO (50% vs 100%) -->
          <div style="background: var(--card-bg); border: 1px solid var(--border-color); padding: 35px; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); color: var(--text-primary); backdrop-filter: blur(12px);">
            <h3 style="font-family: 'Lexend', sans-serif; font-size: 1.2rem; color: #ffffff; margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 12px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
              <span style="color: #EA384D;">1.</span> Plan de Pago
            </h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
              
              <!-- Option 50% -->
              <div id="btn-pay-deposit" style="cursor: pointer; padding: 22px 15px; border-radius: 10px; border: 2px solid #EA384D; background: rgba(6, 182, 212, 0.08); text-align: center; transition: all 0.2s; box-shadow: 0 4px 15px rgba(6, 182, 212, 0.05);">
                <div style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: #EA384D; margin-bottom: 6px; letter-spacing: 0.5px;">Anticipo 50%</div>
                <div style="font-size: 0.7rem; color: var(--text-secondary); margin-bottom: 10px;">Para inicio de desarrollo</div>
                <div id="lbl-deposit-val" style="font-size: 1.35rem; font-weight: 600; color: #ffffff; font-family: 'Lexend', sans-serif;">$0.00</div>
              </div>

              <!-- Option 100% -->
              <div id="btn-pay-full" style="cursor: pointer; padding: 22px 15px; border-radius: 10px; border: 2px solid rgba(255, 255, 255, 0.06); background: rgba(255, 255, 255, 0.02); text-align: center; transition: all 0.2s;">
                <div style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; letter-spacing: 0.5px;">Pago Completo 100%</div>
                <div style="font-size: 0.7rem; color: var(--text-secondary); margin-bottom: 10px;">Abono del total del servicio</div>
                <div id="lbl-full-val" style="font-size: 1.35rem; font-weight: 600; color: var(--text-secondary); font-family: 'Lexend', sans-serif;">$0.00</div>
              </div>

            </div>
          </div>

          <!-- 2. CHOOSE PAYMENT GATEWAY METHOD -->
          <div style="background: var(--card-bg); border: 1px solid var(--border-color); padding: 35px; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.3); color: var(--text-primary); backdrop-filter: blur(12px);">
            <h3 style="font-family: 'Lexend', sans-serif; font-size: 1.2rem; color: #ffffff; margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 12px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
              <span style="color: #EA384D;">2.</span> Método de Pago
            </h3>
            
            <div style="display: flex; gap: 10px; margin-bottom: 25px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 12px;">
              <button id="tab-transfer" style="flex: 1; border: none; background: transparent; color: #ffffff; font-weight: 600; padding: 8px; cursor: pointer; border-bottom: 2px solid #7c3aed; font-size: 0.9rem; transition: all 0.2s; font-family: 'Lexend', sans-serif;">
                🏛️ Transferencia
              </button>
              <button id="tab-mp" style="flex: 1; border: none; background: transparent; color: var(--text-muted); font-weight: 600; padding: 8px; cursor: pointer; border-bottom: 2px solid transparent; font-size: 0.9rem; transition: all 0.2s; font-family: 'Lexend', sans-serif;">
                💳 Mercado Pago
              </button>
            </div>

            <!-- TAB CONTENT: BANK TRANSFER -->
            <div id="pane-transfer">
              <div style="background: rgba(6, 182, 212, 0.05); border: 1.5px solid rgba(6, 182, 212, 0.15); border-radius: 8px; padding: 15px; font-size: 0.8rem; line-height: 1.5; color: var(--text-primary); margin-bottom: 20px; display: flex; gap: 10px; align-items: flex-start;">
                <span style="font-size: 1.1rem; line-height: 1;">ℹ️</span>
                <div>
                  Obtén un <strong>15% de bonificación automática</strong> si seleccionas <strong>Pago Completo 100%</strong> abonando vía transferencia. El monto abajo ya calcula este descuento especial.
                </div>
              </div>

              <!-- Bank details fields -->
              <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 25px;">
                <div class="bank-field" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); padding: 12px 15px; border-radius: 8px;">
                  <div>
                    <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Banco / Entidad</div>
                    <div id="lbl-bank-name" style="font-size: 0.95rem; font-weight: 600; color: #ffffff; margin-top: 2px;">Cargando...</div>
                  </div>
                </div>
                <div class="bank-field" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); padding: 12px 15px; border-radius: 8px;">
                  <div>
                    <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Titular</div>
                    <div id="lbl-bank-titular" style="font-size: 0.95rem; font-weight: 600; color: #ffffff; margin-top: 2px;">Cargando...</div>
                  </div>
                </div>
                <div class="bank-field" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); padding: 12px 15px; border-radius: 8px;">
                  <div>
                    <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Alias CBU</div>
                    <div id="lbl-bank-alias" style="font-size: 0.95rem; font-weight: 600; color: #ffffff; margin-top: 2px;">Cargando...</div>
                  </div>
                  <button id="btn-copy-alias" class="btn btn-secondary btn-sm" style="padding: 6px 12px; border-radius: 6px; font-size: 0.75rem; cursor: pointer; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.05); color: #ffffff;">📋 Copiar</button>
                </div>
                <div class="bank-field" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); padding: 12px 15px; border-radius: 8px;">
                  <div>
                    <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">CBU / CVU</div>
                    <div id="lbl-bank-cbu" style="font-size: 0.95rem; font-weight: 600; color: #ffffff; margin-top: 2px;">Cargando...</div>
                  </div>
                  <button id="btn-copy-cbu" class="btn btn-secondary btn-sm" style="padding: 6px 12px; border-radius: 6px; font-size: 0.75rem; cursor: pointer; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.05); color: #ffffff;">📋 Copiar</button>
                </div>
              </div>

              <!-- Action: Send receipt -->
              <div style="border-top: 1.5px solid rgba(255, 255, 255, 0.08); padding-top: 25px; display: flex; flex-direction: column; align-items: center; text-align: center;">
                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 8px;">Monto total a transferir:</div>
                <div id="lbl-transfer-final-total" style="font-size: 1.9rem; font-weight: 600; color: #ffffff; margin-bottom: 20px; font-family: 'Lexend', sans-serif;">$0.00</div>
                <a id="lnk-whatsapp-receipt" href="#" target="_blank" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 0.9rem; width: 100%; justify-content: center; background: linear-gradient(90deg, #10B981, #059669); border: none; color: white; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);">
                  💬 Enviar Comprobante por WhatsApp
                </a>
              </div>
            </div>

            <!-- TAB CONTENT: MERCADO PAGO -->
            <div id="pane-mp" style="display: none;">
              <div style="background: rgba(124, 58, 237, 0.05); border: 1.5px solid rgba(124, 58, 237, 0.15); border-radius: 8px; padding: 15px; font-size: 0.8rem; line-height: 1.5; color: var(--text-primary); margin-bottom: 20px; display: flex; gap: 10px; align-items: flex-start;">
                <span style="font-size: 1.1rem; line-height: 1;">💳</span>
                <div>
                  Abona de forma segura mediante tarjetas de crédito, débito o dinero en cuenta. Si posees tarjeta bancaria, puedes financiar el anticipo en 3 cuotas fijas sin interés.
                </div>
              </div>

              <div style="border-top: 1.5px solid rgba(255, 255, 255, 0.08); padding-top: 25px; display: flex; flex-direction: column; align-items: center; text-align: center;">
                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 8px;">Monto a abonar en Mercado Pago:</div>
                <div id="lbl-mp-final-total" style="font-size: 1.9rem; font-weight: 600; color: #ffffff; margin-bottom: 20px; font-family: 'Lexend', sans-serif;">$0.00</div>
                <button id="btn-pay-mp" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 0.95rem; width: 100%; justify-content: center; background: #009ee3; border: none; color: white; cursor: pointer; box-shadow: 0 4px 15px rgba(0, 158, 227, 0.2);">
                  🔒 Pagar con Mercado Pago
                </button>
                <div style="margin-top: 12px; font-size: 0.725rem; color: var(--text-muted); display: flex; align-items: center; gap: 4px; justify-content: center;">
                  🛡️ Pagos procesados de forma segura con encriptación TLS 1.3
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

      <!-- SECURE CHECKOUT FOOTER -->
      <div style="margin-top: 60px; padding-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.06); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; font-size: 0.8rem; color: var(--text-muted); padding-bottom: 40px;">
        <div>
          © 2026 Kaptativa. Todos los derechos reservados.
        </div>
        <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
          <a href="/#inicio" style="color: var(--text-muted); text-decoration: none; transition: color 0.2s;">Políticas de Privacidad</a>
          <a href="/#inicio" style="color: var(--text-muted); text-decoration: none; transition: color 0.2s;">Términos de Servicio</a>
          <span style="color: rgba(255,255,255,0.06);">|</span>
          <span>Soporte Técnico: <strong>contacto@kaptativa.com</strong></span>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  import { api } from '../../lib/appwrite.js';

  document.addEventListener('DOMContentLoaded', async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const id = urlParams.get('id');
    const paymentStatusParam = urlParams.get('status');

    const loadingStatus = document.getElementById('payment-loading-status');
    const errorStatus = document.getElementById('payment-error-status');
    const mainView = document.getElementById('payment-main-view');

    // UI state variables
    let selectedOption = 'deposit'; // 'deposit' | 'full'
    let selectedTab = 'transfer'; // 'transfer' | 'mp'
    let budgetObj: any = null;
    let metaObj: any = null;

    // Load Settings
    const crmSettings = JSON.parse(localStorage.getItem('crm_settings') || '{}');
    const bankName = crmSettings.bank_name || 'Agencia Galicia';
    const bankTitular = crmSettings.bank_titular || 'Kaptativa Digital';
    const bankAlias = crmSettings.bank_alias || 'kaptativa.galicia';
    const bankCbu = crmSettings.bank_cbu || '0070123456789012345678';
    
    const mpWebhookUrl = crmSettings.mp_webhook_url || '';

    // Render static bank configurations
    document.getElementById('lbl-bank-name')!.innerText = bankName;
    document.getElementById('lbl-bank-titular')!.innerText = bankTitular;
    document.getElementById('lbl-bank-alias')!.innerText = bankAlias;
    document.getElementById('lbl-bank-cbu')!.innerText = bankCbu;

    if (!id) {
      showError();
      return;
    }

    try {
      budgetObj = await api.db.getBudget(id);
      if (!budgetObj) {
        showError();
        return;
      }

      // Check payment status from URL params
      if (paymentStatusParam === 'success') {
        document.getElementById('payment-status-card')!.style.display = 'block';
        try {
          await api.db.updateBudget(id, { status: 'aceptado' });
        } catch (e) {}
      }

      // Parse metadata
      let userNotes = budgetObj.notes || '';
      metaObj = {
        currency: 'USD',
        exchangeRate: 1000,
        enableInstallments: true,
        enableTransferDiscount: true,
        urgency: 0,
        maintenance: 0,
        discount: 0,
        basePrice: budgetObj.subtotal,
        serviceType: 'Propuesta',
        features: []
      };

      if (budgetObj.metadata) {
        try {
          metaObj = JSON.parse(budgetObj.metadata);
        } catch (err) {
          console.error("Failed to parse dedicated metadata attribute", err);
        }
      } else {
        const sepIdx = userNotes.indexOf('\n\n---METADATA---\n');
        if (sepIdx !== -1) {
          try {
            metaObj = JSON.parse(userNotes.substring(sepIdx + 16));
          } catch (err) {}
        }
      }

      const isArs = metaObj.currency === 'ARS';
      const rate = parseFloat(metaObj.exchangeRate) || 1000;

      // Populate basic views
      document.getElementById('lnk-back-to-quote')!.setAttribute('href', `/presupuestos?id=${id}`);
      document.getElementById('lbl-quote-ref')!.innerText = budgetObj.quote_number || 'KP-0000';
      document.getElementById('lbl-client-business')!.innerText = budgetObj.client_business || '';
      document.getElementById('lbl-client-name')!.innerText = budgetObj.client_name || '';

      const baseLabel = metaObj.serviceType === 'web' ? 'Diseño Web' :
                        metaObj.serviceType === 'auto' ? 'Automatización' :
                        metaObj.serviceType === 'ia' ? 'Agente IA' : 'Sistema Completo';
      document.getElementById('lbl-service-title')!.innerText = baseLabel;

      // Helpers
      function formatVal(value: number) {
        const converted = isArs ? value * rate : value;
        if (isArs) {
          return `$ ${Math.round(converted).toLocaleString('es-AR')} ARS`;
        }
        return `US$ ${Math.round(value).toLocaleString('en-US')}`;
      }

      // Populating dynamic item rows
      const itemsContainer = document.getElementById('payment-items-container')!;
      itemsContainer.innerHTML = '';

      let itemsArray: any[] = [];
      try {
        itemsArray = JSON.parse(budgetObj.items || '[]');
      } catch (e) {}

      itemsArray.forEach(itm => {
        const row = document.createElement('div');
        row.style.display = 'flex';
        row.style.justifyContent = 'space-between';
        row.style.fontSize = '0.85rem';
        row.style.color = 'var(--text-secondary)';
        row.style.marginBottom = '6px';
        row.innerHTML = `
          <span>${itm.name || 'Módulo'}</span>
          <span style="font-weight: 600; color: var(--text-primary);">${formatVal(itm.price)}</span>
        `;
        itemsContainer.appendChild(row);
      });

      // Populate pricing splits
      const totalSetup = budgetObj.total; // total in USD
      const depositUsd = totalSetup * 0.5;

      document.getElementById('lbl-deposit-val')!.innerText = formatVal(depositUsd);
      document.getElementById('lbl-full-val')!.innerText = formatVal(totalSetup);

      // Setup tab actions
      const tabTransfer = document.getElementById('tab-transfer')!;
      const tabMp = document.getElementById('tab-mp')!;
      const paneTransfer = document.getElementById('pane-transfer')!;
      const paneMp = document.getElementById('pane-mp')!;

      tabTransfer.addEventListener('click', () => {
        selectedTab = 'transfer';
        tabTransfer.style.borderBottom = '2px solid #7c3aed';
        tabTransfer.style.color = '#ffffff';
        tabMp.style.borderBottom = '2px solid transparent';
        tabMp.style.color = 'var(--text-muted)';
        
        paneTransfer.style.display = 'block';
        paneMp.style.display = 'none';
        
        recalculateTotals();
      });

      tabMp.addEventListener('click', () => {
        selectedTab = 'mp';
        tabMp.style.borderBottom = '2px solid #7c3aed';
        tabMp.style.color = '#ffffff';
        tabTransfer.style.borderBottom = '2px solid transparent';
        tabTransfer.style.color = 'var(--text-muted)';
        
        paneMp.style.display = 'block';
        paneTransfer.style.display = 'none';
        
        recalculateTotals();
      });

      // Plan option buttons styling togglers
      const btnDeposit = document.getElementById('btn-pay-deposit')!;
      const btnFull = document.getElementById('btn-pay-full')!;

      btnDeposit.addEventListener('click', () => {
        selectedOption = 'deposit';
        
        btnDeposit.style.borderColor = '#EA384D';
        btnDeposit.style.backgroundColor = 'rgba(6, 182, 212, 0.08)';
        btnDeposit.querySelector('div')!.style.color = '#EA384D';
        document.getElementById('lbl-deposit-val')!.style.color = '#ffffff';
        
        btnFull.style.borderColor = 'rgba(255, 255, 255, 0.06)';
        btnFull.style.backgroundColor = 'rgba(255, 255, 255, 0.02)';
        btnFull.querySelector('div')!.style.color = 'var(--text-muted)';
        document.getElementById('lbl-full-val')!.style.color = 'var(--text-secondary)';
        
        recalculateTotals();
      });

      btnFull.addEventListener('click', () => {
        selectedOption = 'full';
        
        btnFull.style.borderColor = '#EA384D';
        btnFull.style.backgroundColor = 'rgba(6, 182, 212, 0.08)';
        btnFull.querySelector('div')!.style.color = '#EA384D';
        document.getElementById('lbl-full-val')!.style.color = '#ffffff';
        
        btnDeposit.style.borderColor = 'rgba(255, 255, 255, 0.06)';
        btnDeposit.style.backgroundColor = 'rgba(255, 255, 255, 0.02)';
        btnDeposit.querySelector('div')!.style.color = 'var(--text-muted)';
        document.getElementById('lbl-deposit-val')!.style.color = 'var(--text-secondary)';
        
        recalculateTotals();
      });

      // Recalculate totals displaying transfer discount
      function recalculateTotals() {
        const showTransferDiscount = metaObj.enableTransferDiscount !== false;
        
        let finalTransferUsd = selectedOption === 'deposit' ? depositUsd : totalSetup;
        if (selectedOption === 'full' && selectedTab === 'transfer' && showTransferDiscount) {
          finalTransferUsd = totalSetup * 0.85;
        }

        let finalMpUsd = selectedOption === 'deposit' ? depositUsd : totalSetup;

        document.getElementById('lbl-transfer-final-total')!.innerText = formatVal(finalTransferUsd);

        // Convert MP value to ARS if budget is in USD (Mercado Pago Argentina expects ARS)
        if (isArs) {
          document.getElementById('lbl-mp-final-total')!.innerText = formatVal(finalMpUsd);
        } else {
          const finalMpArs = finalMpUsd * rate;
          document.getElementById('lbl-mp-final-total')!.innerText = `$ ${Math.round(finalMpArs).toLocaleString('es-AR')} ARS (equiv. a US$ ${Math.round(finalMpUsd).toLocaleString('en-US')})`;
        }

        // WhatsApp receipt message
        const optionLabel = selectedOption === 'deposit' ? 'Anticipo 50%' : 'Pago Completo 100%';
        const formattedTotal = formatVal(finalTransferUsd);
        const contactAgentPhone = getAgencyWhatsAppPhone();

        const receiptMsg = `Hola Kaptativa! Te comparto el comprobante de transferencia por *${formattedTotal}* de mi proyecto *${budgetObj.client_business || ''}* para dar inicio formal al desarrollo del presupuesto *#${(budgetObj.quote_number || '').toUpperCase()}* (${optionLabel}).`;
        document.getElementById('lnk-whatsapp-receipt')!.setAttribute('href', `https://wa.me/${contactAgentPhone}?text=${encodeURIComponent(receiptMsg)}`);
      }

      recalculateTotals();

      // Copy alias & CBU
      document.getElementById('btn-copy-alias')!.addEventListener('click', () => {
        navigator.clipboard.writeText(bankAlias);
        alert('Alias CBU copiado.');
      });
      document.getElementById('btn-copy-cbu')!.addEventListener('click', () => {
        navigator.clipboard.writeText(bankCbu);
        alert('CBU copiado.');
      });

      // Mercado Pago checkout link generator (forces conversion to ARS to prevent API failures)
      document.getElementById('btn-pay-mp')!.addEventListener('click', async () => {
        const finalMpUsd = selectedOption === 'deposit' ? depositUsd : totalSetup;
        
        // Mercado Pago Argentina accounts only support ARS, convert USD amount to ARS
        const currentAmountArs = finalMpUsd * rate;
        const currencyCode = 'ARS';
        
        const optLabel = selectedOption === 'deposit' ? 'Anticipo 50%' : 'Pago Completo 100%';
        const paymentTitle = `${optLabel} - Presupuesto #${(budgetObj.quote_number || '').toUpperCase()} (${budgetObj.client_business})`;

        // Disable button while processing
        const btn = document.getElementById('btn-pay-mp') as HTMLButtonElement;
        btn.disabled = true;
        btn.innerText = 'Procesando checkout...';

        try {
          // A. n8n webhook flow
          if (mpWebhookUrl && !mpWebhookUrl.includes('your-n8n')) {
            const payload = {
              quoteId: id,
              client: budgetObj.client_business,
              email: budgetObj.client_email,
              title: paymentTitle,
              amount: Math.round(currentAmountArs),
              option: selectedOption,
              currency: currencyCode
            };

            const res = await fetch(mpWebhookUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            if (res.ok) {
              const resData = await res.json();
              const initPoint = resData.init_point || resData.initPoint || resData.url;
              if (initPoint) {
                window.location.href = initPoint;
                return;
              }
            }
          }

          // B. Server-side MP preference API call
          const mpRes = await fetch('/api/create-mp-preference', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              quoteId: id,
              client: budgetObj.client_business,
              email: budgetObj.client_email,
              title: paymentTitle,
              amount: Math.round(currentAmountArs),
              currency: currencyCode
            })
          });

          if (!mpRes.ok) {
            const errData = await mpRes.json().catch(() => ({}));
            throw new Error(errData.error || `Error ${mpRes.status}`);
          }

          const mpData = await mpRes.json();
          if (mpData.init_point) {
            window.location.href = mpData.init_point;
          } else {
            throw new Error('No se recibió link de pago. Configurá MP_ACCESS_TOKEN en el servidor.');
          }

        } catch (err: any) {
          console.error('Error generating Mercado Pago link:', err);
          alert('Hubo un error al generar el enlace de pago: ' + err.message);
          btn.disabled = false;
          btn.innerText = 'Pagar con Mercado Pago';
        }
      });

      // Toggle display
      if (loadingStatus) loadingStatus.style.display = 'none';
      if (mainView) mainView.style.display = 'block';

    } catch (e) {
      console.error('Error loading quote payment details', e);
      showError();
    }

    function showError() {
      if (loadingStatus) loadingStatus.style.display = 'none';
      if (errorStatus) errorStatus.style.display = 'block';
    }

    function getAgencyWhatsAppPhone() {
      const saved = localStorage.getItem('crm_settings');
      if (saved) {
        return (JSON.parse(saved).whatsapp_phone || '5491112345678').replace(/[^0-9]/g, '');
      }
      return '5491112345678';
    }
  });
</script>

<style is:global>
  .quote-payment-main .spinner {
    width: 50px;
    height: 50px;
    border: 3px solid rgba(255,255,255,0.05);
    border-top: 3px solid var(--accent-crimson);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

