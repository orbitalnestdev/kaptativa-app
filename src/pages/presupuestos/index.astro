<script>
  import { api } from '../../lib/appwrite.js';

  document.addEventListener('DOMContentLoaded', async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const id = urlParams.get('id');

    const loadingStatus = document.getElementById('quote-loading-status');
    const errorStatus = document.getElementById('quote-error-status');
    const mainView = document.getElementById('quote-main-view');
    const statusBanner = document.getElementById('status-banner');
    const actionsBar = document.getElementById('proposal-actions-bar');

    if (!id) {
      showError();
      return;
    }

    try {
      const budget = await api.db.getBudget(id);
      if (!budget) {
        showError();
        return;
      }

      // 1. Decompress metadata
      let userNotes = budget.notes || '';
      let meta = {
        currency: 'USD',
        exchangeRate: 1000,
        enableInstallments: true,
        enableTransferDiscount: true,
        urgency: 0,
        maintenance: 0,
        discount: 0,
        basePrice: budget.subtotal,
        serviceType: 'Propuesta',
        features: []
      };

      if (budget.metadata) {
        try {
          meta = JSON.parse(budget.metadata);
        } catch (err) {
          console.error("Failed to parse dedicated metadata attribute", err);
        }
      } else {
        const sepIdx = userNotes.indexOf('\n\n---METADATA---\n');
        if (sepIdx !== -1) {
          try {
            meta = JSON.parse(userNotes.substring(sepIdx + 16));
            userNotes = userNotes.substring(0, sepIdx);
          } catch (err) {}
        }
      }

      const isArs = meta.currency === 'ARS';
      const rate = parseFloat(meta.exchangeRate) || 1000;

      // Helper functions to populate both screen and PDF templates
      function setTxt(id: string, value: string) {
        const elScreen = document.getElementById(id + '-screen');
        const elPdf = document.getElementById(id + '-pdf');
        if (elScreen) elScreen.innerText = value;
        if (elPdf) elPdf.innerText = value;
      }

      function showEl(id: string, show = true, displayType = 'block') {
        const elScreen = document.getElementById(id + '-screen');
        const elPdf = document.getElementById(id + '-pdf');
        if (elScreen) elScreen.style.display = show ? displayType : 'none';
        if (elPdf) elPdf.style.display = show ? displayType : 'none';
      }

      // 2. Populate basic headers
      setTxt('lbl-quote-code', budget.quote_number || 'KP-0000');
      setTxt('lbl-quote-date', new Date(budget.created_at || budget.$createdAt).toLocaleDateString('es-AR'));
      setTxt('lbl-quote-validity', budget.validity_days || '15');
      
      setTxt('lbl-client-business', budget.client_business || 'Negocio Cliente');
      setTxt('lbl-client-name', budget.client_name || 'Contacto Representante');
      setTxt('lbl-client-email', budget.client_email || '');

      const supportEmail = getAgencyEmail();
      setTxt('lbl-agency-email', supportEmail);

      // 3. Format helper
      function formatVal(value: number) {
        const converted = isArs ? value * rate : value;
        if (isArs) {
          return `$ ${Math.round(converted).toLocaleString('es-AR')} ARS`;
        }
        return `US$ ${Math.round(value).toLocaleString('en-US')}`;
      }

      // 4. Render items body directly from database records to ensure consistency
      const itemsBodyScreen = document.getElementById('pdf-items-body-screen')!;
      const itemsBodyPdf = document.getElementById('pdf-items-body-pdf')!;
      itemsBodyScreen.innerHTML = '';
      itemsBodyPdf.innerHTML = '';

      let itemsArray: any[] = [];
      try {
        itemsArray = JSON.parse(budget.items || '[]');
      } catch (e) {}

      if (itemsArray.length > 0) {
        itemsArray.forEach((item, index) => {
          const isBaseItem = index === 0 && Array.isArray(meta.features) && meta.features.length > 0 && meta.features.some(f => f.trim() !== '');
          
          // Render for Screen Dashboard (Dark Theme)
          const trScreen = document.createElement('tr');
          trScreen.style.borderBottom = '1px solid rgba(255, 255, 255, 0.06)';
          
          let featuresHtmlScreen = '';
          if (isBaseItem) {
            featuresHtmlScreen = `
              <div class="pdf-features-box" style="margin-top: 12px; padding: 14px 18px; border-radius: 8px; background: rgba(124, 58, 237, 0.03); border-left: 3px solid var(--accent-indigo); margin-bottom: 5px;">
                <div class="pdf-features-title" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; margin-bottom: 8px; color: var(--text-muted); letter-spacing: 0.5px;">Alcance Técnico Incluido:</div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 6px 15px;">
                  ${meta.features.map(f => f.trim() ? `<div class="pdf-feature-item" style="font-size: 0.8rem; color: var(--text-secondary); display: flex; align-items: center; gap: 6px;"><span class="pdf-feature-check" style="color: #10b981; font-weight: 600;">✓</span> ${f.trim()}</div>` : '').join('')}
                </div>
              </div>
            `;
          }

          trScreen.innerHTML = `
            <td class="pdf-desc-col" style="padding: 16px 20px; vertical-align: top; text-align: left; color: var(--text-primary);">
              <div style="font-weight: 600; font-size: 0.95rem; font-family: 'Lexend', sans-serif; color: #ffffff;">${item.name}</div>
              ${featuresHtmlScreen}
            </td>
            <td class="pdf-price-col" style="padding: 16px 20px; text-align: right; font-weight: 600; font-size: 0.95rem; vertical-align: top; color: var(--accent-crimson); font-family: 'Lexend', sans-serif; white-space: nowrap;">${formatVal(item.price * (item.qty || 1))}</td>
          `;
          itemsBodyScreen.appendChild(trScreen);

          // Render for PDF Printable (Light Theme)
          const trPdf = document.createElement('tr');
          trPdf.style.borderBottom = '1px solid #e2e8f0';
          
          let featuresHtmlPdf = '';
          if (isBaseItem) {
            featuresHtmlPdf = `
              <div class="pdf-features-box" style="margin-top: 10px; padding: 12px; border-radius: 6px; background: #f8fafc; border-left: 3px solid #7c3aed; margin-bottom: 5px;">
                <div class="pdf-features-title" style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; margin-bottom: 6px; color: #64748b;">Alcance Técnico Incluido:</div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 4px 12px;">
                  ${meta.features.map(f => f.trim() ? `<div class="pdf-feature-item" style="font-size: 0.75rem; color: #334155; display: flex; align-items: center; gap: 4px;"><span style="color: #10b981; font-weight: 600;">✓</span> ${f.trim()}</div>` : '').join('')}
                </div>
              </div>
            `;
          }

          trPdf.innerHTML = `
            <td class="pdf-desc-col" style="padding: 12px 15px; vertical-align: top; text-align: left; color: #0f172a;">
              <div style="font-weight: 600; font-size: 0.9rem; font-family: 'Lexend', sans-serif;">${item.name}</div>
              ${featuresHtmlPdf}
            </td>
            <td class="pdf-price-col" style="padding: 12px 15px; text-align: right; font-weight: 600; font-size: 0.9rem; vertical-align: top; color: #0f172a; font-family: 'Lexend', sans-serif; white-space: nowrap;">${formatVal(item.price * (item.qty || 1))}</td>
          `;
          itemsBodyPdf.appendChild(trPdf);
        });
      } else {
        itemsBodyScreen.innerHTML = '<tr><td colspan="2" style="text-align:center;color:var(--text-muted);padding:24px;">Sin ítems detallados.</td></tr>';
        itemsBodyPdf.innerHTML = '<tr><td colspan="2" style="text-align:center;color:#94a3b8;padding:24px;">Sin ítems detallados.</td></tr>';
      }

      // 5. Setup Totals Calculations
      const subtotalSetup = budget.subtotal;
      const urgencyPct = meta.urgency || 0;
      const urgencyAmount = subtotalSetup * (urgencyPct / 100);
      const discount = meta.discount || budget.discount_val || 0;
      const totalSetup = Math.max(0, subtotalSetup + urgencyAmount - discount);
      const maintenance = meta.maintenance || 0;
      const estHours = Math.ceil(totalSetup / 40);

      setTxt('lbl-subtotal', formatVal(subtotalSetup));
      
      if (urgencyPct > 0) {
        setTxt('lbl-urgency-pct', urgencyPct.toString());
        setTxt('lbl-urgency-val', `+${formatVal(urgencyAmount)}`);
        showEl('row-urgency', true, 'flex');
      } else {
        showEl('row-urgency', false);
      }

      if (discount > 0) {
        setTxt('lbl-discount-val', `-${formatVal(discount)}`);
        showEl('row-discount', true, 'flex');
      } else {
        showEl('row-discount', false);
      }

      setTxt('lbl-total-setup', formatVal(totalSetup));

      // SLA Maintenance abono
      if (maintenance > 0) {
        setTxt('lbl-total-recurring', `${formatVal(maintenance)}/mes`);
        showEl('card-recurring', true, 'flex');
      } else {
        showEl('card-recurring', false);
      }

      // Exchange rate notes
      if (isArs) {
        setTxt('lbl-exchange-val', rate.toLocaleString('es-AR'));
        showEl('row-exchange-note', true);
      } else {
        showEl('row-exchange-note', false);
      }

      // Terms & Conditions details (styled with flex layouts)
      showEl('li-installments', meta.enableInstallments !== false, 'flex');
      showEl('li-transfer-discount', meta.enableTransferDiscount !== false, 'flex');

      const minDays = Math.max(5, Math.ceil(estHours / 5));
      const maxDays = Math.max(10, Math.ceil(estHours / 3));
      setTxt('lbl-delivery-days', `${minDays} - ${maxDays}`);

      // Notes
      if (userNotes.trim()) {
        setTxt('lbl-custom-notes', userNotes.trim());
        showEl('pdf-custom-note-item', true);
      } else {
        showEl('pdf-custom-note-item', false);
      }

      // 6. Action buttons and link mapping
      document.getElementById('lnk-gateway-pay')!.setAttribute('href', `/presupuestos/pagar?id=${id}`);

      // Render initial status state in client
      updateStatusUI(budget.status);

      // Bind Accept Proposal button
      document.getElementById('btn-accept-proposal')?.addEventListener('click', async () => {
        const btn = document.getElementById('btn-accept-proposal') as HTMLButtonElement;
        btn.disabled = true;
        btn.innerText = 'Aceptando...';
        try {
          await api.db.updateBudget(id, { status: 'aceptado' });
          updateStatusUI('aceptado');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (e) {
          console.error(e);
          alert('No se pudo procesar la solicitud de aceptación. Revisa tu conexión.');
          btn.disabled = false;
          btn.innerText = '✅ Aceptar Propuesta';
        }
      });

      // Bind Reject Proposal button
      document.getElementById('btn-reject-proposal')?.addEventListener('click', async () => {
        const btn = document.getElementById('btn-reject-proposal') as HTMLButtonElement;
        btn.disabled = true;
        btn.innerText = 'Rechazando...';
        try {
          await api.db.updateBudget(id, { status: 'rechazado' });
          updateStatusUI('rechazado');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (e) {
          console.error(e);
          alert('No se pudo procesar la solicitud.');
          btn.disabled = false;
          btn.innerText = '❌ No por ahora';
        }
      });

      // Toggle display
      if (loadingStatus) loadingStatus.style.display = 'none';
      if (mainView) mainView.style.display = 'block';

      // 7. PDF Generators
      document.getElementById('btn-print')?.addEventListener('click', () => {
        window.print();
      });

      document.getElementById('btn-download')?.addEventListener('click', async () => {
        const btn = document.getElementById('btn-download') as HTMLButtonElement;
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '⌛ Generando PDF...';

        const printArea = document.getElementById('print-area-pdf')!;

        // Ensure html2pdf is loaded
        if (typeof (window as any).html2pdf === 'undefined') {
          try {
            await new Promise((resolve, reject) => {
              const s = document.createElement('script');
              s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js';
              s.onload = resolve;
              s.onerror = reject;
              document.head.appendChild(s);
            });
          } catch (e) {
            console.warn('Could not load html2pdf from CDN');
          }
        }

        // Temporarily bring printArea to screen coordinates for html2canvas
        const origStyle = printArea.getAttribute('style') || '';
        printArea.style.display = 'block';
        printArea.style.position = 'fixed';
        printArea.style.left = '0';
        printArea.style.top = '0';
        printArea.style.zIndex = '999999';
        printArea.style.opacity = '1';
        printArea.style.visibility = 'visible';
        printArea.style.background = '#ffffff';
        printArea.style.color = '#0f172a';

        const filename = `Propuesta_Kaptativa_${(budget.client_business || 'Cliente').replace(/[^a-zA-Z0-9]/g, '_')}.pdf`;
        const opt = {
          margin:       [0.3, 0.3, 0.3, 0.3],
          filename:     filename,
          image:        { type: 'jpeg', quality: 0.98 },
          html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false },
          jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
        };

        try {
          if (typeof (window as any).html2pdf !== 'undefined') {
            await (window as any).html2pdf().set(opt).from(printArea).save();
          } else {
            window.print();
          }
        } catch (err) {
          console.error('[PDF] Download Error:', err);
          window.print();
        } finally {
          printArea.setAttribute('style', origStyle);
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      });

      // UI state updater based on budget status
      function updateStatusUI(status: string) {
        if (!statusBanner || !actionsBar) return;

        // Update signatures stamp too
        const digitalSealScreen = document.getElementById('proposal-digital-seal-screen')!;
        const clientSignatureSpaceScreen = document.getElementById('lbl-client-signature-space-screen')!;
        const digitalSealPdf = document.getElementById('proposal-digital-seal-pdf')!;
        const clientSignatureSpacePdf = document.getElementById('lbl-client-signature-space-pdf')!;

        const sealAceptadoHtml = `
          <div style="border: 2px solid #10b981; color: #10b981; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; display: inline-block; transform: rotate(-3deg); background: rgba(16, 185, 129, 0.05); font-family: 'Lexend', sans-serif; box-shadow: 0 4px 10px rgba(16,185,129,0.05);">
            ✓ ACEPTADO DIGITALMENTE
          </div>
        `;
        const signatureAceptadoHtml = `
          <div style="font-family: 'Lexend', sans-serif; font-size: 0.75rem; color: #10b981; font-weight: 600; font-style: italic; line-height: 1.2; text-align: center;">
            Aceptado Online<br>
            <span style="font-size: 0.55rem; font-weight: 400; color: #64748b; font-style: normal; display: block; margin-top: 2px;">ID: ${id.substring(0, 8).toUpperCase()}</span>
          </div>
        `;

        const sealRechazadoHtml = `
          <div style="border: 2px solid #ef4444; color: #ef4444; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; display: inline-block; transform: rotate(-3deg); background: rgba(239, 68, 68, 0.05); font-family: 'Lexend', sans-serif;">
            ✕ PROPUESTA DECLINADA
          </div>
        `;
        const signatureRechazadoHtml = `<span style="font-size: 0.75rem; color: #ef4444; font-weight: 600; font-family: 'Lexend', sans-serif;">Rechazado</span>`;

        const sealPendienteHtml = `
          <div style="border: 2px dashed #cbd5e1; color: #94a3b8; padding: 6px 12px; border-radius: 6px; font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; display: inline-block; font-family: 'Lexend', sans-serif;">
            Pendiente de Aceptación
          </div>
        `;
        const signaturePendienteHtml = `<span style="font-size: 0.75rem; color: #94a3b8; font-style: italic; font-family: 'Lexend', sans-serif;">Firma pendiente</span>`;

        if (status === 'aceptado') {
          if (digitalSealScreen) digitalSealScreen.innerHTML = sealAceptadoHtml;
          if (digitalSealPdf) digitalSealPdf.innerHTML = sealAceptadoHtml;
          if (clientSignatureSpaceScreen) clientSignatureSpaceScreen.innerHTML = signatureAceptadoHtml;
          if (clientSignatureSpacePdf) clientSignatureSpacePdf.innerHTML = signatureAceptadoHtml;
        } else if (status === 'rechazado') {
          if (digitalSealScreen) digitalSealScreen.innerHTML = sealRechazadoHtml;
          if (digitalSealPdf) digitalSealPdf.innerHTML = sealRechazadoHtml;
          if (clientSignatureSpaceScreen) clientSignatureSpaceScreen.innerHTML = signatureRechazadoHtml;
          if (clientSignatureSpacePdf) clientSignatureSpacePdf.innerHTML = signatureRechazadoHtml;
        } else {
          if (digitalSealScreen) digitalSealScreen.innerHTML = sealPendienteHtml;
          if (digitalSealPdf) digitalSealPdf.innerHTML = sealPendienteHtml;
          if (clientSignatureSpaceScreen) clientSignatureSpaceScreen.innerHTML = signaturePendienteHtml;
          if (clientSignatureSpacePdf) clientSignatureSpacePdf.innerHTML = signaturePendienteHtml;
        }

        if (status === 'aceptado') {
          statusBanner.style.display = 'block';
          statusBanner.style.backgroundColor = 'rgba(16, 185, 129, 0.1)';
          statusBanner.style.border = '1.5px solid #10b981';
          statusBanner.style.color = '#10b981';
          statusBanner.innerHTML = `
            <div style="display: flex; gap: 15px; align-items: center;">
              <span style="font-size: 1.5rem;">✅</span>
              <div>
                <h3 style="margin: 0 0 5px 0; font-family: 'Lexend', sans-serif; font-weight: 600; color: white;">¡Propuesta Aceptada!</h3>
                <p style="margin: 0; color: var(--text-secondary);">Hemos registrado la aceptación del presupuesto. Nos pondremos en contacto en las próximas horas para coordinar el inicio del proyecto.</p>
              </div>
            </div>
          `;
          actionsBar.style.display = 'none';
        } else if (status === 'rechazado') {
          statusBanner.style.display = 'block';
          statusBanner.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
          statusBanner.style.border = '1.5px solid #ef4444';
          statusBanner.style.color = '#ef4444';
          statusBanner.innerHTML = `
            <div style="display: flex; gap: 15px; align-items: center;">
              <span style="font-size: 1.5rem;">❌</span>
              <div>
                <h3 style="margin: 0 0 5px 0; font-family: 'Lexend', sans-serif; font-weight: 600; color: white;">Propuesta Rechazada</h3>
                <p style="margin: 0; color: var(--text-secondary);">Entendemos tu postura. Si cambias de opinión o quieres realizar ajustes en el alcance del desarrollo, no dudes en contactarnos a <strong>contacto@kaptativa.com</strong>.</p>
              </div>
            </div>
          `;
          actionsBar.style.display = 'none';
        } else {
          statusBanner.style.display = 'none';
          actionsBar.style.display = 'block';
        }
      }

    } catch (err) {
      console.error('Failed to render quote view', err);
      showError();
    }

    function showError() {
      if (loadingStatus) loadingStatus.style.display = 'none';
      if (errorStatus) errorStatus.style.display = 'block';
    }

    function getAgencyEmail() {
      const saved = localStorage.getItem('crm_settings');
      if (saved) {
        return JSON.parse(saved).support_email || 'contacto@kaptativa.com';
      }
      return 'contacto@kaptativa.com';
    }
  });
</script>

