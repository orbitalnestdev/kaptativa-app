---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Propuesta Comercial | Kaptativa" description="Visualiza tu propuesta técnica y comercial a medida.">
  <Header slot="header" />

  <!-- Load html2pdf from CDN for direct PDF generation -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <main class="quote-public-main" style="padding-top: 130px; padding-bottom: 80px; min-height: 90vh;">
    <!-- SKELETON / LOADING STATUS -->
    <div class="container" id="quote-loading-status">
      <div style="text-align: center; padding: 100px 0;">
        <div class="spinner" style="margin: 0 auto 20px auto;"></div>
        <p style="color: var(--text-secondary); font-size: 1.1rem;">Cargando propuesta comercial...</p>
      </div>
    </div>

    <!-- ERROR STATUS -->
    <div class="container" id="quote-error-status" style="display: none;">
      <div style="text-align: center; padding: 100px 0; max-width: 600px; margin: 0 auto;">
        <span style="font-size: 4rem; display: block; margin-bottom: 20px;">⚠️</span>
        <h2 style="font-family: 'Lexend', sans-serif; font-size: 2rem; color: white;">Propuesta No Encontrada</h2>
        <p style="color: var(--text-secondary); margin: 15px auto 30px auto; line-height: 1.6;">
          No se ha podido encontrar el presupuesto solicitado. El enlace puede ser incorrecto o la cotización ya no se encuentra vigente.
        </p>
        <a href="/" class="btn btn-primary" style="display: inline-block;">Volver al Inicio</a>
      </div>
    </div>

    <!-- MAIN VIEW CONTAINER -->
    <div class="container" id="quote-main-view" style="display: none; max-width: 920px; margin: 0 auto;">
      
      <!-- TOP NAVIGATION BAR -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
        <a href="/" style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; color: var(--text-secondary); text-decoration: none; font-weight: 500; transition: color 0.2s;">
          <span style="font-size: 1.1rem;">←</span> Volver a la web
        </a>
        <div style="display: flex; gap: 12px;">
          <button id="btn-print" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 8px; border-radius: 12px; padding: 10px 20px; font-size: 0.85rem; cursor: pointer; font-weight: 600; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: white; backdrop-filter: blur(10px);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            <span>Imprimir</span>
          </button>
          <button id="btn-download" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 8px; border-radius: 12px; padding: 10px 22px; font-size: 0.85rem; cursor: pointer; font-weight: 600; background: linear-gradient(135deg, #EA384D 0%, #8A35E5 100%); border: none; color: white; box-shadow: 0 4px 15px rgba(234, 56, 77, 0.4);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Descargar PDF</span>
          </button>
        </div>
      </div>

      <!-- STATUS NOTIFICATION BANNER -->
      <div id="status-banner" style="display: none; border-radius: 12px; padding: 20px 25px; margin-bottom: 25px; font-size: 0.9rem; line-height: 1.5; box-shadow: 0 4px 15px rgba(0,0,0,0.15);">
        <!-- Filled dynamically -->
      </div>

      <!-- ==========================================================================
           1. SCREEN VIEW: INTERACTIVE DARK-THEMED DASHBOARD (VISIBLE ON SCREEN ONLY)
           ========================================================================== -->
      <div id="screen-dashboard-container" class="glow-container" style="position: relative; border-radius: 20px; padding: 2px; background: linear-gradient(135deg, rgba(217, 70, 239, 0.25) 0%, rgba(6, 182, 212, 0.25) 100%); margin-bottom: 40px; box-shadow: 0 20px 50px rgba(0,0,0,0.5);">
        <div id="screen-dashboard" style="background: var(--card-bg); color: var(--text-primary); padding: 45px; border-radius: 18px; font-family: 'Inter', sans-serif; box-sizing: border-box; position: relative; border: 1px solid var(--border-color); backdrop-filter: blur(12px);">
          
          <!-- BRAND ACCENT GRADIENT BAND -->
          <div style="position: absolute; top: 0; left: 0; right: 0; height: 6px; background: linear-gradient(90deg, #D946EF 0%, #8B5CF6 50%, #EA384D 100%); border-top-left-radius: 18px; border-top-right-radius: 18px;"></div>

          <!-- BRAND & HEADER -->
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 10px; margin-bottom: 40px; flex-wrap: wrap; gap: 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 30px;">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="180" height="38">
                  <defs>
                    <linearGradient id="logo-gradient-public-screen" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#EA384D" />
                      <stop offset="100%" stop-color="#8A35E5" />
                    </linearGradient>
                  </defs>
                  <g>
                    <path d="M 6 13 L 6 47" stroke="url(#logo-gradient-public-screen)" stroke-width="6.5" stroke-linecap="round" fill="none" />
                    <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-gradient-public-screen)" stroke-width="6.5" stroke-linecap="round" fill="none" />
                    <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-gradient-public-screen)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                  </g>
                  <text x="44" y="39" font-family="'Lexend', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">
                    kaptativa<tspan fill="#EA384D">.</tspan>
                  </text>
                </svg>
              </div>
              <p style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; font-weight: 600; margin: 0; padding-left: 2px;">Diseño Web & Automatización IA</p>
            </div>
            
            <div style="text-align: right; min-width: 200px;">
              <h2 style="font-family: 'Lexend', sans-serif; font-size: 1.6rem; font-weight: 600; text-transform: uppercase; margin: 0; color: #ffffff; letter-spacing: -0.5px;">Propuesta Comercial</h2>
              <div style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 8px;">Ref: <span id="lbl-quote-code-screen" style="font-weight: 600; color: var(--accent-crimson);">KP-0000</span></div>
              <div style="font-size: 0.85rem; color: var(--text-secondary);">Emisión: <span id="lbl-quote-date-screen">00/00/0000</span></div>
              <div style="font-size: 0.85rem; color: #ef4444; font-weight: 600; margin-top: 4px;">Validez: <span id="lbl-quote-validity-screen">15</span> días</div>
            </div>
          </div>

          <!-- CLIENT & PROVIDER INFO GRID -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 35px;">
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); padding: 22px; border-radius: 12px;">
              <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#EA384D" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Presentado a
              </div>
              <div id="lbl-client-business-screen" style="font-size: 1.25rem; font-weight: 600; color: #ffffff; font-family: 'Lexend', sans-serif;">Negocio Cliente</div>
              <div id="lbl-client-name-screen" style="font-size: 0.95rem; color: var(--text-secondary); margin-top: 4px; font-weight: 500;">Contacto Representante</div>
              <div id="lbl-client-email-screen" style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">email@cliente.com</div>
            </div>
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); padding: 22px; border-radius: 12px;">
              <div style="font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8A35E5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg> Proveedor de Soluciones
              </div>
              <div style="font-size: 1.25rem; font-weight: 600; color: #ffffff; font-family: 'Lexend', sans-serif;">Agencia Kaptativa</div>
              <div style="font-size: 0.95rem; color: var(--text-secondary); margin-top: 4px; font-weight: 500;">Consultoría Tecnológica & Automatizaciones</div>
              <div id="lbl-agency-email-screen" style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">contacto@kaptativa.com</div>
            </div>
          </div>

          <!-- PROPOSAL SCOPE / TABLE -->
          <div style="width: 100%; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden; margin-bottom: 35px; background: rgba(0, 0, 0, 0.2);">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
              <thead>
                <tr style="background: rgba(255, 255, 255, 0.03); text-align: left; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                  <th style="padding: 14px 20px; color: var(--text-muted); font-family: 'Lexend', sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; width: 70%;">Descripción del Módulo / Servicio</th>
                  <th style="padding: 14px 20px; color: var(--text-muted); font-family: 'Lexend', sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-align: right; width: 30%;">Inversión</th>
                </tr>
              </thead>
              <tbody id="pdf-items-body-screen">
                <!-- Dynamically populated proposal rows -->
              </tbody>
            </table>
          </div>

          <!-- INVESTMENT SUMMARIES GRID -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-bottom: 35px;">
            
            <!-- Setup payment -->
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.08); padding: 24px; border-radius: 14px;">
              <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 15px;">Costo de Implementación (Pago Único)</div>
              
              <div style="display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 10px; align-items: center;">
                <span>Subtotal Desarrollo:</span>
                <span id="lbl-subtotal-screen" style="font-weight: 600; color: white;">$0.00</span>
              </div>
              
              <div id="row-urgency-screen" style="display: none; justify-content: space-between; font-size: 0.9rem; color: var(--accent-pink); margin-bottom: 10px; align-items: center;">
                <span>Prioridad / Urgencia (<span id="lbl-urgency-pct-screen">0</span>%):</span>
                <span id="lbl-urgency-val-screen" style="font-weight: 600;">+$0.00</span>
              </div>

              <div id="row-discount-screen" style="display: none; justify-content: space-between; font-size: 0.9rem; color: #ef4444; margin-bottom: 10px; align-items: center;">
                <span>Bonificación Especial:</span>
                <span id="lbl-discount-val-screen" style="font-weight: 600;">-$0.00</span>
              </div>

              <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 600; font-size: 0.85rem; color: white; letter-spacing: 0.5px;">TOTAL IMPLEMENTACIÓN:</span>
                <span id="lbl-total-setup-screen" style="font-size: 1.6rem; font-weight: 600; color: #ffffff; font-family: 'Lexend', sans-serif;">US$ 0</span>
              </div>
            </div>

            <!-- Recurring Abono SLA -->
            <div id="card-recurring-screen" style="display: none; background: rgba(138, 53, 229, 0.05); border: 1px solid rgba(138, 53, 229, 0.2); padding: 24px; border-radius: 14px; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="font-size: 0.7rem; color: #a78bfa; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 10px;">Soporte, SLA & Licencias</div>
                <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; margin: 0 0 15px 0;">
                  Mantenimiento de infraestructura cloud, backups autónomos semanales y canal de soporte técnico prioritario 24/7.
                </p>
              </div>
              <div style="padding-top: 15px; border-top: 1px solid rgba(138, 53, 229, 0.2); display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                <span style="font-weight: 600; font-size: 0.85rem; color: white; letter-spacing: 0.5px;">ABONO MENSUAL:</span>
                <span id="lbl-total-recurring-screen" style="font-size: 1.5rem; font-weight: 600; color: #a78bfa; font-family: 'Lexend', sans-serif;">US$ 0/mes</span>
              </div>
            </div>
          </div>

          <!-- EXCHANGE RATE AND DETAILS NOTES -->
          <div id="row-exchange-note-screen" style="display: none; font-size: 0.825rem; color: var(--text-muted); font-style: italic; text-align: right; margin-bottom: 30px; margin-top: -15px;">
            * Tipo de cambio acordado y congelado: 1 USD = $<span id="lbl-exchange-val-screen">1000</span> ARS.
          </div>

          <div id="pdf-custom-note-item-screen" style="display: none; background: rgba(234, 56, 77, 0.05); border-left: 3px solid var(--accent-crimson); padding: 18px 20px; border-radius: 8px; margin-bottom: 35px;">
            <div style="font-size: 0.7rem; color: var(--accent-crimson); text-transform: uppercase; font-weight: 600; margin-bottom: 6px; letter-spacing: 0.5px;">Condiciones Especiales / Observaciones</div>
            <p id="lbl-custom-notes-screen" style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; margin: 0; white-space: pre-line;">Notas adicionales...</p>
          </div>

          <!-- CONDICIONES DE PAGO Y PLAZOS -->
          <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); padding: 25px; border-radius: 14px; margin-bottom: 35px;">
            <h4 style="font-family: 'Lexend', sans-serif; font-size: 1.05rem; font-weight: 600; margin-top: 0; margin-bottom: 16px; color: white;">
              Condiciones Comerciales & Plazos
            </h4>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5;">
              <div style="display: flex; gap: 10px; align-items: flex-start;">
                <span style="color: var(--accent-pink); font-weight: 600;">01.</span>
                <div><strong>Inicio:</strong> Tras acreditación del anticipo del 50%.</div>
              </div>
              <div style="display: flex; gap: 10px; align-items: flex-start;">
                <span style="color: var(--accent-pink); font-weight: 600;">02.</span>
                <div><strong>Plazo Entrega:</strong> <span id="lbl-delivery-days-screen">10 - 20</span> días hábiles desde el inicio.</div>
              </div>
              <div id="li-installments-screen" style="display: none; gap: 10px; align-items: flex-start;">
                <span style="color: var(--accent-pink); font-weight: 600;">03.</span>
                <div><strong>Financiación:</strong> Hasta 3 cuotas fijas sin interés (Mercado Pago).</div>
              </div>
              <div id="li-transfer-discount-screen" style="display: none; gap: 10px; align-items: flex-start;">
                <span style="color: var(--accent-pink); font-weight: 600;">04.</span>
                <div><strong>Bonificación:</strong> 15% aplicando a transferencia/efectivo.</div>
              </div>
              <div style="display: flex; gap: 10px; align-items: flex-start; grid-column: 1 / -1;">
                <span style="color: var(--accent-pink); font-weight: 600;">05.</span>
                <div><strong>Garantía:</strong> Etapa de revisiones técnicas conjuntas antes del despliegue final.</div>
              </div>
            </div>
          </div>

          <!-- DIGITAL STAMP & SIGNATURE BLOCK -->
          <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 10px;">
            <div>
              <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 8px;">Estado del Documento</div>
              <div id="proposal-digital-seal-screen">
                <!-- Injected dynamically -->
              </div>
            </div>
            <div style="display: flex; gap: 35px;">
              <div style="text-align: center; width: 130px;">
                <div style="height: 40px; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 6px;">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 30" width="80" height="24" style="opacity: 0.7;">
                    <path d="M10,20 C30,10 50,25 70,12 C80,8 90,15 95,20" fill="none" stroke="#EA384D" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </div>
                <div style="border-top: 1px solid rgba(255, 255, 255, 0.15); padding-top: 4px; font-size: 0.725rem; color: var(--text-secondary); font-weight: 600;">Kaptativa Digital</div>
                <div style="font-size: 0.65rem; color: var(--text-muted);">Emisor Autorizado</div>
              </div>
              <div style="text-align: center; width: 130px;">
                <div style="height: 40px; display: flex; align-items: flex-end; justify-content: center; margin-bottom: 6px;" id="lbl-client-signature-space-screen">
                  <!-- Render line or client signature status -->
                </div>
                <div style="border-top: 1px solid rgba(255, 255, 255, 0.15); padding-top: 4px; font-size: 0.725rem; color: var(--text-secondary); font-weight: 600;" id="lbl-client-signature-title-screen">Firma del Cliente</div>
                <div style="font-size: 0.65rem; color: var(--text-muted);">Representante Legal</div>
              </div>
            </div>
          </div>

        </div>
      </div>


      <!-- ==========================================================================
           2. PRINT/PDF VIEW: HIGH-QUALITY WHITE DOCUMENT TEMPLATE (OFF-SCREEN)
           ========================================================================== -->
      <div id="print-area-pdf" class="print-only-pdf-template" style="position: absolute; left: -9999px; top: -9999px; width: 820px; background: #ffffff; color: #1e293b; padding: 50px; font-family: 'Inter', sans-serif; box-sizing: border-box; overflow: hidden; border: 1px solid #e2e8f0; line-height: 1.5;">
        
        <!-- BRAND ACCENT GRADIENT BAND -->
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 6px; background: linear-gradient(90deg, #D946EF 0%, #8B5CF6 50%, #EA384D 100%);"></div>

        <!-- BRAND & HEADER -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 15px; margin-bottom: 35px; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 25px;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="160" height="34">
                <defs>
                  <linearGradient id="logo-gradient-public-pdf" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#EA384D" />
                    <stop offset="100%" stop-color="#8A35E5" />
                  </linearGradient>
                </defs>
                <g>
                  <path d="M 6 13 L 6 47" stroke="url(#logo-gradient-public-pdf)" stroke-width="6.5" stroke-linecap="round" fill="none" />
                  <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-gradient-public-pdf)" stroke-width="6.5" stroke-linecap="round" fill="none" />
                  <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-gradient-public-pdf)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </g>
                <text x="44" y="39" font-family="'Lexend', sans-serif" font-size="27" font-weight="600" fill="#0f172a" letter-spacing="0.3">
                  kaptativa<tspan fill="#EA384D">.</tspan>
                </text>
              </svg>
            </div>
            <p style="font-size: 0.7rem; color: #64748b; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; margin: 0; padding-left: 2px;">Diseño Web & Automatización IA</p>
          </div>
          
          <div style="text-align: right;">
            <h2 style="font-family: 'Lexend', sans-serif; font-size: 1.45rem; font-weight: 600; text-transform: uppercase; margin: 0; color: #0f172a; letter-spacing: -0.5px;">Propuesta Comercial</h2>
            <div style="font-size: 0.8rem; color: #475569; margin-top: 6px;">Ref: <span id="lbl-quote-code-pdf" style="font-weight: 600; color: #7c3aed;">KP-0000</span></div>
            <div style="font-size: 0.8rem; color: #475569;">Emisión: <span id="lbl-quote-date-pdf">00/00/0000</span></div>
            <div style="font-size: 0.8rem; color: #e11d48; font-weight: 600; margin-top: 2px;">Validez: <span id="lbl-quote-validity-pdf">15</span> días</div>
          </div>
        </div>

        <!-- CLIENT & PROVIDER INFO GRID -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 30px;">
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 18px; border-radius: 8px;">
            <div style="font-size: 0.65rem; color: #64748b; text-transform: uppercase; font-weight: 600; letter-spacing: 1px; margin-bottom: 8px;">Presentado a</div>
            <div id="lbl-client-business-pdf" style="font-size: 1.05rem; font-weight: 600; color: #0f172a; font-family: 'Lexend', sans-serif;">Negocio Cliente</div>
            <div id="lbl-client-name-pdf" style="font-size: 0.85rem; color: #334155; margin-top: 4px; font-weight: 500;">Contacto Representante</div>
