---
// Fondo 3D para las tarjetas de cierre (call to action): un campo de puntos violeta en perspectiva que ondula
// como un terreno (patrón "Vexel" de MotionSites). Canvas 2D liviano: dibuja solo cuando la tarjeta está a la vista,
// a 30 fps en celular, se corre apenas con el mouse y queda quieto con "reducir movimiento". Un velo oscuro al centro
// mantiene legible el texto. La tarjeta que lo contiene debe tener `position: relative`.
---
<div class="cta-wave" aria-hidden="true"><canvas data-wave></canvas></div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLCanvasElement>('canvas[data-wave]').forEach((cv) => {
    const ctx = cv.getContext('2d');
    const wrap = cv.parentElement as HTMLElement | null;
    const card = wrap?.parentElement as HTMLElement | null;
    if (!ctx || !wrap || !card) return;
    let W = 0, H = 0, raf = 0, visible = false, t = 1.3, last = 0, lastDraw = 0;
    let px = 0, tx = 0; // corrimiento por el mouse (paralaje)

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      const mobile = W < 640;
      const rows = mobile ? 16 : 22;
      const fl = W * 0.75;                // distancia focal
      const near = fl * 0.42, far = fl * 3.6;
      const horizon = H * 0.27;           // línea de horizonte
      const camH = 68;                    // altura de la cámara sobre el plano
      const stepW = mobile ? 30 : 33;     // separación entre puntos en el mundo
      const A = 26;                       // amplitud de la onda
      px += (tx - px) * 0.06;
      ctx.fillStyle = '#9B84FF';
      ctx.strokeStyle = '#8E74FF';
      ctx.lineWidth = 0.8;
      for (let r = 0; r < rows; r++) {
        const z = near * Math.pow(far / near, r / (rows - 1));
        const s = fl / z;
        const depth = 1 - r / (rows - 1);   // 1 cerca, 0 lejos
        const sz = 1.2 + 3 * depth;
        const xmax = (W / 2 + 6) / s;
        const shift = px * (0.5 + 0.5 * depth);
        const pts: number[] = [];
        for (let x = -xmax; x <= xmax; x += stepW) {
          const wx = x + shift;
          const y = A * (Math.sin(wx * 0.0036 + t * 1.15 + z * 0.0022) * 0.6 + Math.sin(z * 0.0048 - t * 0.9 + wx * 0.0012) * 0.4) + A * 0.45 * Math.sin((wx + z) * 0.0025 + t * 0.55);
          const sx = W / 2 + x * s, sy = horizon + (camH - y) * s;
          pts.push(sx, sy);
          if (sy < -4 || sy > H + 4) continue;
          const crest = 0.5 + 0.5 * (y / (A * 1.45));
          ctx.globalAlpha = (0.14 + 0.6 * depth) * (0.45 + 0.55 * crest);
          ctx.fillRect(sx - sz / 2, sy - sz / 2, sz, sz);
        }
        // Línea fina que une la fila: la malla del terreno
        if (pts.length > 3) {
          ctx.globalAlpha = 0.06 + 0.22 * depth;
          ctx.beginPath();
          ctx.moveTo(pts[0], pts[1]);
          for (let i = 2; i < pts.length; i += 2) ctx.lineTo(pts[i], pts[i + 1]);
          ctx.stroke();
        }
      }
      ctx.globalAlpha = 1;
    };
    const resize = () => {
      const r = wrap.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = Math.round(r.width); H = Math.round(r.height);
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    };
    const loop = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      if (W >= 640 || now - lastDraw >= 32) { t += W >= 640 ? dt : now - lastDraw >= 32 ? 0.032 : 0; lastDraw = now; draw(); }
      raf = visible && !document.hidden ? requestAnimationFrame(loop) : 0;
    };
    const start = () => { if (!reduce && !raf) { last = performance.now(); raf = requestAnimationFrame(loop); } };

    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(wrap); else { resize(); window.addEventListener('resize', resize); }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((e) => { visible = e.isIntersecting; if (visible) start(); }), { threshold: 0.05 }).observe(wrap);
    } else { visible = true; start(); }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    if (!reduce && window.matchMedia('(hover: hover)').matches) {
      card.addEventListener('pointermove', (e) => { const r = card.getBoundingClientRect(); tx = ((e.clientX - r.left) / r.width - 0.5) * 80; });
      card.addEventListener('pointerleave', () => { tx = 0; });
    }
    resize();
  });
</script>

<style is:global>
  .cta-wave { position: absolute; inset: 0; z-index: 0; border-radius: inherit; overflow: hidden; pointer-events: none; }
  .cta-wave canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* Velo al centro para que el texto siga legible sobre los puntos */
  .cta-wave::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 46% 68% at 50% 50%, rgba(15, 15, 18, 0.74), rgba(15, 15, 18, 0.3) 60%, rgba(15, 15, 18, 0) 100%); }
  /* El contenido de la tarjeta va por encima del campo de puntos */
  .h2-cta > h2, .h2-cta > p, .h2-cta > .h2-ctas, .precios-cta > h2, .precios-cta > p, .precios-cta > .precios-cta-botones, .cta-card-neon > .cta-info-side, .cta-card-neon > .cta-form-side { position: relative; z-index: 1; }
</style>
