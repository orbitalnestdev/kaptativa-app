---
interface Props {
  /** Header flotante: barra redondeada separada de los bordes (home). */
  floating?: boolean;
}
const { floating = false } = Astro.props;

import { soluciones, icons } from '../data/plataforma.js';
// Dos columnas de 4, en el mismo orden que la home (empieza por Tiendas online)
const solCols = [soluciones.slice(0, 4), soluciones.slice(4, 8)];
const navIcon = (name) => `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[name]}</svg>`;
---

<header class:list={["header", { "header--floating": floating }]} id="header">
  <div class="container">
    <a href="/" class="logo" id="logo-brand" aria-label="Volver al inicio de Kaptativa">
      <svg class="header-logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="195" height="40">
        <g>
          <path d="M 6 13 L 6 47" stroke="#7C5CFF" stroke-width="6.5" stroke-linecap="round" fill="none" />
          <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="#7C5CFF" stroke-width="6.5" stroke-linecap="round" fill="none" />
          <path d="M 15 13 L 26 13 L 26 24" stroke="#7C5CFF" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </g>
        <text x="44" y="39" font-family="'Lexend', sans-serif" font-size="27" font-weight="600" fill="currentColor" letter-spacing="0.3">
          kaptativa<tspan fill="#7C5CFF">.</tspan>
        </text>
      </svg>
    </a>
    
    <!-- Navigation (Desktop & Mobile Drawer) -->
    <nav class="nav" id="main-navigation" aria-label="Navegación principal">
      <div class="nav-item-dropdown nav-item-dropdown--mega">
        <a href="/#rubros" class="nav-link dropdown-trigger" id="nav-link-soluciones" aria-haspopup="true" aria-expanded="false">
          <span>Soluciones</span>
          <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="dropdown-menu dropdown-menu--mega">
          <div class="mega">
            <div class="mega-intro">
              <p class="mega-title">Soluciones por rubro</p>
              <p class="mega-text">La misma plataforma, configurada para cómo trabaja tu negocio: sitio, tienda, gestión y asistente de IA en WhatsApp.</p>
              <a href="/#rubros" class="mega-link">Ver todas las soluciones <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
            </div>
            <div class="mega-grid">
              {soluciones.map((sol, i) => (
                <a href={`/soluciones/${sol.slug}/`} class="dropdown-item mega-item" style={`--i:${i}`}>
                  <div class="item-icon-wrapper"><Fragment set:html={navIcon(sol.icon)} /></div>
                  <div class="item-details">
                    <div class="item-title">{sol.title} <svg class="mega-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></div>
                    <div class="item-desc">{sol.short}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="nav-item-dropdown">
        <a href="/servicios/" class="nav-link dropdown-trigger" id="nav-link-servicios" aria-haspopup="true" aria-expanded="false">
          <span>Servicios</span>
          <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <div class="dropdown-menu">
          <div class="dropdown-grid">
            <div class="dropdown-column">
              <a href="/servicios/publicidad-digital/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"></path><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Publicidad Digital</div>
                  <div class="item-desc">Paid media en Meta y Google con ROI</div>
                </div>
              </a>
              <a href="/servicios/desarrollo-software/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Desarrollo de Software</div>
                  <div class="item-desc">Sistemas a medida para tu empresa</div>
                </div>
              </a>
              <a href="/servicios/automatizacion/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33 1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Automatización & Integraciones</div>
                  <div class="item-desc">Eliminá el trabajo repetitivo</div>
                </div>
              </a>
              <a href="/servicios/social-media/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Social Media Manager</div>
                  <div class="item-desc">Estrategias de contenido y redes</div>
                </div>
              </a>
            </div>
            <div class="dropdown-column">
              <a href="/servicios/seo-geo/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Posicionamiento SEO & GEO</div>
                  <div class="item-desc">Posicionamiento en Google e IA</div>
                </div>
              </a>
              <a href="/servicios/diseno-web/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Desarrollo Web & E-commerce</div>
                  <div class="item-desc">Webs enfocadas en conversión</div>
                </div>
              </a>
              <a href="/servicios/agentes-ia/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="15" x2="23" y2="15"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="15" x2="4" y2="15"></line></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Agentes de IA</div>
                  <div class="item-desc">Atención y calificación 24/7</div>
                </div>
              </a>
              <a href="/servicios/email-marketing/" class="dropdown-item">
                <div class="item-icon-wrapper">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <div class="item-details">
                  <div class="item-title">Email Marketing</div>
                  <div class="item-desc">Campañas e integración Perfit</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
      <a href="/precios/" class="nav-link" id="nav-link-planes">Planes</a>
      <a href="/nosotros/" class="nav-link" id="nav-link-nosotros">Nosotros</a>
      <a href="/contacto/" class="nav-link" id="nav-link-contacto">Contacto</a>
      
      <!-- Mobile Nav Footer (CTAs) -->
      <div class="mobile-nav-footer">
        <a href="/contacto/" class="btn btn-primary mobile-nav-cta">
          Solicitar demo
        </a>
      </div>
    </nav>
    
    <!-- Actions (Desktop CTA & Mobile Toggle Button) -->
    <div class="header-actions">
      <a href="/contacto/" class="btn btn-primary btn-sm" id="btn-header-cta">Solicitar demo</a>
      
      <button class="mobile-toggle" id="mobile-menu-toggle" aria-label="Abrir menú de navegación" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<style is:global>
  /* ---------- Variante flotante (redondeada y fija) ---------- */
  .header.header--floating {
    --hf-top: 14px;
    --hf-x: max(16px, calc((100% - 1240px) / 2));
    top: var(--hf-top);
    left: var(--hf-x);
    right: var(--hf-x);
    width: auto;
    height: 66px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(12, 12, 22, 0.72) !important;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition: height var(--transition-normal), background var(--transition-normal), box-shadow var(--transition-normal), top var(--transition-normal);
  }
  .header.header--floating.scrolled {
    --hf-top: 10px;
    height: 60px;
    background: rgba(20, 20, 24, 0.88) !important;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .header.header--floating > .container { max-width: none; padding: 0 14px 0 22px; }

  @media (max-width: 992px) {
    /* El menú lateral se ubica respecto del header (por el backdrop-filter): compensamos el margen */
    .header.header--floating .nav { top: calc(var(--hf-top) * -1 - 1px) !important; }
    .header.header--floating .nav.open,
    .header.header--floating .nav.active { left: calc(var(--hf-x) * -1 - 1px) !important; }
  }
  @media (max-width: 768px) {
    .header.header--floating { --hf-top: 10px; --hf-x: 10px; height: 58px; border-radius: 20px; }
    .header.header--floating.scrolled { --hf-top: 8px; height: 54px; }
    .header.header--floating > .container { padding: 0 10px 0 16px; }
  }

  /* Menú "Soluciones": panel de presentación + grilla de rubros, centrado bajo el header */
  .header .nav-item-dropdown--mega { position: static !important; }
  .header .dropdown-menu--mega { left: 50% !important; transform: translateX(-50%) translateY(10px) !important; width: min(940px, calc(100vw - 32px)) !important; max-width: none !important; padding: 10px !important; margin-top: 0 !important; background: rgba(21, 21, 25, 0.97) !important; border: 1px solid rgba(255, 255, 255, 0.08) !important; border-radius: 22px !important; }
  .header .dropdown-menu--mega::before { content: ''; position: absolute; left: 0; right: 0; top: -18px; height: 18px; }
  /* Estado abierto: las reglas globales de .dropdown-menu lo corren a -30 %/-35 %; el mega menú queda centrado bajo el header */
  .header .nav-item-dropdown--mega:hover .dropdown-menu--mega, .header .nav-item-dropdown--mega.active .dropdown-menu--mega, .header .dropdown-menu--mega:hover { transform: translateX(-50%) translateY(0) !important; }
  .header .mega { display: grid; grid-template-columns: 250px 1fr; gap: 10px; }
  .header .mega-intro { display: flex; flex-direction: column; padding: 22px 20px; border-radius: 16px; background: linear-gradient(160deg, rgba(124, 92, 255, 0.2), rgba(124, 92, 255, 0.04)); border: 1px solid rgba(124, 92, 255, 0.25); }
  .header .mega-title { margin: 0 0 8px; font-family: 'Lexend', sans-serif; font-weight: 600; font-size: 1.05rem; color: #fff; }
  .header .mega-text { margin: 0; flex: 1; font-size: 0.85rem; line-height: 1.55; color: var(--n-300, #B4B4BE); }
  .header .mega-link { margin-top: 18px; display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; font-weight: 600; color: var(--brand-primary-light); text-decoration: none; }
  .header .mega-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .header .mega-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 6px; padding: 4px 2px; align-content: start; }
  .header .mega-item { padding: 10px 12px !important; gap: 14px !important; }
  @media (prefers-reduced-motion: no-preference) {
    .header .mega-item, .header .mega-intro { opacity: 0; transform: translateY(6px); transition: opacity 0.35s ease, transform 0.35s ease; transition-delay: calc(var(--i, 0) * 35ms); }
    .header .nav-item-dropdown--mega:hover .mega-item, .header .nav-item-dropdown--mega.active .mega-item, .header .nav-item-dropdown--mega:hover .mega-intro, .header .nav-item-dropdown--mega.active .mega-intro, .header .dropdown-menu--mega:hover .mega-item, .header .dropdown-menu--mega:hover .mega-intro { opacity: 1; transform: none; }
  }
  .header .mega-item .item-icon-wrapper { width: 44px !important; height: 44px !important; border-radius: 12px !important; background: rgba(124, 92, 255, 0.12) !important; border: 1px solid rgba(124, 92, 255, 0.2) !important; color: var(--brand-primary) !important; }
  .header .mega-item .item-title { display: flex !important; align-items: center; gap: 6px; font-size: 0.95rem !important; margin-bottom: 2px !important; transition: color 0.2s ease; }
  .header .mega-arrow { opacity: 0; transform: translateX(-4px); transition: opacity 0.2s ease, transform 0.2s ease; color: var(--brand-primary-light); }
  .header .mega-item:hover .item-title { color: var(--brand-primary-light) !important; }
  .header .mega-item:hover .mega-arrow { opacity: 1; transform: none; }
  .header .mega-item .item-desc { font-size: 0.8rem !important; overflow: hidden !important; text-overflow: ellipsis !important; }
  @media (max-width: 992px) {
    .header .nav-item-dropdown--mega { position: relative !important; }
    .header .dropdown-menu--mega { width: auto !important; transform: none !important; left: auto !important; padding: 0 !important; background: transparent !important; border: 0 !important; }
    .header .mega { grid-template-columns: 1fr; gap: 0; }
    .header .mega-intro { display: none; }
    .header .mega-grid { grid-template-columns: 1fr; }
  }
</style>
