---
// Servicios.astro
export interface Props {
  isPage?: boolean;
}
const { isPage = false } = Astro.props;
---
<section class="section" id="servicios">
  <div class="container">
    <div class="section-header reveal" style="text-align: center; margin-bottom: 50px;">
      <span class="badge services-badge">
        <span class="badge-dot"></span> QUÉ HACEMOS
      </span>
      <h2>Sistemas a medida <br class="desktop-only-br" /><span class="text-gradient-cyan">para operar sin fricción</span></h2>
      <p style="max-width: 750px; margin: 0 auto; color: var(--text-secondary);">Ocho soluciones modulares que resuelven cuellos de botella específicos, adaptadas a las necesidades de tu negocio.</p>
    </div>
    <div class="services-grid-container reveal reveal-delay-1">


      <!-- Card 01 -->
      <div class="service-card-v2" style="--card-accent: var(--accent-pink); --card-accent-glow: var(--accent-pink-glow);">
        <span class="card-number">01</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v18h18"></path>
            <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path>
          </svg>
        </div>
        <h3>Publicidad Digital</h3>
        <p>{isPage ? "Campañas orientadas a rentabilidad con tracking avanzado." : "Paid media en Meta y Google con ROI medible."}</p>
        <a href="/servicios/publicidad-digital" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Card 02 -->
      <div class="service-card-v2" style="--card-accent: var(--accent-emerald); --card-accent-glow: rgba(16, 185, 129, 0.15);">
        <span class="card-number">02</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <h3>Posicionamiento SEO & GEO</h3>
        <p>{isPage ? "Presencia orgánica integral en buscadores y motores LLM." : "Que te encuentren en Google y en la IA."}</p>
        <a href="/servicios/seo-geo" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Card 03 -->
      <div class="service-card-v2" style="--card-accent: var(--accent-indigo); --card-accent-glow: var(--accent-indigo-glow);">
        <span class="card-number">03</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <h3>Desarrollo de Software</h3>
        <p>{isPage ? "Soluciones tecnológicas personalizadas para tus operaciones." : "Sistemas a medida que el mercado no te da."}</p>
        <a href="/servicios/desarrollo-software" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Card 04 -->
      <div class="service-card-v2" style="--card-accent: var(--accent-pink); --card-accent-glow: var(--accent-pink-glow);">
        <span class="card-number">04</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h3>Desarrollo Web & E-commerce</h3>
        <p>{isPage ? "Plataformas web corporativas y tiendas online escalables." : "Herramientas de conversión, no páginas."}</p>
        <a href="/servicios/diseno-web" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Card 05 -->
      <div class="service-card-v2" style="--card-accent: var(--accent-indigo); --card-accent-glow: var(--accent-indigo-glow);">
        <span class="card-number">05</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33 1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </div>
        <h3>Automatización & Integraciones</h3>
        <p>{isPage ? "Integración de herramientas para operar sin fricción." : "Eliminá el trabajo repetitivo."}</p>
        <a href="/servicios/automatizacion" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Card 06 -->
      <div class="service-card-v2" style="--card-accent: var(--accent-indigo); --card-accent-glow: var(--accent-indigo-glow);">
        <span class="card-number">06</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
            <rect x="9" y="9" width="6" height="6"></rect>
            <line x1="9" y1="1" x2="9" y2="4"></line>
            <line x1="15" y1="1" x2="15" y2="4"></line>
            <line x1="9" y1="20" x2="9" y2="23"></line>
            <line x1="15" y1="20" x2="15" y2="23"></line>
            <line x1="20" y1="9" x2="23" y2="9"></line>
            <line x1="20" y1="15" x2="23" y2="15"></line>
            <line x1="1" y1="9" x2="4" y2="9"></line>
            <line x1="1" y1="15" x2="4" y2="15"></line>
          </svg>
        </div>
        <h3>Agentes de IA</h3>
        <p>{isPage ? "Modelos de inteligencia artificial para agilizar tu soporte." : "Atienden, califican y resuelven 24/7."}</p>
        <a href="/servicios/agentes-ia" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Card 07 -->
      <div class="service-card-v2 card-half" style="--card-accent: var(--accent-orange); --card-accent-glow: var(--accent-orange-glow);">
        <span class="card-number">07</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
        </div>
        <h3>Social Media Manager</h3>
        <p>{isPage ? "Branding corporativo y gestión visual de alta calidad." : "Estrategias de contenido y redes sociales."}</p>
        <a href="/servicios/social-media" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>

      <!-- Card 08 -->
      <div class="service-card-v2 card-half" style="--card-accent: #2563EB; --card-accent-glow: rgba(37, 99, 235, 0.15);">
        <span class="card-number">08</span>
        <div class="icon-box-v2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </div>
        <h3>Email Marketing</h3>
        <p>{isPage ? "Infraestructura técnica para envíos estratégicos." : "Campañas de conversión e integración con Perfit."}</p>
        <a href="/servicios/email-marketing" class="conocer-mas-link">
          <span>Conocer más</span>
          <div class="arrow-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      </div>
    </div>

    <!-- Navigation numbers for mobile slider -->
    <div class="services-slider-nav">
      <button class="slider-nav-btn active" data-index="0">01</button>
      <button class="slider-nav-btn" data-index="1">02</button>
      <button class="slider-nav-btn" data-index="2">03</button>
      <button class="slider-nav-btn" data-index="3">04</button>
      <button class="slider-nav-btn" data-index="4">05</button>
      <button class="slider-nav-btn" data-index="5">06</button>
      <button class="slider-nav-btn" data-index="6">07</button>
      <button class="slider-nav-btn" data-index="7">08</button>
    </div>
  </div>
</section>

<style>
  .services-grid-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 30px;
    margin-top: 50px;
    position: relative; /* Added for JS offset calculations */
  }

  .service-group-header {
    grid-column: 1 / -1;
    margin-top: 35px;
    margin-bottom: 10px;
    border-left: 4px solid var(--accent-indigo);
    padding-left: 20px;
    text-align: left;
  }

  .service-group-header h3 {
    font-family: 'Lexend', sans-serif;
    font-size: 1.5rem !important;
    font-weight: 600 !important;
    color: var(--text-primary) !important;
    margin-bottom: 6px !important;
    letter-spacing: -0.01em;
  }

  .service-group-header p {
    color: var(--text-secondary) !important;
    font-size: 1rem !important;
    margin: 0 !important;
    line-height: 1.4;
  }

  .service-card-v2 {
    grid-column: span 2;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-md);
    padding: 40px;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .service-card-v2::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--gradient-primary);
    transition: height 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .service-card-v2.card-full::before {
    background: var(--gradient-primary);
  }

  .service-card-v2:hover::before {
    height: 100%;
  }

  .service-card-v2:hover {
    border-color: var(--border-hover);
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), var(--accent-indigo-glow);
  }

  .service-card-v2:hover .card-number {
    color: var(--accent-indigo);
    opacity: 0.8;
  }

  .card-number {
    position: absolute;
    top: 30px;
    right: 40px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    opacity: 0.5;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .icon-box-v2 {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--card-accent-glow, rgba(99, 102, 241, 0.06));
    border: 1px solid var(--card-accent, rgba(99, 102, 241, 0.15));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--card-accent, #8b5cf6);
    margin-bottom: 30px;
    transition: all 0.3s ease;
  }

  .service-card-v2:hover .icon-box-v2 {
    background: var(--card-accent, var(--accent-indigo));
    color: #ffffff;
    border-color: var(--card-accent, var(--accent-indigo));
    box-shadow: 0 0 15px var(--card-accent-glow, var(--accent-indigo-glow));
    transform: scale(1.05);
  }

  .service-card-v2.card-full:hover .icon-box-v2 {
    background: linear-gradient(135deg, var(--card-accent), var(--card-accent-2));
    border-color: var(--card-accent);
  }

  .service-card-v2 h3 {
    font-family: 'Lexend', sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 16px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .service-card-v2 p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 30px;
    flex-grow: 1;
  }

  .conocer-mas-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.3s ease;
    margin-top: auto;
  }

  .arrow-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: var(--text-secondary);
  }

  .conocer-mas-link:hover {
    color: var(--accent-indigo);
  }

  .conocer-mas-link:hover .arrow-circle {
    border-color: var(--accent-indigo);
    background: var(--accent-indigo-glow);
    color: var(--text-primary);
    transform: translateX(4px);
    box-shadow: 0 0 10px var(--accent-indigo-glow);
  }

  /* Full Width Card 07 Styles */
  /* Half Width Card 07 & 08 Styles */
  .card-half {
    grid-column: span 3;
  }

  /* Navigation numbers for mobile slider */
  :global(.services-slider-nav) {
    display: none;
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .services-grid-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .service-card-v2 {
      grid-column: span 1;
    }
    .card-half {
      grid-column: span 1;
    }
  }

  @media (max-width: 768px) {
    :global(.services-grid-container) {
      display: flex !important;
      flex-direction: row !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      scroll-behavior: smooth !important;
      gap: 20px !important;
      margin-top: 30px !important;
      padding: 15px 20px 25px 20px !important;
      margin-left: -20px !important;
      margin-right: -20px !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }

    :global(.services-grid-container::-webkit-scrollbar) {
      display: none !important;
    }

    :global(.service-card-v2) {
      flex: 0 0 85% !important;
      scroll-snap-align: center !important;
      padding: 30px !important;
      height: auto !important;
    }

    :global(.card-half) {
      flex: 0 0 85% !important;
    }

    :global(.service-card-v2 h3) {
      font-size: 1.2rem !important;
    }

    :global(.card-number) {
      top: 20px !important;
      right: 30px !important;
    }

    :global(.services-slider-nav) {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 10px !important;
      margin-top: 25px !important;
      margin-bottom: 10px !important;
    }

    :global(.slider-nav-btn) {
      background: transparent !important;
      border: 1px solid var(--border-color) !important;
      color: var(--text-secondary) !important;
      font-size: 0.85rem !important;
      font-weight: 600 !important;
      width: 38px !important;
      height: 38px !important;
      border-radius: 50% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1) !important;
      font-family: 'Lexend', sans-serif !important;
      padding: 0 !important;
      outline: none !important;
    }

    :global(.slider-nav-btn:hover) {
      border-color: var(--accent-indigo) !important;
      color: var(--text-primary) !important;
    }

    :global(.slider-nav-btn.active) {
      color: var(--text-primary) !important;
      border-color: var(--accent-indigo) !important;
      background: var(--accent-indigo-glow) !important;
      box-shadow: 0 0 10px var(--accent-indigo-glow) !important;
      transform: scale(1.1) !important;
    }
  }
</style>

<script>
  // Runs on the client
  const initServicesSlider = () => {
    const container = document.querySelector('.services-grid-container');
    const buttons = document.querySelectorAll('.slider-nav-btn');
    if (!container || buttons.length === 0) return;

    const cards = container.querySelectorAll('.service-card-v2');

    // Update active button based on scrolling position (closest card to center)
    const updateActiveButton = () => {
      // If we are not on mobile (container is not flex/scrollable), active state is not needed
      if (window.innerWidth > 768) return;

      const containerRect = container.getBoundingClientRect();
      const containerCenter = containerRect.left + containerRect.width / 2;

      let closestIndex = 0;
      let minDistance = Infinity;

      cards.forEach((card, idx) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(cardCenter - containerCenter);
        if (distance < minDistance) {
          minDistance = distance;
          closestIndex = idx;
        }
      });

      buttons.forEach((btn, idx) => {
        if (idx === closestIndex) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    };

    // Smooth scroll to the target card
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = parseInt(btn.getAttribute('data-index') || '0', 10);
        const card = cards[index];
        if (card) {
          const containerWidth = container.clientWidth;
          const cardLeft = card.offsetLeft;
          const cardWidth = card.clientWidth;
          
          // Calculate scroll position to center the card inside the container
          const targetScrollLeft = cardLeft - (containerWidth - cardWidth) / 2;
          
          container.scrollTo({
            left: targetScrollLeft,
            behavior: 'smooth'
          });
        }
      });
    });

    // Listen to scroll events on container
    container.addEventListener('scroll', updateActiveButton, { passive: true });
    
    // Initial check in case of resize or load
    updateActiveButton();
    window.addEventListener('resize', updateActiveButton, { passive: true });
  };

  // Support both standard loads and Astro view transitions page loads
  document.addEventListener('DOMContentLoaded', initServicesSlider);
  document.addEventListener('astro:page-load', initServicesSlider);
</script>

