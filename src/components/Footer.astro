---
// Footer.astro
---
<footer class="footer" id="footer">
  <div class="container" style="position: relative;">
    <!-- Background Watermark Text - Fitted, Darker Deep Magenta Fill (#6A1B3F) & 0.05 Opacity -->
    <div class="footer-container-watermark" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 950 260" width="100%" height="100%" preserveAspectRatio="xMidYMax meet" style="overflow: visible;">
        <text x="50%" y="195" text-anchor="middle" font-family="'Lexend', sans-serif" font-size="210" font-weight="600" fill="#6A1B3F" opacity="0.05" letter-spacing="-2">
          kaptativa<tspan fill="#EA384D">.</tspan>
        </text>
      </svg>
    </div>

    <div class="footer-grid">
      <!-- Col 1: Brand -->
      <div class="footer-col col-brand">
        <div class="footer-logo-wrapper">
          <svg class="footer-logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="195" height="40">
            <defs>
              <linearGradient id="logo-gradient-footer" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#EA384D" />
                <stop offset="100%" stop-color="#8A35E5" />
              </linearGradient>
            </defs>
            <g>
              <path d="M 6 13 L 6 47" stroke="url(#logo-gradient-footer)" stroke-width="6.5" stroke-linecap="round" fill="none" />
              <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-gradient-footer)" stroke-width="6.5" stroke-linecap="round" fill="none" />
              <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-gradient-footer)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </g>
            <text x="44" y="39" font-family="'Lexend', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">
              kaptativa<tspan fill="#EA384D">.</tspan>
            </text>
          </svg>
        </div>
        <p class="brand-desc">Transformamos tu negocio con tecnología que conecta, automatiza y escala.</p>
        <div class="social-links">
          <a href="https://instagram.com/kaptativa" target="_blank" aria-label="Instagram" class="social-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://linkedin.com/company/kaptativa" target="_blank" aria-label="LinkedIn" class="social-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href="https://wa.me/5493804890834" target="_blank" aria-label="WhatsApp" class="social-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Servicios -->
      <div class="footer-col">
        <h4><a href="/servicios/" style="color: inherit; text-decoration: none;">SERVICIOS</a></h4>
        <ul class="footer-links-list">
          <li><a href="/servicios/agentes-ia/">Agentes de IA</a></li>
          <li><a href="/servicios/automatizacion/">Automatización</a></li>
          <li><a href="/servicios/desarrollo-software/">Desarrollo de Software</a></li>
          <li><a href="/servicios/diseno-web/">Diseño Web & E-commerce</a></li>
          <li><a href="/servicios/email-marketing/">Email Marketing</a></li>
          <li><a href="/servicios/publicidad-digital/">Publicidad Digital</a></li>
          <li><a href="/servicios/seo-geo/">SEO & GEO</a></li>
          <li><a href="/servicios/social-media/">Social Media</a></li>
        </ul>
      </div>

      <!-- Col 3: Agencia -->
      <div class="footer-col">
        <h4>AGENCIA</h4>
        <ul class="footer-links-list">
          <li><a href="/#metodologia">El Método</a></li>
          <li><a href="/nosotros/">Casos de éxito</a></li>
          <li><a href="/nosotros/">Nosotros</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>

      <!-- Col 4: Contacto -->
      <div class="footer-col">
        <h4>CONTACTO</h4>
        <ul class="footer-links-list contact-info-list">
          <li><a href="tel:+5493804890834">+54 9 380 489-0834</a></li>
          <li><a href="mailto:hola@kaptativa.com">hola@kaptativa.com</a></li>
          <li><a href="https://instagram.com/kaptativa" target="_blank">@kaptativa</a></li>
          <li><a href="/contacto/">Agendá tu diagnóstico</a></li>
          <li class="address-item" style="color: #94a3b8;">La Rioja, Argentina</li>
        </ul>
      </div>
    </div>

    <!-- Divider Line -->
    <div class="footer-divider"></div>

    <!-- Bottom Row (Left Copyright, Right Legal Links) -->
    <div class="footer-bottom-row">
      <p class="copyright">&copy; 2026 Kaptativa Digital &bull; La Rioja, Argentina.</p>
      <div class="footer-legal-links">
        <a href="/privacidad/">Privacidad</a>
        <span class="legal-dot" style="color: #64748b;">&bull;</span>
        <a href="/terminos/">Términos</a>
      </div>
    </div>
  </div>
</footer>