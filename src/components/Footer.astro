---
// Footer.astro
---
<footer class="footer" id="footer">
  <div class="container" style="position: relative;">
    <!-- Background Watermark Text - Fitted, Darker Deep Magenta Fill (#2E1F7A) & 0.05 Opacity -->
    <div class="footer-container-watermark" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 950 260" width="100%" height="100%" preserveAspectRatio="xMidYMax meet" style="overflow: visible;">
        <text x="50%" y="195" text-anchor="middle" font-family="'Lexend', sans-serif" font-size="210" font-weight="600" fill="#2E1F7A" opacity="0.05" letter-spacing="-2">
          kaptativa<tspan fill="#7C5CFF">.</tspan>
        </text>
      </svg>
    </div>

    <div class="footer-grid">
      <!-- Col 1: Brand -->
      <div class="footer-col col-brand">
        <div class="footer-logo-wrapper">
          <svg class="footer-logo-svg" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 8 169 44" width="154" height="40">
        <!-- Logo: la flecha (isotipo) + kaptativa con k minúscula -->
        <g transform="translate(-4 7.6) scale(0.69)" stroke="#7C5CFF" stroke-width="6.2" stroke-linecap="round" stroke-linejoin="round" fill="none"><path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" /><path d="M 15 13 L 26 13 L 26 24" /></g>
        <text x="26" y="39" font-family="'Lexend', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">kaptativa<tspan fill="#7C5CFF">.</tspan></text>
      </svg>
        </div>
        <p class="brand-desc">Transformamos tu negocio con tecnología que conecta, automatiza y escala.</p>
        <div class="social-links">
          <a href="https://instagram.com/kaptativa" target="_blank" aria-label="Instagram" class="social-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://linkedin.com/company/kaptativa" target="_blank" aria-label="LinkedIn" class="social-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <a href="https://wa.me/5493804890834" target="_blank" aria-label="WhatsApp" class="social-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Servicios -->
      <div class="footer-col">
        <p class="footer-title"><a href="/servicios/" style="color: inherit; text-decoration: none;">Servicios</a></p>
        <ul class="footer-links-list">
          <li><a href="/servicios/agentes-ia/">Agentes de IA</a></li>
          <li><a href="/servicios/automatizacion/">Automatización</a></li>
          <li><a href="/servicios/desarrollo-software/">Desarrollo de Software</a></li>
          <li><a href="/servicios/diseno-web/">Diseño Web & E-commerce</a></li>
          <li><a href="/servicios/email-marketing/">Email Marketing</a></li>
          <li><a href="/servicios/publicidad-digital/">Publicidad Digital</a></li>
          <li><a href="/servicios/seo-geo/">SEO & GEO</a></li>
          <li><a href="/servicios/social-media/">Social Media</a></li>
        </ul>
      </div>

      <!-- Col 3: Agencia -->
      <div class="footer-col">
        <p class="footer-title">Agencia</p>
        <ul class="footer-links-list">
          <li><a href="/precios/">Planes y precios</a></li>
          <li><a href="/soluciones/">Soluciones por rubro</a></li>
          <li><a href="/proyectos/">Proyectos</a></li>
          <li><a href="/nosotros/">Nosotros</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </ul>
      </div>

      <!-- Col 4: Contacto -->
      <div class="footer-col">
        <p class="footer-title">Contacto</p>
        <ul class="footer-links-list contact-info-list">
          <li><a href="tel:+5493804890834">+54 9 380 489-0834</a></li>
          <li><a href="mailto:hola@kaptativa.com">hola@kaptativa.com</a></li>
          <li><a href="https://instagram.com/kaptativa" target="_blank">@kaptativa</a></li>
          <li><a href="/contacto/">¿Hablamos?</a></li>
          <li class="address-item" style="color: #B4B4BE;">La Rioja, Argentina</li>
        </ul>
      </div>
    </div>

    <!-- Divider Line -->
    <div class="footer-divider"></div>

    <!-- Bottom Row (Left Copyright, Right Legal Links) -->
    <div class="footer-bottom-row">
      <p class="copyright">&copy; 2026 kaptativa Digital &bull; La Rioja, Argentina.</p>
      <a class="footer-made" href="/#modulos">Este sitio está hecho con la plataforma</a>
      <div class="footer-legal-links">
        <a href="/privacidad/">Privacidad</a>
        <span class="legal-dot" style="color: #8E8E99;">&bull;</span>
        <a href="/terminos/">Términos</a>
      </div>
    </div>
  </div>
</footer>
<style>
  /* Privacidad y Términos: objetivo táctil de 44 px de alto (antes 20 px) */
  .footer-legal-links { display: flex; align-items: center; gap: 4px; }
  .footer-legal-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 6px; }
</style>
