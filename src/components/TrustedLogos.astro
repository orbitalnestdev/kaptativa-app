---
// TrustedLogos.astro - B2B Social Proof logo bar
---
<div class="trusted-logos-section">
  <div class="container">
    <div class="logos-grid">
      <!-- Logo 1: Gomez & Asoc -->
      <div class="logo-item">
        <svg viewBox="0 0 160 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 12 L20 8 L30 12 V22 C30 27, 20 32, 20 32 C20 32, 10 27, 10 22 V12 Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <path d="M15 17 H25 V23 H20 V20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          <text x="38" y="25" font-family="'Lexend', sans-serif" font-weight="700" font-size="13" fill="currentColor" letter-spacing="1">GOMEZ &amp; ASOC.</text>
        </svg>
      </div>

      <!-- Logo 2: Nexo Logistica -->
      <div class="logo-item">
        <svg viewBox="0 0 160 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 12 L18 20 L10 28 M20 12 L28 20 L20 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <text x="38" y="25" font-family="'Lexend', sans-serif" font-weight="700" font-size="13" fill="currentColor" letter-spacing="1">NEXO LOGISTICA</text>
        </svg>
      </div>

      <!-- Logo 3: Dental Valle -->
      <div class="logo-item">
        <svg viewBox="0 0 160 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 15 C12 25, 28 25, 28 15 C28 12, 24 12, 20 16 C16 12, 12 12, 12 15 Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <text x="38" y="25" font-family="'Lexend', sans-serif" font-weight="700" font-size="13" fill="currentColor" letter-spacing="1">DENTAL VALLE</text>
        </svg>
      </div>

      <!-- Logo 4: Patagonia Deco -->
      <div class="logo-item">
        <svg viewBox="0 0 160 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 28 L17 14 L24 28 M18 28 L23 18 L28 28" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          <text x="38" y="25" font-family="'Lexend', sans-serif" font-weight="700" font-size="13" fill="currentColor" letter-spacing="1">PATAGONIA DECO</text>
        </svg>
      </div>

      <!-- Logo 5: Valor Capital -->
      <div class="logo-item">
        <svg viewBox="0 0 160 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="10" y="10" width="20" height="20" rx="4" stroke="currentColor" stroke-width="2" />
          <path d="M14 24 L18 20 L21 23 L26 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="26" cy="16" r="1.5" fill="currentColor" />
          <text x="38" y="25" font-family="'Lexend', sans-serif" font-weight="700" font-size="13" fill="currentColor" letter-spacing="1">VALOR CAPITAL</text>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .trusted-logos-section {
    padding: 30px 0 40px;
    border-top: none;
    background: transparent;
    position: relative;
    z-index: 10;
    margin-top: -30px;
  }

  .trusted-title {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 25px;
    opacity: 0.6;
  }

  .logos-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 40px 60px;
    max-width: 900px;
    margin: 0 auto;
  }

  .logo-item {
    color: var(--text-secondary);
    opacity: 0.35;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 30px;
  }

  .logo-item svg {
    height: 100%;
    width: auto;
    max-width: 130px;
  }

  .logo-item:hover {
    color: var(--text-primary);
    opacity: 0.8;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .trusted-logos-section {
      padding: 25px 0 35px;
    }
    .logos-grid {
      gap: 25px 40px;
    }
    .logo-item {
      height: 25px;
    }
  }
</style>

