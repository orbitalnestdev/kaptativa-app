---
// Fondo "aurora" para los héroes: tres manchas violeta desenfocadas que derivan despacio detrás del contenido.
// Solo anima `transform` sobre capas ya desenfocadas (sin repintados); se queda quieto con "reducir movimiento".
---
<div class="aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i></div>

<style is:global>
  .aurora { position: absolute; inset: 0; overflow: hidden; z-index: 0; pointer-events: none; }
  .aurora i { position: absolute; display: block; border-radius: 50%; filter: blur(70px); opacity: 0.6; mix-blend-mode: screen; will-change: transform; }
  .aurora .a1 { width: 52vw; height: 52vw; max-width: 760px; max-height: 760px; left: -12%; top: -30%; background: radial-gradient(circle at 40% 40%, rgba(124, 92, 255, 0.55), rgba(124, 92, 255, 0) 65%); animation: aurora-1 22s ease-in-out infinite; }
  .aurora .a2 { width: 46vw; height: 46vw; max-width: 680px; max-height: 680px; right: -14%; top: -10%; background: radial-gradient(circle at 60% 40%, rgba(160, 140, 255, 0.42), rgba(160, 140, 255, 0) 65%); animation: aurora-2 26s ease-in-out infinite; }
  .aurora .a3 { width: 40vw; height: 40vw; max-width: 600px; max-height: 600px; left: 30%; bottom: -35%; background: radial-gradient(circle at 50% 50%, rgba(74, 50, 184, 0.55), rgba(74, 50, 184, 0) 65%); animation: aurora-3 30s ease-in-out infinite; }
  @keyframes aurora-1 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(14vw, 10vh) scale(1.15); } }
  @keyframes aurora-2 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-12vw, 14vh) scale(0.9); } }
  @keyframes aurora-3 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(10vw, -12vh) scale(1.1); } }
  /* El contenido del hero queda por encima de la aurora */
  .h2-hero > .container, .hero > .container, .precios-hero > .container, .hero-contacto > .container { position: relative; z-index: 1; }
  .hero-contacto { position: relative; overflow: hidden; }
  /* Inclinación 3D de los mockups del hero (app.js actualiza --tx/--ty con el mouse) */
  [data-tilt].active, [data-tilt]:not(.reveal) { transform: perspective(1200px) rotateX(var(--tx, 0deg)) rotateY(var(--ty, 0deg)) !important; transition: transform 0.18s ease-out, opacity 0.6s ease !important; transform-style: preserve-3d; }
  @media (prefers-reduced-motion: reduce) { .aurora i { animation: none; } [data-tilt].active { transform: none !important; } }
  @media (max-width: 768px) { .aurora i { filter: blur(50px); opacity: 0.45; } }
</style>
