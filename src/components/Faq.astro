---
import { faqsData } from '../data/content.js';
---

<section class="section section-light" id="faq">
  <div class="container faq-layout">
    <div class="section-header reveal">
      <h2>Preguntas frecuentes</h2>
      <p>Lo que más nos consultan antes de empezar. Si tu duda no está acá, escribinos por WhatsApp.</p>
    </div>

    <div class="faq-wrapper reveal reveal-delay-1">
      {faqsData.map((faq, index) => (
        <div class="faq-item">
          <button class="faq-header" aria-expanded="false">
            <span>{faq.question}</span>
            <svg class="faq-icon-toggle" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div class="faq-content">
            <p>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Dos columnas: título a la izquierda (fijo al hacer scroll), preguntas a la derecha */
  .faq-layout { display: grid !important; grid-template-columns: 1fr 1.7fr !important; gap: 48px !important; align-items: start; }
  .faq-layout .section-header { text-align: left !important; margin: 0 !important; max-width: none !important; position: sticky; top: 110px; }
  .faq-layout .section-header p { margin-left: 0 !important; }
  .faq-layout .faq-wrapper { margin: 0 !important; max-width: none !important; }
  @media (max-width: 992px) {
    .faq-layout { grid-template-columns: 1fr !important; gap: 24px !important; }
    .faq-layout .section-header { position: static; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // FAQ ACCORDION LOGIC
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const headerBtn = item.querySelector('.faq-header');
      const content = item.querySelector('.faq-content') as HTMLElement;

      if(headerBtn) {
        headerBtn.addEventListener('click', () => {
          const isActive = item.classList.contains('active');

          faqItems.forEach(otherItem => {
            otherItem.classList.remove('active');
            const otherHeader = otherItem.querySelector('.faq-header');
            if(otherHeader) otherHeader.setAttribute('aria-expanded', 'false');
            const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
            if(otherContent) otherContent.style.maxHeight = '';
          });

          if (!isActive) {
            item.classList.add('active');
            headerBtn.setAttribute('aria-expanded', 'true');
            if(content) content.style.maxHeight = content.scrollHeight + "px";
          }
        });
      }
    });
  });
</script>

<style is:global>
</style>
