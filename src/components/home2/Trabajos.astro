---
// Trabajos reales: capturas de sitios y paneles entregados. Solo se muestra cuando hay datos.
// Los enlaces salen sin referencia (noreferrer + referrerpolicy) y sin seguimiento: el destino no sabe que el clic vino de acá.
import { trabajos } from '../../data/trabajos.js';
---

{trabajos.length > 0 && (
  <section class="section section-light" id="trabajos">
    <div class="container">
      <div class="section-header reveal">
        <h2>Sitios que ya están<br />funcionando</h2>
        <p>Capturas reales de lo entregado, sin maquetas. Entrá y recorrelos.</p>
      </div>
      <div class="tr-grid">
        {trabajos.map((t) => (
          <a class="tr-card" href={t.url} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer">
            <div class="tr-img"><img src={t.imagen} alt={`Sitio de ${t.nombre}`} width="1200" height="750" loading="lazy" decoding="async" /></div>
            <div class="tr-head"><h3>{t.nombre}</h3><span>{t.rubro}</span></div>
            {t.resultado && <p>{t.resultado}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .tr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 24px; }
  .tr-card { display: block; text-decoration: none; color: inherit; border-radius: var(--radius-lg); background: var(--card-bg); border: 1px solid var(--border-color); overflow: hidden; transition: border-color var(--transition-normal); }
  .tr-card:hover { border-color: var(--border-hover); }
  .tr-img { aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-secondary); border-bottom: 1px solid var(--border-color); }
  .tr-img img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform 0.6s ease; }
  .tr-card:hover .tr-img img { transform: scale(1.03); }
  .tr-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 18px 20px 0; }
  .tr-head h3 { font-family: 'Lexend', sans-serif; font-size: 1.05rem; font-weight: 600; color: var(--text-primary); margin: 0; }
  .tr-head span { font-size: 0.78rem; color: var(--text-muted); white-space: nowrap; }
  .tr-card p { margin: 8px 0 0; padding: 0 20px 20px; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.55; }
  @media (max-width: 992px) { .tr-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .tr-grid { grid-template-columns: 1fr; } }
</style>
