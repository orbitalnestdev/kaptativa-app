---
// Sección "Control total": lista de funciones + mazo de pantallas animadas que avanza solo.
// Cada pantalla es una interfaz simulada en HTML/CSS (no hay videos del sistema todavía).
import { svg } from '../../data/plataforma.js';

const DEMO_URL = 'https://wa.me/5493804890834?text=' + encodeURIComponent('¡Hola Kaptativa! Quiero solicitar una demo de la plataforma web.');

const slides = [
  { icon: 'layers', title: 'Todo tu negocio en un mismo lugar', text: 'Sitio, tienda, pedidos y marketing conectados. Un solo acceso, cero planillas paralelas.', caption: 'Ventas, pedidos y visitas en un solo tablero.', scene: 'dash' },
  { icon: 'edit', title: 'Tu web, editada por vos', text: 'Cambiás portada, bloques y catálogo sin depender de nadie. Lo que tocás se publica al instante.', caption: 'Cambiás el banner y se publica al toque.', scene: 'editor' },
  { icon: 'receipt', title: 'Cada venta, bajo control', text: 'Pedidos con estados claros, historial por cliente y stock que se descuenta solo.', caption: 'Cada pago confirma el pedido y descuenta stock.', scene: 'orders' },
  { icon: 'megaphone', title: 'Marketing que vende solo', text: 'Cupones, promociones, campañas y un asistente con IA que responde a tus clientes 24/7.', caption: 'Cupones y un asistente IA que atiende por vos.', scene: 'mkt' },
  { icon: 'grid', title: 'Empezá con lo justo, sumá el resto', text: 'Módulos que se activan cuando tu negocio los necesita, sin migrar nada.', caption: 'Activás módulos a medida que crecés.', scene: 'mods' },
];

const modsDemo = [
  { icon: 'monitor', name: 'Sitio web' }, { icon: 'cart', name: 'Tienda' }, { icon: 'rocket', name: 'Marketing' },
  { icon: 'file', name: 'Facturación' }, { icon: 'calendar', name: 'Turnos' }, { icon: 'bot', name: 'Asistente IA' },
];
---

<section class="section cs" id="sistema" data-cs>
  <div class="container cs-grid">
    <div class="cs-copy reveal">
      <span class="badge">Autoadministrable</span>
      <h2 class="cs-title">Control total de<br /><span class="text-gradient-crimson">tu negocio</span></h2>
      <p class="cs-lead">Productos, pedidos y contenidos desde un panel simple. Sin pedir cambios, sin esperar a nadie.</p>

      <div class="cs-tabs" role="tablist" aria-label="Funciones del sistema">
        {slides.map((s, i) => (
          <button type="button" class:list={['cs-tab', { active: i === 0 }]} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-go={i}>
            <span class="cs-tab-icon"><Fragment set:html={svg(s.icon)} /></span>
            <span class="cs-tab-text"><strong>{s.title}</strong><span>{s.text}</span></span>
          </button>
        ))}
      </div>

      <a href={DEMO_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary cs-cta"><span>Solicitar demo</span><Fragment set:html={svg('arrow')} /></a>
    </div>

    <div class="cs-stage reveal">
      <div class="cs-progress" aria-hidden="true">
        {slides.map((_, i) => <button type="button" class:list={['cs-dot', { active: i === 0 }]} data-go={i} tabindex="-1"><i></i></button>)}
      </div>

      <div class="cs-deck" aria-live="polite">
        {slides.map((s, i) => (
          <div class:list={['cs-slide', { 'is-active': i === 0 }]} data-pos={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <div class="cs-screen">
              <div class="cs-chrome"><span></span><span></span><span></span><em>panel.tunegocio.com.ar</em></div>
              <div class={`cs-scene cs-${s.scene}`} aria-hidden="true">
                {s.scene === 'dash' && (
                  <Fragment>
                    <aside class="cs-side"><i class="on"></i><i></i><i></i><i></i><i></i></aside>
                    <div class="cs-dash-main">
                      <div class="cs-kpis">
                        <div class="a1"><small>Ventas del mes</small><b>$ 4.82M</b><em>+18%</em></div>
                        <div class="a2"><small>Pedidos</small><b>312</b><em>+9%</em></div>
                        <div class="a3"><small>Visitas</small><b>21.4k</b><em>+32%</em></div>
                      </div>
                      <div class="cs-bars">{[38, 55, 46, 70, 58, 82, 66, 90, 74, 95].map((h, k) => <span style={`height:${h}%; animation-delay:${0.3 + k * 0.07}s`}></span>)}</div>
                    </div>
                    <div class="cs-toast">{<Fragment set:html={svg('cart')} />} Nueva venta · $ 38.900</div>
                  </Fragment>
                )}
                {s.scene === 'editor' && (
                  <Fragment>
                    <div class="cs-ed-bar"><b>Editor de portada</b><span class="cs-badge-live">Publicado</span></div>
                    <div class="cs-ed-hero">
                      <div class="cs-ed-title"><span class="t1">Nueva colección</span><span class="t2">Hasta 30% OFF</span></div>
                      <span class="cs-ed-sub"></span>
                      <i class="cs-ed-btn"></i>
                      <span class="cs-cursor"></span>
                    </div>
                    <div class="cs-ed-blocks"><div><i></i><span></span></div><div><i></i><span></span></div><div><i></i><span></span></div></div>
                  </Fragment>
                )}
                {s.scene === 'orders' && (
                  <Fragment>
                    <div class="cs-ord-head"><b>Pedidos</b><span>Stock remera negra: <b class="cs-stock"><span class="s1">12</span><span class="s2">11</span></b></span></div>
                    <div class="cs-ord-list">
                      <div class="r r1"><i></i><span>#1043 · Lucía M.</span><b class="st st-swap"><span class="p">Pendiente</span><span class="ok">Pagado</span></b></div>
                      <div class="r r2"><i></i><span>#1042 · Martín G.</span><b class="st ship">En camino</b></div>
                      <div class="r r3"><i></i><span>#1041 · Sofía R.</span><b class="st done">Entregado</b></div>
                      <div class="r r4"><i></i><span>#1040 · Diego P.</span><b class="st done">Entregado</b></div>
                    </div>
                  </Fragment>
                )}
                {s.scene === 'mkt' && (
                  <Fragment>
                    <div class="cs-mkt-left">
                      <div class="cs-coupon"><small>Cupón activo</small><b>BIENVENIDA10</b><span>10% OFF primera compra</span></div>
                      <div class="cs-camp"><small>Campaña de invierno</small><div class="cs-camp-bar"><i></i></div><span>68% del objetivo</span></div>
                    </div>
                    <div class="cs-chat">
                      <span class="in m1">¿Tienen talle M?</span>
                      <span class="out m2">¡Sí! Te dejo el link para comprar 🛍️</span>
                      <span class="in m3">¿Hacen envíos a Córdoba?</span>
                      <span class="out m4">Sí, llega en 48 hs 🚚</span>
                    </div>
                  </Fragment>
                )}
                {s.scene === 'mods' && (
                  <div class="cs-mods">
                    {modsDemo.map((m, k) => (
                      <div class:list={['cs-mod', { pre: k < 2 }]} style={`--d:${0.4 + k * 0.35}s`}>
                        <span class="cs-mod-ic"><Fragment set:html={svg(m.icon)} /></span>
                        <span>{m.name}</span>
                        <i class="cs-switch"></i>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
            <p class="cs-caption">{s.caption}</p>
          </div>
        ))}
      </div>

      <div class="cs-controls">
        <button type="button" data-prev aria-label="Anterior"><svg class="ki" viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6" /></svg></button>
        <button type="button" data-toggle aria-label="Pausar"><svg class="ki ic-pause" viewBox="0 0 24 24"><path d="M9 5v14M15 5v14" /></svg><svg class="ki ic-play" viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z" /></svg></button>
        <button type="button" data-next aria-label="Siguiente"><svg class="ki" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg></button>
      </div>
    </div>

    <div class="cs-mobile-info" aria-hidden="true">
      <strong data-m-title>{slides[0].title}</strong>
      <span data-m-text>{slides[0].text}</span>
    </div>
  </div>
  <script type="application/json" data-cs-slides set:html={JSON.stringify(slides.map(({ title, text }) => ({ title, text })))} />
</section>

<script>
  const DURATION = 7000;

  document.querySelectorAll<HTMLElement>('[data-cs]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.cs-slide')];
    const tabs = [...root.querySelectorAll<HTMLElement>('.cs-tab')];
    const dots = [...root.querySelectorAll<HTMLElement>('.cs-dot')];
    const data = JSON.parse(root.querySelector('[data-cs-slides]')?.textContent || '[]');
    const mTitle = root.querySelector('[data-m-title]');
    const mText = root.querySelector('[data-m-text]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const n = slides.length;

    let index = 0;
    let elapsed = 0;
    let last = 0;
    let userPaused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let inView = false;

    const setPaused = (p: boolean) => {
      userPaused = p;
      root.classList.toggle('is-paused', p);
      toggle.setAttribute('aria-label', p ? 'Reproducir' : 'Pausar');
    };
    setPaused(userPaused);

    const go = (i: number) => {
      index = (i + n) % n;
      elapsed = 0;
      slides.forEach((s, k) => {
        const pos = (k - index + n) % n;
        s.dataset.pos = String(pos === n - 1 ? -1 : pos);
        const active = pos === 0;
        // Reinicia las animaciones internas al volver a mostrar la pantalla
        if (active && !s.classList.contains('is-active')) {
          s.getAnimations({ subtree: true }).forEach((a) => { if (a.effect?.target !== s) a.currentTime = 0; });
        }
        s.classList.toggle('is-active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      tabs.forEach((t, k) => { t.classList.toggle('active', k === index); t.setAttribute('aria-selected', k === index ? 'true' : 'false'); });
      dots.forEach((d, k) => { d.classList.toggle('active', k === index); d.style.setProperty('--p', '0'); });
      if (mTitle) mTitle.textContent = data[index]?.title ?? '';
      if (mText) mText.textContent = data[index]?.text ?? '';
    };
    go(0);

    const tick = (t: number) => {
      const dt = last ? t - last : 0;
      last = t;
      if (!userPaused && inView && !document.hidden) {
        elapsed += dt;
        dots[index]?.style.setProperty('--p', String(Math.min(elapsed / DURATION, 1)));
        if (elapsed >= DURATION) go(index + 1);
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    new IntersectionObserver(([e]) => { inView = e.isIntersecting; }, { threshold: 0.35 }).observe(root);

    root.querySelectorAll<HTMLElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go))));
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    toggle.addEventListener('click', () => setPaused(!userPaused));

    // Swipe en celular
    const deck = root.querySelector<HTMLElement>('.cs-deck')!;
    let sx = 0, sy = 0;
    deck.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; });
    deck.addEventListener('pointerup', (e) => {
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (Math.max(Math.abs(dx), Math.abs(dy)) < 40) return;
      const forward = Math.abs(dx) > Math.abs(dy) ? dx < 0 : dy < 0;
      go(index + (forward ? 1 : -1));
    });
  });
</script>

<style>
  .cs { position: relative; }
  .cs :global(.ki) { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .cs-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: center; }

  /* ---------- Columna de texto ---------- */
  .cs-title { font-family: 'Lexend', sans-serif; font-size: clamp(2.2rem, 4.5vw, 3.4rem) !important; line-height: 1.1 !important; margin: 18px 0 16px !important; color: var(--text-primary); }
  .cs-lead { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6; max-width: 480px; margin: 0; }
  .cs-tabs { display: flex; flex-direction: column; gap: 12px; margin-top: 36px; }
  .cs-tab {
    display: flex; gap: 16px; align-items: flex-start; width: 100%; text-align: left; cursor: pointer; font: inherit;
    padding: 16px; border-radius: 16px; background: transparent; border: 1px solid var(--border-color);
    transition: background var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }
  .cs-tab:hover { border-color: rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.02); }
  .cs-tab.active { background: var(--bg-tertiary); border-color: var(--border-hover); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), var(--shadow-glow); }
  .cs-tab-icon {
    width: 46px; height: 46px; border-radius: 12px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    color: var(--accent-indigo); background: var(--accent-indigo-glow); transition: all var(--transition-normal);
  }
  .cs-tab.active .cs-tab-icon { color: #fff; background: var(--gradient-primary); box-shadow: 0 6px 18px rgba(217, 70, 239, 0.35); }
  .cs-tab-text { display: flex; flex-direction: column; gap: 4px; }
  .cs-tab-text strong { font-family: 'Lexend', sans-serif; font-size: 1.02rem; font-weight: 600; color: var(--text-secondary); transition: color var(--transition-normal); }
  .cs-tab.active .cs-tab-text strong { color: var(--text-primary); }
  .cs-tab-text span { font-size: 0.88rem; line-height: 1.5; color: var(--text-muted); }
  .cs-tab.active .cs-tab-text span { color: var(--text-secondary); }
  .cs-cta { margin-top: 32px; gap: 10px; }
  .cs-cta :global(.ki) { width: 18px; height: 18px; }

  /* ---------- Escenario ---------- */
  .cs-stage { display: flex; align-items: center; gap: 22px; }
  .cs-progress { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .cs-dot { position: relative; width: 6px; height: 6px; padding: 0; border: 0; border-radius: 6px; cursor: pointer; overflow: hidden; background: rgba(255, 255, 255, 0.2); transition: height var(--transition-normal), width var(--transition-normal); }
  .cs-dot.active { height: 48px; }
  .cs-dot i { position: absolute; inset: 0; background: var(--accent-indigo); transform-origin: top; transform: scaleY(0); }
  .cs-dot.active i { transform: scaleY(var(--p, 0)); }

  .cs-deck { position: relative; flex: 1; aspect-ratio: 16 / 11.5; touch-action: pan-y; user-select: none; }
  .cs-slide {
    position: absolute; inset: 0; display: flex; flex-direction: column; gap: 12px;
    padding: 14px; border-radius: 24px; background: #12121c; border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease, filter 0.6s ease;
    opacity: 0; pointer-events: none; transform: translateY(30px) scale(0.96);
  }
  .cs-slide[data-pos="0"] { opacity: 1; z-index: 5; transform: none; pointer-events: auto; }
  .cs-slide[data-pos="1"] { opacity: 0.55; z-index: 4; transform: translateY(-20px) scale(0.95); filter: brightness(0.6); }
  .cs-slide[data-pos="2"] { opacity: 0.25; z-index: 3; transform: translateY(-38px) scale(0.9); filter: brightness(0.5); }
  .cs-slide[data-pos="-1"] { opacity: 0; z-index: 6; transform: translateY(40px) scale(1.02); }

  .cs-screen { flex: 1; min-height: 0; display: flex; flex-direction: column; border-radius: 14px; overflow: hidden; background: #0a0a12; border: 1px solid rgba(255, 255, 255, 0.06); }
  .cs-chrome { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
  .cs-chrome span { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.18); }
  .cs-chrome em { margin-left: 10px; font-style: normal; font-size: 0.7rem; color: var(--text-muted); background: rgba(255, 255, 255, 0.04); border-radius: 6px; padding: 3px 10px; }
  .cs-scene { position: relative; flex: 1; min-height: 0; padding: 16px; display: flex; gap: 14px; overflow: hidden; font-size: 0.78rem; color: var(--text-secondary); }
  .cs-caption { margin: 0; padding: 2px 6px 4px 14px; border-left: 3px solid var(--accent-indigo); color: var(--text-primary); font-size: 0.92rem; font-weight: 500; }

  .cs-controls { display: flex; flex-direction: column; gap: 8px; }
  .cs-controls button { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-secondary); background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); transition: all var(--transition-fast); }
  .cs-controls button:hover { color: #fff; border-color: var(--border-hover); }
  .cs-controls :global(.ki) { width: 16px; height: 16px; }
  .cs .ic-play { display: none; }
  .cs.is-paused .ic-play { display: block; fill: currentColor; }
  .cs.is-paused .ic-pause { display: none; }

  .cs-mobile-info { display: none; }

  /* ---------- Animaciones: solo corren en la pantalla activa ---------- */
  .cs-slide :global(*) { animation-play-state: paused; }
  .cs-slide.is-active :global(*) { animation-play-state: running; }
  .cs.is-paused .cs-slide.is-active :global(*) { animation-play-state: paused; }
  @keyframes cs-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes cs-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes cs-pop { 0% { opacity: 0; transform: scale(0.8); } 60% { transform: scale(1.06); } 100% { opacity: 1; transform: scale(1); } }
  @keyframes cs-out { to { opacity: 0; transform: translateY(-8px); } }
  @keyframes cs-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* Escena 1: tablero */
  .cs-side { display: flex; flex-direction: column; gap: 10px; padding-right: 12px; border-right: 1px solid rgba(255, 255, 255, 0.06); }
  .cs-side i { width: 20px; height: 20px; border-radius: 6px; background: rgba(255, 255, 255, 0.07); }
  .cs-side i.on { background: var(--gradient-primary); }
  .cs-dash-main { flex: 1; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .cs-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .cs-kpis div { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: 10px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); animation: cs-up 0.5s both; }
  .cs-kpis .a2 { animation-delay: 0.1s; } .cs-kpis .a3 { animation-delay: 0.2s; }
  .cs-kpis small { font-size: 0.65rem; color: var(--text-muted); }
  .cs-kpis b { font-size: 1rem; color: #fff; }
  .cs-kpis em { font-style: normal; font-size: 0.66rem; color: #10B981; }
  .cs-bars { flex: 1; display: flex; align-items: flex-end; gap: 7px; min-height: 60px; }
  .cs-bars span { flex: 1; border-radius: 4px 4px 0 0; transform-origin: bottom; background: linear-gradient(180deg, #D946EF, rgba(139, 92, 246, 0.2)); animation: cs-grow 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .cs-toast { position: absolute; right: 16px; bottom: 16px; display: flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 10px; color: #fff; font-weight: 500; background: rgba(5, 5, 8, 0.9); border: 1px solid var(--border-hover); animation: cs-pop 0.5s 2.2s both; }
  .cs-toast :global(.ki) { width: 15px; height: 15px; color: var(--accent-indigo); }

  /* Escena 2: editor */
  .cs-editor { flex-direction: column; }
  .cs-ed-bar { display: flex; justify-content: space-between; align-items: center; color: #fff; }
  .cs-badge-live { font-size: 0.66rem; padding: 3px 10px; border-radius: 20px; color: #10B981; background: rgba(16, 185, 129, 0.12); animation: cs-pop 0.4s 3.4s both; }
  .cs-ed-hero { position: relative; flex: 1; min-height: 0; border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 10px; background: linear-gradient(135deg, rgba(217, 70, 239, 0.4), rgba(6, 182, 212, 0.25)); outline: 1px dashed rgba(255, 255, 255, 0.35); outline-offset: -6px; }
  .cs-ed-title { position: relative; height: 1.6em; font-family: 'Lexend', sans-serif; font-size: clamp(1rem, 2vw, 1.4rem); font-weight: 600; color: #fff; }
  .cs-ed-title span { position: absolute; left: 0; top: 0; white-space: nowrap; }
  .cs-ed-title .t1 { animation: cs-out 0.3s 1.8s both; }
  .cs-ed-title .t2 { animation: cs-in 0.4s 2.1s both; }
  .cs-ed-sub { width: 45%; height: 8px; border-radius: 4px; background: rgba(255, 255, 255, 0.55); }
  .cs-ed-btn { margin-top: auto; width: 96px; height: 26px; border-radius: 20px; background: #fff; }
  .cs-cursor { position: absolute; width: 14px; height: 14px; left: 70%; top: 75%; border-left: 2px solid #fff; border-top: 2px solid #fff; transform: rotate(-20deg); filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5)); animation: cs-cursor 3s 0.3s both; }
  @keyframes cs-cursor { 0% { left: 70%; top: 75%; } 45% { left: 34%; top: 26%; } 55% { transform: rotate(-20deg) scale(0.85); } 65% { transform: rotate(-20deg) scale(1); } 100% { left: 34%; top: 26%; } }
  .cs-ed-blocks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .cs-ed-blocks div { display: flex; flex-direction: column; gap: 6px; padding: 8px; border-radius: 10px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }
  .cs-ed-blocks i { height: 30px; border-radius: 6px; background: rgba(255, 255, 255, 0.07); }
  .cs-ed-blocks span { width: 70%; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, 0.08); }

  /* Escena 3: pedidos */
  .cs-orders { flex-direction: column; }
  .cs-ord-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: #fff; }
  .cs-ord-head > span { color: var(--text-muted); font-size: 0.72rem; }
  .cs-stock { position: relative; display: inline-block; width: 1.4em; height: 1.2em; vertical-align: bottom; color: #fff; }
  .cs-stock span { position: absolute; left: 0; }
