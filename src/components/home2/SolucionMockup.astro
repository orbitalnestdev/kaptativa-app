---
// Pantalla de ejemplo animada para el hero de cada solución (HTML/CSS, sin imágenes).
// `tipo` define qué interfaz se dibuja; los datos son ilustrativos.
import { svg } from '../../data/plataforma.js';

interface Props { tipo: 'shop' | 'b2b' | 'menu' | 'members' | 'agenda' | 'props' | 'padron' | 'inbox'; }
const { tipo } = Astro.props;

const urls = {
  shop: 'tutienda.com.ar', b2b: 'mayorista.tunegocio.com.ar', menu: 'carta.turesto.com.ar', members: 'socios.tuclub.com.ar',
  agenda: 'turnos.tuestudio.com.ar', props: 'tuinmobiliaria.com.ar', padron: 'asociados.tumutual.org.ar', inbox: 'panel.tuestudio.com.ar',
};
const toasts = {
  shop: { icon: 'cart', text: 'Nueva venta: $ 38.900' }, b2b: { icon: 'clipboard', text: 'Pedido #2081, 48 unidades' },
  menu: { icon: 'bell', text: 'Mesa 7: pedido a cocina' }, members: { icon: 'card', text: 'Cuota de Ana R. acreditada' },
  agenda: { icon: 'calendar', text: 'Turno confirmado, 10:30' }, props: { icon: 'message', text: 'Consulta por Depto. 3 amb.' },
  padron: { icon: 'users', text: '12 asociados nuevos este mes' }, inbox: { icon: 'calendar', text: 'Reunión agendada: jueves 16 h' },
};
const toast = toasts[tipo];
---

<div class="sm" aria-hidden="true">
  <div class="sm-window">
    <div class="sm-chrome"><span></span><span></span><span></span><em>{urls[tipo]}</em></div>
    <div class={`sm-body sm-${tipo}`}>
      {tipo === 'shop' && (
        <Fragment>
          <div class="sm-bar"><b>Nueva temporada</b><span class="sm-chip">Envío gratis +$50k</span></div>
          <div class="sm-grid3">
            {[['#7C5CFF', '#6A48F5', 'Remera oversize', '$ 18.900'], ['#A08CFF', '#7C5CFF', 'Buzo frisa', '$ 38.900'], ['#5B3FE0', '#7C5CFF', 'Gorra bordada', '$ 12.500']].map(([a, b, n, p], i) => (
              <div class="sm-prod" style={`--d:${0.15 + i * 0.12}s`}>
                <i style={`background:linear-gradient(135deg, ${a}, ${b})`}></i>
                <span>{n}</span><b>{p}</b>
              </div>
            ))}
          </div>
          <div class="sm-row sm-pay"><Fragment set:html={svg('card')} /> MercadoPago, cuotas sin interés <em>Pagado</em></div>
        </Fragment>
      )}
      {tipo === 'b2b' && (
        <Fragment>
          <div class="sm-bar"><b>Lista mayorista, Cliente A</b><span class="sm-chip">-18% aplicado</span></div>
          <div class="sm-table">
            {[['Aceite 900ml x12', '$ 41.200', '86'], ['Yerba 1kg x10', '$ 52.800', '140'], ['Fideos 500g x20', '$ 23.600', '312'], ['Arroz 1kg x10', '$ 19.900', '58']].map(([n, p, s], i) => (
              <div class="sm-tr" style={`--d:${0.1 + i * 0.1}s`}><span>{n}</span><b>{p}</b><em>Stock {s}</em><i class="sm-qty">+</i></div>
            ))}
          </div>
          <div class="sm-row sm-total"><span>Total del pedido</span><b>$ 1.284.600</b></div>
        </Fragment>
      )}
      {tipo === 'menu' && (
        <Fragment>
          <div class="sm-menu-side">
            <div class="sm-qr">{Array.from({ length: 25 }).map((_, k) => <i class={[0, 1, 5, 6, 3, 4, 8, 9, 15, 16, 20, 21, 12, 18, 23, 13, 7].includes(k) ? 'on' : ''}></i>)}</div>
            <span>Escaneá la carta</span>
          </div>
          <div class="sm-menu-list">
            {[['Hamburguesa doble', '$ 14.500', ''], ['Pizza napolitana', '$ 16.200', ''], ['Papas con cheddar', '$ 7.800', 'Agotado'], ['Limonada menta', '$ 4.900', '']].map(([n, p, t], i) => (
              <div class:list={['sm-dish', { off: t }]} style={`--d:${0.1 + i * 0.1}s`}><span>{n}</span>{t ? <em>{t}</em> : <b>{p}</b>}</div>
            ))}
          </div>
        </Fragment>
      )}
      {tipo === 'members' && (
        <Fragment>
          <div class="sm-bar"><b>Socios activos</b><span class="sm-chip">428 al día</span></div>
          {[['Ana Rodríguez', 'Musculación', 'ok'], ['Lucas Pérez', 'Crossfit', 'due'], ['Sofía Gómez', 'Natación', 'ok'], ['Martín Díaz', 'Funcional', 'ok']].map(([n, d, s], i) => (
            <div class="sm-row sm-member" style={`--d:${0.1 + i * 0.1}s`}><i>{n[0]}</i><span>{n}<small>{d}</small></span><em class={s}>{s === 'ok' ? 'Al día' : 'Vence hoy'}</em></div>
          ))}
          <div class="sm-cupo"><span>Spinning 19 h</span><div><i style="width:80%"></i></div><b>16/20</b></div>
        </Fragment>
      )}
      {tipo === 'agenda' && (
        <Fragment>
          <div class="sm-bar"><b>Octubre, semana 3</b><span class="sm-chip">18 turnos</span></div>
          <div class="sm-cal">
            {['L', 'M', 'M', 'J', 'V'].map((d) => <small>{d}</small>)}
            {Array.from({ length: 20 }).map((_, k) => <i class:list={[{ busy: [1, 3, 6, 7, 9, 12, 14, 17, 18].includes(k), pick: k === 11 }]} style={`--d:${0.05 * k}s`}></i>)}
          </div>
          <div class="sm-row sm-slot"><Fragment set:html={svg('calendar')} /> Jueves 10:30, consulta inicial <em>Seña pagada</em></div>
        </Fragment>
      )}
      {tipo === 'props' && (
        <Fragment>
          <div class="sm-search"><Fragment set:html={svg('search')} /><span>Venta, departamento, 3 ambientes, Palermo</span></div>
          <div class="sm-grid2">
            {[['#6A48F5', '#A08CFF', 'USD 168.000', '3 amb, 78 m²'], ['#7C5CFF', '#5B3FE0', 'USD 245.000', '4 amb, 110 m²']].map(([a, b, p, m], i) => (
              <div class="sm-prop" style={`--d:${0.15 + i * 0.15}s`}>
                <i style={`background:linear-gradient(135deg, ${a}, ${b})`}><span>{i === 0 ? 'Destacada' : 'Nueva'}</span></i>
                <b>{p}</b><small>{m}</small>
              </div>
            ))}
          </div>
        </Fragment>
      )}
      {tipo === 'padron' && (
        <Fragment>
          <div class="sm-bar"><b>Padrón de asociados</b><span class="sm-chip">2.140 activos</span></div>
          <div class="sm-grid2 sm-benefits">
            {[['shield', 'Descuento farmacia', '20% OFF'], ['card', 'Cuota online', 'Al día'], ['users', 'Convenio gimnasio', '15% OFF'], ['megaphone', 'Asamblea anual', 'Viernes']].map(([ic, n, v], i) => (
              <div class="sm-benefit" style={`--d:${0.1 + i * 0.1}s`}><Fragment set:html={svg(ic)} /><span>{n}<b>{v}</b></span></div>
            ))}
          </div>
        </Fragment>
      )}
      {tipo === 'inbox' && (
        <Fragment>
          <div class="sm-bar"><b>Consultas</b><span class="sm-chip">5 nuevas hoy</span></div>
          {[['Laura M.', 'Formulario web', 'Necesito asesoramiento para mi sociedad...', 'web'], ['Pablo S.', 'WhatsApp', '¿Tienen disponibilidad esta semana?', 'wa'], ['Carla V.', 'Google', 'Consulta por planificación impositiva', 'web']].map(([n, c, t, k], i) => (
            <div class="sm-row sm-msg" style={`--d:${0.1 + i * 0.12}s`}><i>{n[0]}</i><span><b>{n}</b><small>{t}</small></span><em class={k}>{c}</em></div>
          ))}
        </Fragment>
      )}
    </div>
  </div>
  <div class="sm-toast"><Fragment set:html={svg(toast.icon)} /> {toast.text}</div>
</div>

<style>
  .sm { position: relative; width: 100%; max-width: 540px; margin: 0 auto; }
  .sm :global(.ki) { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .sm-window { border-radius: 20px; overflow: hidden; background: #141418; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55), 0 0 40px rgba(124, 92, 255, 0.12); }
  .sm-chrome { display: flex; align-items: center; gap: 6px; padding: 11px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); background: rgba(255, 255, 255, 0.02); }
  .sm-chrome span { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.18); }
  .sm-chrome em { margin-left: 10px; font-style: normal; font-size: 0.7rem; color: var(--text-muted); background: rgba(255, 255, 255, 0.04); border-radius: 8px; padding: 3px 10px; }
  .sm-body { padding: 16px; display: flex; flex-direction: column; gap: 12px; min-height: 290px; font-size: 0.8rem; color: var(--text-secondary); }

  @keyframes sm-up { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes sm-pop { 0% { opacity: 0; transform: translateY(8px) scale(0.92); } 100% { opacity: 1; transform: none; } }
  @keyframes sm-float { 50% { transform: translateY(-6px); } }
  [style*='--d'] { animation: sm-up 0.5s var(--d) both; }

  .sm-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; color: #fff; }
  .sm-bar b { font-size: 0.88rem; font-weight: 600; }
  .sm-chip { font-size: 0.66rem; padding: 4px 10px; border-radius: 20px; color: #C9BFFF; background: rgba(124, 92, 255, 0.14); white-space: nowrap; }
  .sm-row { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }
  .sm-row em { margin-left: auto; font-style: normal; font-size: 0.66rem; padding: 3px 9px; border-radius: 20px; color: #10B981; background: rgba(16, 185, 129, 0.12); white-space: nowrap; }

  /* shop */
  .sm-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .sm-prod { display: flex; flex-direction: column; gap: 4px; padding: 8px; border-radius: 12px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }
  .sm-prod i { aspect-ratio: 1; border-radius: 8px; margin-bottom: 4px; opacity: 0.85; }
  .sm-prod span { font-size: 0.72rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sm-prod b { color: #fff; font-size: 0.82rem; }
  .sm-pay { color: #fff; }
  .sm-pay :global(.ki) { color: var(--brand-primary-light); }

  /* b2b */
  .sm-table { display: flex; flex-direction: column; gap: 6px; }
  .sm-tr { display: grid; grid-template-columns: 1.6fr 1fr 0.8fr 26px; align-items: center; gap: 8px; padding: 9px 12px; border-radius: 12px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }
  .sm-tr span { color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sm-tr b { color: #fff; }
  .sm-tr em { font-style: normal; font-size: 0.68rem; color: var(--text-muted); }
  .sm-qty { width: 24px; height: 24px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-style: normal; color: #fff; background: linear-gradient(135deg, #7C5CFF, #6A48F5); }
  .sm-total { justify-content: space-between; color: #fff; }
  .sm-total b { font-size: 1rem; }

  /* menu */
  .sm-menu { flex-direction: row; align-items: center; gap: 16px; }
  .sm-menu-side { display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 0.7rem; }
  .sm-qr { display: grid; grid-template-columns: repeat(5, 16px); gap: 3px; padding: 10px; border-radius: 12px; background: #fff; }
  .sm-qr i { width: 16px; height: 16px; border-radius: 2px; background: transparent; }
  .sm-qr i.on { background: #141418; }
  .sm-menu-list { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .sm-dish { display: flex; justify-content: space-between; gap: 10px; padding: 11px 12px; border-radius: 12px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }
  .sm-dish span { color: #fff; }
  .sm-dish b { color: #C9BFFF; }
  .sm-dish.off span { color: var(--text-muted); text-decoration: line-through; }
  .sm-dish em { font-style: normal; font-size: 0.66rem; color: #F97316; }

  /* members */
  .sm-member i, .sm-msg i { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-style: normal; font-weight: 600; color: #fff; background: linear-gradient(135deg, #6A48F5, #06B6D4); flex-shrink: 0; }
  .sm-member span, .sm-msg span { display: flex; flex-direction: column; gap: 2px; color: #fff; min-width: 0; }
  .sm-member small, .sm-msg small { color: var(--text-muted); font-size: 0.68rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sm-row em.due { color: #F97316; background: rgba(249, 115, 22, 0.12); }
  .sm-cupo { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; color: #fff; }
  .sm-cupo div { height: 8px; border-radius: 8px; background: rgba(255, 255, 255, 0.08); overflow: hidden; }
  .sm-cupo div i { display: block; height: 100%; border-radius: 8px; background: linear-gradient(90deg, #7C5CFF, #06B6D4); }

  /* agenda */
  .sm-cal { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .sm-cal small { text-align: center; color: var(--text-muted); font-size: 0.68rem; }
  .sm-cal i { height: 30px; border-radius: 8px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.05); }
  .sm-cal i.busy { background: rgba(106, 72, 245, 0.35); }
  .sm-cal i.pick { background: linear-gradient(135deg, #7C5CFF, #6A48F5); box-shadow: 0 0 14px rgba(124, 92, 255, 0.5); }
  .sm-slot { color: #fff; }
  .sm-slot :global(.ki) { color: #7C5CFF; }

  /* props */
  .sm-search { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 12px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(124, 92, 255, 0.3); color: #fff; }
  .sm-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sm-prop { display: flex; flex-direction: column; gap: 3px; padding: 8px; border-radius: 12px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }
  .sm-prop i { position: relative; height: 110px; border-radius: 8px; margin-bottom: 6px; opacity: 0.85; }
  .sm-prop i span { position: absolute; top: 8px; left: 8px; font-style: normal; font-size: 0.62rem; color: #fff; padding: 3px 8px; border-radius: 20px; background: rgba(0, 0, 0, 0.45); }
  .sm-prop b { color: #fff; font-size: 0.88rem; }
  .sm-prop small { color: var(--text-muted); }

  /* padron */
  .sm-benefit { display: flex; gap: 10px; align-items: center; padding: 14px 12px; border-radius: 12px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); }
  .sm-benefit :global(.ki) { width: 20px; height: 20px; color: #7C5CFF; }
  .sm-benefit span { display: flex; flex-direction: column; gap: 2px; color: var(--text-secondary); }
  .sm-benefit b { color: #fff; }

  /* inbox */
  .sm-row em.wa { color: #10B981; background: rgba(16, 185, 129, 0.12); }
  .sm-row em.web { color: #06B6D4; background: rgba(6, 182, 212, 0.12); }

  .sm-toast {
    position: absolute; right: -18px; bottom: -20px; display: flex; align-items: center; gap: 8px; padding: 11px 16px; border-radius: 12px;
    font-size: 0.8rem; font-weight: 500; color: #fff; background: rgba(20, 20, 24, 0.92); border: 1px solid rgba(124, 92, 255, 0.35);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.5); backdrop-filter: blur(10px);
    animation: sm-pop 0.5s 1.1s both, sm-float 5s 1.6s ease-in-out infinite;
  }
  .sm-toast :global(.ki) { color: #7C5CFF; }

  @media (max-width: 576px) {
    .sm-body { padding: 12px; min-height: 0; }
    .sm-toast { right: 8px; bottom: -18px; font-size: 0.72rem; }
    .sm-tr { grid-template-columns: 1.5fr 1fr 26px; }
    .sm-tr em { display: none; }
    .sm-prop i { height: 80px; }
  }
  @media (prefers-reduced-motion: reduce) {
    [style*='--d'], .sm-toast { animation: none; }
  }
</style>
