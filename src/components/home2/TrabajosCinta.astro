---
// Cinta curva de proyectos (inspirada en la plantilla "Custom Spaces" de MotionSites): las capturas reales de los
// sitios giran sobre un cilindro en 3D que se arrastra con el mouse o el dedo y que deriva despacio en reposo.
// Al pasar el mouse por una captura aparecen el favicon, el nombre, el dominio y el rubro, y la captura recorre el sitio.
// La grilla completa con filtros vive en /proyectos/. Los enlaces salen sin referencia ni seguimiento.
import { trabajos, categorias } from '../../data/trabajos.js';
const host = (u) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const full = (img) => img.replace(/\.webp$/, '-full.webp');
const icon = (img) => img.replace(/\.webp$/, '-icon.webp');
const label = (key) => categorias.find((c) => c.key === key)?.label ?? '';
const n = trabajos.length;
// Arranca con el tercer proyecto al centro: los dos primeros quedan a la izquierda, en orden de lectura
const a0 = (2 * 360) / n;
---

{n > 0 && (
  <section class="section section-light" id="trabajos">
    <div class="container">
      <div class="section-header reveal">
        <h2>Sitios que ya están<br />funcionando</h2>
        <p>Tiendas, sitios y sistemas que hoy venden, reservan y gestionan. Entrá y recorrelos.</p>
      </div>
    </div>

    <div class="cinta" style={`--n:${n}`} data-cinta>
      <div class="cinta-stage">
        <div class="cinta-ring" style={`--a:${a0}deg`}>
          {trabajos.map((t, i) => (
            <a class="cinta-item" style={`--i:${i}`} href={t.url} target="_blank" rel="noopener noreferrer nofollow" referrerpolicy="no-referrer" aria-label={`${t.nombre}: ${t.resultado}`} draggable="false">
              <img src={full(t.imagen)} alt="" width="1000" height="1694" loading="lazy" decoding="async" draggable="false" />
              <span class="cinta-info">
                <img class="cinta-ico" src={icon(t.imagen)} alt="" width="28" height="28" loading="lazy" decoding="async" draggable="false" />
                <span class="cinta-txt"><strong>{t.nombre}</strong><small>{host(t.url)}</small></span>
                <em>{label(t.categoria)}</em>
              </span>
            </a>
          ))}
        </div>
      </div>
      <div class="cinta-nav">
        <button type="button" class="cinta-btn" data-dir="-1" aria-label="Proyecto anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
        <span class="cinta-hint"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0v1a2 2 0 0 0-4 0v2a2 2 0 0 0-4 0v6"/><path d="M14 10V4a2 2 0 0 0-4 0v2"/><path d="M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/></svg>Arrastrá para girar</span>
        <button type="button" class="cinta-btn" data-dir="1" aria-label="Proyecto siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
      </div>
    </div>

    <div class="container cinta-more reveal">
      <a class="btn btn-secondary" href="/proyectos/">Ver todos los proyectos</a>
    </div>
  </section>
)}

<script>
  const root = document.querySelector<HTMLElement>('[data-cinta]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('.cinta-stage')!;
    const ring = root.querySelector<HTMLElement>('.cinta-ring')!;
    const items = [...ring.querySelectorAll<HTMLElement>('.cinta-item')];
    const n = items.length;
    const step = 360 / n;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SPEED = 3.2; // grados por segundo en reposo
    const K = 0.22; // grados por píxel arrastrado

    let angle = 2 * step;
    let target: number | null = null;
    let vel = 0;
    let dragging = false, moved = false, hover = false, visible = false;
    let pauseUntil = 0, pauseT = 0, raf = 0, last = 0;

    const render = () => { ring.style.transform = `rotateY(${angle.toFixed(3)}deg)`; };

    // Un solo bucle: arrastre, inercia, destino (botones y foco) o deriva lenta. Se apaga cuando no hay nada que mover.
    const loop = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      let busy = dragging;
      if (!dragging) {
        if (target !== null) {
          const d = target - angle; angle += d * Math.min(1, dt * 7);
          if (Math.abs(d) < 0.05) { angle = target; target = null; }
          busy = true;
        } else if (Math.abs(vel) > 0.5) {
          angle += vel * dt; vel *= Math.pow(0.04, dt); busy = true;
        } else if (!reduce && !hover && now > pauseUntil) {
          angle += SPEED * dt; busy = true;
        }
      }
      render();
      raf = busy && visible && !document.hidden ? requestAnimationFrame(loop) : 0;
    };
    const start = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(loop); } };
    // Después de una interacción la deriva espera unos segundos
    const rest = () => { pauseUntil = performance.now() + 4000; clearTimeout(pauseT); pauseT = window.setTimeout(start, 4100); };

    // Arrastre con mouse o dedo (sin capturar el puntero: así el clic en una captura sigue abriendo el sitio)
    let x0 = 0, a0 = 0, lastX = 0, lastT = 0;
    const onMove = (e: PointerEvent) => {
      if (!dragging) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 6) moved = true;
      angle = a0 + dx * K;
      const now = performance.now();
      if (now - lastT > 0) vel = ((e.clientX - lastX) * K) / ((now - lastT) / 1000);
      lastX = e.clientX; lastT = now;
    };
    const onUp = () => {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove('is-dragging');
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
      if (reduce || performance.now() - lastT > 80) vel = 0;
      vel = Math.max(-200, Math.min(200, vel));
      rest(); start();
    };
    stage.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true; moved = false; target = null; vel = 0;
      x0 = lastX = e.clientX; a0 = angle; lastT = performance.now();
      stage.classList.add('is-dragging');
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);
      start();
    });
    // Un arrastre no abre el enlace
    ring.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);

    // Pausa mientras el mouse está encima
    stage.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    stage.addEventListener('pointerleave', () => { hover = false; start(); });

    // Botones: giran hasta el proyecto siguiente o anterior
    root.querySelectorAll<HTMLButtonElement>('.cinta-btn').forEach((b) => b.addEventListener('click', () => {
      const dir = Number(b.dataset.dir);
      const cur = angle / step;
      const k = dir > 0 ? Math.floor(cur + 0.02) + 1 : Math.ceil(cur - 0.02) - 1;
      target = k * step; vel = 0; rest(); start();
    }));
    // Teclado: el proyecto enfocado pasa al centro
    items.forEach((el, i) => el.addEventListener('focus', () => {
      if (!el.matches(':focus-visible')) return;
      let t = i * step; t += Math.round((angle - t) / 360) * 360;
      target = t; vel = 0; rest(); start();
    }));

    // Solo gira cuando está a la vista; entrada suave al aparecer (con respaldo por si el observador no dispara)
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        visible = e.isIntersecting;
        if (visible) { root.classList.add('on'); start(); }
      }), { threshold: 0.05 });
      io.observe(root);
      setTimeout(() => root.classList.add('on'), 9000);
    } else { visible = true; root.classList.add('on'); start(); }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    render();
  }
</script>

<style>
  .cinta { --w: 380px; --r: 820px; --p: 2000px; position: relative; margin-top: 4px; opacity: 0; transform: scale(0.97); transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1); }
  .cinta.on { opacity: 1; transform: none; }

  /* Escenario: el observador mira el cilindro desde adentro, así los bordes se acercan y el centro queda más lejos */
  .cinta-stage { position: relative; height: calc(var(--w) * 1.15); overflow: hidden; perspective: var(--p); perspective-origin: 50% 50%; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent); mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent); }
  .cinta-stage.is-dragging, .cinta-stage.is-dragging * { cursor: grabbing !important; }
  .cinta-ring { position: absolute; left: 50%; top: 50%; width: var(--w); height: calc(var(--w) * 1.25); margin: calc(var(--w) * -0.625) 0 0 calc(var(--w) * -0.5); transform-style: preserve-3d; transform: rotateY(var(--a, 0deg)); will-change: transform; pointer-events: none; }
  /* El anillo plano queda delante de las tarjetas en 3D: sin esto intercepta el mouse y ni el hover ni el clic llegan a ellas */
  .cinta-item { position: absolute; inset: 0; display: block; pointer-events: auto; overflow: hidden; border-radius: 14px; background: #FFFFFF; border: 1px solid #E4E4E9; box-shadow: 0 22px 44px -22px rgba(15, 15, 18, 0.4); cursor: pointer; -webkit-user-drag: none; backface-visibility: hidden; -webkit-backface-visibility: hidden; transform: rotateY(calc(var(--i) * -360deg / var(--n))) translateZ(calc(var(--r) * -1)); transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.45s ease, border-color 0.45s ease; }
  .cinta-item img { -webkit-user-drag: none; }
  .cinta-item > img { position: absolute; top: 0; left: 0; width: 100%; height: auto; display: block; transform: translateY(0); transition: transform 1s ease; }

  /* Detalle al pasar el mouse: favicon, nombre, dominio y rubro; la captura recorre el sitio y la tarjeta se adelanta */
  .cinta-info { position: absolute; left: 10px; right: 10px; bottom: 10px; display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 12px; background: rgba(255, 255, 255, 0.96); border: 1px solid #ECECEF; box-shadow: 0 10px 24px rgba(15, 15, 18, 0.16); opacity: 0; transform: translateY(10px); transition: opacity 0.3s ease, transform 0.3s ease; }
  .cinta-ico { flex: none; width: 28px; height: 28px; padding: 3px; border-radius: 8px; background: #FFFFFF; border: 1px solid #ECECEF; object-fit: contain; }
  .cinta-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.2; }
  .cinta-txt strong { font-family: 'Lexend', sans-serif; font-size: 0.78rem; font-weight: 600; color: #0F0F12; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cinta-txt small { font-size: 0.66rem; color: #6E6E7A; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cinta-info em { flex: none; font-style: normal; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.02em; padding: 3px 8px; border-radius: 999px; color: #5B3FE0; background: #F3F0FF; white-space: nowrap; }
  @media (hover: hover) {
    .cinta-item:hover, .cinta-item:focus-visible { border-color: #C9BDFF; box-shadow: 0 30px 50px -22px rgba(124, 92, 255, 0.45); transform: rotateY(calc(var(--i) * -360deg / var(--n))) translateZ(calc(var(--r) * -1 + 28px)); }
    .cinta-item:hover .cinta-info, .cinta-item:focus-visible .cinta-info { opacity: 1; transform: none; }
    .cinta-item:hover > img { transform: translateY(calc(-100% + var(--w) * 1.25)); transition: transform 4.5s linear; }
  }
  @media (hover: none) { .cinta-info { opacity: 1; transform: none; } }

  /* Flechas y pista de arrastre */
  .cinta-nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 14px; }
  .cinta-btn { width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #0F0F12; background: #FFFFFF; border: 1px solid #D4D4D9; cursor: pointer; transition: border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast); }
  .cinta-btn:hover { border-color: #7C5CFF; color: #5B3FE0; transform: translateY(-1px); }
  .cinta-hint { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; color: #6E6E7A; }
  .cinta-more { text-align: center; margin-top: 28px; }

  @media (max-width: 1100px) { .cinta { --w: 320px; --r: 700px; --p: 1700px; } }
  @media (max-width: 768px) { .cinta { --w: 260px; --r: 520px; --p: 1500px; } .cinta-stage { -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent); mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent); } }
  @media (max-width: 480px) { .cinta { --w: 240px; --r: 460px; --p: 1400px; } .cinta-hint { font-size: 0.74rem; } }
  @media (prefers-reduced-motion: reduce) {
    .cinta { opacity: 1; transform: none; transition: none; }
    .cinta-item, .cinta-item > img, .cinta-info { transition: none !important; }
    .cinta-item:hover > img { transform: none; }
  }
</style>
