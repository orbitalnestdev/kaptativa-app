---
import { casesData } from '../data/content.js';
interface Props {
  hideHeader?: boolean;
}
const { hideHeader = false } = Astro.props;
---

<section class="section" id="casos" style="padding-top: 20px;">
  <div class="container">
    {!hideHeader && (
      <div class="section-header reveal text-center" style="max-width: 750px; margin: 0 auto 40px auto;">
        <span class="badge badge-neon">
          <span class="badge-dot-pulsing"></span> PORTAFOLIO DE MARCA
        </span>
        <h2 style="margin-top: 12px; margin-bottom: 14px;">Cómo se ven nuestras soluciones <span class="text-gradient-crimson">en la práctica.</span></h2>
        <p style="color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; margin: 0 auto; max-width: 640px;">
          Sistemas digitales diseñados a medida para resolver cuellos de botella reales y escalar operaciones con orden.
        </p>
      </div>
    )}
    
    <!-- Filter Tabs for Cases -->
    <div class="cases-filter reveal reveal-delay-1" role="tablist">
      <button class="case-filter-btn active" data-filter="all" role="tab">Todos los proyectos</button>
      <button class="case-filter-btn" data-filter="web" role="tab">Web & SEO</button>
      <button class="case-filter-btn" data-filter="auto" role="tab">Automatizaciones</button>
      <button class="case-filter-btn" data-filter="ia" role="tab">Agentes IA</button>
    </div>
    
    <div class="cases-grid reveal reveal-delay-2" id="cases-grid-container">
      {casesData.map((caseItem) => (
        <div class="case-card" data-category={caseItem.category}>
          <!-- Card Header Image & Status -->
          <div class="case-image-wrapper">
            <img src={caseItem.image} alt={caseItem.alt} width="400" height="220" loading="lazy" / decoding="async">
            <div class="case-image-gradient"></div>
            
            <div class="case-badge-top-left">
              <span class="case-industry-pill">{caseItem.industry || 'Tecnología'}</span>
            </div>

            <div class="case-badge-top-right">
              <span class="case-live-badge">
                <span class="badge-dot-pulsing-green"></span> CASO DE ÉXITO
              </span>
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="case-content">
            <span class="case-category-tag">{caseItem.tag}</span>
            <h3>{caseItem.title}</h3>
            
            <div class="case-problem-solution-box">
              <div class="case-ps-item">
                <span class="ps-icon ps-icon-problem">✕</span>
                <p><strong>Desafío:</strong> {caseItem.problem}</p>
              </div>
              <div class="case-ps-item">
                <span class="ps-icon ps-icon-solution">⚡</span>
                <p><strong>Solución:</strong> {caseItem.solution}</p>
              </div>
            </div>

            <!-- Impactful Result Banner -->
            <div class="case-result-banner">
              <div class="result-header">
                <span class="result-checkmark">✓</span>
                <span class="result-title">IMPACTO EN EL NEGOCIO</span>
              </div>
              <p class="result-text">{caseItem.result}</p>
            </div>

            <!-- Tech Stack Tags -->
            {caseItem.stack && (
              <div class="case-stack-wrapper">
                {caseItem.stack.map((tech) => (
                  <span class="tech-pill">{tech}</span>
                ))}
              </div>
            )}

            <!-- CTA Action Button -->
            <div class="case-card-footer">
              <a href="#contacto-proyectos" class="case-btn-action">
                <span>Quiero un sistema similar</span>
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Dynamic projects loader from admin localStorage
    try {
      const stored = localStorage.getItem('kaptativa_projects');
      if (stored) {
        const projects = JSON.parse(stored).filter((p: any) => p.status === 'published').sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
        const grid = document.getElementById('cases-grid-container');
        if (grid && projects.length > 0) {
          grid.innerHTML = projects.map((p: any) => `
            <div class="case-card" data-category="${p.category || 'web'}">
              <div class="case-image-wrapper">
                <img src="${p.image || '/project_b2b.png'}" alt="${p.titulo}" width="400" height="220" loading="lazy" / decoding="async">
                <div class="case-image-gradient"></div>
                <div class="case-badge-top-left">
                  <span class="case-industry-pill">${p.cliente || 'Caso Real'}</span>
                </div>
                <div class="case-badge-top-right">
                  <span class="case-live-badge"><span class="badge-dot-pulsing-green"></span> CASO DE ÉXITO</span>
                </div>
              </div>
              <div class="case-content">
                <span class="case-category-tag">${p.tipo || p.category}</span>
                <h3>${p.titulo}</h3>
                <div class="case-problem-solution-box">
                  <div class="case-ps-item">
                    <span class="ps-icon ps-icon-solution">⚡</span>
                    <p><strong>Solución:</strong> ${p.descripcionBreve || p.subtitle}</p>
                  </div>
                </div>
                <div class="case-result-banner">
                  <div class="result-header">
                    <span class="result-checkmark">✓</span>
                    <span class="result-title">IMPACTO EN EL NEGOCIO</span>
                  </div>
                  <p class="result-text">${p.resultados || 'Optimización del proceso operativo'}</p>
                </div>
                <div class="case-card-footer">
                  <a href="#contacto-proyectos" class="case-btn-action">
                    <span>Quiero un sistema similar</span>
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </a>
                </div>
              </div>
            </div>
          `).join('');
        }
      }
    } catch(e) {}

    // CASE STUDIES DYNAMIC FILTERING
    const caseFilterBtns = document.querySelectorAll('.cases-filter .case-filter-btn');

    caseFilterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        caseFilterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filterValue = btn.getAttribute('data-filter');
        const currentCards = document.querySelectorAll('#cases-grid-container .case-card');

        currentCards.forEach(card => {
          const category = card.getAttribute('data-category');

          if (filterValue === 'all' || category === filterValue) {
            (card as HTMLElement).style.display = 'flex';
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, 10);
          } else {
            (card as HTMLElement).style.opacity = '0';
            (card as HTMLElement).style.transform = 'translateY(15px)';
            setTimeout(() => {
              (card as HTMLElement).style.display = 'none';
            }, 200);
          }
        });
      });
    });
  });
</script>

<style is:global>
/* ==========================================================================
   CASOS / PROYECTOS - ULTRA PREMIUM TECH SHOWCASE CARDS
   ========================================================================== */
.cases-filter {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-bottom: 45px;
  flex-wrap: wrap;
}

.case-filter-btn {
  padding: 11px 26px;
  border-radius: 30px;
  font-family: 'Lexend', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  background: rgba(15, 21, 36, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--text-secondary);
  backdrop-filter: blur(12px);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.case-filter-btn:hover {
  color: #ffffff;
  border-color: rgba(234, 56, 77, 0.4);
  background: rgba(234, 56, 77, 0.1);
}

.case-filter-btn.active {
  background: linear-gradient(135deg, #EA384D 0%, #8A35E5 100%);
  color: #ffffff !important;
  border-color: transparent !important;
  box-shadow: 0 8px 25px rgba(234, 56, 77, 0.45);
}

.cases-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}

.case-card {
  background: linear-gradient(145deg, rgba(15, 21, 36, 0.9) 0%, rgba(22, 11, 33, 0.9) 100%);
  border: 1px solid rgba(138, 53, 229, 0.25);
  border-radius: 26px;
  overflow: hidden;
  backdrop-filter: blur(20px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  position: relative;
}

.case-card:hover {
  border-color: rgba(234, 56, 77, 0.55);
  transform: translateY(-9px) scale(1.01);
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.65), 0 0 35px rgba(234, 56, 77, 0.25);
}

/* Image Header */
.case-image-wrapper {
  height: 220px;
  position: relative;
  overflow: hidden;
  background: #090d16;
}

.case-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.case-card:hover .case-image-wrapper img {
  transform: scale(1.08);
}

.case-image-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(7, 11, 20, 0.3) 0%, rgba(15, 21, 36, 0.95) 100%);
}

.case-badge-top-left {
  position: absolute;
  top: 16px;
  left: 16px;
  z-index: 2;
}

.case-industry-pill {
  font-family: 'Lexend', sans-serif;
  font-size: 0.72rem;
  font-weight: 600;
  color: #ffffff;
  background: rgba(15, 21, 36, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 4px 12px;
  border-radius: 20px;
  backdrop-filter: blur(10px);
}

.case-badge-top-right {
  position: absolute;
  top: 16px;
  right: 16px;
  z-index: 2;
}

.case-live-badge {
  font-family: 'Lexend', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: #10b981;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.35);
  padding: 4px 12px;
  border-radius: 20px;
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  gap: 6px;
  letter-spacing: 0.05em;
}

.badge-dot-pulsing-green {
  width: 6px;
  height: 6px;
  background-color: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 8px #10b981;
  animation: pulseGreen 1.8s infinite;
}

@keyframes pulseGreen {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

/* Card Content Body */
.case-content {
  padding: 28px 26px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.case-category-tag {
  display: inline-block;
  font-family: 'Lexend', sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 4px 12px;
  border-radius: 20px;
  margin-bottom: 14px;
  width: fit-content;
  background: rgba(234, 56, 77, 0.15);
  color: var(--accent-pink);
  border: 1px solid rgba(234, 56, 77, 0.35);
}

.case-card[data-category="ia"] .case-category-tag {
  background: rgba(124, 58, 237, 0.15);
  color: #a78bfa;
  border-color: rgba(124, 58, 237, 0.35);
}

.case-card[data-category="web"] .case-category-tag {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border-color: rgba(16, 185, 129, 0.35);
}

.case-content h3 {
  font-family: 'Lexend', sans-serif;
  font-size: 1.35rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 18px;
  line-height: 1.35;
  letter-spacing: -0.01em;
}

.case-problem-solution-box {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 20px;
}

.case-ps-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

.case-ps-item p {
  margin: 0;
}

.ps-icon {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.72rem;
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 2px;
}

.ps-icon-problem {
  background: rgba(239, 68, 68, 0.15);
  color: #ef4444;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.ps-icon-solution {
  background: rgba(138, 53, 229, 0.15);
  color: #a78bfa;
  border: 1px solid rgba(138, 53, 229, 0.3);
}

/* Impact Result Banner */
.case-result-banner {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(10, 80, 55, 0.15) 100%);
  border: 1px solid rgba(16, 185, 129, 0.35);
  border-radius: 16px;
  padding: 14px 16px;
  margin-bottom: 22px;
  margin-top: auto;
  box-shadow: 0 4px 15px rgba(16, 185, 129, 0.08);
}

.result-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.result-checkmark {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.25);
  color: #10b981;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 900;
}

.result-title {
  font-family: 'Lexend', sans-serif;
  font-size: 0.68rem;
  font-weight: 600;
  color: #10b981;
  letter-spacing: 0.06em;
}

.result-text {
  font-family: 'Lexend', sans-serif;
  font-size: 0.92rem;
  font-weight: 600;
  color: #ffffff;
  margin: 0;
  line-height: 1.4;
}

/* Stack Pills */
.case-stack-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 22px;
}

.tech-pill {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 3px 10px;
  border-radius: 12px;
}

/* Action Footer */
.case-card-footer {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 18px;
}

.case-btn-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 12px 18px;
  border-radius: 16px;
  font-family: 'Lexend', sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  text-decoration: none;
  transition: all 0.3s ease;
}

.case-btn-action:hover {
  background: linear-gradient(135deg, #EA384D 0%, #8A35E5 100%);
  border-color: transparent;
  box-shadow: 0 6px 20px rgba(234, 56, 77, 0.4);
  transform: translateX(2px);
}

.case-btn-action svg {
  transition: transform 0.3s ease;
}

.case-btn-action:hover svg {
  transform: translateX(4px);
}

@media (max-width: 1024px) {
  .cases-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
}

@media (max-width: 768px) {
  .cases-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .case-content {
    padding: 22px;
  }
}
</style>
