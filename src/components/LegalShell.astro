---
// Armazón de las páginas legales (privacidad y términos): hero oscuro con aurora, índice fijo a la izquierda
// y el texto en una tarjeta clara. El contenido va en el slot; los títulos h2 llevan id para el índice.
import HeroAurora from './HeroAurora.astro';
interface Props { title: string; updated: string; intro: string; toc: { id: string; label: string }[] }
const { title, updated, intro, toc } = Astro.props;
---

<section class="hero hero-section legal-hero">
  <HeroAurora />
  <div class="hero-glow-1"></div>
  <div class="container hero-container">
    <div class="hero-content reveal">
      <h1 class="hero-tagline">{title}</h1>
      <p class="hero-description">{intro}</p>
      <p class="legal-updated">Última actualización: {updated}</p>
    </div>
  </div>
</section>

<section class="section section-light legal-section">
  <div class="container legal-grid">
    <nav class="legal-toc reveal" aria-label="Contenido">
      <p class="legal-toc-title">En esta página</p>
      <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
    </nav>
    <article class="legal-body reveal reveal-delay-1"><slot /></article>
  </div>
</section>

<style is:global>
  .legal-hero { min-height: 0 !important; padding: 150px 0 60px !important; }
  .legal-hero .hero-tagline { font-size: clamp(2.1rem, 4.5vw, 3rem) !important; }
  .legal-hero .hero-description { max-width: 62ch; }
  .legal-updated { margin-top: 18px !important; font-size: 0.88rem !important; color: var(--text-muted, #8E8E99) !important; }
  .legal-grid { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 36px; align-items: start; }
  .legal-toc { position: sticky; top: 100px; padding: 20px 20px 16px; border-radius: 18px; background: #FFFFFF; border: 1px solid #E9E5F8; box-shadow: 0 1px 2px rgba(15, 15, 18, 0.04), 0 14px 34px -24px rgba(124, 92, 255, 0.35); }
  .legal-toc-title { margin: 0 0 10px !important; font-family: 'Lexend', sans-serif; font-size: 0.82rem !important; font-weight: 600; color: #5B3FE0 !important; }
  .legal-toc ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; display: grid; gap: 2px; }
  .legal-toc li { counter-increment: toc; }
  .legal-toc a { display: flex; gap: 10px; align-items: baseline; padding: 6px 8px; border-radius: 8px; font-size: 0.86rem; line-height: 1.35; color: #4B4A57; text-decoration: none; transition: background 0.2s ease, color 0.2s ease; }
  .legal-toc a::before { content: counter(toc, decimal-leading-zero); flex: none; font-family: 'Lexend', sans-serif; font-size: 0.72rem; font-weight: 600; color: #A08CFF; }
  .legal-toc a:hover { background: #F6F3FF; color: #17161D; }
  .legal-body { min-width: 0; padding: 40px 44px; border-radius: 22px; background: #FFFFFF; border: 1px solid #E9E5F8; box-shadow: 0 1px 2px rgba(15, 15, 18, 0.04), 0 24px 50px -28px rgba(124, 92, 255, 0.4); }
  .legal-section .legal-body h2 { font-family: 'Lexend', sans-serif; font-size: 1.35rem !important; line-height: 1.3 !important; font-weight: 600; color: #17161D !important; margin: 38px 0 12px !important; padding-top: 22px; border-top: 1px solid #EFEEF4; scroll-margin-top: 110px; }
  .legal-section .legal-body h2:first-child { margin-top: 0 !important; padding-top: 0; border-top: 0; }
  .legal-section .legal-body h3 { font-family: 'Lexend', sans-serif; font-size: 1.02rem !important; font-weight: 600; color: #17161D !important; margin: 22px 0 8px !important; }
  .legal-body p, .legal-body li { color: #3F3E4A !important; font-size: 1rem; line-height: 1.75; }
  .legal-body p { margin: 0 0 14px !important; }
  .legal-body ul, .legal-body ol { margin: 0 0 16px !important; padding-left: 22px !important; }
  .legal-body ul { list-style: disc !important; }
  .legal-body li { display: list-item !important; margin: 0 0 6px !important; padding-left: 4px; }
  .legal-body li::marker { color: #7C5CFF; }
  .legal-body a { color: #5B3FE0; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(124, 92, 255, 0.4); }
  .legal-body a:hover { text-decoration-color: currentColor; }
  .legal-body strong { color: #17161D; font-weight: 600; }
  .legal-body .legal-note { margin: 18px 0; padding: 16px 18px; border-radius: 14px; background: #F6F3FF; border: 1px solid rgba(124, 92, 255, 0.25); font-size: 0.95rem; }
  .legal-body .legal-note p { margin: 0 !important; font-size: 0.95rem; }
  .legal-body table { width: 100%; border-collapse: collapse; margin: 6px 0 18px; font-size: 0.93rem; }
  .legal-body th, .legal-body td { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid #EFEEF4; color: #3F3E4A; line-height: 1.5; }
  .legal-body th { font-family: 'Lexend', sans-serif; font-size: 0.8rem; font-weight: 600; color: #5B3FE0; background: #FAF8FF; }
  .legal-body .btn { margin-top: 6px; }
  @media (max-width: 960px) { .legal-grid { grid-template-columns: 1fr; gap: 22px; } .legal-toc { position: static; } .legal-toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .legal-body { padding: 26px 20px; border-radius: 18px; }
    .legal-toc ol { grid-template-columns: 1fr; }
    .legal-hero { padding: 120px 0 44px !important; }
    /* Las tablas pasan a fichas apiladas: cada fila es un bloque y la primera celda hace de título */
    .legal-body table, .legal-body tbody, .legal-body tr, .legal-body td { display: block; width: 100%; }
    .legal-body thead { display: none; }
    .legal-body tr { padding: 12px 0; border-bottom: 1px solid #EFEEF4; }
    .legal-body td { padding: 2px 0; border: 0; }
    .legal-body td:first-child { font-family: 'Lexend', sans-serif; font-weight: 600; color: #17161D; }
    .legal-body td:nth-child(3)::before { content: 'Dónde: '; color: #5B3FE0; font-weight: 600; }
  }
</style>
