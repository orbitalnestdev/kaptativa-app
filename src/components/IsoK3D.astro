---
// Isotipo de kaptativa en "3D" para la esquina de las tarjetas de cierre (como el ícono 3D de MasLeads).
// Es SVG puro: una pastilla violeta con extrusión y brillo, la K de la marca extruida encima, y una flotación lenta.
interface Props { class?: string; size?: number }
const { class: cls = '', size = 150 } = Astro.props;
---

<span class:list={['iso3d', cls]} style={`--iso-size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 160 160" width={size} height={size}>
    <defs>
      <linearGradient id="isoTile" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#A08CFF" />
        <stop offset="0.55" stop-color="#7C5CFF" />
        <stop offset="1" stop-color="#5B3FE0" />
      </linearGradient>
      <linearGradient id="isoSide" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4A32B8" />
        <stop offset="1" stop-color="#2E1F7A" />
      </linearGradient>
      <linearGradient id="isoGloss" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.42" />
        <stop offset="1" stop-color="#FFFFFF" stop-opacity="0" />
      </linearGradient>
      <filter id="isoShadow" x="-30%" y="-30%" width="160%" height="170%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
    </defs>
    <!-- sombra en el piso -->
    <ellipse cx="82" cy="146" rx="46" ry="9" fill="#2E1F7A" opacity="0.55" filter="url(#isoShadow)" />
    <g transform="rotate(-8 80 80)">
      <!-- extrusión de la pastilla -->
      <rect x="28" y="40" width="104" height="104" rx="30" fill="url(#isoSide)" />
      <!-- cara de la pastilla -->
      <rect x="28" y="26" width="104" height="104" rx="30" fill="url(#isoTile)" />
      <!-- brillo superior -->
      <path d="M58 26h44a30 30 0 0 1 30 30v12c-24-6-50-8-104 0V56a30 30 0 0 1 30-30z" fill="url(#isoGloss)" />
      <!-- K de la marca: extrusión y cara -->
      <g transform="translate(43 38) scale(1.75)" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="6.5">
        <g stroke="#3B2A8F" transform="translate(0 3.2)">
          <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" />
          <path d="M 15 13 L 26 13 L 26 24" />
        </g>
        <g stroke="#FFFFFF">
          <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" />
          <path d="M 15 13 L 26 13 L 26 24" />
        </g>
      </g>
    </g>
  </svg>
</span>

<style>
  .iso3d { position: absolute; width: var(--iso-size); height: var(--iso-size); pointer-events: none; z-index: 2; filter: drop-shadow(0 22px 34px rgba(124, 92, 255, 0.45)); }
  .iso3d svg { display: block; width: 100%; height: 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .iso3d { animation: iso-float 6s ease-in-out infinite; }
    @keyframes iso-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-9px) rotate(2deg); } }
  }
</style>
