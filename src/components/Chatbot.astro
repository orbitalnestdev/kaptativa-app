---
// Chatbot.astro (Official Floating WhatsApp Direct Button)
---
<div class="whatsapp-float-container" id="whatsapp-float-wrapper">
  <a href="https://wa.me/5493804890834?text=Hola!%20Vi%20la%20web%20de%20Kaptativa%20y%20quisiera%20recibir%20informaci%C3%B3n." target="_blank" rel="noopener noreferrer" class="whatsapp-float-btn" id="floating-wa-link" aria-label="Contactar por WhatsApp">
    <!-- Official WhatsApp SVG Icon -->
    <svg width="32" height="32" viewBox="0 0 24 24" fill="#ffffff">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.157 4.228 4.228-1.157zm12.39-7.391c.083.056.244.17.268.272.03.125.03.714-.18 1.251-.21.537-.99 1.139-1.488 1.189-.498.05-1.144.15-3.847-.941-3.265-1.319-5.312-4.636-5.474-4.852-.162-.216-1.319-1.758-1.319-3.352 0-1.594.836-2.378 1.133-2.702.297-.324.648-.405.864-.405.216 0 .432.003.621.012.198.009.459-.075.72.551.27.648.918 2.241.999 2.403.081.162.135.351.027.567-.108.216-.162.351-.324.54-.162.189-.342.422-.486.567-.162.162-.333.338-.144.662.189.324.841 1.385 1.802 2.241 1.233 1.098 2.274 1.439 2.598 1.599.324.162.513.135.702-.081.189-.216.81-.945 1.026-1.269.216-.324.432-.27.729-.162.297.108 1.89.891 2.214 1.053z"/>
    </svg>
    <span class="whatsapp-float-pulse"></span>
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const waLink = document.getElementById('floating-wa-link') as HTMLAnchorElement;
    if (!waLink) return;

    const path = window.location.pathname;
    const phone = "5493804890834";
    let message = "Hola! Vi la web de Kaptativa y quisiera solicitar un diagnóstico.";

    if (path.includes('/inmobiliarias')) {
      message = "Hola! Vi la propuesta de Sistema Web + CRM para Inmobiliarias y quisiera consultar por la puesta en marcha.";
    } else if (path.includes('/checkout')) {
      message = "Hola! Estoy en el checkout de Kaptativa y quisiera hacer una consulta sobre la contratación.";
    } else if (path.includes('/agentes-ia')) {
      message = "Hola! Quisiera más información sobre la solución de Agentes de Inteligencia Artificial para mi empresa.";
    } else if (path.includes('/automatizacion')) {
      message = "Hola! Quisiera consultar sobre Automatización e Integración de Procesos para mi empresa.";
    } else if (path.includes('/diseno-web')) {
      message = "Hola! Quisiera consultar sobre el desarrollo de Web & E-commerce a medida.";
    } else if (path.includes('/desarrollo-software')) {
      message = "Hola! Quisiera consultar por un proyecto de Desarrollo de Software a Medida.";
    } else if (path.includes('/publicidad-digital')) {
      message = "Hola! Quisiera información sobre el servicio de Publicidad Digital & Paid Media.";
    } else if (path.includes('/seo-geo')) {
      message = "Hola! Quisiera consultar sobre Posicionamiento SEO & GEO con IA.";
    } else if (path.includes('/social-media')) {
      message = "Hola! Quisiera consultar sobre el servicio de Social Media Manager & Branding.";
    } else if (path.includes('/contacto')) {
      message = "Hola! Quisiera contactarme con un especialista de Kaptativa.";
    }

    waLink.href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
  });
</script>

<style>
  .whatsapp-float-container {
    position: fixed;
    bottom: 25px;
    right: 25px;
    z-index: 9999;
  }

  .whatsapp-float-btn {
    position: relative;
    width: 58px;
    height: 58px;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4), 0 2px 10px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .whatsapp-float-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.6), 0 0 20px rgba(37, 211, 102, 0.3);
  }

  .whatsapp-float-btn:active {
    transform: scale(0.95);
  }

  .whatsapp-float-pulse {
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    animation: wa-pulse 2.2s infinite;
    pointer-events: none;
    z-index: -1;
  }

  @keyframes wa-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70% {
      transform: scale(1.3);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .whatsapp-float-container {
      bottom: 18px;
      right: 18px;
    }
    .whatsapp-float-btn {
      width: 50px;
      height: 50px;
    }
    .whatsapp-float-btn svg {
      width: 26px;
      height: 26px;
    }
  }
</style>
