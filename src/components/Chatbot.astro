---
// Chatbot.astro (Official Floating WhatsApp Direct Button)
---
<div class="whatsapp-float-container" id="whatsapp-float-wrapper">
  <a href="https://wa.me/5493804890834?text=Hola!%20Vi%20la%20web%20de%20Kaptativa%20y%20quisiera%20recibir%20informaci%C3%B3n." target="_blank" rel="noopener noreferrer" class="whatsapp-float-btn" id="floating-wa-link" aria-label="Contactar por WhatsApp">
    <!-- Logo oficial de WhatsApp -->
    <svg width="30" height="30" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const waLink = document.getElementById('floating-wa-link') as HTMLAnchorElement;
    if (!waLink) return;

    const path = window.location.pathname;
    const phone = "5493804890834";
    let message = "Hola! Vi la web de Kaptativa y quisiera solicitar un diagnóstico.";

    if (path.includes('/inmobiliarias')) {
      message = "Hola! Vi la propuesta de Sistema Web + CRM para Inmobiliarias y quisiera consultar por la puesta en marcha.";
    } else if (path.includes('/checkout')) {
      message = "Hola! Estoy en el checkout de Kaptativa y quisiera hacer una consulta sobre la contratación.";
    } else if (path.includes('/agentes-ia')) {
      message = "Hola! Quisiera más información sobre la solución de Agentes de Inteligencia Artificial para mi empresa.";
    } else if (path.includes('/automatizacion')) {
      message = "Hola! Quisiera consultar sobre Automatización e Integración de Procesos para mi empresa.";
    } else if (path.includes('/diseno-web')) {
      message = "Hola! Quisiera consultar sobre el desarrollo de Web & E-commerce a medida.";
    } else if (path.includes('/desarrollo-software')) {
      message = "Hola! Quisiera consultar por un proyecto de Desarrollo de Software a Medida.";
    } else if (path.includes('/publicidad-digital')) {
      message = "Hola! Quisiera información sobre el servicio de Publicidad Digital & Paid Media.";
    } else if (path.includes('/seo-geo')) {
      message = "Hola! Quisiera consultar sobre Posicionamiento SEO & GEO con IA.";
    } else if (path.includes('/social-media')) {
      message = "Hola! Quisiera consultar sobre el servicio de Social Media Manager & Branding.";
    } else if (path.includes('/contacto')) {
      message = "Hola! Quisiera contactarme con un especialista de Kaptativa.";
    }

    waLink.href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
  });
</script>

<style>
  .whatsapp-float-container { position: fixed; bottom: 25px; right: 25px; z-index: 9999; line-height: 0; }
  /* Tamaño fijo y proporción cuadrada: el botón no puede deformarse aunque hereden reglas de enlaces */
  .whatsapp-float-btn { position: relative; box-sizing: border-box; width: 58px; height: 58px; min-width: 58px; aspect-ratio: 1 / 1; padding: 0; margin: 0; border: 0; border-radius: 50%; background: #25D366; color: #FFFFFF; display: grid; place-items: center; text-decoration: none; box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4), 0 2px 10px rgba(0, 0, 0, 0.3); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .whatsapp-float-btn svg { position: relative; display: block; width: 30px; height: 30px; flex: none; shape-rendering: geometricPrecision; }
  /* Halo: anillo aparte que anima solo opacidad y escala (lo resuelve la GPU). Antes se animaba box-shadow sin parar y repintaba en cada cuadro */
  .whatsapp-float-btn::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 50%; background: rgba(37, 211, 102, 0.5); opacity: 0; pointer-events: none; animation: wa-ring 2.6s ease-out infinite; }
  .whatsapp-float-btn:hover { transform: scale(1.06); box-shadow: 0 8px 25px rgba(37, 211, 102, 0.55), 0 0 0 8px rgba(37, 211, 102, 0.14); }
  .whatsapp-float-btn:hover::before { animation: none; }
  .whatsapp-float-btn:active { transform: scale(0.96); }
  .whatsapp-float-btn:focus-visible { outline: 3px solid rgba(37, 211, 102, 0.6); outline-offset: 3px; }
  @keyframes wa-ring {
    0% { opacity: 0.55; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(1.5); }
  }
  @media (prefers-reduced-motion: reduce) { .whatsapp-float-btn::before { animation: none; } }
  @media (max-width: 768px) {
    .whatsapp-float-container { bottom: 18px; right: 18px; }
    .whatsapp-float-btn { width: 52px; height: 52px; min-width: 52px; }
    .whatsapp-float-btn svg { width: 27px; height: 27px; }
  }
</style>
