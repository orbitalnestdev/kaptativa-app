---
interface Props {
  activeTab: 'crm' | 'prospeccion' | 'agenda' | 'blog' | 'proyectos' | 'presupuestos' | 'services' | 'settings';
}

const { activeTab } = Astro.props;
---

<!-- MOBILE HEADER BAR (Visible <= 900px) -->
<div class="admin-mobile-header">
  <div style="display: flex; align-items: center; gap: 10px;">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="110" height="26" style="display: block;">
      <defs>
        <linearGradient id="logo-grad-adm-mob" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#EA384D" />
          <stop offset="100%" stop-color="#8A35E5" />
        </linearGradient>
      </defs>
      <g>
        <path d="M 6 13 L 6 47" stroke="url(#logo-grad-adm-mob)" stroke-width="6.5" stroke-linecap="round" fill="none" />
        <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-grad-adm-mob)" stroke-width="6.5" stroke-linecap="round" fill="none" />
        <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-grad-adm-mob)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </g>
      <text x="44" y="39" font-family="'Lexend', 'Inter', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">
        kaptativa<tspan fill="#EA384D">.</tspan>
      </text>
    </svg>
    <span class="admin-badge admin-badge-indigo" style="font-size: 0.65rem;">PANEL</span>
  </div>
  <button type="button" class="admin-mobile-toggle" id="btn-toggle-mobile-sidebar" aria-label="Abrir navegación">
    ☰
  </button>
</div>

<!-- SIDEBAR NAVIGATION -->
<aside class="admin-sidebar">
  <div class="sidebar-brand">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 8 215 44" width="130" height="32" style="display: block;">
      <defs>
        <linearGradient id="logo-grad-adm-side" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#EA384D" />
          <stop offset="100%" stop-color="#8A35E5" />
        </linearGradient>
      </defs>
      <g>
        <path d="M 6 13 L 6 47" stroke="url(#logo-grad-adm-side)" stroke-width="6.5" stroke-linecap="round" fill="none" />
        <path d="M 28 47 C 18 41 11 36 11 30 C 11 24 18 19 26 13" stroke="url(#logo-grad-adm-side)" stroke-width="6.5" stroke-linecap="round" fill="none" />
        <path d="M 15 13 L 26 13 L 26 24" stroke="url(#logo-grad-adm-side)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </g>
      <text x="44" y="39" font-family="'Lexend', 'Inter', sans-serif" font-size="27" font-weight="600" fill="#ffffff" letter-spacing="0.3">
        kaptativa<tspan fill="#EA384D">.</tspan>
      </text>
    </svg>
    <span class="badge badge-sm" style="margin-top: 5px;">CRM & Portafolio</span>
  </div>
  
  <nav class="sidebar-nav">
    <a href="/admin" class={`sidebar-link ${activeTab === 'crm' ? 'active' : ''}`} id="nav-crm">
      <span class="nav-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </span> Pipeline & CRM
    </a>
    <a href="/admin/agenda" class={`sidebar-link ${activeTab === 'agenda' ? 'active' : ''}`} id="nav-agenda">
      <span class="nav-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </span> Agenda del Equipo
    </a>
    <a href="/admin/presupuestos" class={`sidebar-link ${activeTab === 'presupuestos' ? 'active' : ''}`} id="nav-presupuestos">
      <span class="nav-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle;"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </span> Presupuestos
    </a>
    <a href="/admin/services" class={`sidebar-link ${activeTab === 'services' ? 'active' : ''}`} id="nav-services">
      <span class="nav-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      </span> Servicios
    </a>
    <a href="/admin/eteam" class={`sidebar-link ${activeTab === 'eteam' ? 'active' : ''}`} id="nav-eteam">
      <span class="nav-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span> Team
    </a>
    <a href="/admin/settings" class={`sidebar-link ${activeTab === 'settings' ? 'active' : ''}`} id="nav-settings">
      <span class="nav-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle;"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </span> Configuración
    </a>
    <a href="/" class="sidebar-link">
      <span class="nav-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: middle;"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      </span> Ver Sitio Web
    </a>
  </nav>
  
  <div class="sidebar-footer">
    <div class="admin-profile">
      <div class="admin-avatar">A</div>
      <div class="admin-profile-details">
        <span class="admin-name" id="admin-user-name">Admin</span>
        <span class="admin-role">Consultor Senior</span>
      </div>
    </div>
    <button class="btn btn-secondary btn-sm" id="btn-logout" style="width: 100%; margin-top: 15px;">Cerrar Sesión</button>
  </div>
</aside>

<script>
  import { api } from '../lib/appwrite.js';

  document.addEventListener('DOMContentLoaded', () => {
    // Mobile Drawer controller
    const mobileToggle = document.getElementById('btn-toggle-mobile-sidebar');
    const sidebar = document.querySelector('.admin-sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    const closeMobileSidebar = () => {
      sidebar?.classList.remove('mobile-open');
      overlay?.classList.remove('active');
    };

    if (mobileToggle) {
      mobileToggle.addEventListener('click', () => {
        sidebar?.classList.toggle('mobile-open');
        overlay?.classList.toggle('active');
      });
    }

    if (overlay) {
      overlay.addEventListener('click', closeMobileSidebar);
    }

    // Auto close drawer when navigating on mobile
    const sidebarLinks = document.querySelectorAll('.sidebar-link, .sidebar-submenu-link');
    sidebarLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 900) {
          closeMobileSidebar();
        }
      });
    });

    // Client-side logout logic
    const logoutBtn = document.getElementById('btn-logout');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        try {
          await api.account.logout();
        } catch (err) {
          console.warn("Appwrite logout failed, cleaning fallback session", err);
        } finally {
          // Clear session cookies and localStorage
          localStorage.setItem('mock_session', '');
          document.cookie = 'kaptativa_session=; path=/; expires=Thu, 01 Jan 1970 00:00:01 GMT;';
          window.location.href = '/admin/login';
        }
      });
    }

    // Dynamic admin user name display from session cookie if present
    const adminUserName = document.getElementById('admin-user-name');
    if (adminUserName) {
      const match = document.cookie.match(/(?:^|; )kaptativa_session=([^;]*)/);
      if (match) {
        try {
          const session = JSON.parse(decodeURIComponent(match[1]));
          adminUserName.innerText = session.name || session.email || 'Admin';
        } catch (e) {}
      }
    }

    // ==========================================================================
    // SIDEBAR SUBMENU CONTROLLER
    // ==========================================================================
    const trigger = document.getElementById('nav-settings-trigger');
    const group = trigger?.closest('.sidebar-menu-item-group');
    
    if (trigger && group) {
      trigger.addEventListener('click', () => {
        if (window.location.pathname !== '/admin/settings') {
          window.location.href = '/admin/settings?tab=integrations';
          return;
        }
        group.classList.toggle('active');
      });
    }

    // Set active link and bind events for live switches on /admin/settings page
    const urlParams = new URLSearchParams(window.location.search);
    const currentTab = urlParams.get('tab') || 'integrations';
    
    const submenuLinks = document.querySelectorAll('.sidebar-submenu-link');
    submenuLinks.forEach(link => {
      const tab = link.getAttribute('data-submenu-tab')!;
      if (tab === currentTab && window.location.pathname === '/admin/settings') {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
      
      link.addEventListener('click', (e) => {
        if (window.location.pathname === '/admin/settings') {
          e.preventDefault();
          // Update URL without reloading page
          const newUrl = `${window.location.pathname}?tab=${tab}`;
          window.history.pushState({ path: newUrl }, '', newUrl);
          
          // Set active classes
          submenuLinks.forEach(l => l.classList.remove('active'));
          link.classList.add('active');

          // Trigger CustomEvent for settings page
          const event = new CustomEvent('settings-tab-change', { detail: { tab } });
          window.dispatchEvent(event);
        }
      });
    });
  });
</script>

