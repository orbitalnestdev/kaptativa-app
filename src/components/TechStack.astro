        <div class="tech-pill"><img src="https://cdn.simpleicons.org/postgresql" alt="PostgreSQL" height="20" width="20" / loading="lazy" decoding="async"><span>PostgreSQL</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/supabase" alt="Supabase" height="20" width="20" / loading="lazy" decoding="async"><span>Supabase</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/vercel/ffffff" alt="Vercel" height="20" width="20" / loading="lazy" decoding="async"><span>Vercel</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/figma" alt="Figma" height="20" width="20" / loading="lazy" decoding="async"><span>Figma</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/react" alt="React" height="20" width="20" / loading="lazy" decoding="async"><span>React</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/nextdotjs/ffffff" alt="Next.js" height="20" width="20" / loading="lazy" decoding="async"><span>Next.js</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/typescript" alt="TypeScript" height="20" width="20" / loading="lazy" decoding="async"><span>TypeScript</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/nodedotjs" alt="Node.js" height="20" width="20" / loading="lazy" decoding="async"><span>Node.js</span></div>
        
        <!-- Group 2 (Repeated for infinite scrolling) -->
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/python" alt="Python" height="20" width="20" / loading="lazy" decoding="async"><span>Python</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/postgresql" alt="PostgreSQL" height="20" width="20" / loading="lazy" decoding="async"><span>PostgreSQL</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/supabase" alt="Supabase" height="20" width="20" / loading="lazy" decoding="async"><span>Supabase</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/vercel/ffffff" alt="Vercel" height="20" width="20" / loading="lazy" decoding="async"><span>Vercel</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/figma" alt="Figma" height="20" width="20" / loading="lazy" decoding="async"><span>Figma</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/react" alt="React" height="20" width="20" / loading="lazy" decoding="async"><span>React</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/nextdotjs/ffffff" alt="Next.js" height="20" width="20" / loading="lazy" decoding="async"><span>Next.js</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/typescript" alt="TypeScript" height="20" width="20" / loading="lazy" decoding="async"><span>TypeScript</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/nodedotjs" alt="Node.js" height="20" width="20" / loading="lazy" decoding="async"><span>Node.js</span></div>
