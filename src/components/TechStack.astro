    </div>

    <!-- Row 2: Rightward slider -->
    <div class="marquee-row" style="margin-top: 16px;">
      <div class="marquee-track marquee-right">
        <!-- Group 1 -->
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/whatsapp" alt="WhatsApp API" height="20" width="20" / loading="lazy" decoding="async"><span>WhatsApp API</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/shopify" alt="Shopify" height="20" width="20" / loading="lazy" decoding="async"><span>Shopify</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/tailwindcss" alt="Tailwind" height="20" width="20" / loading="lazy" decoding="async"><span>Tailwind</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/anthropic/F96854" alt="Claude" height="20" width="20" / loading="lazy" decoding="async"><span>Claude</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/meta" alt="Meta Ads" height="20" width="20" / loading="lazy" decoding="async"><span>Meta Ads</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/googleads" alt="Google Ads" height="20" width="20" / loading="lazy" decoding="async"><span>Google Ads</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/googleanalytics" alt="GA4" height="20" width="20" / loading="lazy" decoding="async"><span>GA4</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/n8n" alt="n8n" height="20" width="20" / loading="lazy" decoding="async"><span>n8n</span></div>

        <!-- Group 2 (Repeated for infinite scrolling) -->
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/whatsapp" alt="WhatsApp API" height="20" width="20" / loading="lazy" decoding="async"><span>WhatsApp API</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/shopify" alt="Shopify" height="20" width="20" / loading="lazy" decoding="async"><span>Shopify</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/tailwindcss" alt="Tailwind" height="20" width="20" / loading="lazy" decoding="async"><span>Tailwind</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/anthropic/F96854" alt="Claude" height="20" width="20" / loading="lazy" decoding="async"><span>Claude</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/meta" alt="Meta Ads" height="20" width="20" / loading="lazy" decoding="async"><span>Meta Ads</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/googleads" alt="Google Ads" height="20" width="20" / loading="lazy" decoding="async"><span>Google Ads</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/googleanalytics" alt="GA4" height="20" width="20" / loading="lazy" decoding="async"><span>GA4</span></div>
        <div class="tech-pill"><img src="https://cdn.simpleicons.org/n8n" alt="n8n" height="20" width="20" / loading="lazy" decoding="async"><span>n8n</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .tech-slider-section {
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .marquee-container {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 20px 0;
    position: relative;
    width: 100%;
  }

  /* Fade gradient on edges */
  .marquee-container::before,
  .marquee-container::after {
    content: '';
    position: absolute;
    top: 0;
    width: 250px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  
  .marquee-container::before {
    left: 0;
    background: linear-gradient(to right, var(--bg-primary) 0%, transparent 100%);
  }
  
  .marquee-container::after {
    right: 0;
    background: linear-gradient(to left, var(--bg-primary) 0%, transparent 100%);
  }

  .marquee-row {
    display: flex;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    gap: 16px;
    width: max-content;
    will-change: transform;
  }

  .marquee-left {
    animation: scroll-left 35s linear infinite;
  }

  .marquee-right {
    animation: scroll-right 35s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  .tech-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    cursor: default;
    backdrop-filter: blur(5px);
    flex-shrink: 0;
  }

  .tech-pill img {
    height: 20px;
    width: 20px;
    object-fit: contain;
    filter: brightness(0.95);
    transition: transform 0.3s ease;
  }

  .tech-pill:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--accent-indigo);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px var(--accent-indigo-glow);
  }

  .tech-pill:hover img {
    transform: scale(1.1);
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* Support for light theme Vercel/Next.js logos */
  :global(html[data-theme="light"]) .tech-pill img[src*="vercel/ffffff"] {
    filter: invert(1) brightness(0.1);
  }
  :global(html[data-theme="light"]) .tech-pill img[src*="nextdotjs/ffffff"] {
    filter: invert(1) brightness(0.1);
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .tech-slider-section {
      padding: 60px 0;
    }
    .marquee-container::before,
    .marquee-container::after {
      width: 100px;
    }
    .tech-pill {
      padding: 10px 18px;
      font-size: 0.875rem;
    }
    .tech-pill img {
      height: 18px;
      width: 18px;
    }
  }
</style>